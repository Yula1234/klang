import "std/mem/allocator.kl" as mem;
import "std/str/view.kl" as view;
import "std/sys/linux.kl" as linux;
import "std/io/file.kl" as file;

//! File system access.
//!
//! Conveniences over the Linux syscalls in std.sys.linux: existence checks,
//! whole-file reads and directory listing. Paths are NUL-terminated C
//! strings, matching io.File and the raw syscall layer.
//!
//! Failure is reported with a boolean or a (value, bool) pair rather than a
//! raw Errno, so the common cases read as plain conditionals.

/// Kind of a directory entry, as reported by the kernel (DT_*).
pub enum FileKind: u32 {
    UNKNOWN = 0,
    FIFO     = 1,
    CHR      = 2,
    DIR      = 4,
    BLK      = 6,
    REG      = 8,
    LNK      = 10,
    SOCK     = 12
}

/// One directory entry: the file name plus its kind.
///
/// The name borrows the listing buffer, so it is valid only until the next
/// call to DirIterator.next().
pub struct DirEntry {
    private name: view.StringView,
    private kind: FileKind,

    /// Returns the entry name, without any directory prefix.
    @inline proc name(self) -> view.StringView {
        return self.name;
    }

    /// Returns the entry kind.
    @inline proc kind(self) -> FileKind {
        return self.kind;
    }
}

/// Iterator over the entries of a directory, backed by getdents64.
///
/// Borrows a caller-provided buffer for the kernel records, so iteration
/// performs no allocation. The buffer must stay alive and unmodified while
/// the iterator is in use; a page-sized buffer is a good default.
pub struct DirIterator {
    private fd:     i32,
    private buf:    []u8,
    private pos:    u64,
    private filled: u64,

    /// Initializes over an open directory descriptor.
    proc init(self, fd: i32, buf: []u8) -> void {
        self.fd     = fd;
        self.buf    = buf;
        self.pos    = 0;
        self.filled = 0;
    }

    /// Closes the underlying descriptor.
    proc close(self) -> void {
        if (self.fd >= 0) {
            linux.close(self.fd);
            self.fd = -1;
        }
    }

    /// Returns the next entry, or (empty, false) when exhausted.
    proc next(self) -> (DirEntry, bool) {
        if (self.fd < 0) {
            return (empty_entry(), false);
        }

        while (true) {
            if (self.pos >= self.filled) {
                var (n, err) = linux.getdents64(self.fd, self.buf.ptr, self.buf.len);

                if (err != linux.Errno.SUCCESS || n == 0) {
                    return (empty_entry(), false);
                }

                self.pos    = 0;
                self.filled = n;
            }

            var rec_start: u64 = self.pos;
            var reclen:    u64 = cast(u64, self.buf[rec_start + 16]) | (cast(u64, self.buf[rec_start + 17]) << 8);

            if (reclen == 0) {
                return (empty_entry(), false);
            }

            var dtype:      u8  = self.buf[rec_start + 18];
            var name_start: u64 = rec_start + 19;
            var name_end:   u64 = name_start;

            while (name_end < rec_start + reclen && self.buf[name_end] != 0) {
                name_end += 1;
            }

            self.pos = rec_start + reclen;

            var entry: DirEntry = DirEntry {
                name: view.from_raw(cast(char*, self.buf.ptr + name_start), name_end - name_start),
                kind: d_type_to_kind(dtype)
            };

            return (entry, true);
        }
    }
}

// End-of-iteration sentinel.
@inline proc empty_entry() -> DirEntry {
    return DirEntry {
        name: view.from_raw(null, 0),
        kind: FileKind.UNKNOWN
    };
}

// Maps a raw d_type byte to a FileKind.
proc d_type_to_kind(dt: u8) -> FileKind {
    switch (dt) {
        case 1:  return FileKind.FIFO;
        case 2:  return FileKind.CHR;
        case 4:  return FileKind.DIR;
        case 6:  return FileKind.BLK;
        case 8:  return FileKind.REG;
        case 10: return FileKind.LNK;
        case 12: return FileKind.SOCK;
        default: return FileKind.UNKNOWN;
    }
}

/// Returns true when a file or directory exists at path.
pub proc exists(path: char*) -> bool {
    return linux.access(path, linux.F_OK) == linux.Errno.SUCCESS;
}

/// Reads the whole file at path into memory.
///
/// The size is obtained by seeking to the end, so this is intended for
/// regular files. The returned slice is allocated with alloc and owned by
/// the caller, who must release it with mem.dealloc_slice(alloc, bytes).
pub proc read_entire_file(alloc: mem.Allocator, path: char*) -> ([]u8, bool) {
    var (f, err) = file.open(path, linux.O_RDONLY);

    if (err != linux.Errno.SUCCESS) {
        return ([], false);
    }

    var (size, size_err) = f.seek(0, linux.SEEK_END);

    if (size_err != linux.Errno.SUCCESS) {
        f.close();
        return ([], false);
    }

    var (_, rewind_err) = f.seek_to(0);

    if (rewind_err != linux.Errno.SUCCESS) {
        f.close();
        return ([], false);
    }

    var (bytes, ok) = mem.alloc_slice[u8](alloc, size);

    if (!ok) {
        f.close();
        return ([], false);
    }

    var (nread, read_err) = f.read_all(bytes);

    f.close();

    if (read_err != linux.Errno.SUCCESS) {
        mem.dealloc_slice[u8](alloc, bytes);
        return ([], false);
    }

    if (nread == size) {
        return (bytes, true);
    }

    var (shrunk, shrink_ok) = mem.realloc_slice[u8](alloc, bytes, nread);

    return (shrunk, shrink_ok);
}

/// Opens path as a directory and returns an iterator over its entries.
///
/// The caller provides the buffer that backs the iteration and must close()
/// the iterator when done.
pub proc read_dir(path: char*, buf: []u8) -> (DirIterator, bool) {
    var (fd, err) = linux.open(path, linux.O_RDONLY | linux.O_DIRECTORY, 0);

    if (err != linux.Errno.SUCCESS) {
        var empty: DirIterator;
        empty.init(-1, buf);

        return (empty, false);
    }

    var it: DirIterator;
    it.init(fd, buf);

    return (it, true);
}
