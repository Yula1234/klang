import "std/mem/allocator.kl" as mem;
import "std/mem/utils.kl" as utils;

//! A contiguous, growable array of T backed by an allocator.
//!
//! The vector owns its backing memory and must be released with deinit();
//! moving a Vec by value transfers that ownership. Capacity is measured in
//! elements; the byte size is capacity() * sizeof(T).
//!
//! Growth follows grow_capacity(old, min) = old + old / 2 + GROWTH_EXTRA,
//! repeated until the requirement is met, for amortized O(1) appends. Growing
//! goes through Allocator.realloc, so an allocator may extend the block in
//! place.
//!
//! Allocation may fail; fallible operations report it with a boolean or a
//! (value, bool) pair and leave the vector unchanged. Zero-sized element
//! types are supported without ever allocating.

// Minimum extra elements added by one growth step.
const GROWTH_EXTRA: u64 = 8;

// Sentinel backing address for zero-sized element types.
var __zst_backing: u8;

/// Returns the sentinel backing pointer for zero-sized T.
@inline proc zst_sentinel[T]() -> T* {
    return cast(T*, &__zst_backing);
}

/// Next capacity for growth from cur to at least min; saturates on overflow.
proc grow_capacity(cur: u64, min: u64) -> u64 {
    var new: u64 = cur;

    while (new < min) {
        var step: u64 = new / 2 + GROWTH_EXTRA;

        if (new > (~cast(u64, 0)) - step) {
            return min;
        }

        new = new + step;
    }

    return new;
}

pub struct Vec[T] {
    private alloc: mem.Allocator,
    private data:  T*,
    private len:   u64,
    private cap:   u64,

    /// Initializes an empty vector bound to alloc; nothing is allocated.
    proc init(self, alloc: mem.Allocator) -> void {
        self.alloc = alloc;
        self.data  = null;
        self.len   = 0;
        self.cap   = 0;
    }

    /// Releases the backing memory; safe to call more than once.
    proc deinit(self) -> void {
        self.free_backing();
    }

    /// Returns the bound allocator.
    @inline proc allocator(self) -> mem.Allocator {
        return self.alloc;
    }

    /// Returns the number of elements.
    @inline proc count(self) -> u64 {
        return self.len;
    }

    /// Returns the capacity in elements.
    @inline proc capacity(self) -> u64 {
        return self.cap;
    }

    /// Returns true when empty.
    @inline proc is_empty(self) -> bool {
        return self.len == 0;
    }

    /// Returns the live elements as a slice.
    @inline proc as_slice(self) -> []T {
        if (self.len == 0 || self.data == null) {
            return [];
        }

        return self.data[0..self.len];
    }

    /// Returns a pointer to the element at index, or null if out of range.
    @inline proc get(self, index: u64) -> T* {
        if (index >= self.len) {
            return null;
        }

        return &self.data[index];
    }

    /// Copies out the element at index, or (zero, false) when out of range.
    proc get_copy(self, index: u64) -> (T, bool) {
        if (index >= self.len) {
            var empty: T;

            return (empty, false);
        }

        return (self.data[index], true);
    }

    /// Overwrites the element at index; false when out of range.
    proc set(self, index: u64, value: T) -> bool {
        if (index >= self.len) {
            return false;
        }

        self.data[index] = value;

        return true;
    }

    /// Returns a pointer to the first element, or null when empty.
    @inline proc first(self) -> T* {
        if (self.len == 0) {
            return null;
        }

        return &self.data[0];
    }

    /// Returns a pointer to the last element, or null when empty.
    @inline proc last(self) -> T* {
        if (self.len == 0) {
            return null;
        }

        return &self.data[self.len - 1];
    }

    /// Bounds-checked element access for v[index].
    @inline proc __index__(self, index: u64) -> T* {
        return self.get(index);
    }

    /// Slice view for v[start..end]; end is clamped to the length.
    @inline proc __slice__(self, start: u64, end: u64) -> []T {
        if (end <= start || start >= self.len) {
            return [];
        }

        var actual_end: u64 = end;

        if (actual_end > self.len) {
            actual_end = self.len;
        }

        return self.data[start..actual_end];
    }

    /// Grows so the vector can hold at least min_cap elements.
    proc ensure_capacity(self, min_cap: u64) -> bool {
        if (min_cap < self.len) {
            return false;
        }

        if (min_cap <= self.cap) {
            return true;
        }

        var elem_size: u64 = sizeof(T);

        if (elem_size == 0) {
            self.cap = min_cap;

            if (self.data == null) {
                self.data = zst_sentinel[T]();
            }

            return true;
        }

        var new_cap: u64 = grow_capacity(self.cap, min_cap);

        if (new_cap > (~cast(u64, 0)) / elem_size) {
            return false;
        }

        var new_bytes: u64 = new_cap * elem_size;
        var align:     u64 = alignof(T);

        var old_slice: []u8 = [];

        if (self.cap > 0) {
            old_slice = cast(u8*, self.data)[0..self.cap * elem_size];
        }

        var (mem, ok) = self.alloc.realloc(old_slice, align, new_bytes);

        if (!ok) {
            return false;
        }

        self.data = cast(T*, mem.ptr);
        self.cap  = new_cap;

        return true;
    }

    /// Reserves room for at least additional more elements.
    proc reserve(self, additional: u64) -> bool {
        var needed: u64 = self.len + additional;

        if (needed < self.len) {
            return false;
        }

        return self.ensure_capacity(needed);
    }

    /// Releases excess capacity; false when the allocator refuses to shrink.
    proc shrink_to_fit(self) -> bool {
        if (self.cap == self.len) {
            return true;
        }

        if (self.len == 0) {
            self.free_backing();

            return true;
        }

        var elem_size: u64 = sizeof(T);

        if (elem_size == 0) {
            self.cap = self.len;

            return true;
        }

        var old_slice: []u8 = cast(u8*, self.data)[0..self.cap * elem_size];

        var (mem, ok) = self.alloc.realloc(old_slice, alignof(T), self.len * elem_size);

        if (!ok) {
            return false;
        }

        self.data = cast(T*, mem.ptr);
        self.cap  = self.len;

        return true;
    }

    /// Appends one element; false on allocation failure.
    proc append(self, item: T) -> bool {
        if (!self.ensure_capacity(self.len + 1)) {
            return false;
        }

        self.data[self.len] = item;
        self.len += 1;

        return true;
    }

    /// Appends one element; the caller must have reserved capacity.
    @inline proc append_assume_cap(self, item: T) -> void {
        self.data[self.len] = item;
        self.len += 1;
    }

    /// Appends every element of items; items must not alias this vector.
    proc append_all(self, items: []T) -> bool {
        if (items.len == 0) {
            return true;
        }

        if (!self.ensure_capacity(self.len + items.len)) {
            return false;
        }

        utils.raw_copy(cast(u8*, self.data + self.len), cast(u8*, items.ptr), items.len * sizeof(T));

        self.len += items.len;

        return true;
    }

    /// Appends every element of items; the caller must have reserved capacity.
    proc append_all_assume_cap(self, items: []T) -> void {
        if (items.len == 0) {
            return;
        }

        utils.raw_copy(cast(u8*, self.data + self.len), cast(u8*, items.ptr), items.len * sizeof(T));

        self.len += items.len;
    }

    /// Appends another vector's elements.
    proc append_vec(self, other: Vec[T]*) -> bool {
        if (other == null || other == self) {
            return true;
        }

        return self.append_all(other.as_slice());
    }

    /// Inserts item at index, shifting the tail right.
    proc insert(self, index: u64, item: T) -> bool {
        if (index > self.len) {
            return false;
        }

        if (!self.ensure_capacity(self.len + 1)) {
            return false;
        }

        var tail: u64 = self.len - index;

        if (tail > 0) {
            utils.raw_move(cast(u8*, self.data + index + 1), cast(u8*, self.data + index), tail * sizeof(T));
        }

        self.data[index] = item;
        self.len += 1;

        return true;
    }

    /// Inserts items at index, shifting the tail right.
    proc insert_all(self, index: u64, items: []T) -> bool {
        if (index > self.len) {
            return false;
        }

        if (items.len == 0) {
            return true;
        }

        if (!self.ensure_capacity(self.len + items.len)) {
            return false;
        }

        var tail: u64 = self.len - index;

        if (tail > 0) {
            utils.raw_move(cast(u8*, self.data + index + items.len), cast(u8*, self.data + index), tail * sizeof(T));
        }

        utils.raw_copy(cast(u8*, self.data + index), cast(u8*, items.ptr), items.len * sizeof(T));

        self.len += items.len;

        return true;
    }

    /// Removes and returns the last element, or (zero, false) when empty.
    proc pop(self) -> (T, bool) {
        if (self.len == 0) {
            var empty: T;

            return (empty, false);
        }

        self.len -= 1;

        return (self.data[self.len], true);
    }

    /// Removes the element at index, preserving order.
    proc remove(self, index: u64) -> (T, bool) {
        if (index >= self.len) {
            var empty: T;

            return (empty, false);
        }

        var item: T = self.data[index];
        var tail: u64 = self.len - index - 1;

        if (tail > 0) {
            utils.raw_move(cast(u8*, self.data + index), cast(u8*, self.data + index + 1), tail * sizeof(T));
        }

        self.len -= 1;

        return (item, true);
    }

    /// Removes the element at index by swapping in the last; O(1).
    proc swap_remove(self, index: u64) -> (T, bool) {
        if (index >= self.len) {
            var empty: T;

            return (empty, false);
        }

        var item: T = self.data[index];
        var last: u64 = self.len - 1;

        if (index != last) {
            self.data[index] = self.data[last];
        }

        self.len -= 1;

        return (item, true);
    }

    /// Shrinks the length to new_len; capacity is retained.
    proc truncate(self, new_len: u64) -> void {
        if (new_len < self.len) {
            self.len = new_len;
        }
    }

    /// Removes all elements, retaining the backing memory.
    @inline proc clear(self) -> void {
        self.len = 0;
    }

    /// Removes all elements and releases the backing memory.
    proc clear_and_free(self) -> void {
        self.free_backing();

        self.len = 0;
    }

    /// Resizes to exactly new_len elements, filling new slots with filler.
    proc resize(self, new_len: u64, filler: T) -> bool {
        if (new_len < self.len) {
            self.len = new_len;

            return true;
        }

        if (!self.ensure_capacity(new_len)) {
            return false;
        }

        while (self.len < new_len) {
            self.data[self.len] = filler;
            self.len += 1;
        }

        return true;
    }

    /// Returns true when item is present.
    proc contains(self, item: T) -> bool {
        var (_, found) = self.find_index(item, false);

        return found;
    }

    /// Returns the index of the first occurrence of item.
    proc index_of(self, item: T) -> (u64, bool) {
        return self.find_index(item, false);
    }

    /// Returns the index of the last occurrence of item.
    proc last_index_of(self, item: T) -> (u64, bool) {
        return self.find_index(item, true);
    }

    /// Returns a deep copy that owns its own backing memory.
    proc clone(self) -> (Vec[T], bool) {
        var res: Vec[T];
        res.init(self.alloc);

        if (!res.append_all(self.as_slice())) {
            res.deinit();

            return (res, false);
        }

        return (res, true);
    }

    /// Hands the backing memory to the caller and resets the vector.
    proc to_owned_slice(self) -> ([]T, bool) {
        var s: []T = [];

        if (self.len == 0) {
            self.deinit();

            return (s, true);
        }

        if (self.len == self.cap) {
            s = self.as_slice();
        } else {
            if (!self.shrink_to_fit()) {
                return (s, false);
            }

            s = self.as_slice();
        }

        self.data = null;
        self.len  = 0;
        self.cap  = 0;

        return (s, true);
    }

    // Releases the backing memory and clears data/capacity.
    private proc free_backing(self) -> void {
        var elem_size: u64 = sizeof(T);

        if (elem_size > 0 && self.cap > 0 && self.data != null) {
            var old_slice: []u8 = cast(u8*, self.data)[0..self.cap * elem_size];

            self.alloc.dealloc(old_slice, alignof(T));
        }

        self.data = null;
        self.cap  = 0;
        self.len  = 0;
    }

    // Shared forward/backward scan behind contains/index_of/last_index_of.
    private proc find_index(self, item: T, from_end: bool) -> (u64, bool) {
        if (from_end) {
            var i: u64 = self.len;

            while (i > 0) {
                i -= 1;

                if (self.data[i] == item) {
                    return (i, true);
                }
            }

            return (0, false);
        }

        var i: u64 = 0;

        while (i < self.len) {
            if (self.data[i] == item) {
                return (i, true);
            }

            i += 1;
        }

        return (0, false);
    }
}

/// Returns an empty vector bound to alloc.
pub proc empty[T](alloc: mem.Allocator) -> Vec[T] {
    var v: Vec[T];
    v.init(alloc);

    return v;
}

/// Returns an empty vector with capacity for at least capacity elements.
pub proc with_capacity[T](alloc: mem.Allocator, capacity: u64) -> (Vec[T], bool) {
    var v: Vec[T];
    v.init(alloc);

    if (capacity > 0) {
        if (!v.ensure_capacity(capacity)) {
            return (v, false);
        }
    }

    return (v, true);
}

/// Returns a vector holding a copy of items.
pub proc from_slice[T](alloc: mem.Allocator, items: []T) -> (Vec[T], bool) {
    var v: Vec[T];
    v.init(alloc);

    if (!v.append_all(items)) {
        v.deinit();

        return (v, false);
    }

    return (v, true);
}

/// Returns a vector that adopts items without copying.
pub proc from_owned_slice[T](alloc: mem.Allocator, items: []T) -> Vec[T] {
    var v: Vec[T];
    v.init(alloc);

    if (items.len == 0) {
        v.data = null;
    } else {
        v.data = items.ptr;
    }

    v.len = items.len;
    v.cap = items.len;

    return v;
}
