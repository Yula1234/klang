import "std/io/writer.kl" as writer;

//! A Writer that discards its input and counts the bytes.
//!
//! Handy for measuring how large a formatted value would be before reserving
//! space. Every write succeeds and is never partial.
pub struct CountingWriter {
    bytes_written: u64,

    proc init(self) -> void {
        self.bytes_written = 0;
    }

    /// Returns a Writer that counts bytes and discards them.
    proc writer(self) -> writer.Writer {
        return writer.make_writer(cast(void*, self), counting_write);
    }
}

// Writer callback.
proc counting_write(ctx: void*, bytes: []u8) -> (u64, bool) {
    var cw: CountingWriter* = cast(CountingWriter*, ctx);

    cw.bytes_written = cw.bytes_written + bytes.len;

    return (bytes.len, true);
}