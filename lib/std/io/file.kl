import "std/sys/linux.kl" as linux;
import "std/io/writer.kl" as writer;
import "std/io/reader.kl" as reader;

// 0644: owner rw, group r, other r.
const DEFAULT_MODE: u32 = 0x1A4;

//! Handle to an open file descriptor.
//!
//! Wraps a Linux file descriptor with read, write, seek and close operations,
//! plus Reader/Writer adapters that plug a File into the io interfaces.
//! Closing an already-closed or invalid handle is a no-op.
pub struct File {
    private fd: i32,

    /// Initializes from an existing file descriptor.
    proc init(self, fd: i32) -> void {
        self.fd = fd;
    }

    /// Closes the descriptor; subsequent reads and writes fail with EBADF.
    proc close(self) -> linux.Errno {
        if (self.fd < 0) {
            return linux.Errno.SUCCESS;
        }

        var err: linux.Errno = linux.close(self.fd);

        self.fd = -1;

        return err;
    }

    /// Reads up to buffer.len bytes; a zero read means end-of-file.
    proc read(self, buffer: []u8) -> (u64, linux.Errno) {
        return linux.read(self.fd, buffer.ptr, buffer.len);
    }

    /// Reads until buffer is full or end-of-file is reached.
    proc read_all(self, buffer: []u8) -> (u64, linux.Errno) {
        var index: u64 = 0;

        while (index < buffer.len) {
            var (nread, err) = linux.read(self.fd, buffer.ptr + index, buffer.len - index);

            if (err == linux.Errno.EINTR) {
                continue;
            }

            if (err != linux.Errno.SUCCESS) {
                return (index, err);
            }

            if (nread == 0) {
                break;
            }

            index = index + nread;
        }

        return (index, linux.Errno.SUCCESS);
    }

    /// Writes up to bytes.len bytes; a partial write is not retried.
    proc write(self, bytes: []u8) -> (u64, linux.Errno) {
        return linux.write(self.fd, bytes.ptr, bytes.len);
    }

    /// Writes every byte, retrying partial writes and EINTR.
    proc write_all(self, bytes: []u8) -> linux.Errno {
        var index: u64 = 0;

        while (index < bytes.len) {
            var (nwritten, err) = linux.write(self.fd, bytes.ptr + index, bytes.len - index);

            if (err == linux.Errno.EINTR) {
                continue;
            }

            if (err != linux.Errno.SUCCESS) {
                return err;
            }

            if (nwritten == 0) {
                return linux.Errno.EIO;
            }

            index = index + nwritten;
        }

        return linux.Errno.SUCCESS;
    }

    /// Repositions the file offset relative to the given origin.
    proc seek(self, offset: i64, whence: i32) -> (u64, linux.Errno) {
        return linux.lseek(self.fd, offset, whence);
    }

    /// Repositions the file offset to an absolute position.
    proc seek_to(self, offset: i64) -> (u64, linux.Errno) {
        return linux.lseek(self.fd, offset, linux.SEEK_SET);
    }

    /// Returns the current file offset.
    proc tell(self) -> (u64, linux.Errno) {
        return linux.lseek(self.fd, 0, linux.SEEK_CUR);
    }

    /// Returns a Reader that reads from this file.
    proc reader(self) -> reader.Reader {
        return reader.make_reader(cast(void*, self), file_read);
    }

    /// Returns a Writer that writes to this file.
    proc writer(self) -> writer.Writer {
        return writer.make_writer(cast(void*, self), file_write);
    }
}

/// Opens or creates path with flags and the default mode.
pub proc open(path: char*, flags: u32) -> (File, linux.Errno) {
    return open_mode(path, flags, DEFAULT_MODE);
}

/// Wraps an existing descriptor; the handle owns it and closes it on close().
pub proc from_fd(fd: i32) -> File {
    return File { fd: fd };
}

/// Opens or creates path with flags and creation mode; mode applies only with O_CREAT.
pub proc open_mode(path: char*, flags: u32, mode: u32) -> (File, linux.Errno) {
    var (new_fd, err) = linux.open(path, flags, mode);

    if (err != linux.Errno.SUCCESS) {
        return (File { fd: -1 }, err);
    }

    return (File { fd: new_fd }, linux.Errno.SUCCESS);
}

/// Creates a file for writing, truncating existing contents.
pub proc create(path: char*, mode: u32) -> (File, linux.Errno) {
    return open_mode(path, linux.O_CREAT | linux.O_WRONLY | linux.O_TRUNC, mode);
}

/// Returns the process standard input.
pub @inline proc stdin() -> File {
    return File { fd: linux.STDIN_FILENO };
}

/// Returns the process standard output.
pub @inline proc stdout() -> File {
    return File { fd: linux.STDOUT_FILENO };
}

/// Returns the process standard error.
pub @inline proc stderr() -> File {
    return File { fd: linux.STDERR_FILENO };
}

// Reader callback.
proc file_read(ctx: void*, dest: []u8) -> (u64, bool) {
    var file: File* = cast(File*, ctx);

    var (nread, err) = linux.read(file.fd, dest.ptr, dest.len);

    if (err != linux.Errno.SUCCESS) {
        return (0, false);
    }

    return (nread, true);
}

// Writer callback.
proc file_write(ctx: void*, bytes: []u8) -> (u64, bool) {
    var file: File* = cast(File*, ctx);

    var (nwritten, err) = linux.write(file.fd, bytes.ptr, bytes.len);

    if (err != linux.Errno.SUCCESS) {
        return (0, false);
    }

    return (nwritten, true);
}