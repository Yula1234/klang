import "std/io/reader.kl" as reader;
import "std/mem/utils.kl" as utils;

//! Buffered Reader.
//!
//! Serves small reads from an internal buffer, refilling it from the
//! underlying Reader when it runs dry.
//!
//! The caller owns the buffer and must keep the BufferedReader alive as long
//! as the Reader returned by reader() is in use.
pub struct BufferedReader {
    private unbuffered_reader: reader.Reader,
    private buf:               []u8,
    private start:             u64,
    private end:               u64,

    /// Initializes over unbuffered with the caller-owned buffer.
    proc init(self, unbuffered: reader.Reader, buf: []u8) -> void {
        self.unbuffered_reader = unbuffered;
        self.buf               = buf;
        self.start             = 0;
        self.end               = 0;
    }

    /// Returns a Reader that reads through the buffer.
    proc reader(self) -> reader.Reader {
        return reader.make_reader(cast(void*, self), buffered_read);
    }
}

// Reader callback.
proc buffered_read(ctx: void*, dest: []u8) -> (u64, bool) {
    var br: BufferedReader* = cast(BufferedReader*, ctx);

    if (dest.len == 0) {
        return (0, true);
    }

    if (br.buf.len == 0) {
        return br.unbuffered_reader.read(dest);
    }

    if (br.start == br.end) {
        var (nread, ok) = br.unbuffered_reader.read(br.buf);

        if (!ok) {
            return (0, false);
        }

        if (nread == 0) {
            return (0, true);
        }

        br.start = 0;
        br.end   = nread;
    }

    var available: u64 = br.end - br.start;
    var count:    u64 = dest.len;

    if (available < count) {
        count = available;
    }

    utils.raw_copy(dest.ptr, br.buf.ptr + br.start, count);

    br.start = br.start + count;

    return (count, true);
}