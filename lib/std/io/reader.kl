//! An input byte stream.
//!
//! A Reader is a context pointer plus a read callback. The callback returns
//! the number of bytes read and a success flag: (0, true) is end-of-stream,
//! (0, false) an I/O error.
pub struct Reader {
    private ctx:     void*,
    private read_fn: proc(void*, []u8) -> (u64, bool),

    /// Initializes with a context pointer and a read callback.
    proc init(self, ctx: void*, read_fn: proc(void*, []u8) -> (u64, bool)) -> void {
        self.ctx     = ctx;
        self.read_fn = read_fn;
    }

    /// Reads up to buffer.len bytes; may be partial.
    proc read(self, buffer: []u8) -> (u64, bool) {
        if (self.read_fn == null) {
            return (0, false);
        }

        return self.read_fn(self.ctx, buffer);
    }

    /// Reads until buffer is full; false on early end-of-stream or error.
    proc read_all(self, buffer: []u8) -> bool {
        var index: u64 = 0;

        while (index < buffer.len) {
            var (nread, ok) = self.read(buffer[index..buffer.len]);

            if (!ok || nread == 0) {
                return false;
            }

            index = index + nread;
        }

        return true;
    }

    /// Reads a single byte.
    proc read_byte(self) -> (u8, bool) {
        var buf: [1]u8;

        var (nread, ok) = self.read(buf[0..1]);

        if (!ok || nread == 0) {
            return (0, false);
        }

        return (buf[0], true);
    }

    /// Discards count bytes; false on early end-of-stream or error.
    proc skip_bytes(self, count: u64) -> bool {
        var scratch: [512]u8;

        var remaining: u64 = count;

        while (remaining > 0) {
            var chunk: u64 = 512;

            if (remaining < chunk) {
                chunk = remaining;
            }

            var (nread, ok) = self.read(scratch[0..chunk]);

            if (!ok || nread == 0) {
                return false;
            }

            remaining = remaining - nread;
        }

        return true;
    }
}

/// Returns a Reader bound to ctx and read_fn.
pub @inline proc make_reader(ctx: void*, read_fn: proc(void*, []u8) -> (u64, bool)) -> Reader {
    var r: Reader;
    r.init(ctx, read_fn);

    return r;
}