// Represents an output byte stream.
// Wraps a context pointer and a write callback, providing formatted
// output and partial write handling without heap allocations or libc.
pub struct Writer {
    private ctx:      void*,
    private write_fn: proc(void*, []u8) -> (u64, bool),

    // Initializes a writer with a context pointer and a write callback.
    proc init(self, ctx: void*, write_fn: proc(void*, []u8) -> (u64, bool)) -> void {
        self.ctx      = ctx;
        self.write_fn = write_fn;
    }

    // Direct write to the underlying stream.
    // May perform a partial write. Returns (bytes_written, ok).
    proc write(self, bytes: []u8) -> (u64, bool) {
        if (self.write_fn == null) {
            return (0, false);
        }

        return self.write_fn(self.ctx, bytes);
    }

    // Writes all bytes from the buffer, looping on partial writes.
    // Guarantees all bytes are sent unless an I/O error occurs.
    proc write_all(self, bytes: []u8) -> bool {
        var index: u64 = 0;

        while (index < bytes.len) {
            var (written, ok) = self.write(bytes[index..bytes.len]);

            if (!ok || written == 0) {
                return false;
            }

            index = index + written;
        }

        return true;
    }

    // Writes a single byte to the output stream.
    proc write_byte(self, b: u8) -> bool {
        var buf: [1]u8;
        buf[0] = b;

        return self.write_all(buf[0..1]);
    }

    // Writes a null-terminated string to the output stream.
    // Handles null pointers safely by writing "(null)".
    proc write_str(self, s: char*) -> bool {
        if (s == null) {
            return self.write_all(cast(u8*, "(null)")[0..6]);
        }

        var len: u64 = 0;

        while (s[len] != '\0') {
            len = len + 1;
        }

        return self.write_all(cast(u8*, s)[0..len]);
    }

    // Formats an unsigned 64-bit integer into a stack buffer and writes it to the stream.
    proc write_u64(self, val: u64) -> bool {
        if (val == 0) {
            return self.write_byte(cast(u8, '0'));
        }

        var buf: [32]u8;
        var pos: u64 = 32;
        var v:   u64 = val;

        while (v > 0) {
            pos = pos - 1;
            buf[pos] = cast(u8, '0') + cast(u8, v % 10);
            v = v / 10;
        }

        return self.write_all(buf[pos..32]);
    }

    // Formats a signed 64-bit integer into a stack buffer and writes it to the stream.
    // Handles negative values and edge-case INT64_MIN cleanly.
    proc write_i64(self, val: i64) -> bool {
        if (val >= 0) {
            return self.write_u64(cast(u64, val));
        }

        if (!self.write_byte(cast(u8, '-'))) {
            return false;
        }

        if (val == -9223372036854775807 - 1) {
            return self.write_all(cast(u8*, "9223372036854775808")[0..19]);
        }

        return self.write_u64(cast(u64, -val));
    }

    // Formats an unsigned 64-bit integer as hexadecimal digits.
    proc write_hex(self, val: u64, uppercase: bool) -> bool {
        if (val == 0) {
            return self.write_byte(cast(u8, '0'));
        }

        var buf: [32]u8;
        var pos: u64 = 32;
        var v:   u64 = val;

        var hex_base: u8 = cast(u8, 'a');

        if (uppercase) {
            hex_base = cast(u8, 'A');
        }

        while (v > 0) {
            pos = pos - 1;
            var rem: u8 = cast(u8, v & 15);

            if (rem < 10) {
                buf[pos] = cast(u8, '0') + rem;
            } else {
                buf[pos] = hex_base + (rem - 10);
            }

            v = v >> 4;
        }

        return self.write_all(buf[pos..32]);
    }

    // Formats a memory pointer as a hexadecimal address with a "0x" prefix.
    proc write_ptr(self, ptr: void*) -> bool {
        if (ptr == null) {
            return self.write_all(cast(u8*, "(null)")[0..6]);
        }

        if (!self.write_all(cast(u8*, "0x")[0..2])) {
            return false;
        }

        return self.write_hex(cast(u64, ptr), false);
    }

    // Formats a boolean as "true" or "false".
    proc write_bool(self, b: bool) -> bool {
        if (b) {
            return self.write_all(cast(u8*, "true")[0..4]);
        }

        return self.write_all(cast(u8*, "false")[0..5]);
    }

    // Formatted printing using a format string and variadic arguments.
    // Specifiers: %s (string), %c (char), %d/%i (i64), %u (u64), %x/%X (hex), %p (ptr), %b (bool), %% (percent).
    // Operates with zero heap allocations by formatting scalar values on the stack.
    proc print(self, fmt: char*, ...) -> bool {
        if (fmt == null) {
            return false;
        }

        var ap: VaList;
        va_start(ap);

        var start: u64 = 0;
        var i:     u64 = 0;

        while (fmt[i] != '\0') {
            if (fmt[i] == '%') {
                if (i > start) {
                    if (!self.write_all(cast(u8*, fmt + start)[0..(i - start)])) {
                        va_end(ap);
                        return false;
                    }
                }

                i = i + 1;
                var spec: char = fmt[i];

                if (spec == '\0') {
                    break;
                }

                switch (spec) {
                    case '%': {
                        if (!self.write_byte(cast(u8, '%'))) {
                            va_end(ap);
                            return false;
                        }
                    }

                    case 's': {
                        var str_arg: char* = va_arg(ap, char*);

                        if (!self.write_str(str_arg)) {
                            va_end(ap);
                            return false;
                        }
                    }

                    case 'c': {
                        var char_arg: i32 = va_arg(ap, i32);

                        if (!self.write_byte(cast(u8, char_arg))) {
                            va_end(ap);
                            return false;
                        }
                    }

                    case 'd', 'i': {
                        var int_arg: i64 = va_arg(ap, i64);

                        if (!self.write_i64(int_arg)) {
                            va_end(ap);
                            return false;
                        }
                    }

                    case 'u': {
                        var uint_arg: u64 = va_arg(ap, u64);

                        if (!self.write_u64(uint_arg)) {
                            va_end(ap);
                            return false;
                        }
                    }

                    case 'x': {
                        var hex_arg: u64 = va_arg(ap, u64);

                        if (!self.write_hex(hex_arg, false)) {
                            va_end(ap);
                            return false;
                        }
                    }

                    case 'X': {
                        var hex_arg: u64 = va_arg(ap, u64);

                        if (!self.write_hex(hex_arg, true)) {
                            va_end(ap);
                            return false;
                        }
                    }

                    case 'p': {
                        var ptr_arg: void* = va_arg(ap, void*);

                        if (!self.write_ptr(ptr_arg)) {
                            va_end(ap);
                            return false;
                        }
                    }

                    case 'b': {
                        var bool_arg: bool = va_arg(ap, bool);

                        if (!self.write_bool(bool_arg)) {
                            va_end(ap);
                            return false;
                        }
                    }

                    default: {
                        if (!self.write_byte(cast(u8, '%')) || !self.write_byte(cast(u8, spec))) {
                            va_end(ap);
                            return false;
                        }
                    }
                }

                i = i + 1;
                start = i;
                continue;
            }

            i = i + 1;
        }

        if (i > start) {
            if (!self.write_all(cast(u8*, fmt + start)[0..(i - start)])) {
                va_end(ap);
                return false;
            }
        }

        va_end(ap);

        return true;
    }
}

// Factory helper to construct a Writer from a context pointer and a write callback.
pub @inline proc make_writer(ctx: void*, write_fn: proc(void*, []u8) -> (u64, bool)) -> Writer {
    var w: Writer;
    w.init(ctx, write_fn);

    return w;
}