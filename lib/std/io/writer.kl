//! An output byte stream.
//!
//! A Writer is a context pointer plus a write callback. write() may perform a
//! partial write; write_all() loops until every byte has been written.
//! Formatting lives in std/fmt.kl, not here.

pub struct Writer {
    private ctx:      void*,
    private write_fn: proc(void*, []u8) -> (u64, bool),

    /// Initializes with a context pointer and a write callback.
    proc init(self, ctx: void*, write_fn: proc(void*, []u8) -> (u64, bool)) -> void {
        self.ctx      = ctx;
        self.write_fn = write_fn;
    }

    /// Writes up to bytes.len bytes; may be partial.
    proc write(self, bytes: []u8) -> (u64, bool) {
        if (self.write_fn == null) {
            return (0, false);
        }

        return self.write_fn(self.ctx, bytes);
    }

    /// Writes every byte, looping on partial writes.
    proc write_all(self, bytes: []u8) -> bool {
        var index: u64 = 0;

        while (index < bytes.len) {
            var (written, ok) = self.write(bytes[index..bytes.len]);

            if (!ok || written == 0) {
                return false;
            }

            index = index + written;
        }

        return true;
    }

    /// Writes a single byte.
    proc write_byte(self, b: u8) -> bool {
        var buf: [1]u8;
        buf[0] = b;

        return self.write_all(buf[0..1]);
    }

    /// Writes a NUL-terminated string; a null pointer writes "(null)".
    proc write_str(self, s: char*) -> bool {
        if (s == null) {
            return self.write_all(cast(u8*, "(null)")[0..6]);
        }

        var len: u64 = 0;

        while (s[len] != '\0') {
            len = len + 1;
        }

        return self.write_all(cast(u8*, s)[0..len]);
    }
}

/// Returns a Writer bound to ctx and write_fn.
pub @inline proc make_writer(ctx: void*, write_fn: proc(void*, []u8) -> (u64, bool)) -> Writer {
    var w: Writer;
    w.init(ctx, write_fn);

    return w;
}