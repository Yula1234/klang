import "std/io/writer.kl" as writer;
import "std/mem/utils.kl" as utils;

//! Buffered Writer.
//!
//! Accumulates small writes in an internal buffer and flushes to the
//! underlying Writer when the buffer fills or flush() is called.
//!
//! The caller owns the buffer and must keep the BufferedWriter alive as long
//! as the Writer returned by writer() is in use. An empty buffer degrades to
//! pass-through writes.
pub struct BufferedWriter {
    private unbuffered_writer: writer.Writer,
    private buf:               []u8,
    private start:             u64,

    /// Initializes over unbuffered with the caller-owned buffer.
    proc init(self, unbuffered: writer.Writer, buf: []u8) -> void {
        self.unbuffered_writer = unbuffered;
        self.buf               = buf;
        self.start             = 0;
    }

    /// Returns a Writer that appends to the buffer, flushing when full.
    proc writer(self) -> writer.Writer {
        return writer.make_writer(cast(void*, self), buffered_write);
    }

    /// Flushes buffered bytes; false if the underlying writer failed.
    proc flush(self) -> bool {
        if (self.start == 0) {
            return true;
        }

        if (!self.unbuffered_writer.write_all(self.buf[0..self.start])) {
            return false;
        }

        self.start = 0;

        return true;
    }
}

// Writer callback.
proc buffered_write(ctx: void*, bytes: []u8) -> (u64, bool) {
    var bw: BufferedWriter* = cast(BufferedWriter*, ctx);

    if (bytes.len >= bw.buf.len) {
        // Large write: flush, then bypass the buffer.
        if (!bw.flush()) {
            return (0, false);
        }

        return bw.unbuffered_writer.write(bytes);
    }

    if (bw.start == bw.buf.len) {
        if (!bw.flush()) {
            return (0, false);
        }
    }

    var space: u64 = bw.buf.len - bw.start;
    var count: u64 = bytes.len;

    if (space < count) {
        count = space;
    }

    utils.raw_copy(bw.buf.ptr + bw.start, bytes.ptr, count);

    bw.start = bw.start + count;

    return (count, true);
}