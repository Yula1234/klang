import "std/io/writer.kl" as io;

//! Integer formatting and printf-style output over an io.Writer.
//!
//! format_* writes into a caller-provided buffer from the front and returns
//! the number of characters written, which is also the buffer size the caller
//! must provide. At most buf.len characters are stored.
//!
//! write_* renders a value into a Writer. print() is a printf-style formatter
//! over a Writer; it understands %s, %c, %d, %i, %u, %x, %X, %p, %b and %%:
//!
//!   %s  string (char*)
//!   %c  character
//!   %d  signed 64-bit integer
//!   %i  signed 64-bit integer
//!   %u  unsigned 64-bit integer
//!   %x  hexadecimal, lowercase
//!   %X  hexadecimal, uppercase
//!   %p  pointer, as 0xNNN... (or "(null)")
//!   %b  boolean, as true/false
//!   %%  literal percent
//!
//! Nothing here allocates.

/// Writes val in decimal; returns the number of characters written.
pub proc format_u64(buf: []u8, val: u64) -> u64 {
    if (val == 0) {
        if (buf.len > 0) {
            buf[0] = cast(u8, '0');
        }

        return 1;
    }

    var tmp: [20]u8;
    var pos: u64 = 20;
    var v:   u64 = val;

    while (v > 0) {
        pos -= 1;
        tmp[pos] = cast(u8, '0') + cast(u8, v % 10);
        v = v / 10;
    }

    var count: u64 = 20 - pos;
    var i:     u64 = 0;

    while (i < count && i < buf.len) {
        buf[i] = tmp[pos + i];
        i += 1;
    }

    return count;
}

/// Writes val in decimal with a leading '-' when negative.
pub proc format_i64(buf: []u8, val: i64) -> u64 {
    if (val >= 0) {
        return format_u64(buf, cast(u64, val));
    }

    var written: u64 = 0;

    if (buf.len > 0) {
        buf[0] = cast(u8, '-');
        written = 1;
    }

    var mag: u64;

    if (val == -9223372036854775807 - 1) {
        mag = cast(u64, 1) << 63;
    } else {
        mag = cast(u64, -val);
    }

    var sub: []u8 = [];

    if (buf.len > 1) {
        sub = buf[1..buf.len];
    }

    var digits: u64 = format_u64(sub, mag);

    return written + digits;
}

/// Writes val in hexadecimal; lowercase digits unless uppercase is set.
pub proc format_hex(buf: []u8, val: u64, uppercase: bool) -> u64 {
    if (val == 0) {
        if (buf.len > 0) {
            buf[0] = cast(u8, '0');
        }

        return 1;
    }

    var base: u8 = cast(u8, 'a');

    if (uppercase) {
        base = cast(u8, 'A');
    }

    var tmp: [16]u8;
    var pos: u64 = 16;
    var v:   u64 = val;

    while (v > 0) {
        pos -= 1;

        var rem: u64 = v & 15;

        if (rem < 10) {
            tmp[pos] = cast(u8, '0') + cast(u8, rem);
        } else {
            tmp[pos] = base + cast(u8, rem - 10);
        }

        v = v >> 4;
    }

    var count: u64 = 16 - pos;
    var i:     u64 = 0;

    while (i < count && i < buf.len) {
        buf[i] = tmp[pos + i];
        i += 1;
    }

    return count;
}

/// Writes val in binary.
pub proc format_bin(buf: []u8, val: u64) -> u64 {
    if (val == 0) {
        if (buf.len > 0) {
            buf[0] = cast(u8, '0');
        }

        return 1;
    }

    var tmp: [64]u8;
    var pos: u64 = 64;
    var v:   u64 = val;

    while (v > 0) {
        pos -= 1;
        tmp[pos] = cast(u8, '0') + cast(u8, v & 1);
        v = v >> 1;
    }

    var count: u64 = 64 - pos;
    var i:     u64 = 0;

    while (i < count && i < buf.len) {
        buf[i] = tmp[pos + i];
        i += 1;
    }

    return count;
}

/// Writes val in decimal to w.
pub proc write_u64(w: io.Writer, val: u64) -> bool {
    var buf: [20]u8;

    var n: u64 = format_u64(buf[0..20], val);

    return w.write_all(buf[0..n]);
}

/// Writes val in decimal to w, with a leading '-' when negative.
pub proc write_i64(w: io.Writer, val: i64) -> bool {
    var buf: [20]u8;

    var n: u64 = format_i64(buf[0..20], val);

    return w.write_all(buf[0..n]);
}

/// Writes val in hexadecimal to w; lowercase digits unless uppercase is set.
pub proc write_hex(w: io.Writer, val: u64, uppercase: bool) -> bool {
    var buf: [16]u8;

    var n: u64 = format_hex(buf[0..16], val, uppercase);

    return w.write_all(buf[0..n]);
}

/// Writes val in binary to w.
pub proc write_bin(w: io.Writer, val: u64) -> bool {
    var buf: [64]u8;

    var n: u64 = format_bin(buf[0..64], val);

    return w.write_all(buf[0..n]);
}

/// Writes a pointer as a 0x-prefixed hex address, or "(null)" when null.
pub proc write_ptr(w: io.Writer, ptr: void*) -> bool {
    if (ptr == null) {
        return w.write_all(cast(u8*, "(null)")[0..6]);
    }

    if (!w.write_all(cast(u8*, "0x")[0..2])) {
        return false;
    }

    return write_hex(w, cast(u64, ptr), false);
}

/// Writes a boolean as "true" or "false".
pub proc write_bool(w: io.Writer, b: bool) -> bool {
    if (b) {
        return w.write_all(cast(u8*, "true")[0..4]);
    }

    return w.write_all(cast(u8*, "false")[0..5]);
}

/// printf-style formatted output; see the module doc for specifiers.
pub proc print(w: io.Writer, fmt: char*, ...) -> bool {
    if (fmt == null) {
        return false;
    }

    var ap: VaList;
    va_start(ap);

    var start: u64 = 0;
    var i:     u64 = 0;

    while (fmt[i] != '\0') {
        if (fmt[i] == '%') {
            if (i > start) {
                if (!w.write_all(cast(u8*, fmt + start)[0..(i - start)])) {
                    va_end(ap);
                    return false;
                }
            }

            i = i + 1;
            var spec: char = fmt[i];

            if (spec == '\0') {
                break;
            }

            switch (spec) {
                case '%': {
                    if (!w.write_byte(cast(u8, '%'))) {
                        va_end(ap);
                        return false;
                    }
                }

                case 's': {
                    var str_arg: char* = va_arg(ap, char*);

                    if (!w.write_str(str_arg)) {
                        va_end(ap);
                        return false;
                    }
                }

                case 'c': {
                    var char_arg: i32 = va_arg(ap, i32);

                    if (!w.write_byte(cast(u8, char_arg))) {
                        va_end(ap);
                        return false;
                    }
                }

                case 'd', 'i': {
                    var int_arg: i64 = va_arg(ap, i64);

                    if (!write_i64(w, int_arg)) {
                        va_end(ap);
                        return false;
                    }
                }

                case 'u': {
                    var uint_arg: u64 = va_arg(ap, u64);

                    if (!write_u64(w, uint_arg)) {
                        va_end(ap);
                        return false;
                    }
                }

                case 'x': {
                    var hex_arg: u64 = va_arg(ap, u64);

                    if (!write_hex(w, hex_arg, false)) {
                        va_end(ap);
                        return false;
                    }
                }

                case 'X': {
                    var hex_arg: u64 = va_arg(ap, u64);

                    if (!write_hex(w, hex_arg, true)) {
                        va_end(ap);
                        return false;
                    }
                }

                case 'p': {
                    var ptr_arg: void* = va_arg(ap, void*);

                    if (!write_ptr(w, ptr_arg)) {
                        va_end(ap);
                        return false;
                    }
                }

                case 'b': {
                    var bool_arg: bool = va_arg(ap, bool);

                    if (!write_bool(w, bool_arg)) {
                        va_end(ap);
                        return false;
                    }
                }

                default: {
                    if (!w.write_byte(cast(u8, '%')) || !w.write_byte(cast(u8, spec))) {
                        va_end(ap);
                        return false;
                    }
                }
            }

            i = i + 1;
            start = i;
            continue;
        }

        i = i + 1;
    }

    if (i > start) {
        if (!w.write_all(cast(u8*, fmt + start)[0..(i - start)])) {
            va_end(ap);
            return false;
        }
    }

    va_end(ap);

    return true;
}
