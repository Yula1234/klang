import "libc.kl";
import "arena.kl";
import "strview.kl";
import "ast.kl";
import "ir/ir.kl";
import "codegen/x86.kl";
import "codegen/abi.kl";
import "codegen/frame.kl";
import "codegen/operands.kl";
import "codegen/inst.kl";

proc codegen_set_section(out: void*, custom_section: StrView, default_section: char*, active_section: StrView*) -> void {
    var target: StrView = custom_section;

    if (target.len == 0) {
        target = strview_from_cstr(default_section);
    }

    if (active_section.len == target.len && active_section.equals(target)) {
        return;
    }

    if (target.equals_cstr(".text")) {
        fprintf(out, "\nsection '.text' executable align 16\n");
    } else if (target.equals_cstr(".data")) {
        fprintf(out, "\nsection '.data' writeable align 4096\n");
    } else if (target.equals_cstr(".bss")) {
        fprintf(out, "\nsection '.bss' writeable align 4096\n");
    } else if (target.equals_cstr(".rodata")) {
        fprintf(out, "\nsection '.rodata' align 4096\n");
    } else {
        fprintf(out, "\nsection '%.*s' align 4096\n", cast(i32, target.len), target.data);
    }

    *active_section = target;
}

proc mark_jump_targets(func: IRFunction*, is_target: bool*, max_id: u64) -> void {
    var b: IRBlock* = func.first_block;

    while (b != null) {
        var inst: IRInst* = b.first_inst;

        while (inst != null) {
            if (inst.opcode == IROpcode.IR_JMP && inst.dst.kind == IROperandKind.IR_OP_BLOCK && inst.dst.block != null) {
                var tid: u64 = cast(u64, inst.dst.block.id);

                if (tid < max_id) {
                    is_target[tid] = true;
                }
            } else if (inst.opcode == IROpcode.IR_BR) {
                if (inst.src1.kind == IROperandKind.IR_OP_BLOCK && inst.src1.block != null) {
                    var tid: u64 = cast(u64, inst.src1.block.id);

                    if (tid < max_id) {
                        is_target[tid] = true;
                    }
                }

                if (inst.src2.kind == IROperandKind.IR_OP_BLOCK && inst.src2.block != null) {
                    var tid: u64 = cast(u64, inst.src2.block.id);

                    if (tid < max_id) {
                        is_target[tid] = true;
                    }
                }
            } else if (inst.opcode == IROpcode.IR_SWITCH) {
                if (inst.src1.kind == IROperandKind.IR_OP_BLOCK && inst.src1.block != null) {
                    var tid: u64 = cast(u64, inst.src1.block.id);

                    if (tid < max_id) {
                        is_target[tid] = true;
                    }
                }

                var si: u64 = 0;

                while (si < inst.extra_arg_count) {
                    if (inst.extra_args[si].kind == IROperandKind.IR_OP_BLOCK &&
                        inst.extra_args[si].block != null) {
                        var tid: u64 = cast(u64, inst.extra_args[si].block.id);

                        if (tid < max_id) {
                            is_target[tid] = true;
                        }
                    }

                    si += 1;
                }
            }

            inst = inst.next;
        }

        b = b.next_block;
    }
}

proc emit_function(out: void*, a: Arena*, func: IRFunction*) -> void {
    if (func.attrs.custom_align > 0) {
        fprintf(out, "    align %llu\n", func.attrs.custom_align);
    }

    fprintf(out, "public %.*s\n", cast(i32, func.name.len), func.name.data);
    fprintf(out, "%.*s:\n", cast(i32, func.name.len), func.name.data);

    emit_callee_saved_push(out, func);

    var align_padding: u64 = get_stack_alignment_padding(func);

    if (align_padding > 0) {
        fprintf(out, "    sub rsp, %llu\n", align_padding);
    }

    var has_frame: bool = func_needs_frame_pointer(func) || func.is_variadic;

    if (frame_use_rsp(func)) {
        var rsp_total: u64 = rsp_frame_total(func);

        if (rsp_total > 0) {
            fprintf(out, "    sub rsp, %llu\n", rsp_total);
        }
    } else if (has_frame) {
        fprintf(out, "    push rbp\n");
        fprintf(out, "    mov rbp, rsp\n");

        var total_stack: u64 = get_total_function_stack_size(func);

        if (total_stack > 0) {
            fprintf(out, "    sub rsp, %llu\n", total_stack);
        }

        if (func.is_variadic && func.reg_save_slot != 0) {
            var slot_off: i32 = get_effective_stack_offset(func, func.reg_save_slot);

            for (var i: u64 = 0; i < KLANG_ABI_GP_ARG_COUNT; i += 1) {
                var mem_buf: [64]char;
                format_stack_offset(&mem_buf[0], 64, func, slot_off + cast(i32, i * KLANG_ABI_GP_SLOT_SIZE));
                fprintf(out, "    mov qword %s, %s\n", &mem_buf[0], abi_gp_arg_reg_name(i));
            }
        }
    }

    var max_block_id: u64   = cast(u64, func.next_block_id) + 1;
    var is_jump_target: bool* = alloc_array_zero[bool](a, max_block_id);

    mark_jump_targets(func, is_jump_target, max_block_id);

    var b: IRBlock* = func.first_block;
    var prev_exit: bool = false;

    while (b != null) {
        if (prev_exit && !is_jump_target[b.id] && b != func.first_block) {
            b = b.next_block;
            continue;
        }

        if (is_jump_target[b.id]) {
            fprintf(out, "\n.L_%.*s_%.*s:\n", cast(i32, func.name.len), func.name.data, cast(i32, b.name.len), b.name.data);
        }

        var inst: IRInst* = b.first_inst;

        while (inst != null) {
            var next_fused: IRInst* = null;

            if (try_emit_fused_mem_op(out, func, inst, &next_fused)) {
                inst = next_fused;
                inst = inst.next;
                continue;
            }

            if (inst.opcode >= IROpcode.IR_CMP_EQ && inst.opcode <= IROpcode.IR_CMP_GE) {
                if (try_emit_fused_cmp_branch(out, func, b, inst)) {
                    inst = inst.next;
                    inst = inst.next;
                    continue;
                }
            }

            emit_instruction(out, func, b, inst);

            if (ir_opcode_is_terminator(inst.opcode)) {
                break;
            }

            inst = inst.next;
        }

        prev_exit = false;

        var last: IRInst* = b.last_inst;

        if (last != null && ir_opcode_is_terminator(last.opcode)) {
            prev_exit = true;
        }

        b = b.next_block;
    }

    fprintf(out, "\n");
}

proc codegen_emit_fasm(module: IRModule*, a: Arena*, out: void*) -> void {
    if (module == null || out == null) {
        return;
    }

    fprintf(out, "format ELF64\n");

    var active_section: StrView = strview_from_raw(null, 0);

    if (module.str_count > 0) {
        codegen_set_section(out, strview_from_raw(null, 0), ".rodata", &active_section);

        var s: IRStringConst* = module.first_str;

        while (s != null) {
            fprintf(out, "    LC_STR_%u: db ", s.id);

            for (var i: u64 = 0; i < s.value.len; i += 1) {
                fprintf(out, "0x%02X, ", cast(u32, cast(u8, s.value.data[i])));
            }

            fprintf(out, "0x00\n");

            s = s.next;
        }
    }

    if (module.float_count > 0) {
        codegen_set_section(out, strview_from_raw(null, 0), ".rodata", &active_section);

        var f: IRFloatConst* = module.first_float;

        while (f != null) {
            if (f.byte_size == 4) {
                fprintf(out, "    align 4\n");
                fprintf(out, "    LC_FLT_%u: dd 0x%08llX\n", f.id, f.bits & 0xFFFFFFFF);
            } else {
                fprintf(out, "    align 8\n");
                fprintf(out, "    LC_FLT_%u: dq 0x%016llX\n", f.id, f.bits);
            }

            f = f.next;
        }

        fprintf(out, "    align 16\n");
        fprintf(out, "    LC_FLT_SIGN32: dd 0x80000000, 0x00000000, 0x00000000, 0x00000000\n");
        fprintf(out, "    align 16\n");
        fprintf(out, "    LC_FLT_SIGN64: dq 0x8000000000000000, 0x0000000000000000\n");
        fprintf(out, "    LC_FLT_ABS32:  dd 0x7FFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF\n");
        fprintf(out, "    LC_FLT_ABS64:  dq 0x7FFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF\n");
        fprintf(out, "    align 4\n");
        fprintf(out, "    LC_FLT_U64_CUT32: dd 0x5F000000\n");
        fprintf(out, "    align 8\n");
        fprintf(out, "    LC_FLT_U64_CUT64: dq 0x43E0000000000000\n");
    }

    if (module.needs_f16_helpers || module.needs_f8_helpers) {
        codegen_set_section(out, strview_from_raw(null, 0), ".text", &active_section);
        codegen_emit_storage_float_helpers(out, module);
    }

    var g: IRGlobalVar* = module.first_global;

    while (g != null) {
        if (g.attrs.is_extern) {
            g = g.next;
            continue;
        }

        var align_val: u64 = g.attrs.custom_align;

        if (align_val == 0) {
            if (g.var_type != null && g.var_type.align > 0) {
                align_val = g.var_type.align;
            } else {
                align_val = 8;
            }
        }

        if (g.has_init && g.init_item_count > 0) {
            codegen_set_section(out, g.attrs.section_name, ".data", &active_section);

            if (align_val > 0) {
                fprintf(out, "    align %llu\n", align_val);
            }

            fprintf(out, "    public %.*s\n", cast(i32, g.name.len), g.name.data);
            fprintf(out, "    %.*s:\n", cast(i32, g.name.len), g.name.data);

            for (var i: u64 = 0; i < g.init_item_count; i += 1) {
                var item: IRDataItem* = &g.init_items[i];

                switch (item.kind) {
                    case IRDataKind.IR_DATA_INT: {
                        var dir: char* = "dq";

                        if (item.size == 1)      dir = "db";
                        else if (item.size == 2) dir = "dw";
                        else if (item.size == 4) dir = "dd";

                        fprintf(out, "        %s %lld\n", dir, item.val);
                    }

                    case IRDataKind.IR_DATA_STR_REF: {
                        if (item.val == 0) {
                            fprintf(out, "        dq LC_STR_%u\n", item.str_id);
                        } else if (item.val > 0) {
                            fprintf(out, "        dq LC_STR_%u + %lld\n", item.str_id, item.val);
                        } else {
                            fprintf(out, "        dq LC_STR_%u - %lld\n", item.str_id, -item.val);
                        }
                    }

                    case IRDataKind.IR_DATA_SYM_REF: {
                        if (item.val == 0) {
                            fprintf(out, "        dq %.*s\n", cast(i32, item.sym_name.len), item.sym_name.data);
                        } else if (item.val > 0) {
                            fprintf(out, "        dq %.*s + %lld\n", cast(i32, item.sym_name.len), item.sym_name.data, item.val);
                        } else {
                            fprintf(out, "        dq %.*s - %lld\n", cast(i32, item.sym_name.len), item.sym_name.data, -item.val);
                        }
                    }

                    case IRDataKind.IR_DATA_ZERO: {
                        if (item.size > 0) {
                            fprintf(out, "        db %llu dup (0)\n", item.size);
                        }
                    }
                }
            }
        } else {
            codegen_set_section(out, g.attrs.section_name, ".bss", &active_section);

            if (align_val > 0) {
                fprintf(out, "    align %llu\n", align_val);
            }

            var size_val: u64 = 8;

            if (g.var_type != null && g.var_type.size > 0) {
                size_val = g.var_type.size;
            }

            fprintf(out, "    public %.*s\n", cast(i32, g.name.len), g.name.data);
            fprintf(out, "    %.*s: rb %llu\n", cast(i32, g.name.len), g.name.data, size_val);
        }

        g = g.next;
    }

    var has_externs: bool = false;
    var ext_g: IRGlobalVar* = module.first_global;

    while (ext_g != null) {
        if (ext_g.attrs.is_extern) {
            fprintf(out, "extrn %.*s\n", cast(i32, ext_g.name.len), ext_g.name.data);
            has_externs = true;
        }

        ext_g = ext_g.next;
    }

    var ext_f: IRFunction* = module.first_func;

    while (ext_f != null) {
        if (ext_f.attrs.is_extern) {
            fprintf(out, "extrn %.*s\n", cast(i32, ext_f.name.len), ext_f.name.data);
            has_externs = true;
        }

        ext_f = ext_f.next;
    }

    if (has_externs) {
        fprintf(out, "\n");
    }

    var f: IRFunction* = module.first_func;

    while (f != null) {
        if (!f.attrs.is_extern) {
            if (f.attrs.is_inlined && !f.attrs.is_exported) {
                f = f.next;
                continue;
            }

            codegen_set_section(out, f.attrs.section_name, ".text", &active_section);
            emit_function(out, a, f);
        }

        f = f.next;
    }
}

proc codegen_generate_file(module: IRModule*, a: Arena*, output_path: char*) -> bool {
    var out: void* = fopen(output_path, "w");

    if (out == null) {
        fprintf(stderr, "klang: error: could not open output file '%s' for writing\n", output_path);
        return false;
    }

    codegen_emit_fasm(module, a, out);

    fclose(out);

    return true;
}

proc codegen_emit_narrow_helper(out: void*, name: char*, mant_bits: u32, exp_bias: i32, exp_max: u32) -> void {
    var mant_mask:  u32 = (cast(u32, 1) << mant_bits) - 1;
    var drop:       u32 = 23 - mant_bits;
    var sign_shift: u32 = 16;

    if (mant_bits == 2) {
        sign_shift = 24;
    }

    fprintf(out, "%s:\n", name);
    fprintf(out, "    mov eax, edi\n");
    fprintf(out, "    shr eax, %u\n", sign_shift);
    fprintf(out, "    and eax, %u\n", cast(u32, 1) << (mant_bits + 5));
    fprintf(out, "    mov r8d, eax\n");
    fprintf(out, "    mov eax, edi\n");
    fprintf(out, "    shr eax, 23\n");
    fprintf(out, "    and eax, 0xFF\n");
    fprintf(out, "    mov ecx, edi\n");
    fprintf(out, "    and ecx, 0x7FFFFF\n");
    fprintf(out, "    cmp eax, 0xFF\n");
    fprintf(out, "    jne .%s_finite\n", name);
    fprintf(out, "    test ecx, ecx\n");
    fprintf(out, "    jz .%s_inf\n", name);
    fprintf(out, "    mov edx, ecx\n");
    fprintf(out, "    shr edx, %u\n", drop);
    fprintf(out, "    test edx, edx\n");
    fprintf(out, "    jnz .%s_nan_ok\n", name);
    fprintf(out, "    mov edx, 1\n");
    fprintf(out, ".%s_nan_ok:\n", name);
    fprintf(out, "    or edx, %u\n", exp_max << mant_bits);
    fprintf(out, "    or edx, r8d\n");
    fprintf(out, "    mov eax, edx\n");
    fprintf(out, "    ret\n");
    fprintf(out, ".%s_inf:\n", name);
    fprintf(out, "    mov eax, %u\n", exp_max << mant_bits);
    fprintf(out, "    or eax, r8d\n");
    fprintf(out, "    ret\n");
    fprintf(out, ".%s_finite:\n", name);
    fprintf(out, "    test eax, eax\n");
    fprintf(out, "    jnz .%s_normal\n", name);
    fprintf(out, "    mov eax, r8d\n");
    fprintf(out, "    ret\n");
    fprintf(out, ".%s_normal:\n", name);
    fprintf(out, "    sub eax, 127\n");
    fprintf(out, "    cmp eax, %d\n", exp_bias);
    fprintf(out, "    jle .%s_no_overflow\n", name);
    fprintf(out, "    mov eax, %u\n", exp_max << mant_bits);
    fprintf(out, "    or eax, r8d\n");
    fprintf(out, "    ret\n");
    fprintf(out, ".%s_no_overflow:\n", name);
    fprintf(out, "    cmp eax, %d\n", 1 - exp_bias);
    fprintf(out, "    jge .%s_in_range\n", name);
    fprintf(out, "    mov edx, ecx\n");
    fprintf(out, "    or edx, 0x800000\n");
    fprintf(out, "    mov r9d, %d\n", 1 - exp_bias);
    fprintf(out, "    sub r9d, eax\n");
    fprintf(out, "    add r9d, %u\n", drop);
    fprintf(out, "    cmp r9d, 31\n");
    fprintf(out, "    jle .%s_sub_shift\n", name);
    fprintf(out, "    mov eax, r8d\n");
    fprintf(out, "    ret\n");
    fprintf(out, ".%s_sub_shift:\n", name);
    fprintf(out, "    mov ecx, r9d\n");
    fprintf(out, "    mov r10d, 1\n");
    fprintf(out, "    shl r10d, cl\n");
    fprintf(out, "    mov r11d, r10d\n");
    fprintf(out, "    shr r11d, 1\n");
    fprintf(out, "    dec r10d\n");
    fprintf(out, "    mov eax, edx\n");
    fprintf(out, "    and eax, r10d\n");
    fprintf(out, "    shr edx, cl\n");
    fprintf(out, "    cmp eax, r11d\n");
    fprintf(out, "    ja .%s_sub_round\n", name);
    fprintf(out, "    jb .%s_sub_done\n", name);
    fprintf(out, "    test edx, 1\n");
    fprintf(out, "    jz .%s_sub_done\n", name);
    fprintf(out, ".%s_sub_round:\n", name);
    fprintf(out, "    inc edx\n");
    fprintf(out, ".%s_sub_done:\n", name);
    fprintf(out, "    or edx, r8d\n");
    fprintf(out, "    mov eax, edx\n");
    fprintf(out, "    ret\n");
    fprintf(out, ".%s_in_range:\n", name);
    fprintf(out, "    add eax, %d\n", exp_bias);
    fprintf(out, "    mov edx, ecx\n");
    fprintf(out, "    and edx, %u\n", (1 << drop) - 1);
    fprintf(out, "    shr ecx, %u\n", drop);
    fprintf(out, "    cmp edx, %u\n", 1 << (drop - 1));
    fprintf(out, "    ja .%s_round_up\n", name);
    fprintf(out, "    jb .%s_round_done\n", name);
    fprintf(out, "    test ecx, 1\n");
    fprintf(out, "    jz .%s_round_done\n", name);
    fprintf(out, ".%s_round_up:\n", name);
    fprintf(out, "    inc ecx\n");
    fprintf(out, "    cmp ecx, %u\n", mant_mask);
    fprintf(out, "    jbe .%s_round_done\n", name);
    fprintf(out, "    xor ecx, ecx\n");
    fprintf(out, "    inc eax\n");
    fprintf(out, "    cmp eax, %u\n", exp_max);
    fprintf(out, "    jb .%s_round_done\n", name);
    fprintf(out, "    mov eax, %u\n", exp_max << mant_bits);
    fprintf(out, "    or eax, r8d\n");
    fprintf(out, "    ret\n");
    fprintf(out, ".%s_round_done:\n", name);
    fprintf(out, "    shl eax, %u\n", mant_bits);
    fprintf(out, "    or eax, ecx\n");
    fprintf(out, "    or eax, r8d\n");
    fprintf(out, "    ret\n\n");
}

proc codegen_emit_widen_helper(out: void*, name: char*, mant_bits: u32, exp_bias: i32, exp_max: u32) -> void {
    var mant_mask:  u32 = (cast(u32, 1) << mant_bits) - 1;
    var drop:       u32 = 23 - mant_bits;
    var sign_shift: u32 = 16;

    if (mant_bits == 2) {
        sign_shift = 24;
    }

    fprintf(out, "%s:\n", name);
    fprintf(out, "    mov eax, edi\n");
    fprintf(out, "    and eax, %u\n", cast(u32, 1) << (mant_bits + 5));
    fprintf(out, "    shl eax, %u\n", sign_shift);
    fprintf(out, "    mov r8d, eax\n");
    fprintf(out, "    mov eax, edi\n");
    fprintf(out, "    shr eax, %u\n", mant_bits);
    fprintf(out, "    and eax, %u\n", exp_max);
    fprintf(out, "    mov ecx, edi\n");
    fprintf(out, "    and ecx, %u\n", mant_mask);
    fprintf(out, "    cmp eax, %u\n", exp_max);
    fprintf(out, "    jne .%s_finite\n", name);
    fprintf(out, "    test ecx, ecx\n");
    fprintf(out, "    jz .%s_inf\n", name);
    fprintf(out, "    shl ecx, %u\n", drop);
    fprintf(out, "    or ecx, 0x7F800000\n");
    fprintf(out, "    or ecx, r8d\n");
    fprintf(out, "    mov eax, ecx\n");
    fprintf(out, "    ret\n");
    fprintf(out, ".%s_inf:\n", name);
    fprintf(out, "    mov eax, 0x7F800000\n");
    fprintf(out, "    or eax, r8d\n");
    fprintf(out, "    ret\n");
    fprintf(out, ".%s_finite:\n", name);
    fprintf(out, "    test eax, eax\n");
    fprintf(out, "    jnz .%s_normal\n", name);
    fprintf(out, "    test ecx, ecx\n");
    fprintf(out, "    jnz .%s_denorm\n", name);
    fprintf(out, "    mov eax, r8d\n");
    fprintf(out, "    ret\n");
    fprintf(out, ".%s_denorm:\n", name);
    fprintf(out, "    mov edx, 0\n");
    fprintf(out, ".%s_denorm_loop:\n", name);
    fprintf(out, "    test ecx, %u\n", cast(u32, 1) << mant_bits);
    fprintf(out, "    jnz .%s_denorm_done\n", name);
    fprintf(out, "    shl ecx, 1\n");
    fprintf(out, "    inc edx\n");
    fprintf(out, "    jmp .%s_denorm_loop\n", name);
    fprintf(out, ".%s_denorm_done:\n", name);
    fprintf(out, "    and ecx, %u\n", mant_mask);
    fprintf(out, "    mov eax, %d\n", 127 - exp_bias + 1);
    fprintf(out, "    sub eax, edx\n");
    fprintf(out, "    shl eax, 23\n");
    fprintf(out, "    shl ecx, %u\n", drop);
    fprintf(out, "    or eax, ecx\n");
    fprintf(out, "    or eax, r8d\n");
    fprintf(out, "    ret\n");
    fprintf(out, ".%s_normal:\n", name);
    fprintf(out, "    sub eax, %d\n", exp_bias);
    fprintf(out, "    add eax, 127\n");
    fprintf(out, "    shl eax, 23\n");
    fprintf(out, "    shl ecx, %u\n", drop);
    fprintf(out, "    or eax, ecx\n");
    fprintf(out, "    or eax, r8d\n");
    fprintf(out, "    ret\n\n");
}

proc codegen_emit_storage_float_helpers(out: void*, module: IRModule*) -> void {
    if (module.needs_f16_helpers) {
        codegen_emit_narrow_helper(out, "__klang_f32_to_f16", 10, 15, 0x1F);
        codegen_emit_widen_helper(out, "__klang_f16_to_f32", 10, 15, 0x1F);
    }

    if (module.needs_f8_helpers) {
        codegen_emit_narrow_helper(out, "__klang_f32_to_f8", 2, 15, 0x1F);
        codegen_emit_widen_helper(out, "__klang_f8_to_f32", 2, 15, 0x1F);
    }
}