import "libc.kl";
import "strview.kl";
import "ast.kl";
import "ir/ir.kl";
import "codegen/x86.kl";
import "codegen/abi.kl";
import "codegen/frame.kl";

struct ArgMove {
    dst_reg: X86Reg,
    src_op:  IROperand,
    done:    bool
}

proc x86_reg_name_from_str(reg64: char*, bytes: u64) -> char* {
    if (bytes == 0 || bytes >= 8) {
        return reg64;
    }

    if (strcmp(reg64, "rax") == 0) { if (bytes == 1) return "al";   if (bytes == 2) return "ax";   return "eax"; }
    if (strcmp(reg64, "rcx") == 0) { if (bytes == 1) return "cl";   if (bytes == 2) return "cx";   return "ecx"; }
    if (strcmp(reg64, "rdx") == 0) { if (bytes == 1) return "dl";   if (bytes == 2) return "dx";   return "edx"; }
    if (strcmp(reg64, "rbx") == 0) { if (bytes == 1) return "bl";   if (bytes == 2) return "bx";   return "ebx"; }
    if (strcmp(reg64, "rsi") == 0) { if (bytes == 1) return "sil";  if (bytes == 2) return "si";   return "esi"; }
    if (strcmp(reg64, "rdi") == 0) { if (bytes == 1) return "dil";  if (bytes == 2) return "di";   return "edi"; }
    if (strcmp(reg64, "rsp") == 0) { if (bytes == 1) return "spl";  if (bytes == 2) return "sp";   return "esp"; }
    if (strcmp(reg64, "rbp") == 0) { if (bytes == 1) return "bpl";  if (bytes == 2) return "bp";   return "ebp"; }
    if (strcmp(reg64, "r8")  == 0) { if (bytes == 1) return "r8b";  if (bytes == 2) return "r8w";  return "r8d"; }
    if (strcmp(reg64, "r9")  == 0) { if (bytes == 1) return "r9b";  if (bytes == 2) return "r9w";  return "r9d"; }
    if (strcmp(reg64, "r10") == 0) { if (bytes == 1) return "r10b"; if (bytes == 2) return "r10w"; return "r10d"; }
    if (strcmp(reg64, "r11") == 0) { if (bytes == 1) return "r11b"; if (bytes == 2) return "r11w"; return "r11d"; }
    if (strcmp(reg64, "r12") == 0) { if (bytes == 1) return "r12b"; if (bytes == 2) return "r12w"; return "r12d"; }
    if (strcmp(reg64, "r13") == 0) { if (bytes == 1) return "r13b"; if (bytes == 2) return "r13w"; return "r13d"; }
    if (strcmp(reg64, "r14") == 0) { if (bytes == 1) return "r14b"; if (bytes == 2) return "r14w"; return "r14d"; }
    if (strcmp(reg64, "r15") == 0) { if (bytes == 1) return "r15b"; if (bytes == 2) return "r15w"; return "r15d"; }

    return reg64;
}

@inline proc x86_reg_name_is_xmm(reg: char*) -> bool {
    return reg != null && reg[0] == 'x' && reg[1] == 'm' && reg[2] == 'm';
}

proc emit_load_float_operand(out: void*, func: IRFunction*, op: IROperand*, target_reg: char*, extra_shift: i32) -> bool {
    if (!ir_operand_is_float(func, *op) && !x86_reg_name_is_xmm(target_reg)) {
        return false;
    }

    var size: u64 = op.byte_size;

    if (size != 4) {
        size = 8;
    }

    var mov: char* = x86_float_mov(size);

    switch (op.kind) {
        case IROperandKind.IR_OP_CONST: {
            if (op.int_val == 0) {
                fprintf(out, "    %s %s, %s\n", x86_float_xor(size), target_reg, target_reg);
                return true;
            }

            if (op.has_pool_slot) {
                fprintf(out, "    %s %s, %s [LC_FLT_%u]\n", mov, target_reg, x86_size_prefix(size), op.str_id);
                return true;
            }

            fprintf(out, "    mov rax, %lld\n", op.int_val);

            if (size == 4) {
                fprintf(out, "    movd %s, eax\n", target_reg);
            } else {
                fprintf(out, "    movq %s, rax\n", target_reg);
            }

            return true;
        }

        case IROperandKind.IR_OP_REG: {
            var src: char* = reg_name(op.reg, size);

            if (strcmp(src, target_reg) != 0) {
                fprintf(out, "    %s %s, %s\n", mov, target_reg, src);
            }

            return true;
        }

        case IROperandKind.IR_OP_VREG: {
            var off: i32 = get_vreg_stack_offset(func, op.vreg_id) + extra_shift;

            var mem: [64]char;
            format_stack_offset(&mem[0], 64, func, off);

            fprintf(out, "    %s %s, %s %s\n", mov, target_reg, x86_size_prefix(size), &mem[0]);
            return true;
        }

        case IROperandKind.IR_OP_STACK: {
            var off: i32 = get_effective_stack_offset(func, op.stack_offset) + extra_shift;

            var mem: [64]char;
            format_stack_offset(&mem[0], 64, func, off);

            fprintf(out, "    %s %s, %s %s\n", mov, target_reg, x86_size_prefix(size), &mem[0]);
            return true;
        }

        case IROperandKind.IR_OP_GLOBAL: {
            fprintf(out, "    %s %s, %s [%.*s]\n", mov, target_reg, x86_size_prefix(size),
                    cast(i32, op.global_name.len), op.global_name.data);
            return true;
        }

        default: {
            return false;
        }
    }
}

proc emit_load_operand_shifted(out: void*, func: IRFunction*, op: IROperand*, target_reg: char*, extra_shift: i32) -> void {
    if (op == null) {
        return;
    }

    if (emit_load_float_operand(out, func, op, target_reg, extra_shift)) {
        return;
    }

    switch (op.kind) {
        case IROperandKind.IR_OP_CONST: {
            if (op.int_val == 0) {
                var r32: char* = x86_reg_name_from_str(target_reg, 4);
                fprintf(out, "    xor %s, %s\n", r32, r32);
            } else {
                fprintf(out, "    mov %s, %lld\n", target_reg, op.int_val);
            }
        }

        case IROperandKind.IR_OP_REG: {
            var size: u64 = op.byte_size;

            if (size == 0) {
                size = 8;
            }

            if (x86_reg_is_xmm(op.reg)) {
                var move_width: u64 = size;

                if (move_width != 4) {
                    move_width = 8;
                }

                if (move_width == 4) {
                    fprintf(out, "    movd %s, %s\n", x86_reg_name_from_str(target_reg, 4), reg_name(op.reg, 4));
                } else {
                    fprintf(out, "    movq %s, %s\n", target_reg, reg_name(op.reg, 8));
                }

                return;
            }

            var src_r: char* = reg_name(op.reg, size);
            var dst_r: char* = x86_reg_name_from_str(target_reg, size);

            if (strcmp(src_r, dst_r) != 0) {
                if (size == 1 || size == 2) {
                    var inst: char* = "movzx";

                    if (op.is_signed) {
                        inst = "movsx";
                    }

                    fprintf(out, "    %s %s, %s\n", inst, x86_reg_name_from_str(target_reg, 4), src_r);
                } else if (size == 4) {
                    if (op.is_signed) {
                        fprintf(out, "    movsxd %s, %s\n", target_reg, src_r);
                    } else {
                        fprintf(out, "    mov %s, %s\n", dst_r, src_r);
                    }
                } else {
                    fprintf(out, "    mov %s, %s\n", target_reg, src_r);
                }
            }
        }

        case IROperandKind.IR_OP_VREG: {
            var off: i32 = get_vreg_stack_offset(func, op.vreg_id) + extra_shift;
            var size: u64 = op.byte_size;

            if (size == 0) {
                size = 8;
            }

            var mem_op: [64]char;
            format_stack_offset(&mem_op[0], 64, func, off);

            if (size == 1) {
                var inst: char* = "movzx";

                if (op.is_signed) {
                    inst = "movsx";
                }

                fprintf(
                    out,
                    "    %s %s, byte %s\n",
                    inst,
                    x86_reg_name_from_str(target_reg, 4),
                    &mem_op[0]
                );
            } else if (size == 2) {
                var inst: char* = "movzx";

                if (op.is_signed) {
                    inst = "movsx";
                }

                fprintf(
                    out,
                    "    %s %s, word %s\n",
                    inst,
                    x86_reg_name_from_str(target_reg, 4),
                    &mem_op[0]
                );
            } else if (size == 4) {
                if (op.is_signed) {
                    fprintf(
                        out,
                        "    movsxd %s, dword %s\n",
                        target_reg,
                        &mem_op[0]
                    );
                } else {
                    fprintf(
                        out,
                        "    mov %s, dword %s\n",
                        x86_reg_name_from_str(target_reg, 4),
                        &mem_op[0]
                    );
                }
            } else {
                fprintf(
                    out,
                    "    mov %s, qword %s\n",
                    target_reg,
                    &mem_op[0]
                );
            }
        }

        case IROperandKind.IR_OP_STACK: {
            var off: i32 = get_effective_stack_offset(func, op.stack_offset) + extra_shift;

            var mem_op: [64]char;
            format_stack_offset(&mem_op[0], 64, func, off);

            var size: u64 = op.byte_size;

            if (size == 0) {
                size = 8;
            }

            if (size == 1) {
                var inst: char* = "movzx";

                if (op.is_signed) {
                    inst = "movsx";
                }

                fprintf(out, "    %s %s, byte %s\n", inst, x86_reg_name_from_str(target_reg, 4), &mem_op[0]);
            } else if (size == 2) {
                var inst: char* = "movzx";

                if (op.is_signed) {
                    inst = "movsx";
                }

                fprintf(out, "    %s %s, word %s\n", inst, x86_reg_name_from_str(target_reg, 4), &mem_op[0]);
            } else if (size == 4) {
                if (op.is_signed) {
                    fprintf(out, "    movsxd %s, dword %s\n", target_reg, &mem_op[0]);
                } else {
                    var reg32: char* = x86_reg_name_from_str(target_reg, 4);
                    fprintf(out, "    mov %s, dword %s\n", reg32, &mem_op[0]);
                }
            } else {
                fprintf(out, "    mov %s, qword %s\n", target_reg, &mem_op[0]);
            }
        }

        case IROperandKind.IR_OP_GLOBAL: {
            var gname: StrView = op.global_name;
            var size:  u64     = op.byte_size;

            if (size == 0) {
                size = 8;
            }

            if (size == 1) {
                var inst: char* = "movzx";

                if (op.is_signed) {
                    inst = "movsx";
                }

                fprintf(out, "    %s %s, byte [%.*s]\n", inst, x86_reg_name_from_str(target_reg, 4), cast(i32, gname.len), gname.data);
            } else if (size == 2) {
                var inst: char* = "movzx";

                if (op.is_signed) {
                    inst = "movsx";
                }

                fprintf(out, "    %s %s, word [%.*s]\n", inst, x86_reg_name_from_str(target_reg, 4), cast(i32, gname.len), gname.data);
            } else if (size == 4) {
                if (op.is_signed) {
                    fprintf(out, "    movsxd %s, dword [%.*s]\n", target_reg, cast(i32, gname.len), gname.data);
                } else {
                    var reg32: char* = x86_reg_name_from_str(target_reg, 4);
                    fprintf(out, "    mov %s, dword [%.*s]\n", reg32, cast(i32, gname.len), gname.data);
                }
            } else {
                fprintf(out, "    mov %s, qword [%.*s]\n", target_reg, cast(i32, gname.len), gname.data);
            }
        }

        case IROperandKind.IR_OP_STR: {
            fprintf(out, "    lea %s, [LC_STR_%u]\n", target_reg, op.str_id);
        }

        default: {}
    }
}

var g_float_mem_spec: [96]char;

proc float_scratch_memory_spec(spec: char*) -> char* {
    var i: u64 = 0;

    while (i < 95 && spec[i] != '\0') {
        g_float_mem_spec[i] = spec[i];
        i += 1;
    }

    g_float_mem_spec[i] = '\0';

    return &g_float_mem_spec[0];
}

proc float_memory_operand(func: IRFunction*, op: IROperand*, out_spec: char*, cap: u64, width: u64) -> bool {
    if (op == null) {
        return false;
    }

    switch (op.kind) {
        case IROperandKind.IR_OP_CONST: {
            if (!op.has_pool_slot || op.int_val == 0) {
                return false;
            }

            snprintf(out_spec, cap, "%s [LC_FLT_%u]", x86_size_prefix(width), op.str_id);
            return true;
        }

        case IROperandKind.IR_OP_STACK: {
            var mem: [64]char;
            format_stack_offset(&mem[0], 64, func, get_effective_stack_offset(func, op.stack_offset));

            snprintf(out_spec, cap, "%s %s", x86_size_prefix(width), &mem[0]);
            return true;
        }

        case IROperandKind.IR_OP_GLOBAL: {
            snprintf(out_spec, cap, "%s [%.*s]", x86_size_prefix(width),
                     cast(i32, op.global_name.len), op.global_name.data);
            return true;
        }

        default: {
            return false;
        }
    }
}

@inline proc store_widens_from_al(dst: IROperand*) -> bool {
    if (dst == null || dst.kind != IROperandKind.IR_OP_REG) {
        return false;
    }

    if (x86_reg_is_xmm(dst.reg)) {
        return false;
    }

    var size: u64 = dst.byte_size;

    return size == 1 || size == 2;
}

proc emit_store_from_xmm(out: void*, func: IRFunction*, dst: IROperand*, src_reg: char*) -> void {
    if (dst == null) {
        return;
    }

    if (dst.kind == IROperandKind.IR_OP_REG && !x86_reg_is_xmm(dst.reg)) {
        var gp_width: u64 = dst.byte_size;

        if (gp_width != 4) {
            gp_width = 8;
        }

        if (gp_width == 4) {
            fprintf(out, "    movd %s, %s\n", reg_name(dst.reg, 4), src_reg);
        } else {
            fprintf(out, "    movq %s, %s\n", reg_name(dst.reg, 8), src_reg);
        }

        return;
    }

    var size: u64 = dst.byte_size;

    if (size != 4) {
        size = 8;
    }

    var mov: char* = x86_float_mov(size);

    switch (dst.kind) {
        case IROperandKind.IR_OP_REG: {
            var dst_r: char* = reg_name(dst.reg, size);

            if (strcmp(dst_r, src_reg) != 0) {
                fprintf(out, "    %s %s, %s\n", mov, dst_r, src_reg);
            }
        }

        case IROperandKind.IR_OP_VREG: {
            var off: i32 = get_vreg_stack_offset(func, dst.vreg_id);

            var mem: [64]char;
            format_stack_offset(&mem[0], 64, func, off);

            fprintf(out, "    %s %s %s, %s\n", mov, x86_size_prefix(size), &mem[0], src_reg);
        }

        case IROperandKind.IR_OP_STACK: {
            var off: i32 = get_effective_stack_offset(func, dst.stack_offset);

            var mem: [64]char;
            format_stack_offset(&mem[0], 64, func, off);

            fprintf(out, "    %s %s %s, %s\n", mov, x86_size_prefix(size), &mem[0], src_reg);
        }

        case IROperandKind.IR_OP_GLOBAL: {
            fprintf(out, "    %s %s [%.*s], %s\n", mov, x86_size_prefix(size),
                    cast(i32, dst.global_name.len), dst.global_name.data, src_reg);
        }

        default: {}
    }
}

proc emit_store_from_rax(out: void*, func: IRFunction*, dst: IROperand*) -> void {
    if (dst == null) {
        return;
    }

    if (dst.kind == IROperandKind.IR_OP_REG && x86_reg_is_xmm(dst.reg)) {
        var width: u64 = dst.byte_size;

        if (width != 4) {
            width = 8;
        }

        if (width == 4) {
            fprintf(out, "    movd %s, eax\n", reg_name(dst.reg, 4));
        } else {
            fprintf(out, "    movq %s, rax\n", reg_name(dst.reg, 8));
        }

        return;
    }

    if (dst.kind == IROperandKind.IR_OP_REG) {
        var size: u64 = dst.byte_size;

        if (size == 0) {
            size = 8;
        }

        if (size == 1 || size == 2) {
            var dst_r32: char* = reg_name(dst.reg, 4);
            var ext:     char* = "movzx";

            if (dst.is_signed) {
                ext = "movsx";
            }

            if (size == 1) {
                fprintf(out, "    %s %s, al\n", ext, dst_r32);
            } else {
                fprintf(out, "    %s %s, ax\n", ext, dst_r32);
            }
        } else if (size == 4) {
            var dst_r32: char* = reg_name(dst.reg, 4);

            if (strcmp(dst_r32, "eax") != 0) {
                fprintf(out, "    mov %s, eax\n", dst_r32);
            }
        } else {
            var dst_r64: char* = reg_name(dst.reg, 8);

            if (strcmp(dst_r64, "rax") != 0) {
                fprintf(out, "    mov %s, rax\n", dst_r64);
            }
        }
    } else if (dst.kind == IROperandKind.IR_OP_VREG) {
        var off: i32 = get_vreg_stack_offset(func, dst.vreg_id);
        var sv_mem: [64]char;
        format_stack_offset(&sv_mem[0], 64, func, off);
        fprintf(out, "    mov %s, rax\n", &sv_mem[0]);
    } else if (dst.kind == IROperandKind.IR_OP_STACK) {
        var off: i32 = get_effective_stack_offset(func, dst.stack_offset);

        var mem_op: [64]char;
        format_stack_offset(&mem_op[0], 64, func, off);

        var size:   u64   = dst.byte_size;

        if (size == 0) {
            size = 8;
        }

        var prefix: char* = x86_size_prefix(size);
        var reg:    char* = x86_reg_name_from_str("rax", size);

        fprintf(out, "    mov %s %s, %s\n", prefix, &mem_op[0], reg);
    } else if (dst.kind == IROperandKind.IR_OP_GLOBAL) {
        var size:   u64   = dst.byte_size;

        if (size == 0) {
            size = 8;
        }

        var prefix: char* = x86_size_prefix(size);
        var reg:    char* = x86_reg_name_from_str("rax", size);

        fprintf(out, "    mov %s [%.*s], %s\n", prefix, cast(i32, dst.global_name.len), dst.global_name.data, reg);
    }
}

proc emit_load_address(out: void*, func: IRFunction*, op: IROperand*, target_reg: char*) -> void {
    if (op == null) {
        return;
    }

    switch (op.kind) {
        case IROperandKind.IR_OP_REG: {
            var src_r: char* = reg_name(op.reg, 8);
            var dst_r: char* = x86_reg_name_from_str(target_reg, 8);

            if (strcmp(src_r, dst_r) != 0) {
                fprintf(out, "    mov %s, %s\n", dst_r, src_r);
            }
        }

        case IROperandKind.IR_OP_VREG: {
            var off: i32 = get_vreg_stack_offset(func, op.vreg_id);
            var ld_mem: [64]char;
            format_stack_offset(&ld_mem[0], 64, func, off);
            fprintf(out, "    mov %s, %s\n", target_reg, &ld_mem[0]);
        }

        case IROperandKind.IR_OP_STACK: {
            var off: i32 = get_effective_stack_offset(func, op.stack_offset);

            var mem_op: [64]char;
            format_stack_offset(&mem_op[0], 64, func, off);

            fprintf(out, "    lea %s, %s\n", target_reg, &mem_op[0]);
        }

        case IROperandKind.IR_OP_GLOBAL: {
            var gname: StrView = op.global_name;
            fprintf(out, "    lea %s, [%.*s]\n", target_reg, cast(i32, gname.len), gname.data);
        }

        case IROperandKind.IR_OP_CONST: {
            if (op.int_val == 0) {
                var r32: char* = x86_reg_name_from_str(target_reg, 4);
                fprintf(out, "    xor %s, %s\n", r32, r32);
            } else {
                fprintf(out, "    mov %s, %lld\n", target_reg, op.int_val);
            }
        }

        default: {}
    }
}

proc emit_parallel_register_moves(out: void*, func: IRFunction*, moves: []ArgMove) -> void {
    var count:   u64 = moves.len;
    var pending: u64 = 0;

    for (var i: u64 = 0; i < count; i += 1) {
        if (moves[i].src_op.kind == IROperandKind.IR_OP_REG && moves[i].src_op.reg == moves[i].dst_reg) {
            moves[i].done = true;
        } else {
            moves[i].done = false;
            pending += 1;
        }
    }

    while (pending > 0) {
        var progress: bool = false;

        for (var i: u64 = 0; i < count; i += 1) {
            if (moves[i].done) {
                continue;
            }

            var dst_used_as_src: bool = false;

            for (var j: u64 = 0; j < count; j += 1) {
                if (!moves[j].done && i != j &&
                    moves[j].src_op.kind == IROperandKind.IR_OP_REG &&
                    moves[j].src_op.reg == moves[i].dst_reg) {

                    dst_used_as_src = true;
                    break;
                }
            }

            if (!dst_used_as_src) {
                var target_r: char* = reg_name(moves[i].dst_reg, 8);
                emit_load_operand(out, func, &moves[i].src_op, target_r);

                moves[i].done = true;
                pending -= 1;
                progress = true;
                break;
            }
        }

        if (!progress && pending > 0) {
            var cycle_idx: u64 = count;

            for (var i: u64 = 0; i < count; i += 1) {
                if (!moves[i].done) {
                    cycle_idx = i;
                    break;
                }
            }

            if (cycle_idx < count) {
                var chain: [16]X86Reg;
                var chain_len: u64 = 1;

                chain[0] = moves[cycle_idx].dst_reg;

                var guard: u64  = 0;
                var closed:  bool = false;

                while (guard <= count) {
                    var cur_dst: X86Reg = chain[chain_len - 1];
                    var advanced: bool  = false;

                    for (var j: u64 = 0; j < count; j += 1) {
                        if (!moves[j].done &&
                            moves[j].src_op.kind == IROperandKind.IR_OP_REG &&
                            moves[j].src_op.reg == cur_dst) {

                            if (moves[j].dst_reg == chain[0]) {
                                closed = true;
                            } else if (chain_len < 16) {
                                chain[chain_len] = moves[j].dst_reg;
                                chain_len       += 1;
                                advanced         = true;
                            }

                            break;
                        }
                    }

                    if (closed || !advanced) {
                        break;
                    }

                    guard += 1;
                }

                var cycle_ok: bool = closed && chain_len >= 2 && chain_len <= 16;

                if (!cycle_ok) {
                    fprintf(stderr, "klang: internal compiler error: parallel move cycle resolution failed (len=%llu closed=%d)\n", chain_len, closed);
                    abort();
                }

                for (var x: u64 = 1; x < chain_len; x += 1) {
                    if (chain[x] != chain[0]) {
                        fprintf(out, "    xchg %s, %s\n", reg_name(chain[0], 8), reg_name(chain[x], 8));
                    }
                }

                for (var j: u64 = 0; j < count; j += 1) {
                    if (!moves[j].done) {
                        var in_cycle: bool = false;

                        for (var x: u64 = 0; x < chain_len; x += 1) {
                            if (moves[j].dst_reg == chain[x]) {
                                in_cycle = true;
                                break;
                            }
                        }

                        if (in_cycle) {
                            moves[j].done = true;
                            pending      -= 1;
                        }
                    }
                }
            }
        }
    }
}

proc arg_is_sse_class(func: IRFunction*, arg: IROperand*) -> bool {
    return ir_operand_is_float(func, *arg);
}

proc call_stack_arg_count(func: IRFunction*, inst: IRInst*) -> u64 {
    var gp_used:    u64 = 0;
    var sse_used:   u64 = 0;
    var stack_args: u64 = 0;

    for (var k: u64 = 0; k < inst.extra_arg_count; k += 1) {
        if (arg_is_sse_class(func, &inst.extra_args[k])) {
            if (sse_used < KLANG_ABI_SSE_ARG_COUNT) {
                sse_used += 1;
            } else {
                stack_args += 1;
            }
        } else {
            if (gp_used < KLANG_ABI_GP_ARG_COUNT) {
                gp_used += 1;
            } else {
                stack_args += 1;
            }
        }
    }

    return stack_args;
}

proc call_stack_cleanup_bytes(func: IRFunction*, inst: IRInst*) -> u64 {
    var stack_args: u64 = call_stack_arg_count(func, inst);
    var pad_count:  u64 = 0;

    if ((stack_args % 2) != 0) {
        pad_count = 1;
    }

    return (stack_args + pad_count) * KLANG_ABI_GP_SLOT_SIZE;
}

proc emit_call_arguments(out: void*, func: IRFunction*, inst: IRInst*) -> void {
    var argc: u64 = inst.extra_arg_count;

    var reg_slot:   [64]u64;
    var is_sse:     [64]bool;
    var goes_stack: [64]bool;

    var gp_used:    u64 = 0;
    var sse_used:   u64 = 0;
    var stack_args: u64 = 0;

    for (var k: u64 = 0; k < argc; k += 1) {
        var sse: bool = arg_is_sse_class(func, &inst.extra_args[k]);

        is_sse[k] = sse;

        if (sse) {
            if (sse_used < KLANG_ABI_SSE_ARG_COUNT) {
                reg_slot[k]   = sse_used;
                goes_stack[k] = false;
                sse_used += 1;
            } else {
                goes_stack[k] = true;
                stack_args += 1;
            }
        } else {
            if (gp_used < KLANG_ABI_GP_ARG_COUNT) {
                reg_slot[k]   = gp_used;
                goes_stack[k] = false;
                gp_used += 1;
            } else {
                goes_stack[k] = true;
                stack_args += 1;
            }
        }
    }

    var needs_pad: bool = (stack_args % 2) != 0;

    if (needs_pad) {
        fprintf(out, "    sub rsp, %llu\n", KLANG_ABI_GP_SLOT_SIZE);
    }

    var pushed: u64 = 0;
    var i:      u64 = argc;

    while (i > 0) {
        var idx: u64 = i - 1;

        if (!goes_stack[idx]) {
            i -= 1;
            continue;
        }

        var arg:        IROperand* = &inst.extra_args[idx];
        var push_shift: i32        = cast(i32, pushed * 8);

        if (is_sse[idx]) {
            emit_load_operand_shifted(out, func, arg, "xmm8", push_shift);
            fprintf(out, "    sub rsp, %llu\n", KLANG_ABI_GP_SLOT_SIZE);
            fprintf(out, "    movsd qword [rsp], xmm8\n");
        } else if (arg.kind == IROperandKind.IR_OP_REG && arg.reg != X86Reg.REG_NONE) {
            fprintf(out, "    push %s\n", reg_name(arg.reg, 8));
        } else if (arg.kind == IROperandKind.IR_OP_STACK) {
            var poff: i32 = get_effective_stack_offset(func, arg.stack_offset) + push_shift;

            var pmem: [64]char;
            format_stack_offset(&pmem[0], 64, func, poff);

            fprintf(out, "    push qword %s\n", &pmem[0]);
        } else if (arg.kind == IROperandKind.IR_OP_GLOBAL) {
            fprintf(out, "    push qword [%.*s]\n", cast(i32, arg.global_name.len), arg.global_name.data);
        } else if (arg.kind == IROperandKind.IR_OP_VREG) {
            var voff: i32 = get_vreg_stack_offset(func, arg.vreg_id) + push_shift;

            var vmem: [64]char;
            format_stack_offset(&vmem[0], 64, func, voff);

            fprintf(out, "    push qword %s\n", &vmem[0]);
        } else if (arg.kind == IROperandKind.IR_OP_CONST && is_signed_imm32(arg.int_val)) {
            fprintf(out, "    push %lld\n", arg.int_val);
        } else {
            emit_load_operand_shifted(out, func, arg, "rax", push_shift);
            fprintf(out, "    push rax\n");
        }

        pushed += 1;
        i -= 1;
    }

    var moves:      [14]ArgMove;
    var move_count: u64 = 0;

    for (var k: u64 = 0; k < argc; k += 1) {
        if (goes_stack[k]) {
            continue;
        }

        if (is_sse[k]) {
            moves[move_count].dst_reg = abi_sse_arg_reg(reg_slot[k]);
        } else {
            moves[move_count].dst_reg = abi_gp_arg_reg(reg_slot[k]);
        }

        moves[move_count].src_op = inst.extra_args[k];
        moves[move_count].done   = false;

        move_count += 1;
    }

    emit_parallel_register_moves(out, func, moves[0..move_count]);

    if (inst.is_variadic) {
        if (sse_used == 0) {
            fprintf(out, "    xor eax, eax\n");
        } else {
            fprintf(out, "    mov eax, %llu\n", sse_used);
        }
    }
}

proc emit_load_operand(out: void*, func: IRFunction*, op: IROperand*, target_reg: char*) -> void {
    emit_load_operand_shifted(out, func, op, target_reg, 0);
}