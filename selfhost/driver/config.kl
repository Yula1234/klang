import "libc.kl";
import "arena.kl";
import "strview.kl";
import "vec.kl";

enum OutputPhase: u32 {
    PHASE_EXE = 0,
    PHASE_OBJ,
    PHASE_ASM,
    PHASE_SHARED
}

enum OptPass: u32 {
    OPT_PASS_SROA        = 1,
    OPT_PASS_MEM2REG     = 2,
    OPT_PASS_SCCP        = 4,
    OPT_PASS_GVN         = 8,
    OPT_PASS_LICM        = 16,
    OPT_PASS_CFG_OPT     = 32,
    OPT_PASS_IR_OPT      = 64,
    OPT_PASS_STACK_COLOR = 128,
    OPT_PASS_PEEPHOLE    = 256
}

struct DriverConfig {
    input_path:         char*,
    output_path:        char*,
    include_dir:        char*,

    phase:              OutputPhase,
    dump_ir:            bool,
    save_temps:         bool,
    verbose:            bool,
    no_pie:             bool,
    static_link:        bool,

    disable_passes:     u32,

    fasm_memory_mb:     u64,

    libs:               Vec[char*],
    lib_dirs:           Vec[char*],
    linker_extra_args:  Vec[char*],
    asm_extra_args:     Vec[char*],

    proc init(self, a: Arena*) -> void {
        self.input_path         = null;
        self.output_path        = null;
        self.include_dir        = null;
        self.phase              = OutputPhase.PHASE_EXE;
        self.dump_ir            = false;
        self.save_temps         = false;
        self.verbose            = false;
        self.no_pie             = true;
        self.static_link        = false;
        self.disable_passes     = 0;
        self.fasm_memory_mb     = 512;

        self.libs.init(a);
        self.lib_dirs.init(a);
        self.linker_extra_args.init(a);
        self.asm_extra_args.init(a);
    }
}

proc print_driver_help(prog_name: char*) -> void {
    printf("Usage: %s <input.kl> [options]\n\n", prog_name);
    printf("Compilation Stage Control:\n");
    printf("  -c                   Compile and assemble, but do not link (emit .o)\n");
    printf("  -S                   Compile only, do not assemble or link (emit .asm)\n");
    printf("  -shared              Create a shared library\n");
    printf("  -static              Produce a statically linked executable\n");
    printf("  --dump-ir            Print Intermediate Representation (3AC) to stdout\n\n");
    printf("Options:\n");
    printf("  -o <file>            Specify output file name\n");
    printf("  -I <dir>             Add directory to module search path\n");
    printf("  -l<lib>              Pass library to linker\n");
    printf("  -L<dir>              Add library search directory\n");
    printf("  -Wl,<arg>            Pass comma-separated argument(s) to linker\n");
    printf("  -Wa,<arg>            Pass comma-separated argument(s) to assembler\n");
    printf("  -no-pie              Do not produce position-independent executable (default)\n");
    printf("  -pie                 Produce position-independent executable\n");
    printf("  -save-temps          Do not delete intermediate .asm and .o files\n");
    printf("  -f<pass>             Enable optimization pass\n");
    printf("  -fno-<pass>          Disable optimization pass\n");
    printf("                       Passes: sroa, mem2reg, sccp, gvn, licm,\n");
    printf("                       cfg_opt, ir_opt, stack_color, peephole\n");
    printf("  -v, --verbose        Print commands executed by driver\n");
    printf("  --fasm-mem <MB>      Set memory limit for FASM in MB (default: 512)\n");
    printf("  --version            Display compiler version information\n");
    printf("  -h, --help           Display this help message\n\n");
}

proc split_comma_separated(a: Arena*, list: Vec[char*]*, str: char*) -> void {
    var start: char* = str;

    while (start[0] != '\0') {
        var comma: char* = strchr(start, 44);
        var len: u64 = 0;

        if (comma != null) {
            len = cast(u64, cast(u64, comma) - cast(u64, start));
        } else {
            len = strlen(start);
        }

        if (len > 0) {
            var item: char* = a.strndup(start, len);
            list.push(item);
        }

        if (comma == null) {
            break;
        }

        start = cast(char*, cast(u64, comma) + 1);
    }
}

proc apply_pass_flag(name: char*, disable: bool, config: DriverConfig*) -> bool {
    if (strcmp(name, "sroa") == 0) {
        if (disable) {
            config.disable_passes = config.disable_passes | cast(u32, OptPass.OPT_PASS_SROA);
        } else {
            config.disable_passes = config.disable_passes & ~cast(u32, OptPass.OPT_PASS_SROA);
        }

        return true;
    }

    if (strcmp(name, "mem2reg") == 0) {
        if (disable) {
            config.disable_passes = config.disable_passes | cast(u32, OptPass.OPT_PASS_MEM2REG);
        } else {
            config.disable_passes = config.disable_passes & ~cast(u32, OptPass.OPT_PASS_MEM2REG);
        }

        return true;
    }

    if (strcmp(name, "sccp") == 0) {
        if (disable) {
            config.disable_passes = config.disable_passes | cast(u32, OptPass.OPT_PASS_SCCP);
        } else {
            config.disable_passes = config.disable_passes & ~cast(u32, OptPass.OPT_PASS_SCCP);
        }

        return true;
    }

    if (strcmp(name, "gvn") == 0) {
        if (disable) {
            config.disable_passes = config.disable_passes | cast(u32, OptPass.OPT_PASS_GVN);
        } else {
            config.disable_passes = config.disable_passes & ~cast(u32, OptPass.OPT_PASS_GVN);
        }

        return true;
    }

    if (strcmp(name, "licm") == 0) {
        if (disable) {
            config.disable_passes = config.disable_passes | cast(u32, OptPass.OPT_PASS_LICM);
        } else {
            config.disable_passes = config.disable_passes & ~cast(u32, OptPass.OPT_PASS_LICM);
        }

        return true;
    }

    if (strcmp(name, "cfg_opt") == 0) {
        if (disable) {
            config.disable_passes = config.disable_passes | cast(u32, OptPass.OPT_PASS_CFG_OPT);
        } else {
            config.disable_passes = config.disable_passes & ~cast(u32, OptPass.OPT_PASS_CFG_OPT);
        }

        return true;
    }

    if (strcmp(name, "ir_opt") == 0) {
        if (disable) {
            config.disable_passes = config.disable_passes | cast(u32, OptPass.OPT_PASS_IR_OPT);
        } else {
            config.disable_passes = config.disable_passes & ~cast(u32, OptPass.OPT_PASS_IR_OPT);
        }

        return true;
    }

    if (strcmp(name, "stack_color") == 0) {
        if (disable) {
            config.disable_passes = config.disable_passes | cast(u32, OptPass.OPT_PASS_STACK_COLOR);
        } else {
            config.disable_passes = config.disable_passes & ~cast(u32, OptPass.OPT_PASS_STACK_COLOR);
        }

        return true;
    }

    if (strcmp(name, "peephole") == 0) {
        if (disable) {
            config.disable_passes = config.disable_passes | cast(u32, OptPass.OPT_PASS_PEEPHOLE);
        } else {
            config.disable_passes = config.disable_passes & ~cast(u32, OptPass.OPT_PASS_PEEPHOLE);
        }

        return true;
    }

    return false;
}

proc parse_opt_flag(arg: char*, config: DriverConfig*) -> bool {
    if (strncmp(arg, "-fno-", 5) == 0 && strlen(arg) > 5) {
        if (!apply_pass_flag(arg + 5, true, config)) {
            fprintf(stderr, "error: unknown optimization pass '%s'\n", arg + 5);
            exit(1);
        }

        return true;
    }

    if (strncmp(arg, "-f", 2) == 0 && strlen(arg) > 2) {
        if (!apply_pass_flag(arg + 2, false, config)) {
            fprintf(stderr, "error: unknown optimization pass '%s'\n", arg + 2);
            exit(1);
        }

        return true;
    }

    return false;
}

proc parse_driver_args(a: Arena*, argc: i32, argv: char**) -> (DriverConfig, bool) {
    var config: DriverConfig;
    config.init(a);

    if (argc < 2) {
        print_driver_help(argv[0]);
        return (config, false);
    }

    for (var i: i32 = 1; i < argc; i += 1) {
        var arg: char* = argv[i];

        if (strcmp(arg, "-h") == 0 || strcmp(arg, "--help") == 0) {
            print_driver_help(argv[0]);
            exit(0);
        }

        if (strcmp(arg, "--version") == 0) {
            printf("klang version 0.1.0 (Kernel Language Compiler - Self-Hosted)\n");
            exit(0);
        }

        if (parse_opt_flag(arg, &config)) {
            continue;
        }

        if (strcmp(arg, "--dump-ir") == 0) {
            config.dump_ir = true;
            continue;
        }

        if (strcmp(arg, "-S") == 0) {
            config.phase = OutputPhase.PHASE_ASM;
            continue;
        }

        if (strcmp(arg, "-c") == 0) {
            config.phase = OutputPhase.PHASE_OBJ;
            continue;
        }

        if (strcmp(arg, "-shared") == 0) {
            config.phase = OutputPhase.PHASE_SHARED;
            continue;
        }

        if (strcmp(arg, "-static") == 0) {
            config.static_link = true;
            continue;
        }

        if (strcmp(arg, "-no-pie") == 0) {
            config.no_pie = true;
            continue;
        }

        if (strcmp(arg, "-pie") == 0) {
            config.no_pie = false;
            continue;
        }

        if (strcmp(arg, "-save-temps") == 0 || strcmp(arg, "--save-temps") == 0) {
            config.save_temps = true;
            continue;
        }

        if (strcmp(arg, "-v") == 0 || strcmp(arg, "--verbose") == 0) {
            config.verbose = true;
            continue;
        }

        if (strcmp(arg, "--fasm-mem") == 0) {
            if (i + 1 >= argc) {
                fprintf(stderr, "error: missing memory size after '--fasm-mem'\n");
                return (config, false);
            }
            i += 1;
            config.fasm_memory_mb = strtoull(argv[i], null, 10);
            continue;
        }

        if (strncmp(arg, "--fasm-mem=", 11) == 0 && strlen(arg) > 11) {
            config.fasm_memory_mb = strtoull(cast(char*, cast(u64, arg) + 11), null, 10);
            continue;
        }

        if (strcmp(arg, "-I") == 0) {
            if (i + 1 >= argc) {
                fprintf(stderr, "error: missing directory after '-I'\n");
                return (config, false);
            }
            i += 1;
            config.include_dir = argv[i];
            continue;
        }

        if (strncmp(arg, "-I", 2) == 0 && strlen(arg) > 2) {
            config.include_dir = cast(char*, cast(u64, arg) + 2);
            continue;
        }

        if (strcmp(arg, "-o") == 0) {
            if (i + 1 >= argc) {
                fprintf(stderr, "error: missing output filename after '-o'\n");
                return (config, false);
            }
            i += 1;
            config.output_path = argv[i];
            continue;
        }

        if (strncmp(arg, "-l", 2) == 0 && strlen(arg) > 2) {
            var lib_name: char* = cast(char*, cast(u64, arg) + 2);
            config.libs.push(lib_name);
            continue;
        }

        if (strcmp(arg, "-l") == 0) {
            if (i + 1 >= argc) {
                fprintf(stderr, "error: missing library name after '-l'\n");
                return (config, false);
            }
            i += 1;
            config.libs.push(argv[i]);
            continue;
        }

        if (strncmp(arg, "-L", 2) == 0 && strlen(arg) > 2) {
            var dir_name: char* = cast(char*, cast(u64, arg) + 2);
            config.lib_dirs.push(dir_name);
            continue;
        }

        if (strcmp(arg, "-L") == 0) {
            if (i + 1 >= argc) {
                fprintf(stderr, "error: missing directory after '-L'\n");
                return (config, false);
            }
            i += 1;
            config.lib_dirs.push(argv[i]);
            continue;
        }

        if (strncmp(arg, "-Wl,", 4) == 0 && strlen(arg) > 4) {
            split_comma_separated(a, &config.linker_extra_args, cast(char*, cast(u64, arg) + 4));
            continue;
        }

        if (strncmp(arg, "-Wa,", 4) == 0 && strlen(arg) > 4) {
            split_comma_separated(a, &config.asm_extra_args, cast(char*, cast(u64, arg) + 4));
            continue;
        }

        if (arg[0] == '-') {
            fprintf(stderr, "error: unrecognized command-line option '%s'\n", arg);
            return (config, false);
        }

        if (config.input_path != null) {
            fprintf(stderr, "error: multiple input files are not supported ('%s' and '%s')\n", config.input_path, arg);
            return (config, false);
        }

        config.input_path = arg;
    }

    if (config.input_path == null) {
        fprintf(stderr, "error: no input file specified\n");
        return (config, false);
    }

    return (config, true);
}