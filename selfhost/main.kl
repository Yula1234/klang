import "libc.kl";
import "arena.kl";
import "strview.kl";
import "lexer.kl";
import "type.kl";
import "ast.kl";
import "parser.kl";
import "diag.kl";
import "vec.kl";
import "hash_map.kl";
import "bitset.kl";
import "sbuilder.kl";
import "ast_dump.kl";

proc read_file(arena: Arena*, path: char*) -> (char*, u64) {
    var file: void* = fopen(path, "rb");

    if (file == null) {
        return (null, 0);
    }

    fseek(file, 0, SEEK_END);
    var size: i64 = ftell(file);
    fseek(file, 0, SEEK_SET);

    defer fclose(file);

    if (size < 0) {
        return (null, 0);
    }

    var u_size: u64 = cast(u64, size);
    var buf:    u8* = arena.alloc(u_size + 1);

    if (arena == null) {
        return (cast(char*, 0), 0);
    }

    var read_bytes: u64 = fread(buf, 1, u_size, file);
    buf[read_bytes] = cast(u8, 0);

    return (cast(char*, buf), read_bytes);
}

proc main(argc: i32, argv: char**) -> i32 {
    if (argc < 2) {
        fprintf(stderr, "Usage: klang <input.kl> [include_dir] [--dump-ast]\n");
        return 1;
    }

    var arena: Arena;
    arena.init(0);
    defer arena.destroy();

    var input_path: char* = argv[1];
    var inc_dir:    char* = null;
    var dump_ast:   bool  = true;

    if (argc >= 3) {
        inc_dir = argv[2];
    }

    var (source, source_len) = read_file(&arena, input_path);

    if (source == null) {
        fprintf(stderr, "error: failed to open or read file '%s'\n", input_path);
        return 1;
    }

    var lexer: Lexer;
    lexer.init(source, source_len, input_path);

    var parser: Parser;
    parser.init(&lexer, &arena, inc_dir);

    var program: AstProgram* = parse_program(&parser);

    if (parser.had_error || program == null) {
        fprintf(stderr, "\nerror: parsing terminated due to syntax errors.\n");
        return 1;
    }

    if (dump_ast) {
        printf("======================================================================\n");
        printf("                       FULL AST DUMP FOR: %s\n", input_path);
        printf("======================================================================\n\n");

        ast_dump_program(&arena, program);

        printf("======================================================================\n");
        printf("                       END OF AST DUMP\n");
        printf("======================================================================\n\n");
    }

    printf("=== AST Parse Summary for '%s' ===\n", input_path);
    printf("  Constants:     %llu\n", program.const_count);
    printf("  Typedefs:      %llu\n", program.typedef_count);
    printf("  Globals:       %llu\n", program.global_count);
    printf("  Structs:       %llu\n", program.struct_count);
    printf("  Unions:        %llu\n", program.union_count);
    printf("  Enums:         %llu\n", program.enum_count);
    printf("  Procedures:    %llu\n\n", program.proc_count);

    printf("SUCCESS: Successfully parsed and dumped '%s'!\n", input_path);

    return 0;
}