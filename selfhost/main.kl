import "libc.kl";
import "arena.kl";
import "strview.kl";
import "lexer.kl";
import "type.kl";
import "ast.kl";
import "parser.kl";
import "diag.kl";
import "sema/sema.kl";
import "ir/ir.kl";
import "ir/lower.kl";
import "ir/dump.kl";
import "codegen/codegen.kl";

var KLANG_VERSION: char* = "0.1.0";

struct Config {
    input_path:  char*,
    output_path: char*,
    include_dir: char*,
    dump_ir:     bool
}

proc print_version() -> void {
    printf("klang version %s (Kernel Language Compiler - Self-Hosted)\n", KLANG_VERSION);
}

proc print_help(prog_name: char*) -> void {
    printf("Usage: %s <input.kl> [options]\n\n", prog_name);
    printf("Options:\n");
    printf("  -o <file>        Specify output assembly file (default: output.asm)\n");
    printf("  -I <dir>         Add directory to module search path\n");
    printf("  --dump-ir        Print Intermediate Representation (3AC) to stdout\n");
    printf("  --version        Display compiler version information\n");
    printf("  -h, --help       Display this help message\n\n");
}

proc parse_args(argc: i32, argv: char**) -> (Config, bool) {
    var config: Config;
    config.input_path  = null;
    config.output_path = "output.asm";
    config.include_dir = null;
    config.dump_ir     = false;

    if (argc < 2) {
        print_help(argv[0]);
        return (config, false);
    }

    for (var i: i32 = 1; i < argc; i += 1) {
        var arg: char* = argv[i];

        if (strcmp(arg, "-h") == 0 || strcmp(arg, "--help") == 0) {
            print_help(argv[0]);
            exit(0);
        }

        if (strcmp(arg, "--version") == 0) {
            print_version();
            exit(0);
        }

        if (strcmp(arg, "--dump-ir") == 0) {
            config.dump_ir = true;
            continue;
        }

        if (strcmp(arg, "-I") == 0) {
            if (i + 1 >= argc) {
                fprintf(stderr, "error: missing directory after '-I'\n");
                return (config, false);
            }

            i += 1;
            config.include_dir = argv[i];
            continue;
        }

        if (strncmp(arg, "-I", 2) == 0 && strlen(arg) > 2) {
            config.include_dir = arg + 2;
            continue;
        }

        if (strcmp(arg, "-o") == 0) {
            if (i + 1 >= argc) {
                fprintf(stderr, "error: missing output filename after '-o'\n");
                return (config, false);
            }

            i += 1;
            config.output_path = argv[i];
            continue;
        }

        if (arg[0] == '-') {
            fprintf(stderr, "error: unrecognized command-line option '%s'\n", arg);
            return (config, false);
        }

        if (config.input_path != null) {
            fprintf(stderr, "error: multiple input files are not supported ('%s' and '%s')\n", config.input_path, arg);
            return (config, false);
        }

        config.input_path = arg;
    }

    if (config.input_path == null) {
        fprintf(stderr, "error: no input file specified\n");
        return (config, false);
    }

    return (config, true);
}

proc read_file(a: Arena*, path: char*) -> (char*, u64) {
    var file: void* = fopen(path, "rb");

    if (file == null) {
        return (null, 0);
    }

    fseek(file, 0, SEEK_END);
    var size: i64 = ftell(file);
    fseek(file, 0, SEEK_SET);

    if (size < 0) {
        fclose(file);
        return (null, 0);
    }

    var u_size: u64 = cast(u64, size);
    var buf:    u8* = a.alloc(u_size + 1);

    var read_bytes: u64 = fread(cast(void*, buf), 1, u_size, file);
    buf[read_bytes] = cast(u8, 0);

    fclose(file);

    return (cast(char*, buf), read_bytes);
}

proc main(argc: i32, argv: char**) -> i32 {
    var (config, ok) = parse_args(argc, argv);

    if (!ok) {
        return 1;
    }

    var arena: Arena;
    arena.init(0);
    defer arena.destroy();

    var (source, source_len) = read_file(&arena, config.input_path);

    if (source == null) {
        fprintf(stderr, "error: cannot open input file '%s'\n", config.input_path);
        return 1;
    }

    var lexer: Lexer;
    lexer.init(source, source_len, config.input_path);

    var parser: Parser;
    parser.init(&lexer, &arena, config.include_dir);

    var program: AstProgram* = parse_program(&parser);

    if (parser.had_error || program == null) {
        fprintf(stderr, "error: compilation terminated due to parse errors.\n");
        return 1;
    }

    var sema: Sema;
    sema.init(&arena);

    var sema_ok: bool = sema_analyze_program(&sema, program);

    if (!sema_ok || sema.had_error) {
        fprintf(stderr, "error: compilation terminated due to semantic errors.\n");
        return 1;
    }

    var ir_mod: IRModule* = ir_lower_program(&arena, program);

    if (ir_mod == null) {
        fprintf(stderr, "fatal error: failed to lower AST to IR.\n");
        return 1;
    }

    if (config.dump_ir) {
        ir_dump_module(ir_mod, &arena);
    }

    var codegen_ok: bool = codegen_generate_file(ir_mod, &arena, config.output_path);

    if (!codegen_ok) {
        fprintf(stderr, "error: failed to write output assembly to '%s'\n", config.output_path);
        return 1;
    }

    printf("Successfully generated: %s\n", config.output_path);

    return 0;
}