import "libc.kl";
import "arena.kl";
import "vec.kl";
import "strview.kl";
import "lexer.kl";
import "type.kl";
import "ast.kl";
import "ir/ir.kl";
import "ir/context.kl";
import "opt/dom_tree.kl";

struct PromoteCandidate {
    stack_offset: i32,
    byte_size:    u64,
    is_signed:    bool,
    is_escaped:   bool
}

struct PromotedVar {
    stack_offset: i32,
    byte_size:    u64,
    is_signed:    bool,
    var_id:       u32,
    def_blocks:   Vec[DomNode*],

    proc init(self, a: Arena*, stack_offset: i32, byte_size: u64, is_signed: bool, var_id: u32) -> void {
        self.stack_offset = stack_offset;
        self.byte_size    = byte_size;
        self.is_signed    = is_signed;
        self.var_id       = var_id;
        self.def_blocks.init(a);
    }
}

struct DefStackNode {
    val:  IROperand,
    next: DefStackNode*
}

struct Mem2RegCtx {
    arena:          Arena*,
    func:           IRFunction*,
    dom_tree:       DomTree*,
    vars:           PromotedVar*,
    var_count:      u64,
    def_stacks:     DefStackNode**,
    vreg_subst:     IROperand*,
    vreg_subst_cap: u64,

    proc init(self, a: Arena*, func: IRFunction*, dt: DomTree*, vars: PromotedVar*, var_count: u64) -> void {
        self.arena          = a;
        self.func           = func;
        self.dom_tree       = dt;
        self.vars           = vars;
        self.var_count      = var_count;
        self.def_stacks     = alloc_array_zero[DefStackNode*](a, var_count);

        var init_vreg_cap: u64 = cast(u64, func.next_vreg_id) + 1024;
        self.vreg_subst_cap = init_vreg_cap;
        self.vreg_subst     = alloc_array_zero[IROperand](a, init_vreg_cap);
    }
}

proc split_critical_edges(a: Arena*, func: IRFunction*) -> void {
    var changed: bool = true;

    while (changed) {
        changed = false;
        var b: IRBlock* = func.first_block;

        while (b != null) {
            var term: IRInst* = b.last_inst;

            if (term == null || term.opcode != IROpcode.IR_BR) {
                b = b.next_block;
                continue;
            }

            var targets: [2]IRBlock*;
            targets[0] = term.src1.block;
            targets[1] = term.src2.block;

            for (var t: u64 = 0; t < 2; t += 1) {
                var target: IRBlock* = targets[t];
                var pred_count: u64  = 0;
                var p: IRBlock*      = func.first_block;

                while (p != null) {
                    var p_term: IRInst* = p.last_inst;

                    if (p_term != null) {
                        if (p_term.opcode == IROpcode.IR_JMP && p_term.dst.block == target) {
                            pred_count += 1;
                        } else if (p_term.opcode == IROpcode.IR_BR && (p_term.src1.block == target || p_term.src2.block == target)) {
                            pred_count += 1;
                        }
                    }

                    p = p.next_block;
                }

                if (pred_count > 1) {
                    var split_bb: IRBlock* = ir_block_create(func, strview_from_cstr("bb_crit_split"));

                    ir_block_switch(func, split_bb);
                    ir_emit_inst(func, IROpcode.IR_JMP, ir_op_block(target), ir_op_none(), ir_op_none(), term.loc);

                    if (t == 0) {
                        term.src1 = ir_op_block(split_bb);
                    } else {
                        term.src2 = ir_op_block(split_bb);
                    }

                    changed = true;
                    break;
                }
            }

            if (changed) {
                break;
            }

            b = b.next_block;
        }
    }
}

proc mark_slot_range_escaped(base_offset: i32, byte_size: u64, candidates: Vec[PromoteCandidate]*) -> void {
    var size: u64 = byte_size;

    if (size == 0) {
        size = 8;
    }

    var obj_low:  i32 = base_offset;
    var obj_high: i32 = base_offset + cast(i32, size);

    for (var s: u64 = 0; s < candidates.len; s += 1) {
        var slot: i32 = candidates.data[s].stack_offset;

        if (slot >= obj_low && slot < obj_high) {
            candidates.data[s].is_escaped = true;
        }
    }
}

proc def_stack_push(ctx: Mem2RegCtx*, var_id: u32, val: IROperand) -> void {
    var node: DefStackNode* = alloc_zero[DefStackNode](ctx.arena);

    node.val  = val;
    node.next = ctx.def_stacks[var_id];

    ctx.def_stacks[var_id] = node;
}

proc def_stack_top(ctx: Mem2RegCtx*, var_id: u32) -> IROperand {
    if (ctx.def_stacks[var_id] != null) {
        return ctx.def_stacks[var_id].val;
    }

    var v: PromotedVar* = &ctx.vars[var_id];

    return ir_op_const(0, v.byte_size, v.is_signed);
}

proc def_stack_pop(ctx: Mem2RegCtx*, var_id: u32) -> void {
    if (ctx.def_stacks[var_id] != null) {
        ctx.def_stacks[var_id] = ctx.def_stacks[var_id].next;
    }
}

proc resolve_operand(ctx: Mem2RegCtx*, op_in: IROperand) -> IROperand {
    var op: IROperand = op_in;

    while (op.kind == IROperandKind.IR_OP_VREG && cast(u64, op.vreg_id) < ctx.vreg_subst_cap) {
        var subst: IROperand = ctx.vreg_subst[op.vreg_id];

        if (subst.kind == IROperandKind.IR_OP_NONE) {
            break;
        }

        op = subst;
    }

    return op;
}

proc find_promoted_var(ctx: Mem2RegCtx*, stack_offset: i32) -> i32 {
    for (var i: u64 = 0; i < ctx.var_count; i += 1) {
        if (ctx.vars[i].stack_offset == stack_offset) {
            return cast(i32, i);
        }
    }

    return -1;
}

proc rename_block_ssa(ctx: Mem2RegCtx*, b: DomNode*) -> void {
    var pushes: u64* = alloc_array_zero[u64](ctx.arena, ctx.var_count);

    var inst: IRInst* = b.block.first_inst;

    while (inst != null) {
        if (inst.opcode != IROpcode.IR_PHI) {
            break;
        }

        var var_id: i32 = find_promoted_var(ctx, inst.src1.stack_offset);

        if (var_id >= 0) {
            def_stack_push(ctx, cast(u32, var_id), inst.dst);
            pushes[var_id] += 1;
        }

        inst = inst.next;
    }

    inst = b.block.first_inst;

    while (inst != null) {
        if (inst.opcode == IROpcode.IR_PHI) {
            inst = inst.next;
            continue;
        }

        if (inst.opcode == IROpcode.IR_PARAM && inst.dst.kind == IROperandKind.IR_OP_STACK) {
            var var_id: i32 = find_promoted_var(ctx, inst.dst.stack_offset);

            if (var_id >= 0) {
                var v:      PromotedVar* = &ctx.vars[var_id];
                var vreg:   u32          = ir_vreg_alloc(ctx.func);
                var new_op: IROperand    = ir_op_vreg(vreg, v.byte_size, v.is_signed);

                inst.dst = new_op;

                def_stack_push(ctx, cast(u32, var_id), new_op);
                pushes[var_id] += 1;
            }
        } else if (inst.opcode == IROpcode.IR_MOV && inst.src1.kind == IROperandKind.IR_OP_STACK && inst.dst.kind == IROperandKind.IR_OP_VREG) {
            var var_id: i32 = find_promoted_var(ctx, inst.src1.stack_offset);

            if (var_id >= 0) {
                var val: IROperand = def_stack_top(ctx, cast(u32, var_id));
                val = resolve_operand(ctx, val);

                if (cast(u64, inst.dst.vreg_id) < ctx.vreg_subst_cap) {
                    ctx.vreg_subst[inst.dst.vreg_id] = val;
                }

                inst.opcode = IROpcode.IR_NOP;
            }
        } else if (inst.opcode == IROpcode.IR_MOV && inst.dst.kind == IROperandKind.IR_OP_STACK) {
            var var_id: i32 = find_promoted_var(ctx, inst.dst.stack_offset);

            if (var_id >= 0) {
                var val: IROperand = resolve_operand(ctx, inst.src1);

                def_stack_push(ctx, cast(u32, var_id), val);
                pushes[var_id] += 1;

                inst.opcode = IROpcode.IR_NOP;
            } else {
                inst.src1 = resolve_operand(ctx, inst.src1);
            }
        } else {
            if (inst.opcode == IROpcode.IR_STORE || inst.opcode == IROpcode.IR_MEMCPY || inst.opcode == IROpcode.IR_BR || inst.opcode == IROpcode.IR_RET) {
                inst.dst = resolve_operand(ctx, inst.dst);
            }

            inst.src1 = resolve_operand(ctx, inst.src1);
            inst.src2 = resolve_operand(ctx, inst.src2);

            for (var k: u64 = 0; k < inst.extra_arg_count; k += 1) {
                inst.extra_args[k] = resolve_operand(ctx, inst.extra_args[k]);
            }

            for (var k: u64 = 0; k < inst.asm_input_count; k += 1) {
                inst.asm_inputs[k].val = resolve_operand(ctx, inst.asm_inputs[k].val);
            }
        }

        inst = inst.next;
    }

    for (var s: u64 = 0; s < b.succs.len; s += 1) {
        var succ:     DomNode* = b.succs.data[s];
        var pred_idx: u64      = 0;

        for (var p: u64 = 0; p < succ.preds.len; p += 1) {
            if (succ.preds.data[p] == b) {
                pred_idx = p;
                break;
            }
        }

        var p_inst: IRInst* = succ.block.first_inst;

        while (p_inst != null && p_inst.opcode == IROpcode.IR_PHI) {
            var var_id: i32 = find_promoted_var(ctx, p_inst.src1.stack_offset);

            if (var_id >= 0) {
                var val: IROperand = def_stack_top(ctx, cast(u32, var_id));
                val = resolve_operand(ctx, val);

                p_inst.extra_args[2 * pred_idx]     = val;
                p_inst.extra_args[2 * pred_idx + 1] = ir_op_block(b.block);
            }

            p_inst = p_inst.next;
        }
    }

    for (var c: u64 = 0; c < b.dom_children.len; c += 1) {
        rename_block_ssa(ctx, b.dom_children.data[c]);
    }

    for (var v: u64 = 0; v < ctx.var_count; v += 1) {
        while (pushes[v] > 0) {
            def_stack_pop(ctx, cast(u32, v));
            pushes[v] -= 1;
        }
    }
}

proc mem2reg_run_on_function(a: Arena*, func: IRFunction*) -> void {
    if (func == null || func.first_block == null) {
        return;
    }

    split_critical_edges(a, func);

    var candidates: Vec[PromoteCandidate];
    candidates.init(a);

    var b: IRBlock* = func.first_block;

    while (b != null) {
        var inst: IRInst* = b.first_inst;

        while (inst != null) {
            if (inst.src1.kind == IROperandKind.IR_OP_STACK && inst.src1.stack_offset < 0) {
                var off: i32 = inst.src1.stack_offset;
                var found: bool = false;

                for (var s: u64 = 0; s < candidates.len; s += 1) {
                    if (candidates.data[s].stack_offset == off) {
                        found = true;
                        if (inst.src1.byte_size > candidates.data[s].byte_size) {
                            candidates.data[s].byte_size = inst.src1.byte_size;
                        }
                        break;
                    }
                }

                if (!found) {
                    var sz: u64 = inst.src1.byte_size;
                    if (sz == 0) {
                        sz = 8;
                    }

                    candidates.push(PromoteCandidate {
                        stack_offset: off,
                        byte_size:    sz,
                        is_signed:    inst.src1.is_signed,
                        is_escaped:   false
                    });
                }
            }

            if (inst.dst.kind == IROperandKind.IR_OP_STACK && inst.dst.stack_offset < 0) {
                var off: i32 = inst.dst.stack_offset;
                var found: bool = false;

                for (var s: u64 = 0; s < candidates.len; s += 1) {
                    if (candidates.data[s].stack_offset == off) {
                        found = true;
                        if (inst.dst.byte_size > candidates.data[s].byte_size) {
                            candidates.data[s].byte_size = inst.dst.byte_size;
                        }
                        break;
                    }
                }

                if (!found) {
                    var sz: u64 = inst.dst.byte_size;
                    if (sz == 0) {
                        sz = 8;
                    }

                    candidates.push(PromoteCandidate {
                        stack_offset: off,
                        byte_size:    sz,
                        is_signed:    inst.dst.is_signed,
                        is_escaped:   false
                    });
                }
            }

            inst = inst.next;
        }

        b = b.next_block;
    }

    b = func.first_block;

    while (b != null) {
        var inst: IRInst* = b.first_inst;

        while (inst != null) {
            if (inst.opcode == IROpcode.IR_ADDR && inst.src1.kind == IROperandKind.IR_OP_STACK && inst.src1.stack_offset < 0) {
                mark_slot_range_escaped(inst.src1.stack_offset, inst.src1.byte_size, &candidates);
            }

            if (inst.opcode == IROpcode.IR_MEMCPY) {
                var cpy_sz: u64 = 8;

                if (inst.src2.kind == IROperandKind.IR_OP_CONST && inst.src2.int_val > 0) {
                    cpy_sz = cast(u64, inst.src2.int_val);
                }

                if (inst.dst.kind == IROperandKind.IR_OP_STACK && inst.dst.stack_offset < 0) {
                    mark_slot_range_escaped(inst.dst.stack_offset, cpy_sz, &candidates);
                }

                if (inst.src1.kind == IROperandKind.IR_OP_STACK && inst.src1.stack_offset < 0) {
                    mark_slot_range_escaped(inst.src1.stack_offset, cpy_sz, &candidates);
                }
            }

            inst = inst.next;
        }

        b = b.next_block;
    }

    var promo_count: u64 = 0;

    for (var s: u64 = 0; s < candidates.len; s += 1) {
        if (!candidates.data[s].is_escaped && candidates.data[s].byte_size > 0 && candidates.data[s].byte_size <= 8) {
            promo_count += 1;
        }
    }

    if (promo_count == 0) {
        return;
    }

    var vars: []PromotedVar = alloc_array[PromotedVar](a, promo_count)[0..promo_count];
    var v_idx: u64 = 0;

    for (var s: u64 = 0; s < candidates.len; s += 1) {
        if (!candidates.data[s].is_escaped && candidates.data[s].byte_size > 0 && candidates.data[s].byte_size <= 8) {
            vars[v_idx].init(
                a,
                candidates.data[s].stack_offset,
                candidates.data[s].byte_size,
                candidates.data[s].is_signed,
                cast(u32, v_idx)
            );
            v_idx += 1;
        }
    }

    var dt: DomTree = dom_tree_build(a, func);

    for (var v: u64 = 0; v < promo_count; v += 1) {
        for (var i: u64 = 0; i < dt.node_count; i += 1) {
            var node: DomNode* = dt.nodes[i];
            var inst: IRInst*  = node.block.first_inst;

            while (inst != null) {
                if ((inst.opcode == IROpcode.IR_MOV || inst.opcode == IROpcode.IR_PARAM) &&
                    inst.dst.kind == IROperandKind.IR_OP_STACK &&
                    inst.dst.stack_offset == vars[v].stack_offset) {

                    vars[v].def_blocks.push(node);
                    break;
                }

                inst = inst.next;
            }
        }
    }

    for (var v: u64 = 0; v < promo_count; v += 1) {
        var work_queue: DomNode** = alloc_array[DomNode*](a, dt.node_count * 2);
        var w_head: u64 = 0;
        var w_tail: u64 = 0;

        var has_phi: bool* = alloc_array_zero[bool](a, dt.node_count);
        var in_work: bool* = alloc_array_zero[bool](a, dt.node_count);

        for (var d: u64 = 0; d < vars[v].def_blocks.len; d += 1) {
            var def_node: DomNode* = vars[v].def_blocks.data[d];

            work_queue[w_tail] = def_node;
            w_tail += 1;

            in_work[def_node.dense_id] = true;
        }

        while (w_head < w_tail) {
            var x: DomNode* = work_queue[w_head];
            w_head += 1;

            for (var f: u64 = 0; f < x.df.len; f += 1) {
                var y: DomNode* = x.df.data[f];

                if (!has_phi[y.dense_id]) {
                    has_phi[y.dense_id] = true;

                    var phi_vreg: u32     = ir_vreg_alloc(func);
                    var phi_inst: IRInst* = alloc_zero[IRInst](a);

                    phi_inst.opcode          = IROpcode.IR_PHI;
                    phi_inst.dst             = ir_op_vreg(phi_vreg, vars[v].byte_size, vars[v].is_signed);
                    phi_inst.src1            = ir_op_stack(vars[v].stack_offset, vars[v].byte_size, vars[v].is_signed);
                    phi_inst.src2            = ir_op_none();

                    if (y.block.first_inst != null) {
                        phi_inst.loc = y.block.first_inst.loc;
                    }

                    phi_inst.extra_arg_count = 2 * y.preds.len;
                    phi_inst.extra_args      = alloc_array_zero[IROperand](a, phi_inst.extra_arg_count);

                    phi_inst.next            = y.block.first_inst;
                    y.block.first_inst       = phi_inst;

                    if (y.block.last_inst == null) {
                        y.block.last_inst = phi_inst;
                    }

                    y.block.inst_count += 1;

                    if (!in_work[y.dense_id]) {
                        in_work[y.dense_id] = true;
                        work_queue[w_tail]  = y;
                        w_tail += 1;
                    }
                }
            }
        }
    }

    var ctx: Mem2RegCtx;
    ctx.init(a, func, &dt, vars.ptr, promo_count);

    if (cast(u64, func.next_vreg_id) >= ctx.vreg_subst_cap) {
        ctx.vreg_subst_cap = cast(u64, func.next_vreg_id) + 1024;
        ctx.vreg_subst     = alloc_array_zero[IROperand](a, ctx.vreg_subst_cap);
    }

    if (dt.rpo_count > 0 && dt.rpo_nodes[0] != null) {
        rename_block_ssa(&ctx, dt.rpo_nodes[0]);
    }

    ir_eliminate_nops(func);
}

proc mem2reg_run_on_module(a: Arena*, module: IRModule*) -> void {
    if (module == null) {
        return;
    }

    var f: IRFunction* = module.first_func;

    while (f != null) {
        mem2reg_run_on_function(a, f);
        f = f.next;
    }
}