import "libc.kl";
import "arena.kl";
import "vec.kl";
import "strview.kl";
import "lexer.kl";
import "type.kl";
import "ast.kl";
import "ir/ir.kl";
import "ir/context.kl";

const IR_OPT_VREG_HEADROOM:      u64 = 1024;
const IR_OPT_MAX_ITERATIONS:     u64 = 16;
const IR_OPT_MAX_RESOLVE_DEPTH:  u64 = 32;
const IR_OPT_MAX_TAIL_CALL_ARGS: u64 = 6;

const IR_OPT_INT64_MIN: i64 = -9223372036854775807 - 1;

@inline proc ir_opt_is_power_of_two(val: u64) -> bool {
    return val > 0 && (val & (val - 1)) == 0;
}

@inline proc ir_opt_power_of_two_exp(val: u64) -> u32 {
    var rest: u64 = val;
    var exp:  u32 = 0;

    while ((rest & 1) == 0) {
        rest = rest >> 1;
        exp += 1;
    }

    return exp;
}

@inline proc ir_opt_bool_to_int(value: bool) -> i64 {
    if (value) {
        return 1;
    }

    return 0;
}

@inline proc ir_opt_shift_mask(byte_size: u64) -> u64 {
    if (byte_size == 8) {
        return 63;
    }

    return 31;
}

proc ir_opt_operand_identical(a: IROperand, b: IROperand) -> bool {
    return a.kind == b.kind &&
           a.byte_size == b.byte_size &&
           a.is_signed == b.is_signed &&
           a.int_val == b.int_val &&
           a.vreg_id == b.vreg_id &&
           a.reg == b.reg &&
           a.stack_offset == b.stack_offset &&
           a.str_id == b.str_id &&
           a.block == b.block &&
           a.global_name.data == b.global_name.data &&
           a.global_name.len == b.global_name.len;
}

proc ir_opt_has_side_effects(inst: IRInst*) -> bool {
    var op: IROpcode = inst.opcode;

    if (op == IROpcode.IR_STORE         || op == IROpcode.IR_MEMCPY   ||
        op == IROpcode.IR_JMP           || op == IROpcode.IR_BR       ||
        op == IROpcode.IR_SWITCH        ||
        op == IROpcode.IR_RET           || op == IROpcode.IR_CALL     ||
        op == IROpcode.IR_CALL_PTR      || op == IROpcode.IR_TAIL_CALL ||
        op == IROpcode.IR_TAIL_CALL_PTR || op == IROpcode.IR_PARAM    ||
        op == IROpcode.IR_INLINE_ASM) {
        return true;
    }

    if (op == IROpcode.IR_MOV &&
        (inst.dst.kind == IROperandKind.IR_OP_STACK ||
         inst.dst.kind == IROperandKind.IR_OP_GLOBAL)) {
        return true;
    }

    return false;
}

proc ir_opt_escapes_caller_stack(func: IRFunction*, op: IROperand) -> bool {
    if (op.kind == IROperandKind.IR_OP_STACK) {
        return true;
    }

    if (op.kind != IROperandKind.IR_OP_VREG) {
        return false;
    }

    var b: IRBlock* = func.first_block;

    while (b != null) {
        var inst: IRInst* = b.first_inst;

        while (inst != null) {
            if (inst.dst.kind == IROperandKind.IR_OP_VREG && inst.dst.vreg_id == op.vreg_id) {
                if (inst.opcode == IROpcode.IR_ALLOCA) {
                    return true;
                }

                if (inst.opcode == IROpcode.IR_ADDR &&
                    inst.src1.kind == IROperandKind.IR_OP_STACK) {
                    return true;
                }

                if (inst.opcode == IROpcode.IR_MOV || inst.opcode == IROpcode.IR_ADD) {
                    if (ir_opt_escapes_caller_stack(func, inst.src1) ||
                        ir_opt_escapes_caller_stack(func, inst.src2)) {
                        return true;
                    }
                }
            }

            inst = inst.next;
        }

        b = b.next_block;
    }

    return false;
}

proc ir_opt_fold_binary(op: IROpcode, a: i64, b: i64, byte_size: u64, is_signed: bool) -> (i64, bool) {
    switch (op) {
        case IROpcode.IR_ADD: {
            return (a + b, true);
        }

        case IROpcode.IR_SUB: {
            return (a - b, true);
        }

        case IROpcode.IR_MUL: {
            return (a * b, true);
        }

        case IROpcode.IR_DIV: {
            if (b == 0) {
                return (0, false);
            }

            if (is_signed) {
                if (a == IR_OPT_INT64_MIN && b == -1) {
                    return (0, false);
                }

                return (a / b, true);
            }

            return (cast(i64, cast(u64, a) / cast(u64, b)), true);
        }

        case IROpcode.IR_MOD: {
            if (b == 0) {
                return (0, false);
            }

            if (is_signed) {
                if (a == IR_OPT_INT64_MIN && b == -1) {
                    return (0, false);
                }

                return (a % b, true);
            }

            return (cast(i64, cast(u64, a) % cast(u64, b)), true);
        }

        case IROpcode.IR_AND: {
            return (a & b, true);
        }

        case IROpcode.IR_OR: {
            return (a | b, true);
        }

        case IROpcode.IR_XOR: {
            return (a ^ b, true);
        }

        case IROpcode.IR_SHL: {
            var shift: u64 = cast(u64, b) & ir_opt_shift_mask(byte_size);

            return (cast(i64, cast(u64, a) << shift), true);
        }

        case IROpcode.IR_SHR: {
            var shift: u64 = cast(u64, b) & ir_opt_shift_mask(byte_size);

            if (is_signed) {
                return (a >> cast(i64, shift), true);
            }

            return (cast(i64, cast(u64, a) >> shift), true);
        }

        case IROpcode.IR_CMP_EQ: {
            return (ir_opt_bool_to_int(a == b), true);
        }

        case IROpcode.IR_CMP_NE: {
            return (ir_opt_bool_to_int(a != b), true);
        }

        case IROpcode.IR_CMP_LT: {
            if (is_signed) {
                return (ir_opt_bool_to_int(a < b), true);
            }

            return (ir_opt_bool_to_int(cast(u64, a) < cast(u64, b)), true);
        }

        case IROpcode.IR_CMP_LE: {
            if (is_signed) {
                return (ir_opt_bool_to_int(a <= b), true);
            }

            return (ir_opt_bool_to_int(cast(u64, a) <= cast(u64, b)), true);
        }

        case IROpcode.IR_CMP_GT: {
            if (is_signed) {
                return (ir_opt_bool_to_int(a > b), true);
            }

            return (ir_opt_bool_to_int(cast(u64, a) > cast(u64, b)), true);
        }

        case IROpcode.IR_CMP_GE: {
            if (is_signed) {
                return (ir_opt_bool_to_int(a >= b), true);
            }

            return (ir_opt_bool_to_int(cast(u64, a) >= cast(u64, b)), true);
        }
    }

    return (0, false);
}

@inline proc ir_opt_to_mov_keep_src1(inst: IRInst*) -> bool {
    inst.opcode = IROpcode.IR_MOV;
    inst.src2   = ir_op_none();

    return true;
}

@inline proc ir_opt_to_mov_from_src2(inst: IRInst*) -> bool {
    inst.opcode = IROpcode.IR_MOV;
    inst.src1   = inst.src2;
    inst.src2   = ir_op_none();

    return true;
}

@inline proc ir_opt_to_mov_const(inst: IRInst*, value: i64) -> bool {
    inst.opcode = IROpcode.IR_MOV;
    inst.src1   = ir_op_const(value, inst.dst.byte_size, inst.dst.is_signed);
    inst.src2   = ir_op_none();

    return true;
}

@inline proc ir_opt_to_mov_flag(inst: IRInst*, value: i64) -> bool {
    inst.opcode = IROpcode.IR_MOV;
    inst.src1   = ir_op_const(value, 1, false);
    inst.src2   = ir_op_none();

    return true;
}

@inline proc ir_opt_to_jmp(inst: IRInst*, target: IROperand) -> bool {
    inst.opcode = IROpcode.IR_JMP;
    inst.dst    = target;
    inst.src1   = ir_op_none();
    inst.src2   = ir_op_none();

    return true;
}

proc ir_opt_simplify_copy_and_unary(inst: IRInst*) -> bool {
    if (inst.opcode == IROpcode.IR_MOV &&
        inst.dst.kind == IROperandKind.IR_OP_VREG &&
        inst.src1.kind == IROperandKind.IR_OP_VREG &&
        inst.dst.vreg_id == inst.src1.vreg_id &&
        inst.dst.byte_size == inst.src1.byte_size) {
        inst.opcode = IROpcode.IR_NOP;

        return true;
    }

    if (inst.src1.kind != IROperandKind.IR_OP_CONST) {
        return false;
    }

    if (inst.opcode == IROpcode.IR_NEG) {
        return ir_opt_to_mov_const(inst, -inst.src1.int_val);
    }

    if (inst.opcode == IROpcode.IR_NOT) {
        return ir_opt_to_mov_const(inst, ~inst.src1.int_val);
    }

    return false;
}

proc ir_opt_simplify_constants(inst: IRInst*) -> bool {
    if (inst.src1.kind != IROperandKind.IR_OP_CONST ||
        inst.src2.kind != IROperandKind.IR_OP_CONST) {
        return false;
    }

    var (folded, ok) = ir_opt_fold_binary(inst.opcode,
                                          inst.src1.int_val,
                                          inst.src2.int_val,
                                          inst.dst.byte_size,
                                          inst.src1.is_signed);

    if (!ok) {
        return false;
    }

    return ir_opt_to_mov_const(inst, folded);
}

proc ir_opt_simplify_same_vreg(inst: IRInst*) -> bool {
    if (inst.src1.kind != IROperandKind.IR_OP_VREG ||
        inst.src2.kind != IROperandKind.IR_OP_VREG ||
        inst.src1.vreg_id != inst.src2.vreg_id) {
        return false;
    }

    switch (inst.opcode) {
        case IROpcode.IR_SUB,
             IROpcode.IR_XOR: {
            return ir_opt_to_mov_const(inst, 0);
        }

        case IROpcode.IR_AND,
             IROpcode.IR_OR: {
            return ir_opt_to_mov_keep_src1(inst);
        }

        case IROpcode.IR_CMP_EQ,
             IROpcode.IR_CMP_LE,
             IROpcode.IR_CMP_GE: {
            return ir_opt_to_mov_flag(inst, 1);
        }

        case IROpcode.IR_CMP_NE,
             IROpcode.IR_CMP_LT,
             IROpcode.IR_CMP_GT: {
            return ir_opt_to_mov_flag(inst, 0);
        }
    }

    return false;
}

proc ir_opt_simplify_rhs_const(inst: IRInst*) -> bool {
    if (inst.src2.kind != IROperandKind.IR_OP_CONST) {
        return false;
    }

    var op: IROpcode = inst.opcode;
    var c:  i64      = inst.src2.int_val;

    if (c == 0 && (op == IROpcode.IR_ADD || op == IROpcode.IR_SUB ||
                   op == IROpcode.IR_OR  || op == IROpcode.IR_XOR ||
                   op == IROpcode.IR_SHL || op == IROpcode.IR_SHR)) {
        return ir_opt_to_mov_keep_src1(inst);
    }

    if (c == 1 && (op == IROpcode.IR_MUL || op == IROpcode.IR_DIV)) {
        return ir_opt_to_mov_keep_src1(inst);
    }

    if (c == 0 && (op == IROpcode.IR_MUL || op == IROpcode.IR_AND)) {
        return ir_opt_to_mov_const(inst, 0);
    }

    if (c <= 0 || !ir_opt_is_power_of_two(cast(u64, c))) {
        return false;
    }

    if (op == IROpcode.IR_MUL) {
        inst.opcode = IROpcode.IR_SHL;
        inst.src2   = ir_op_const(cast(i64, ir_opt_power_of_two_exp(cast(u64, c))), 8, false);

        return true;
    }

    if (inst.src1.is_signed) {
        return false;
    }

    if (op == IROpcode.IR_DIV) {
        inst.opcode = IROpcode.IR_SHR;
        inst.src2   = ir_op_const(cast(i64, ir_opt_power_of_two_exp(cast(u64, c))), 8, false);

        return true;
    }

    if (op == IROpcode.IR_MOD) {
        inst.opcode = IROpcode.IR_AND;
        inst.src2   = ir_op_const(c - 1, inst.dst.byte_size, false);

        return true;
    }

    return false;
}

proc ir_opt_simplify_lhs_const(inst: IRInst*) -> bool {
    if (inst.src1.kind != IROperandKind.IR_OP_CONST) {
        return false;
    }

    var op: IROpcode = inst.opcode;
    var c:  i64      = inst.src1.int_val;

    if (c == 0 && (op == IROpcode.IR_ADD || op == IROpcode.IR_OR || op == IROpcode.IR_XOR)) {
        return ir_opt_to_mov_from_src2(inst);
    }

    if (c == 1 && op == IROpcode.IR_MUL) {
        return ir_opt_to_mov_from_src2(inst);
    }

    if (c == 0 && (op == IROpcode.IR_MUL || op == IROpcode.IR_AND)) {
        return ir_opt_to_mov_const(inst, 0);
    }

    return false;
}

proc ir_opt_simplify_branch(inst: IRInst*) -> bool {
    if (inst.opcode != IROpcode.IR_BR) {
        return false;
    }

    if (inst.dst.kind == IROperandKind.IR_OP_CONST) {
        var target: IRBlock* = inst.src2.block;

        if (inst.dst.int_val != 0) {
            target = inst.src1.block;
        }

        return ir_opt_to_jmp(inst, ir_op_block(target));
    }

    if (inst.src1.kind == IROperandKind.IR_OP_BLOCK &&
        inst.src2.kind == IROperandKind.IR_OP_BLOCK &&
        inst.src1.block == inst.src2.block) {
        return ir_opt_to_jmp(inst, inst.src1);
    }

    return false;
}

proc ir_opt_simplify(inst: IRInst*) -> bool {
    if (inst.opcode == IROpcode.IR_NOP) {
        return false;
    }

    if (ir_opt_simplify_copy_and_unary(inst)) {
        return true;
    }

    if (ir_opt_simplify_constants(inst)) {
        return true;
    }

    if (ir_opt_simplify_same_vreg(inst)) {
        return true;
    }

    if (ir_opt_simplify_rhs_const(inst)) {
        return true;
    }

    if (ir_opt_simplify_lhs_const(inst)) {
        return true;
    }

    return ir_opt_simplify_branch(inst);
}

struct IROptTables {
    subst:      IROperand*,
    use_counts: u32*,
    def_counts: u32*,
    cap:        u64,
    alloc_cap:  u64,

    proc allocate(self, a: Arena*) -> void {
        self.subst      = alloc_array_zero[IROperand](a, self.alloc_cap);
        self.use_counts = alloc_array_zero[u32](a, self.alloc_cap);
        self.def_counts = alloc_array_zero[u32](a, self.alloc_cap);
    }

    proc clear(self) -> void {
        memset(cast(void*, self.subst),      0, self.cap * sizeof(IROperand));
        memset(cast(void*, self.use_counts), 0, self.cap * sizeof(u32));
        memset(cast(void*, self.def_counts), 0, self.cap * sizeof(u32));
    }

    proc reset(self, a: Arena*, next_vreg_id: u32) -> void {
        self.cap = cast(u64, next_vreg_id);

        if (self.cap > self.alloc_cap) {
            self.alloc_cap = self.cap + IR_OPT_VREG_HEADROOM;

            self.allocate(a);

            return;
        }

        self.clear();
    }

    @inline proc holds(self, op: IROperand*) -> bool {
        return op.kind == IROperandKind.IR_OP_VREG && cast(u64, op.vreg_id) < self.cap;
    }

    proc resolve(self, op: IROperand) -> IROperand {
        var orig_byte_size: u64  = op.byte_size;
        var orig_is_signed: bool = op.is_signed;

        var result: IROperand = op;
        var depth:  u64       = 0;

        while (result.kind == IROperandKind.IR_OP_VREG &&
               cast(u64, result.vreg_id) < self.cap &&
               depth < IR_OPT_MAX_RESOLVE_DEPTH) {
            var mapped: IROperand = self.subst[cast(u64, result.vreg_id)];

            if (mapped.kind == IROperandKind.IR_OP_NONE) {
                break;
            }

            result = mapped;
            depth += 1;
        }

        if (orig_byte_size > 0) {
            result.byte_size = orig_byte_size;
            result.is_signed = orig_is_signed;
        }

        if (result.kind == IROperandKind.IR_OP_CONST) {
            result.int_val = int_truncate_to_width(result.int_val, result.byte_size, result.is_signed);
        }

        return result;
    }
}

struct IROptContext {
    arena:  Arena*,
    func:   IRFunction*,
    tables: IROptTables*,

    proc init(self, a: Arena*, func: IRFunction*, tables: IROptTables*) -> void {
        self.arena  = a;
        self.func   = func;
        self.tables = tables;

        self.tables.reset(a, func.next_vreg_id);
    }

    proc count_defs(self) -> void {
        var b: IRBlock* = self.func.first_block;

        while (b != null) {
            var inst: IRInst* = b.first_inst;

            while (inst != null) {
                if (inst.opcode != IROpcode.IR_NOP &&
                    !ir_opcode_reads_dst(inst.opcode) &&
                    self.tables.holds(&inst.dst)) {
                    self.tables.def_counts[cast(u64, inst.dst.vreg_id)] += 1;
                }

                inst = inst.next;
            }

            b = b.next_block;
        }
    }

    proc rewrite_operand(self, slot: IROperand*) -> bool {
        var resolved: IROperand = self.tables.resolve(*slot);

        if (ir_opt_operand_identical(resolved, *slot)) {
            return false;
        }

        *slot = resolved;

        return true;
    }

    proc try_tail_call(self, inst: IRInst*) -> bool {
        if (inst.opcode != IROpcode.IR_CALL && inst.opcode != IROpcode.IR_CALL_PTR) {
            return false;
        }

        if (inst.next == null) {
            return false;
        }

        var next_inst: IRInst* = inst.next;

        while (next_inst != null && next_inst.opcode == IROpcode.IR_NOP) {
            next_inst = next_inst.next;
        }

        if (next_inst == null || next_inst.opcode != IROpcode.IR_RET) {
            return false;
        }

        var returns_nothing: bool = inst.dst.kind == IROperandKind.IR_OP_NONE &&
                                    next_inst.dst.kind == IROperandKind.IR_OP_NONE;

        var returns_call_result: bool = inst.dst.kind == IROperandKind.IR_OP_VREG &&
                                        next_inst.dst.kind == IROperandKind.IR_OP_VREG &&
                                        inst.dst.vreg_id == next_inst.dst.vreg_id;

        if (!returns_nothing && !returns_call_result) {
            return false;
        }

        if (inst.extra_arg_count > IR_OPT_MAX_TAIL_CALL_ARGS) {
            return false;
        }

        for (var a: u64 = 0; a < inst.extra_arg_count; a += 1) {
            if (ir_opt_escapes_caller_stack(self.func, inst.extra_args[a])) {
                return false;
            }
        }

        if (inst.opcode == IROpcode.IR_CALL) {
            inst.opcode = IROpcode.IR_TAIL_CALL;
        } else {
            inst.opcode = IROpcode.IR_TAIL_CALL_PTR;
        }

        next_inst.opcode = IROpcode.IR_NOP;

        return true;
    }

    proc record_substitution(self, inst: IRInst*) -> void {
        if (inst.opcode != IROpcode.IR_MOV || !self.tables.holds(&inst.dst)) {
            return;
        }

        if (self.tables.def_counts[cast(u64, inst.dst.vreg_id)] != 1) {
            return;
        }

        if (inst.src1.kind != IROperandKind.IR_OP_CONST) {
            return;
        }

        self.tables.subst[cast(u64, inst.dst.vreg_id)] = ir_op_const(inst.src1.int_val,
                                                                     inst.dst.byte_size,
                                                                     inst.dst.is_signed);
    }

    proc rewrite_inst(self, inst: IRInst*) -> bool {
        var changed: bool = false;

        if (ir_opcode_reads_dst(inst.opcode) && self.rewrite_operand(&inst.dst)) {
            changed = true;
        }

        if (self.rewrite_operand(&inst.src1)) {
            changed = true;
        }

        if (self.rewrite_operand(&inst.src2)) {
            changed = true;
        }

        var step: u64 = 1;

        if (inst.opcode == IROpcode.IR_PHI) {
            step = 2;
        }

        for (var i: u64 = 0; i < inst.extra_arg_count; i += step) {
            if (self.rewrite_operand(&inst.extra_args[i])) {
                changed = true;
            }
        }

        for (var i: u64 = 0; i < inst.asm_input_count; i += 1) {
            if (self.rewrite_operand(&inst.asm_inputs[i].val)) {
                changed = true;
            }
        }

        if (ir_opt_simplify(inst)) {
            changed = true;
        }

        if (self.try_tail_call(inst)) {
            changed = true;
        }

        self.record_substitution(inst);

        return changed;
    }

    proc rewrite_and_fold(self) -> bool {
        var changed: bool     = false;
        var b:       IRBlock* = self.func.first_block;

        while (b != null) {
            var inst: IRInst* = b.first_inst;

            while (inst != null) {
                if (inst.opcode != IROpcode.IR_NOP && self.rewrite_inst(inst)) {
                    changed = true;
                }

                inst = inst.next;
            }

            b = b.next_block;
        }

        return changed;
    }

    proc bump_use(self, op: IROperand*) -> void {
        if (self.tables.holds(op)) {
            self.tables.use_counts[cast(u64, op.vreg_id)] += 1;
        }
    }

    proc count_uses_in_inst(self, inst: IRInst*) -> void {
        if (ir_opcode_reads_dst(inst.opcode)) {
            self.bump_use(&inst.dst);
        }

        if (inst.opcode == IROpcode.IR_MOV &&
            (inst.dst.kind == IROperandKind.IR_OP_STACK ||
             inst.dst.kind == IROperandKind.IR_OP_GLOBAL)) {
            self.bump_use(&inst.src1);
        }

        self.bump_use(&inst.src1);
        self.bump_use(&inst.src2);

        for (var i: u64 = 0; i < inst.extra_arg_count; i += 1) {
            self.bump_use(&inst.extra_args[i]);
        }

        for (var i: u64 = 0; i < inst.asm_input_count; i += 1) {
            self.bump_use(&inst.asm_inputs[i].val);
        }
    }

    proc count_uses(self) -> void {
        var b: IRBlock* = self.func.first_block;

        while (b != null) {
            var inst: IRInst* = b.first_inst;

            while (inst != null) {
                if (inst.opcode != IROpcode.IR_NOP) {
                    self.count_uses_in_inst(inst);
                }

                inst = inst.next;
            }

            b = b.next_block;
        }
    }

    proc eliminate_dead(self) -> bool {
        var changed: bool     = false;
        var b:       IRBlock* = self.func.first_block;

        while (b != null) {
            var inst: IRInst* = b.first_inst;

            while (inst != null) {
                if (inst.opcode != IROpcode.IR_NOP &&
                    !ir_opt_has_side_effects(inst) &&
                    self.tables.holds(&inst.dst)) {
                    var vreg: u64 = cast(u64, inst.dst.vreg_id);

                    if (self.tables.use_counts[vreg] == 0 && self.tables.def_counts[vreg] >= 1) {
                        inst.opcode = IROpcode.IR_NOP;
                        inst.dst    = ir_op_none();
                        inst.src1   = ir_op_none();
                        inst.src2   = ir_op_none();

                        changed = true;
                    }
                }

                inst = inst.next;
            }

            b = b.next_block;
        }

        return changed;
    }

    proc run(self) -> void {
        var changed:   bool = true;
        var iteration: u64  = 0;

        while (changed && iteration < IR_OPT_MAX_ITERATIONS) {
            changed = false;
            iteration += 1;

            self.tables.reset(self.arena, self.func.next_vreg_id);

            self.count_defs();

            if (self.rewrite_and_fold()) {
                changed = true;
            }

            self.count_uses();

            if (self.eliminate_dead()) {
                changed = true;
            }
        }

        ir_eliminate_nops(self.func);
    }
}

var g_ir_opt_tables: IROptTables;

proc ir_opt_addr_count_use(op: IROperand*, counts: u32*, use_inst: IRInst**, cap: u64, inst: IRInst*) -> void {
    if (op.kind == IROperandKind.IR_OP_VREG && cast(u64, op.vreg_id) < cap) {
        counts[op.vreg_id] += 1;
        use_inst[op.vreg_id] = inst;
    }
}

proc ir_opt_addr_dst_is_read(op: IROpcode) -> bool {
    return op == IROpcode.IR_STORE ||
           op == IROpcode.IR_PUSH ||
           op == IROpcode.IR_MEMCPY ||
           op == IROpcode.IR_BR ||
           op == IROpcode.IR_SWITCH ||
           op == IROpcode.IR_RET;
}

proc ir_opt_addr_count_inst(inst: IRInst*, counts: u32*, use_inst: IRInst**, cap: u64) -> void {
    ir_opt_addr_count_use(&inst.src1, counts, use_inst, cap, inst);
    ir_opt_addr_count_use(&inst.src2, counts, use_inst, cap, inst);

    if (ir_opt_addr_dst_is_read(inst.opcode)) {
        ir_opt_addr_count_use(&inst.dst, counts, use_inst, cap, inst);
    }

    var i: u64 = 0;

    while (i < inst.extra_arg_count) {
        ir_opt_addr_count_use(&inst.extra_args[i], counts, use_inst, cap, inst);
        i += 1;
    }

    i = 0;

    while (i < inst.asm_input_count) {
        ir_opt_addr_count_use(&inst.asm_inputs[i].val, counts, use_inst, cap, inst);
        i += 1;
    }
}

proc ir_opt_addr_fold_into_use(use: IRInst*, base: IROperand, delta: i64, addr_is_dst: bool) -> bool {
    var disp_op: IROperand* = &use.src2;

    if (disp_op.kind != IROperandKind.IR_OP_NONE && disp_op.kind != IROperandKind.IR_OP_CONST) {
        return false;
    }

    var new_disp: i64 = delta;

    if (disp_op.kind == IROperandKind.IR_OP_CONST) {
        new_disp += disp_op.int_val;
    }

    if (new_disp < -2147483648 || new_disp > 2147483647) {
        return false;
    }

    if (addr_is_dst) {
        use.dst = base;
    } else {
        use.src1 = base;
    }

    if (new_disp != 0) {
        use.src2 = ir_op_const(new_disp, 8, true);
    } else {
        use.src2 = ir_op_none();
    }

    return true;
}

proc ir_opt_fold_addr_disp_round(a: Arena*, func: IRFunction*, changed: bool*) -> void {
    var cap: u64 = cast(u64, func.next_vreg_id);

    if (cap == 0) {
        return;
    }

    var counts:   u32*     = alloc_array_zero[u32](a, cap);
    var use_inst: IRInst** = alloc_array_zero[IRInst*](a, cap);

    var b: IRBlock* = func.first_block;

    while (b != null) {
        var inst: IRInst* = b.first_inst;

        while (inst != null) {
            if (inst.opcode != IROpcode.IR_NOP) {
                ir_opt_addr_count_inst(inst, counts, use_inst, cap);
            }

            inst = inst.next;
        }

        b = b.next_block;
    }

    b = func.first_block;

    while (b != null) {
        var inst: IRInst* = b.first_inst;

        while (inst != null) {
            if (inst.dst.kind == IROperandKind.IR_OP_VREG &&
                counts[inst.dst.vreg_id] == 1) {

                var delta:  i64  = 0;
                var base:   IROperand = ir_op_none();
                var can:    bool = false;

                if ((inst.opcode == IROpcode.IR_ADD || inst.opcode == IROpcode.IR_SUB) &&
                    inst.src1.kind == IROperandKind.IR_OP_VREG &&
                    inst.src2.kind == IROperandKind.IR_OP_CONST) {

                    delta = inst.src2.int_val;

                    if (inst.opcode == IROpcode.IR_SUB) {
                        delta = -delta;
                    }

                    base = inst.src1;
                    can  = true;
                } else if (inst.opcode == IROpcode.IR_ADDR &&
                           inst.src1.kind == IROperandKind.IR_OP_VREG) {
                    base = inst.src1;

                    if (inst.src2.kind == IROperandKind.IR_OP_CONST) {
                        delta = inst.src2.int_val;
                    }

                    can = true;
                }

                if (can) {
                    var use:    IRInst* = use_inst[inst.dst.vreg_id];
                    var folded: bool    = false;

                    if (use != null && use != inst) {
                        if (use.opcode == IROpcode.IR_LOAD &&
                            use.src1.kind == IROperandKind.IR_OP_VREG &&
                            use.src1.vreg_id == inst.dst.vreg_id) {
                            folded = ir_opt_addr_fold_into_use(use, base, delta, false);
                        } else if (use.opcode == IROpcode.IR_STORE &&
                                   use.dst.kind == IROperandKind.IR_OP_VREG &&
                                   use.dst.vreg_id == inst.dst.vreg_id) {
                            folded = ir_opt_addr_fold_into_use(use, base, delta, true);
                        }
                    }

                    if (folded) {
                        inst.opcode = IROpcode.IR_NOP;
                        *changed = true;
                    }
                }
            }

            inst = inst.next;
        }

        b = b.next_block;
    }
}

proc ir_opt_fold_addr_disp(a: Arena*, func: IRFunction*) -> void {
    var changed: bool = true;
    var rounds:  u64  = 0;

    while (changed && rounds < 8) {
        changed = false;
        ir_opt_fold_addr_disp_round(a, func, &changed);
        rounds += 1;
    }
}

proc ir_opt_pair_div_mod(func: IRFunction*) -> void {
    var b: IRBlock* = func.first_block;

    while (b != null) {
        var inst: IRInst* = b.first_inst;

        while (inst != null) {
            if (inst.opcode == IROpcode.IR_MOD &&
                inst.dst.kind == IROperandKind.IR_OP_VREG) {
                var scan: IRInst* = inst.next;

                while (scan != null) {
                    var same_src2: bool = ir_opt_operand_identical(scan.src2, inst.src2);

                    if (!same_src2 &&
                        scan.src2.kind == IROperandKind.IR_OP_CONST &&
                        inst.src2.kind == IROperandKind.IR_OP_CONST &&
                        scan.src2.int_val == inst.src2.int_val) {
                        same_src2 = true;
                    }

                    if (scan.opcode == IROpcode.IR_DIV &&
                        ir_opt_operand_identical(scan.src1, inst.src1) &&
                        same_src2 &&
                        scan.dst.kind == IROperandKind.IR_OP_VREG) {

                        var divi: IRInst* = alloc_zero[IRInst](func.arena);

                        divi.opcode = IROpcode.IR_DIV;
                        divi.dst    = scan.dst;
                        divi.src1   = inst.src1;
                        divi.src2   = inst.src2;
                        divi.loc    = inst.loc;

                        var mul: IRInst* = alloc_zero[IRInst](func.arena);

                        mul.opcode = IROpcode.IR_MUL;
                        mul.dst    = ir_op_vreg(ir_vreg_alloc(func), inst.dst.byte_size, inst.dst.is_signed);
                        mul.src1   = scan.dst;
                        mul.src2   = inst.src2;
                        mul.loc    = inst.loc;

                        inst.opcode = IROpcode.IR_SUB;
                        inst.src1   = inst.src1;
                        inst.src2   = mul.dst;

                        divi.next = mul;
                        mul.next  = inst;

                        var prev: IRInst* = b.first_inst;

                        if (prev == inst) {
                            b.first_inst = divi;
                        } else {
                            while (prev.next != inst) {
                                prev = prev.next;
                            }

                            prev.next = divi;
                        }

                        scan.opcode = IROpcode.IR_NOP;
                        break;
                    }

                    if (!ir_opcode_reads_dst(scan.opcode) &&
                        scan.dst.kind == IROperandKind.IR_OP_VREG &&
                        inst.src1.kind == IROperandKind.IR_OP_VREG &&
                        scan.dst.vreg_id == inst.src1.vreg_id) {
                        break;
                    }

                    scan = scan.next;
                }
            }

            if (inst.opcode == IROpcode.IR_DIV &&
                inst.dst.kind == IROperandKind.IR_OP_VREG) {
                var scan: IRInst* = inst.next;

                while (scan != null) {
                    var same_src2: bool = ir_opt_operand_identical(scan.src2, inst.src2);

                    if (!same_src2 &&
                        scan.src2.kind == IROperandKind.IR_OP_CONST &&
                        inst.src2.kind == IROperandKind.IR_OP_CONST &&
                        scan.src2.int_val == inst.src2.int_val) {
                        same_src2 = true;
                    }

                    if (scan.opcode == IROpcode.IR_MOD &&
                        ir_opt_operand_identical(scan.src1, inst.src1) &&
                        same_src2 &&
                        scan.dst.kind == IROperandKind.IR_OP_VREG) {

                        var mul: IRInst* = alloc_zero[IRInst](func.arena);

                        mul.opcode = IROpcode.IR_MUL;
                        mul.dst    = ir_op_vreg(ir_vreg_alloc(func), scan.dst.byte_size, scan.dst.is_signed);
                        mul.src1   = inst.dst;
                        mul.src2   = inst.src2;
                        mul.loc    = scan.loc;
                        mul.next   = scan;

                        scan.opcode = IROpcode.IR_SUB;
                        scan.src1   = inst.src1;
                        scan.src2   = mul.dst;

                        var prev: IRInst* = inst;

                        while (prev.next != scan) {
                            prev = prev.next;
                        }

                        prev.next = mul;

                        if (b.last_inst == scan) {
                        }

                        break;
                    }

                    if (!ir_opcode_reads_dst(scan.opcode) &&
                        scan.dst.kind == IROperandKind.IR_OP_VREG &&
                        inst.src1.kind == IROperandKind.IR_OP_VREG &&
                        scan.dst.vreg_id == inst.src1.vreg_id) {
                        break;
                    }

                    if (!ir_opcode_reads_dst(scan.opcode) &&
                        scan.dst.kind == IROperandKind.IR_OP_VREG &&
                        inst.src2.kind == IROperandKind.IR_OP_VREG &&
                        scan.dst.vreg_id == inst.src2.vreg_id) {
                        break;
                    }

                    scan = scan.next;
                }
            }

            inst = inst.next;
        }

        b = b.next_block;
    }
}

proc ir_opt_next_real(inst: IRInst*) -> IRInst* {
    var cur: IRInst* = inst;

    while (cur != null && cur.opcode == IROpcode.IR_NOP) {
        cur = cur.next;
    }

    return cur;
}

proc ir_opt_fold_one_range(func: IRFunction*, b: IRBlock*) -> bool {
    var cursor: IRInst* = b.first_inst;

    while (cursor != null) {
        if (cursor.opcode == IROpcode.IR_NOP   ||
            cursor.opcode == IROpcode.IR_MOV   ||
            cursor.opcode == IROpcode.IR_PARAM) {
            cursor = cursor.next;
            continue;
        }

        break;
    }

    var cmp1: IRInst* = ir_opt_next_real(cursor);

    if (cmp1 == null) {
        return false;
    }

    if (cmp1.opcode != IROpcode.IR_CMP_GE && cmp1.opcode != IROpcode.IR_CMP_GT) {
        return false;
    }

    if (cmp1.src1.kind != IROperandKind.IR_OP_VREG ||
        cmp1.src2.kind != IROperandKind.IR_OP_CONST) {
        return false;
    }

    var br1: IRInst* = ir_opt_next_real(cmp1.next);

    if (br1 == null || br1.opcode != IROpcode.IR_BR) {
        return false;
    }

    if (br1.src1.kind != IROperandKind.IR_OP_BLOCK || br1.src2.kind != IROperandKind.IR_OP_BLOCK) {
        return false;
    }

    var rhs: IRBlock* = br1.src1.block;
    var fls: IRBlock* = br1.src2.block;

    if (rhs == null || rhs == fls) {
        return false;
    }

    var cmp2: IRInst* = ir_opt_next_real(rhs.first_inst);

    if (cmp2 == null) {
        return false;
    }

    if (cmp2.opcode != IROpcode.IR_CMP_LE && cmp2.opcode != IROpcode.IR_CMP_LT) {
        return false;
    }

    if (cmp2.src1.kind != IROperandKind.IR_OP_VREG ||
        cmp2.src2.kind != IROperandKind.IR_OP_CONST ||
        cmp2.src1.vreg_id != cmp1.src1.vreg_id ||
        false) {
        return false;
    }

    var br2: IRInst* = ir_opt_next_real(cmp2.next);

    if (br2 == null || br2.opcode != IROpcode.IR_BR) {
        return false;
    }

    if (br2.src2.kind != IROperandKind.IR_OP_BLOCK || br2.src2.block != fls) {
        return false;
    }

    if (br2.src1.kind != IROperandKind.IR_OP_BLOCK) {
        return false;
    }

    var lo: i64 = cmp1.src2.int_val;

    if (cmp1.opcode == IROpcode.IR_CMP_GT) {
        lo += 1;
    }

    var hi: i64 = cmp2.src2.int_val;

    if (cmp2.opcode == IROpcode.IR_CMP_LT) {
        hi -= 1;
    }

    if (hi < lo) {
        return false;
    }

    var span: i64 = hi - lo;
    var y:    u32 = ir_vreg_alloc(func);
    var sz:   u64 = cmp1.src1.byte_size;

    if (sz == 0) {
        sz = 8;
    }

    cmp1.opcode    = IROpcode.IR_SUB;
    cmp1.dst       = ir_op_vreg(y, sz, false);
    cmp1.src2      = ir_op_const(lo, sz, false);
    cmp1.src1.is_signed = false;

    var ncmp: IRInst* = alloc_zero[IRInst](func.arena);

    ncmp.opcode         = IROpcode.IR_CMP_LE;
    ncmp.dst            = br1.dst;
    ncmp.src1           = ir_op_vreg(y, sz, false);
    ncmp.src2           = ir_op_const(span, sz, false);
    ncmp.loc            = cmp1.loc;
    ncmp.next           = br1;

    cmp1.next = ncmp;
    br1.src1  = br2.src1;

    cmp2.opcode = IROpcode.IR_NOP;
    br2.opcode  = IROpcode.IR_NOP;

    return true;
}

proc ir_opt_fold_range_compares(func: IRFunction*) -> void {
    var changed: bool = true;
    var round:   u64  = 0;

    while (changed && round < 8) {
        changed = false;
        round += 1;

        var b: IRBlock* = func.first_block;

        while (b != null) {
            if (ir_opt_fold_one_range(func, b)) {
                changed = true;
            }

            b = b.next_block;
        }
    }
}

proc ir_opt_run_on_function(a: Arena*, func: IRFunction*) -> void {
    if (func == null || func.first_block == null) {
        return;
    }

    var ctx: IROptContext;

    ctx.init(a, func, &g_ir_opt_tables);
    ctx.run();

    ir_opt_fold_addr_disp(a, func);
    ir_opt_pair_div_mod(func);
    ir_opt_fold_range_compares(func);
    ir_strip_after_terminator(func);
}

proc ir_opt_run_on_module(a: Arena*, module: IRModule*) -> void {
    if (module == null) {
        return;
    }

    var f: IRFunction* = module.first_func;

    while (f != null) {
        ir_opt_run_on_function(a, f);

        f = f.next;
    }
}