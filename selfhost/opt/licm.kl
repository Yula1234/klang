import "libc.kl";
import "arena.kl";
import "bitset.kl";
import "vec.kl";
import "strview.kl";
import "lexer.kl";
import "type.kl";
import "ast.kl";
import "ir/ir.kl";
import "ir/context.kl";

const LICM_VREG_HEADROOM: u64 = 1024;

struct LICMBlock {
    block:    IRBlock*,
    dense_id: u64,
    rpo_idx:  u64,

    preds:    Vec[LICMBlock*],
    succs:    Vec[LICMBlock*],

    idom:     LICMBlock*,

    proc init(self, a: Arena*, block: IRBlock*, dense_id: u64) -> void {
        self.block    = block;
        self.dense_id = dense_id;
        self.rpo_idx  = 0;
        self.idom     = null;

        self.preds.init(a);
        self.succs.init(a);
    }

    proc add_succ(self, to: LICMBlock*) -> void {
        if (to == null) {
            return;
        }

        for (var i: u64 = 0; i < self.succs.len; i += 1) {
            if (self.succs.data[i] == to) {
                return;
            }
        }

        self.succs.push(to);
        to.preds.push(self);
    }

    proc dominates(self, other: LICMBlock*) -> bool {
        var curr: LICMBlock* = other;

        while (curr != null) {
            if (curr == self) {
                return true;
            }

            if (curr.idom == curr) {
                break;
            }

            curr = curr.idom;
        }

        return false;
    }
}

struct NaturalLoop {
    header:    LICMBlock*,
    preheader: LICMBlock*,

    blocks:    BitSet,
    latches:   Vec[LICMBlock*],

    next:      NaturalLoop*,

    proc init(self, a: Arena*, header: LICMBlock*, block_capacity: u64) -> void {
        self.header    = header;
        self.preheader = null;
        self.blocks    = bitset_create(a, block_capacity);
        self.next      = null;

        self.latches.init(a);
    }

    @inline proc contains(self, node: LICMBlock*) -> bool {
        return node != null && self.blocks.test(node.dense_id);
    }

    proc add_block(self, node: LICMBlock*) -> bool {
        if (node == null || node.dense_id >= self.blocks.count() || self.blocks.test(node.dense_id)) {
            return false;
        }

        self.blocks.set(node.dense_id);

        return true;
    }
}

struct LICMContext {
    arena:         Arena*,
    func:          IRFunction*,

    blocks:        LICMBlock**,
    block_count:   u64,

    lookup:        LICMBlock**,
    lookup_cap:    u64,

    rpo_blocks:    LICMBlock**,
    rpo_count:     u64,

    next_dense_id: u64,

    loops:         NaturalLoop*,
    vreg_cap:      u64,

    proc init(self, a: Arena*, func: IRFunction*, vreg_cap: u64) -> void {
        self.arena         = a;
        self.func          = func;
        self.blocks        = null;
        self.block_count   = 0;
        self.lookup        = null;
        self.lookup_cap    = 0;
        self.rpo_blocks    = null;
        self.rpo_count     = 0;
        self.next_dense_id = 0;
        self.loops         = null;
        self.vreg_cap      = vreg_cap;
    }

    proc create_node(self, block: IRBlock*) -> LICMBlock* {
        var node: LICMBlock* = alloc_zero[LICMBlock](self.arena);
        node.init(self.arena, block, self.next_dense_id);

        self.next_dense_id += 1;

        return node;
    }

    proc find_node(self, block: IRBlock*) -> LICMBlock* {
        if (block == null) {
            return null;
        }

        var id: u64 = cast(u64, block.id);

        if (self.lookup != null && id < self.lookup_cap) {
            var cached: LICMBlock* = self.lookup[id];

            if (cached != null && cached.block == block) {
                return cached;
            }
        }

        for (var i: u64 = 0; i < self.block_count; i += 1) {
            if (self.blocks[i].block == block) {
                return self.blocks[i];
            }
        }

        return null;
    }
}

@inline proc licm_block_operand(op: IROperand) -> IRBlock* {
    if (op.kind != IROperandKind.IR_OP_BLOCK) {
        return null;
    }

    return op.block;
}

@inline proc licm_is_terminator(op: IROpcode) -> bool {
    return op == IROpcode.IR_JMP || op == IROpcode.IR_BR || op == IROpcode.IR_RET;
}

@inline proc licm_is_block_exit(op: IROpcode) -> bool {
    return op == IROpcode.IR_RET || op == IROpcode.IR_TAIL_CALL || op == IROpcode.IR_TAIL_CALL_PTR;
}

@inline proc licm_inst_dst_is_read(op: IROpcode) -> bool {
    return op == IROpcode.IR_STORE || op == IROpcode.IR_MEMCPY || op == IROpcode.IR_BR || op == IROpcode.IR_RET;
}

proc licm_is_candidate(op: IROpcode) -> bool {
    switch (op) {
        case IROpcode.IR_ADD,
             IROpcode.IR_SUB,
             IROpcode.IR_MUL,
             IROpcode.IR_AND,
             IROpcode.IR_OR,
             IROpcode.IR_XOR,
             IROpcode.IR_SHL,
             IROpcode.IR_SHR,
             IROpcode.IR_NEG,
             IROpcode.IR_NOT,
             IROpcode.IR_CMP_EQ,
             IROpcode.IR_CMP_NE,
             IROpcode.IR_CMP_LT,
             IROpcode.IR_CMP_LE,
             IROpcode.IR_CMP_GT,
             IROpcode.IR_CMP_GE,
             IROpcode.IR_MOV,
             IROpcode.IR_ADDR,
             IROpcode.IR_GLOBAL_STR: {
            return true;
        }

        case IROpcode.IR_DIV,
             IROpcode.IR_MOD: {
            return true;
        }

        default: {
            return false;
        }
    }
}

proc licm_zero_loc() -> SourceLoc {
    return SourceLoc {
        filename:   null,
        line_start: null,
        line:       0,
        col:        0,
        len:        0
    };
}

proc licm_connect_block(ctx: LICMContext*, node: LICMBlock*) -> void {
    var term: IRInst* = node.block.last_inst;

    if (term != null && term.opcode == IROpcode.IR_JMP && term.dst.kind == IROperandKind.IR_OP_BLOCK) {
        node.add_succ(ctx.find_node(term.dst.block));
        return;
    }

    if (term != null && term.opcode == IROpcode.IR_BR) {
        var on_true:  LICMBlock* = ctx.find_node(licm_block_operand(term.src1));
        var on_false: LICMBlock* = ctx.find_node(licm_block_operand(term.src2));

        if (on_true != null && on_false != null && on_false.dense_id < on_true.dense_id) {
            var earlier: LICMBlock* = on_false;

            on_false = on_true;
            on_true  = earlier;
        }

        node.add_succ(on_true);
        node.add_succ(on_false);

        return;
    }

    if (term != null && licm_is_block_exit(term.opcode)) {
        return;
    }

    node.add_succ(ctx.find_node(node.block.next_block));
}

proc licm_build_cfg(ctx: LICMContext*) -> void {
    var count: u64 = ctx.func.block_count;

    ctx.blocks      = alloc_array[LICMBlock*](ctx.arena, count);
    ctx.block_count = count;
    ctx.lookup_cap  = cast(u64, ctx.func.next_block_id);

    if (ctx.lookup_cap > 0) {
        ctx.lookup = alloc_array_zero[LICMBlock*](ctx.arena, ctx.lookup_cap);
    }

    var block: IRBlock* = ctx.func.first_block;
    var idx:   u64      = 0;

    while (block != null && idx < count) {
        var node: LICMBlock* = ctx.create_node(block);
        var id:   u64        = cast(u64, block.id);

        ctx.blocks[idx] = node;

        if (ctx.lookup != null && id < ctx.lookup_cap && ctx.lookup[id] == null) {
            ctx.lookup[id] = node;
        }

        idx += 1;
        block = block.next_block;
    }

    ctx.block_count = idx;

    for (var i: u64 = 0; i < ctx.block_count; i += 1) {
        licm_connect_block(ctx, ctx.blocks[i]);
    }
}

proc licm_rpo_dfs(node: LICMBlock*, visited: bool*, post_order: LICMBlock**, po_count: u64*) -> void {
    if (visited[node.dense_id]) {
        return;
    }

    visited[node.dense_id] = true;

    for (var i: u64 = 0; i < node.succs.len; i += 1) {
        licm_rpo_dfs(node.succs.data[i], visited, post_order, po_count);
    }

    post_order[*po_count] = node;
    *po_count = *po_count + 1;
}

proc licm_dom_intersect(lhs: LICMBlock*, rhs: LICMBlock*) -> LICMBlock* {
    var finger1: LICMBlock* = lhs;
    var finger2: LICMBlock* = rhs;

    while (finger1 != finger2) {
        while (finger1.rpo_idx > finger2.rpo_idx) {
            finger1 = finger1.idom;
        }

        while (finger2.rpo_idx > finger1.rpo_idx) {
            finger2 = finger2.idom;
        }
    }

    return finger1;
}

proc licm_build_dominators(ctx: LICMContext*) -> void {
    if (ctx.block_count == 0) {
        return;
    }

    var visited:    bool*       = alloc_array_zero[bool](ctx.arena, ctx.block_count);
    var post_order: LICMBlock** = alloc_array[LICMBlock*](ctx.arena, ctx.block_count);
    var po_count:   u64         = 0;

    licm_rpo_dfs(ctx.blocks[0], visited, post_order, &po_count);

    if (po_count == 0) {
        return;
    }

    ctx.rpo_blocks = alloc_array[LICMBlock*](ctx.arena, po_count);
    ctx.rpo_count  = po_count;

    for (var i: u64 = 0; i < po_count; i += 1) {
        var node: LICMBlock* = post_order[po_count - 1 - i];

        node.rpo_idx      = i;
        ctx.rpo_blocks[i] = node;
    }

    ctx.rpo_blocks[0].idom = ctx.rpo_blocks[0];

    var changed: bool = true;

    while (changed) {
        changed = false;

        for (var i: u64 = 1; i < po_count; i += 1) {
            var node:     LICMBlock* = ctx.rpo_blocks[i];
            var new_idom: LICMBlock* = null;

            for (var p: u64 = 0; p < node.preds.len; p += 1) {
                var pred: LICMBlock* = node.preds.data[p];

                if (pred.idom == null) {
                    continue;
                }

                if (new_idom == null) {
                    new_idom = pred;
                } else {
                    new_idom = licm_dom_intersect(pred, new_idom);
                }
            }

            if (new_idom != null && node.idom != new_idom) {
                node.idom = new_idom;
                changed   = true;
            }
        }
    }
}

proc licm_discover_loop_body(ctx: LICMContext*, loop: NaturalLoop*, latch: LICMBlock*) -> void {
    loop.latches.push(latch);

    loop.add_block(loop.header);
    loop.add_block(latch);

    var work_stack: Vec[LICMBlock*];
    work_stack.init(ctx.arena);
    work_stack.push(latch);

    while (!work_stack.is_empty()) {
        var (curr, ok) = work_stack.pop();

        if (!ok) {
            break;
        }

        for (var p: u64 = 0; p < curr.preds.len; p += 1) {
            var pred: LICMBlock* = curr.preds.data[p];

            if (pred != loop.header && loop.add_block(pred)) {
                work_stack.push(pred);
            }
        }
    }
}

proc licm_find_loop(ctx: LICMContext*, header: LICMBlock*) -> NaturalLoop* {
    var loop: NaturalLoop* = ctx.loops;

    while (loop != null) {
        if (loop.header == header) {
            return loop;
        }

        loop = loop.next;
    }

    return null;
}

proc licm_find_natural_loops(ctx: LICMContext*) -> void {
    for (var i: u64 = 0; i < ctx.rpo_count; i += 1) {
        var node: LICMBlock* = ctx.rpo_blocks[i];

        for (var s: u64 = 0; s < node.succs.len; s += 1) {
            var succ: LICMBlock* = node.succs.data[s];

            if (!succ.dominates(node)) {
                continue;
            }

            var loop: NaturalLoop* = licm_find_loop(ctx, succ);

            if (loop == null) {
                loop = alloc_zero[NaturalLoop](ctx.arena);
                loop.init(ctx.arena, succ, ctx.block_count);

                loop.next = ctx.loops;
                ctx.loops = loop;
            }

            licm_discover_loop_body(ctx, loop, node);
        }
    }
}

proc licm_redirect_terminator(term: IRInst*, from: IRBlock*, to: IRBlock*) -> void {
    if (term == null) {
        return;
    }

    if (term.opcode == IROpcode.IR_JMP) {
        if (licm_block_operand(term.dst) == from) {
            term.dst = ir_op_block(to);
        }

        return;
    }

    if (term.opcode == IROpcode.IR_BR) {
        if (licm_block_operand(term.src1) == from) {
            term.src1 = ir_op_block(to);
        }

        if (licm_block_operand(term.src2) == from) {
            term.src2 = ir_op_block(to);
        }
    }
}

proc licm_redirect_phi_inputs(header: IRBlock*, from: IRBlock*, to: IRBlock*) -> void {
    var inst: IRInst* = header.first_inst;

    while (inst != null && inst.opcode == IROpcode.IR_PHI) {
        var a: u64 = 0;

        while (a + 1 < inst.extra_arg_count) {
            if (licm_block_operand(inst.extra_args[a + 1]) == from) {
                inst.extra_args[a + 1] = ir_op_block(to);
            }

            a += 2;
        }

        inst = inst.next;
    }
}

proc licm_create_preheader(ctx: LICMContext*, loop: NaturalLoop*) -> void {
    var header:        LICMBlock* = loop.header;
    var outside_count: u64        = 0;

    for (var p: u64 = 0; p < header.preds.len; p += 1) {
        if (!loop.contains(header.preds.data[p])) {
            outside_count += 1;
        }
    }

    if (outside_count == 1) {
        for (var p: u64 = 0; p < header.preds.len; p += 1) {
            var pred: LICMBlock* = header.preds.data[p];

            if (!loop.contains(pred) && pred.succs.len == 1) {
                loop.preheader = pred;
                return;
            }
        }
    }

    var func:   IRFunction* = ctx.func;
    var pre_bb: IRBlock*    = ir_block_create(func, strview_from_cstr("bb_loop_preheader"));

    ir_block_switch(func, pre_bb);
    ir_emit_inst(func, IROpcode.IR_JMP, ir_op_block(header.block), ir_op_none(), ir_op_none(), licm_zero_loc());

    for (var p: u64 = 0; p < header.preds.len; p += 1) {
        var pred: LICMBlock* = header.preds.data[p];

        if (loop.contains(pred)) {
            continue;
        }

        licm_redirect_terminator(pred.block.last_inst, header.block, pre_bb);
        licm_redirect_phi_inputs(header.block, pred.block, pre_bb);
    }

    loop.preheader = ctx.create_node(pre_bb);
}

proc licm_insert_before_terminator(block: IRBlock*, inst: IRInst*) -> void {
    var prev: IRInst* = null;
    var curr: IRInst* = block.first_inst;

    while (curr != null && curr.next != null && !licm_is_terminator(curr.opcode)) {
        prev = curr;
        curr = curr.next;
    }

    if (curr != null && licm_is_terminator(curr.opcode)) {
        inst.next = curr;

        if (prev != null) {
            prev.next = inst;
        } else {
            block.first_inst = inst;
        }
    } else if (block.last_inst != null) {
        block.last_inst.next = inst;
        block.last_inst      = inst;
    } else {
        block.first_inst = inst;
        block.last_inst  = inst;
    }

    block.inst_count += 1;
}

proc licm_operand_is_invariant(op: IROperand, defined_in_loop: BitSet*, invariant_vregs: BitSet*, vreg_cap: u64) -> bool {
    switch (op.kind) {
        case IROperandKind.IR_OP_CONST,
             IROperandKind.IR_OP_GLOBAL,
             IROperandKind.IR_OP_STR,
             IROperandKind.IR_OP_NONE: {
            return true;
        }

        case IROperandKind.IR_OP_VREG: {
            var id: u64 = cast(u64, op.vreg_id);

            if (id >= vreg_cap) {
                return false;
            }

            if (!defined_in_loop.test(id)) {
                return true;
            }

            return invariant_vregs.test(id);
        }

        default: {
            return false;
        }
    }
}

proc licm_candidate_vreg(inst: IRInst*, vreg_cap: u64) -> (u64, bool) {
    if (inst.opcode == IROpcode.IR_NOP || inst.opcode == IROpcode.IR_PHI || !licm_is_candidate(inst.opcode)) {
        return (0, false);
    }

    if (licm_inst_dst_is_read(inst.opcode) || inst.dst.kind != IROperandKind.IR_OP_VREG) {
        return (0, false);
    }

    var id: u64 = cast(u64, inst.dst.vreg_id);

    if (id >= vreg_cap) {
        return (0, false);
    }

    return (id, true);
}

proc licm_has_safe_divisor(inst: IRInst*) -> bool {
    if (inst.opcode != IROpcode.IR_DIV && inst.opcode != IROpcode.IR_MOD) {
        return true;
    }

    return inst.src2.kind == IROperandKind.IR_OP_CONST && inst.src2.int_val != 0;
}

proc licm_is_hoist_source(loop: NaturalLoop*, node: LICMBlock*) -> bool {
    if (!loop.contains(node)) {
        return false;
    }

    for (var i: u64 = 0; i < loop.latches.len; i += 1) {
        if (!node.dominates(loop.latches.data[i])) {
            return false;
        }
    }

    return true;
}

proc licm_mark_defined_vregs(ctx: LICMContext*, loop: NaturalLoop*, defined_in_loop: BitSet*) -> void {
    for (var i: u64 = 0; i < ctx.rpo_count; i += 1) {
        var node: LICMBlock* = ctx.rpo_blocks[i];

        if (!loop.contains(node)) {
            continue;
        }

        var inst: IRInst* = node.block.first_inst;

        while (inst != null) {
            if (inst.opcode != IROpcode.IR_NOP && !licm_inst_dst_is_read(inst.opcode)) {
                if (inst.dst.kind == IROperandKind.IR_OP_VREG) {
                    var id: u64 = cast(u64, inst.dst.vreg_id);

                    if (id < ctx.vreg_cap) {
                        defined_in_loop.set(id);
                    }
                }
            }

            inst = inst.next;
        }
    }
}

proc licm_mark_invariant_vregs(ctx: LICMContext*, loop: NaturalLoop*, defined_in_loop: BitSet*, invariant_vregs: BitSet*) -> void {
    var changed: bool = true;

    while (changed) {
        changed = false;

        for (var i: u64 = 0; i < ctx.rpo_count; i += 1) {
            var node: LICMBlock* = ctx.rpo_blocks[i];

            if (!licm_is_hoist_source(loop, node)) {
                continue;
            }

            var inst: IRInst* = node.block.first_inst;

            while (inst != null) {
                var (dst_vreg, is_candidate) = licm_candidate_vreg(inst, ctx.vreg_cap);

                if (is_candidate && !invariant_vregs.test(dst_vreg) && licm_has_safe_divisor(inst)) {
                    var src1_invariant: bool = licm_operand_is_invariant(inst.src1, defined_in_loop, invariant_vregs, ctx.vreg_cap);
                    var src2_invariant: bool = licm_operand_is_invariant(inst.src2, defined_in_loop, invariant_vregs, ctx.vreg_cap);

                    if (src1_invariant && src2_invariant) {
                        invariant_vregs.set(dst_vreg);
                        changed = true;
                    }
                }

                inst = inst.next;
            }
        }
    }
}

proc licm_hoist_invariant_insts(ctx: LICMContext*, loop: NaturalLoop*, invariant_vregs: BitSet*) -> void {
    var preheader: IRBlock* = loop.preheader.block;

    for (var i: u64 = 0; i < ctx.rpo_count; i += 1) {
        var node: LICMBlock* = ctx.rpo_blocks[i];

        if (!licm_is_hoist_source(loop, node)) {
            continue;
        }

        var inst: IRInst* = node.block.first_inst;

        while (inst != null) {
            var (dst_vreg, is_candidate) = licm_candidate_vreg(inst, ctx.vreg_cap);

            if (is_candidate && invariant_vregs.test(dst_vreg)) {
                var hoisted: IRInst* = alloc_type[IRInst](ctx.arena);

                *hoisted = *inst;
                hoisted.next = null;

                licm_insert_before_terminator(preheader, hoisted);

                inst.opcode = IROpcode.IR_NOP;
            }

            inst = inst.next;
        }
    }
}

proc licm_optimize_loop(ctx: LICMContext*, loop: NaturalLoop*) -> void {
    if (loop.preheader == null) {
        return;
    }

    var defined_in_loop: BitSet = bitset_create(ctx.arena, ctx.vreg_cap);
    var invariant_vregs: BitSet = bitset_create(ctx.arena, ctx.vreg_cap);

    licm_mark_defined_vregs(ctx, loop, &defined_in_loop);
    licm_mark_invariant_vregs(ctx, loop, &defined_in_loop, &invariant_vregs);
    licm_hoist_invariant_insts(ctx, loop, &invariant_vregs);
}

proc licm_run_on_function(a: Arena*, func: IRFunction*) -> void {
    if (a == null || func == null || func.first_block == null || func.first_block == func.last_block) {
        return;
    }

    var ctx: LICMContext;
    ctx.init(a, func, cast(u64, func.next_vreg_id) + LICM_VREG_HEADROOM);

    licm_build_cfg(&ctx);
    licm_build_dominators(&ctx);
    licm_find_natural_loops(&ctx);

    var loop: NaturalLoop* = ctx.loops;

    while (loop != null) {
        licm_create_preheader(&ctx, loop);
        loop = loop.next;
    }

    loop = ctx.loops;

    while (loop != null) {
        licm_optimize_loop(&ctx, loop);
        loop = loop.next;
    }

    ir_eliminate_nops(func);
}

proc licm_run_on_module(a: Arena*, module: IRModule*) -> void {
    if (a == null || module == null) {
        return;
    }

    var f: IRFunction* = module.first_func;

    while (f != null) {
        licm_run_on_function(a, f);
        f = f.next;
    }
}