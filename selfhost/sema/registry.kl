import "libc.kl";
import "arena.kl";
import "strview.kl";
import "vec.kl";
import "hash_map.kl";
import "type.kl";
import "ast.kl";
import "diag.kl";
import "sema/eval.kl";
import "sema/generic.kl";
import "sema/modules.kl";

proc subst_value_params_expr(a: Arena*, expr: AstExpr*, params: []TypeParamInfo, values: []i64) -> AstExpr* {
    if (expr == null) {
        return null;
    }

    if (expr.kind == AstExprKind.EXPR_VAR) {
        for (var i: u64 = 0; i < params.len; i += 1) {
            if (params[i].is_value && params[i].name.equals(expr.var_name)) {
                var lit: AstExpr* = ast_expr_int_lit(a, values[i], expr.loc);

                lit.expr_type = params[i].value_type;

                return lit;
            }
        }

        return expr;
    }

    if (expr.kind == AstExprKind.EXPR_UNARY) {
        var operand: AstExpr* = subst_value_params_expr(a, expr.unary_operand, params, values);

        if (operand != expr.unary_operand) {
            return ast_expr_unary(a, expr.unary_op, operand, expr.loc);
        }

        return expr;
    }

    if (expr.kind == AstExprKind.EXPR_BINARY) {
        var lhs: AstExpr* = subst_value_params_expr(a, expr.binary_lhs, params, values);
        var rhs: AstExpr* = subst_value_params_expr(a, expr.binary_rhs, params, values);

        if (lhs != expr.binary_lhs || rhs != expr.binary_rhs) {
            return ast_expr_binary(a, expr.binary_op, lhs, rhs, expr.loc);
        }

        return expr;
    }

    if (expr.kind == AstExprKind.EXPR_CAST) {
        var inner: AstExpr* = subst_value_params_expr(a, expr.cast_expr, params, values);

        if (inner != expr.cast_expr) {
            return ast_expr_cast(a, expr.cast_target_type, inner, expr.loc);
        }

        return expr;
    }

    return expr;
}

proc subst_value_params(a: Arena*, t: Type*, params: []TypeParamInfo, values: []i64) -> void {
    if (t == null || params.len == 0) {
        return;
    }

    switch (t.kind) {
        case TypeKind.TYPE_ARRAY: {
            subst_value_params(a, t.array_elem, params, values);

            if (t.size_expr != null) {
                var folded: AstExpr* = subst_value_params_expr(a, t.size_expr, params, values);

                var (val, ok) = eval_const_int(folded);

                if (ok && val >= 0) {
                    t.array_count = cast(u64, val);
                    t.size_expr   = null;
                    type_array_recompute_size(t);
                }
            }

            return;
        }

        case TypeKind.TYPE_PTR: {
            subst_value_params(a, t.base_type, params, values);
            return;
        }

        case TypeKind.TYPE_SLICE: {
            subst_value_params(a, t.slice_elem, params, values);
            return;
        }

        case TypeKind.TYPE_DISTINCT: {
            subst_value_params(a, t.base_type, params, values);
            return;
        }

        case TypeKind.TYPE_TUPLE: {
            for (var i: u64 = 0; i < t.tuple_count; i += 1) {
                subst_value_params(a, t.tuple_elements[i], params, values);
            }

            return;
        }

        case TypeKind.TYPE_FUNC: {
            subst_value_params(a, t.func_return_type, params, values);

            for (var i: u64 = 0; i < t.func_param_count; i += 1) {
                subst_value_params(a, t.func_param_types[i], params, values);
            }

            return;
        }

        case TypeKind.TYPE_STRUCT: {
            if (t.generic_arg_count == 0) {
                return;
            }

            var resolved_values: i64* = null;

            for (var i: u64 = 0; i < t.generic_arg_count; i += 1) {
                if (t.generic_arg_is_value != null && t.generic_arg_is_value[i]) {
                    if (t.generic_value_exprs != null && t.generic_value_exprs[i] != null) {
                        var folded: AstExpr* = subst_value_params_expr(a, t.generic_value_exprs[i], params, values);

                        var (val, ok) = eval_const_int(folded);

                        if (ok) {
                            if (resolved_values == null) {
                                resolved_values = alloc_array_zero[i64](a, t.generic_arg_count);
                            }

                            resolved_values[i] = val;
                        }
                    }

                    continue;
                }

                if (t.generic_args != null && t.generic_args[i] != null &&
                    t.generic_args[i].kind == TypeKind.TYPE_STRUCT && t.generic_args[i].generic_arg_count == 0) {
                    var (val, ok) = lookup_value_param(params, values, t.generic_args[i].name);

                    if (ok && t.generic_arg_is_value != null) {
                        t.generic_arg_is_value[i] = true;
                        t.generic_args[i]         = null;
                        t.generic_value_exprs[i]  = null;

                        if (resolved_values == null) {
                            resolved_values = alloc_array_zero[i64](a, t.generic_arg_count);
                        }

                        resolved_values[i] = val;

                        continue;
                    }
                }

                if (t.generic_args != null) {
                    subst_value_params(a, t.generic_args[i], params, values);
                }
            }

            if (resolved_values != null) {
                t.generic_values = resolved_values;
            }

            return;
        }

        default: {}
    }
}

struct StructEntry {
    name:         StrView,
    struct_type:  Type*,
    def:          AstStructDef*,
    is_resolving: bool,
    is_resolved:  bool
}

struct InterfaceEntry {
    name:       StrView,
    iface_type: Type*,
    def:        AstInterfaceDef*
}

struct UnionEntry {
    name:         StrView,
    union_type:   Type*,
    def:          AstUnionDef*,
    is_resolving: bool,
    is_resolved:  bool
}

struct EnumEntry {
    name:      StrView,
    enum_type: Type*,
    def:       AstEnumDef*
}

struct AliasEntry {
    name:         StrView,
    alias_type:   Type*,
    def:          AstTypeDef*,
    is_distinct:  bool,
    is_resolving: bool
}

struct GenericStructTemplate {
    name: StrView,
    def:  AstStructDef*,
    next: GenericStructTemplate*
}

struct GenericProcTemplate {
    name: StrView,
    def:  AstProc*,
    next: GenericProcTemplate*
}

struct StructInstanceCache {
    template_type:     Type*,
    args:              Type**,
    arg_count:         u64,
    instantiated_type: Type*,
    next:              StructInstanceCache*
}

struct ProcInstanceCache {
    def_template:      AstProc*,
    args:              Type**,
    arg_count:         u64,
    instantiated_proc: AstProc*,
    next:              ProcInstanceCache*
}

struct TypeRegistry {
    arena:            Arena*,

    structs:          HashMap[StrView, StructEntry*],
    unions:           HashMap[StrView, UnionEntry*],
    enums:            HashMap[StrView, EnumEntry*],
    aliases:          HashMap[StrView, AliasEntry*],
    interfaces:       HashMap[StrView, InterfaceEntry*],

    generic_structs:  HashMap[StrView, AstStructDef*],
    generic_procs:    HashMap[StrView, AstProc*],

    struct_instances: HashMap[StrView, Type*],
    proc_instances:   HashMap[StrView, AstProc*],

    modules:          ModuleTable*,
    resolve_module:   u32,
    had_error:        bool,

    proc init(self, a: Arena*) -> void {
        self.arena = a;

        self.structs.init(a, hash_str);
        self.unions.init(a, hash_str);
        self.enums.init(a, hash_str);
        self.aliases.init(a, hash_str);
        self.interfaces.init(a, hash_str);

        self.generic_structs.init(a, hash_str);
        self.generic_procs.init(a, hash_str);

        self.struct_instances.init(a, hash_str);
        self.proc_instances.init(a, hash_str);

        self.modules        = null;
        self.resolve_module = 0;
        self.had_error      = false;
    }

    proc split_qualified_name(self, name: StrView) -> (StrView, u32, bool) {
        if (self.modules == null) {
            return (name, 0, false);
        }

        var rest: StrView = name;
        var mod:  u32     = self.resolve_module;
        var qualified: bool = false;

        while (true) {
            var dot: i64 = rest.find_char('.');

            if (dot <= 0 || cast(u64, dot) + 1 >= rest.len) {
                break;
            }

            var seg: StrView = rest.subview(0, cast(u64, dot));

            var (next_mod, ok) = self.modules.resolve_alias_scoped(mod, seg, self.resolve_module);

            if (!ok) {
                break;
            }

            mod       = next_mod;
            qualified = true;
            rest      = rest.subview(cast(u64, dot) + 1, rest.len - cast(u64, dot) - 1);
        }

        if (!qualified) {
            return (name, 0, false);
        }

        return (rest, mod, true);
    }

    proc check_type_module(self, base: StrView, entry_module: u32, qualified: bool, required: u32, is_public: bool, kind: char*, loc: SourceLoc) -> bool {
        if (self.modules == null) {
            return true;
        }

        if (qualified) {
            if (!self.modules.exports(required, entry_module)) {
                self.had_error = true;

                diag_error(loc, "module '%.*s' has no %s '%.*s'",
                           cast(i32, self.modules.module_path(required).len), self.modules.module_path(required).data,
                           kind,
                           cast(i32, base.len), base.data);
                return false;
            }
        } else if (self.modules.is_hidden(self.resolve_module, entry_module)) {
            self.had_error = true;

            var path: StrView = self.modules.find_qualified_path(self.resolve_module, entry_module);

            if (path.len > 0) {
                diag_error(loc, "%s '%.*s' is only accessible via module path '%.*s'",
                           kind,
                           cast(i32, base.len), base.data,
                           cast(i32, path.len), path.data);
            } else {
                diag_error(loc, "%s '%.*s' is hidden behind a module alias import",
                           kind,
                           cast(i32, base.len), base.data);
            }

            return false;
        }

        if (entry_module != self.resolve_module && self.modules.is_strict(entry_module) && !is_public) {
            self.had_error = true;

            diag_error(loc, "%s '%.*s' is private to module '%.*s'",
                       kind,
                       cast(i32, base.len), base.data,
                       cast(i32, self.modules.module_path(entry_module).len), self.modules.module_path(entry_module).data);

            return false;
        }

        return true;
    }

    proc register_struct(self, name: StrView, struct_type: Type*, def: AstStructDef*) -> StructEntry* {
        var entry: StructEntry* = alloc_zero[StructEntry](self.arena);

        entry.name         = name;
        entry.struct_type  = struct_type;
        entry.def          = def;
        entry.is_resolving = false;
        entry.is_resolved  = false;

        self.structs.put(name, entry);

        return entry;
    }

    proc find_struct(self, name: StrView) -> StructEntry* {
        var (entry, found) = self.structs.get(name);

        if (found) {
            return entry;
        }

        return null;
    }

    proc register_interface(self, name: StrView, iface_type: Type*, def: AstInterfaceDef*) -> InterfaceEntry* {
        var entry: InterfaceEntry* = alloc_zero[InterfaceEntry](self.arena);

        entry.name       = name;
        entry.iface_type = iface_type;
        entry.def        = def;

        self.interfaces.put(name, entry);

        return entry;
    }

    proc find_interface(self, name: StrView) -> InterfaceEntry* {
        var (entry, found) = self.interfaces.get(name);

        if (found) {
            return entry;
        }

        return null;
    }

    proc register_union(self, name: StrView, union_type: Type*, def: AstUnionDef*) -> UnionEntry* {
        var entry: UnionEntry* = alloc_zero[UnionEntry](self.arena);

        entry.name         = name;
        entry.union_type   = union_type;
        entry.def          = def;
        entry.is_resolving = false;
        entry.is_resolved  = false;

        self.unions.put(name, entry);

        return entry;
    }

    proc find_union(self, name: StrView) -> UnionEntry* {
        var (entry, found) = self.unions.get(name);

        if (found) {
            return entry;
        }

        return null;
    }

    proc register_enum(self, name: StrView, enum_type: Type*, def: AstEnumDef*) -> EnumEntry* {
        var entry: EnumEntry* = alloc_zero[EnumEntry](self.arena);

        entry.name      = name;
        entry.enum_type = enum_type;
        entry.def       = def;

        self.enums.put(name, entry);

        return entry;
    }

    proc find_enum(self, name: StrView) -> EnumEntry* {
        var (entry, found) = self.enums.get(name);

        if (found) {
            return entry;
        }

        return null;
    }

    proc register_alias(self, name: StrView, alias_type: Type*, is_distinct: bool, def: AstTypeDef*) -> AliasEntry* {
        var entry: AliasEntry* = alloc_zero[AliasEntry](self.arena);

        entry.name         = name;
        entry.alias_type   = alias_type;
        entry.def          = def;
        entry.is_distinct  = is_distinct;
        entry.is_resolving = false;

        self.aliases.put(name, entry);

        return entry;
    }

    proc find_alias(self, name: StrView) -> AliasEntry* {
        var (entry, found) = self.aliases.get(name);

        if (found) {
            return entry;
        }

        return null;
    }

    proc register_generic_struct(self, name: StrView, def: AstStructDef*) -> void {
        self.generic_structs.put(name, def);
    }

    proc find_generic_struct(self, name: StrView) -> AstStructDef* {
        var (def, found) = self.generic_structs.get(name);

        if (found) {
            return def;
        }

        return null;
    }

    proc resolve_struct_with_defaults(self, a: Arena*, t: Type*, env: TypeSubstEnv*, proc_template: AstProc*) -> Type* {
        var (name_base, name_req, name_qual) = self.split_qualified_name(t.name);

        var s_def: AstStructDef* = self.find_generic_struct(name_base);

        if (s_def == null || s_def.generic_param_count == 0) {
            return null;
        }

        var n: u64 = s_def.generic_param_count;

        var dargs: []Type* = alloc_array_zero[Type*](a, n)[0..n];
        var dvals: []i64   = alloc_array_zero[i64](a, n)[0..n];

        for (var i: u64 = 0; i < n; i += 1) {
            var param: TypeParamInfo* = &s_def.generic_params[i];

            if (param.is_value) {
                if (!param.has_default || param.default_expr == null) {
                    return null;
                }

                var (val, ok) = eval_const_int(param.default_expr);

                if (!ok) {
                    return null;
                }

                dvals[i] = val;
            } else {
                if (!param.has_default) {
                    return null;
                }

                dargs[i] = self.resolve_type(a, param.default_type, env, proc_template);
            }
        }

        t.generic_args         = dargs.ptr;
        t.generic_arg_count    = n;
        t.generic_values       = dvals.ptr;
        t.generic_arg_is_value = null;

        return self.resolve_type(a, t, env, proc_template);
    }

    proc register_generic_proc(self, name: StrView, def: AstProc*) -> void {
        self.generic_procs.put(name, def);
    }

    proc find_generic_proc(self, name: StrView) -> AstProc* {
        var (def, found) = self.generic_procs.get(name);

        if (found) {
            return def;
        }

        return null;
    }

    proc find_struct_instance(self, mangled_name: StrView) -> Type* {
        var (t, found) = self.struct_instances.get(mangled_name);

        if (found) {
            return t;
        }

        return null;
    }

    proc cache_struct_instance(self, mangled_name: StrView, inst_type: Type*) -> void {
        self.struct_instances.put(mangled_name, inst_type);
    }

    proc find_proc_instance(self, mangled_name: StrView) -> AstProc* {
        var (p, found) = self.proc_instances.get(mangled_name);

        if (found) {
            return p;
        }

        return null;
    }

    proc cache_proc_instance(self, mangled_name: StrView, inst_proc: AstProc*) -> void {
        self.proc_instances.put(mangled_name, inst_proc);
    }

    proc all_structs(self, a: Arena*) -> Vec[StructEntry*] {
        return self.structs.values(a);
    }

    proc all_unions(self, a: Arena*) -> Vec[UnionEntry*] {
        return self.unions.values(a);
    }

    proc resolve_type(self, a: Arena*, t: Type*, env: TypeSubstEnv*, proc_template: AstProc*) -> Type* {
        if (t == null) {
            return null;
        }

        if (t.kind == TypeKind.TYPE_PARAM) {
            if (env != null) {
                return type_subst(a, t, env);
            }
            return t;
        }

        if (t.kind == TypeKind.TYPE_DISTINCT) {
            var res_base: Type* = self.resolve_type(a, t.base_type, env, proc_template);

            t.base_type = res_base;
            t.size      = res_base.size;
            t.align     = res_base.align;

            return t;
        }

        if (t.kind == TypeKind.TYPE_PTR) {
            var res_base: Type* = self.resolve_type(a, t.base_type, env, proc_template);

            if (res_base != t.base_type) {
                var res: Type* = type_ptr(a, res_base);
                res.is_const = t.is_const;

                return res;
            }

            return t;
        }

        if (t.kind == TypeKind.TYPE_ARRAY) {
            var res_elem: Type* = self.resolve_type(a, t.array_elem, env, proc_template);

            if (res_elem != t.array_elem) {
                var res: Type* = type_array_like(a, res_elem, t.array_count, t.is_flexible);
                res.is_const = t.is_const;

                return res;
            }

            return t;
        }

        if (t.kind == TypeKind.TYPE_SLICE) {
            var res_elem: Type* = self.resolve_type(a, t.slice_elem, env, proc_template);

            if (res_elem != t.slice_elem) {
                var res: Type* = type_slice(a, res_elem);
                res.is_const = t.is_const;

                return res;
            }

            return t;
        }

        if (t.kind == TypeKind.TYPE_TUPLE) {
            var res_elems: []Type* = alloc_array[Type*](a, t.tuple_count)[0..t.tuple_count];

            for (var i: u64 = 0; i < t.tuple_count; i += 1) {
                res_elems[i] = self.resolve_type(a, t.tuple_elements[i], env, proc_template);
            }

            var res: Type* = type_tuple(a, res_elems);
            res.is_const = t.is_const;

            return res;
        }

        if (t.kind == TypeKind.TYPE_STRUCT) {
            if (t.generic_arg_count > 0) {
                if (t.fields != null && t.generic_template != null) {
                    return t;
                }

                var (tmpl_base, tmpl_req, tmpl_qual) = self.split_qualified_name(t.name);
                var template_name: StrView = tmpl_base;

                if (t.generic_template != null) {
                    template_name = t.generic_template.name;
                }

                var s_def: AstStructDef* = self.find_generic_struct(template_name);

                if (s_def != null && !self.check_type_module(template_name, s_def.module_id, tmpl_qual, tmpl_req, s_def.is_public, "type", t.loc)) {
                    return type_primitive(TypeKind.TYPE_I64);
                }

                if (s_def == null) {
                    diag_error(t.loc, "unknown generic struct '%.*s'", cast(i32, template_name.len), template_name.data);
                    return type_primitive(TypeKind.TYPE_I64);
                }

                var n: u64 = s_def.generic_param_count;

                if (t.generic_arg_count > n) {
                    diag_error(t.loc, "generic struct '%.*s' expects %llu generic arguments, got %llu",
                               cast(i32, template_name.len), template_name.data, n, t.generic_arg_count);
                    return type_primitive(TypeKind.TYPE_I64);
                }

                var concrete_args:   []Type* = alloc_array_zero[Type*](a, n)[0..n];
                var concrete_values: []i64   = alloc_array_zero[i64](a, n)[0..n];

                for (var i: u64 = 0; i < t.generic_arg_count; i += 1) {
                    var param: TypeParamInfo* = &s_def.generic_params[i];

                    if (param.is_value) {
                        if (t.generic_values != null) {
                            concrete_values[i] = t.generic_values[i];
                        }

                        continue;
                    }

                    if (t.generic_arg_is_value != null && t.generic_arg_is_value[i]) {
                        diag_error(t.loc, "generic parameter '%.*s' of struct '%.*s' expects a type argument, but a value was provided",
                                   cast(i32, param.name.len), param.name.data,
                                   cast(i32, template_name.len), template_name.data);
                        return type_primitive(TypeKind.TYPE_I64);
                    }

                    concrete_args[i] = self.resolve_type(a, t.generic_args[i], env, proc_template);
                }

                for (var i: u64 = 0; i < n; i += 1) {
                    var param: TypeParamInfo* = &s_def.generic_params[i];

                    if (param.is_value) {
                        if (i >= t.generic_arg_count && param.has_default && param.default_expr != null) {
                            var (val, ok) = eval_const_int(param.default_expr);

                            if (ok) {
                                concrete_values[i] = val;
                            }
                        }

                        continue;
                    }

                    if (concrete_args[i] == null && param.has_default) {
                        concrete_args[i] = self.resolve_type(a, param.default_type, env, proc_template);
                    }

                    if (concrete_args[i] == null) {
                        diag_error(t.loc, "missing type for generic parameter '%.*s' of struct '%.*s'",
                                   cast(i32, param.name.len), param.name.data,
                                   cast(i32, template_name.len), template_name.data);
                        return type_primitive(TypeKind.TYPE_I64);
                    }
                }

                var mangled: StrView = mangle_generic_proc_name(a, template_name,
                                                                 s_def.generic_params[0..n],
                                                                 concrete_args, concrete_values);

                var cached: Type* = self.find_struct_instance(mangled);

                if (cached != null) {
                    return cached;
                }

                var inst_type: Type* = alloc_zero[Type](a);

                inst_type.kind              = TypeKind.TYPE_STRUCT;
                inst_type.name              = mangled;
                inst_type.generic_template  = s_def.def_type;
                inst_type.generic_arg_count = n;
                inst_type.generic_args      = concrete_args.ptr;
                inst_type.generic_values    = concrete_values.ptr;
                inst_type.size              = 8;
                inst_type.align             = 8;

                self.cache_struct_instance(mangled, inst_type);

                var inst_env: TypeSubstEnv = TypeSubstEnv {
                    depth:           0,
                    concrete_types:  concrete_args.ptr,
                    concrete_values: concrete_values.ptr,
                    count:           n,
                    parent:          null,
                    proc_template:   null
                };

                var inst_fields: []StructField = alloc_array[StructField](a, s_def.field_count)[0..s_def.field_count];

                var saved_module: u32 = self.resolve_module;
                self.resolve_module = s_def.module_id;

                for (var f: u64 = 0; f < s_def.field_count; f += 1) {
                    inst_fields[f].name                = s_def.fields[f].name;
                    inst_fields[f].default_value       = s_def.fields[f].default_value;
                    inst_fields[f].offset              = 0;
                    inst_fields[f].has_explicit_offset = s_def.fields[f].has_explicit_offset;
                    inst_fields[f].explicit_offset     = s_def.fields[f].explicit_offset;
                    inst_fields[f].is_private          = s_def.fields[f].is_private;

                    var substituted: Type* = type_subst(a, s_def.fields[f].field_type, &inst_env);
                    var field_type:  Type* = clone_type(a, substituted);

                    subst_value_params(a, field_type, s_def.generic_params[0..n], concrete_values);

                    inst_fields[f].field_type = self.resolve_type(a, field_type, &inst_env, null);
                }

                self.resolve_module = saved_module;

                type_struct_init(inst_type, mangled, inst_fields, s_def.is_packed);

                inst_type.module_id = s_def.module_id;

                return inst_type;
            }

            var cached_direct: Type* = self.find_struct_instance(t.name);

            if (cached_direct != null) {
                return cached_direct;
            }

            if (env != null && proc_template != null) {
                for (var i: u64 = 0; i < proc_template.generic_param_count; i += 1) {
                    if (!proc_template.generic_params[i].is_value &&
                        proc_template.generic_params[i].name.equals(t.name)) {
                        if (i < env.count) {
                            return env.concrete_types[i];
                        }
                    }
                }
            }

            var (name_base, name_req, name_qual) = self.split_qualified_name(t.name);

            var s_entry: StructEntry* = self.find_struct(name_base);

            if (s_entry != null) {
                if (s_entry.def != null && s_entry.struct_type != t &&
                    !self.check_type_module(name_base, s_entry.def.module_id, name_qual, name_req, s_entry.def.is_public, "type", t.loc)) {
                    return type_primitive(TypeKind.TYPE_I64);
                }

                return s_entry.struct_type;
            }

            var u_entry: UnionEntry* = self.find_union(name_base);

            if (u_entry != null) {
                if (u_entry.def != null && u_entry.union_type != t &&
                    !self.check_type_module(name_base, u_entry.def.module_id, name_qual, name_req, u_entry.def.is_public, "type", t.loc)) {
                    return type_primitive(TypeKind.TYPE_I64);
                }

                return u_entry.union_type;
            }

            var e_entry: EnumEntry* = self.find_enum(name_base);

            if (e_entry != null) {
                if (e_entry.def != null && e_entry.enum_type != t &&
                    !self.check_type_module(name_base, e_entry.def.module_id, name_qual, name_req, e_entry.def.is_public, "enum", t.loc)) {
                    return type_primitive(TypeKind.TYPE_I64);
                }

                return e_entry.enum_type;
            }

            var a_entry: AliasEntry* = self.find_alias(name_base);

            if (a_entry != null) {
                if (a_entry.def != null && a_entry.alias_type != t &&
                    !self.check_type_module(name_base, a_entry.def.module_id, name_qual, name_req, a_entry.def.is_public, "type", t.loc)) {
                    return type_primitive(TypeKind.TYPE_I64);
                }

                if (a_entry.is_resolving) {
                    diag_error(t.loc, "cyclic type alias definition '%.*s'", cast(i32, a_entry.name.len), a_entry.name.data);
                    return type_primitive(TypeKind.TYPE_I64);
                }

                if (a_entry.alias_type == null) {
                    return t;
                }

                a_entry.is_resolving = true;
                var resolved: Type* = self.resolve_type(a, a_entry.alias_type, env, proc_template);
                a_entry.is_resolving = false;

                if (a_entry.is_distinct) {
                    return type_distinct(a, a_entry.name, resolved);
                }

                return resolved;
            }

            var i_entry: InterfaceEntry* = self.find_interface(name_base);

            if (i_entry != null) {
                if (i_entry.def != null && i_entry.iface_type != t &&
                    !self.check_type_module(name_base, i_entry.def.module_id, name_qual, name_req, i_entry.def.is_public, "interface", t.loc)) {
                    return type_primitive(TypeKind.TYPE_I64);
                }

                return i_entry.iface_type;
            }

            if (t.fields != null && t.field_count > 0) {
                return t;
            }

            var defaulted: Type* = self.resolve_struct_with_defaults(a, t, env, proc_template);

            if (defaulted != null) {
                return defaulted;
            }

            diag_error(t.loc, "unknown type '%.*s'", cast(i32, t.name.len), t.name.data);
        }

        if (t.kind == TypeKind.TYPE_FUNC) {
            var res_ret: Type* = self.resolve_type(a, t.func_return_type, env, proc_template);
            var res_params: []Type* = alloc_array[Type*](a, t.func_param_count)[0..t.func_param_count];

            for (var i: u64 = 0; i < t.func_param_count; i += 1) {
                res_params[i] = self.resolve_type(a, t.func_param_types[i], env, proc_template);
            }

            return type_func(a, res_ret, res_params, t.func_is_variadic);
        }

        return t;
    }
}

proc registry_create(a: Arena*) -> TypeRegistry* {
    var r: TypeRegistry* = alloc_zero[TypeRegistry](a);

    r.init(a);

    return r;
}