import "libc.kl";
import "arena.kl";
import "strview.kl";
import "vec.kl";
import "sbuilder.kl";
import "lexer.kl";
import "type.kl";
import "ast.kl";
import "diag.kl";
import "sema/eval.kl";
import "sema/scope.kl";
import "sema/modules.kl";
import "sema/registry.kl";
import "sema/generic.kl";
import "sema/layout.kl";
import "sema/operator.kl";
import "ir/comptime.kl";
import "codegen/x86.kl";

proc type_is_byte_like(t: Type*) -> bool {
    if (t == null) {
        return false;
    }

    return t.kind == TypeKind.TYPE_CHAR || t.kind == TypeKind.TYPE_U8;
}

proc struct_is_derived_from(t: Type*, base: Type*) -> bool {
    var curr: Type* = t;

    while (curr != null && curr.kind == TypeKind.TYPE_STRUCT && !curr.is_interface) {
        if (curr == base) {
            return true;
        }

        curr = curr.parent_type;
    }

    return false;
}

proc one_stmt_slice(a: Arena*, s: AstStmt*) -> []AstStmt* {
    var stmts: []AstStmt* = alloc_array[AstStmt*](a, 1)[0..1];

    stmts[0] = s;

    return stmts;
}

proc expr_contains_kind(expr: AstExpr*, kind: AstExprKind) -> bool {
    if (expr == null) {
        return false;
    }

    if (expr.kind == kind) {
        return true;
    }

    switch (expr.kind) {
        case AstExprKind.EXPR_UNARY: {
            return expr_contains_kind(expr.unary_operand, kind);
        }

        case AstExprKind.EXPR_BINARY: {
            return expr_contains_kind(expr.binary_lhs, kind) || expr_contains_kind(expr.binary_rhs, kind);
        }

        case AstExprKind.EXPR_CALL: {
            if (expr_contains_kind(expr.call_callee_expr, kind)) {
                return true;
            }

            for (var i: u64 = 0; i < expr.call_arg_count; i += 1) {
                if (expr_contains_kind(expr.call_args[i], kind)) {
                    return true;
                }
            }

            for (var i: u64 = 0; i < expr.call_generic_arg_count; i += 1) {
                if (expr_contains_kind(expr.call_generic_args[i].value_expr, kind)) {
                    return true;
                }
            }

            return false;
        }

        case AstExprKind.EXPR_INDEX: {
            return expr_contains_kind(expr.index_ptr, kind) || expr_contains_kind(expr.index_index, kind);
        }

        case AstExprKind.EXPR_MEMBER: {
            return expr_contains_kind(expr.member_target, kind);
        }

        case AstExprKind.EXPR_CAST: {
            return expr_contains_kind(expr.cast_expr, kind);
        }

        case AstExprKind.EXPR_IF: {
            return expr_contains_kind(expr.if_cond, kind) || expr_contains_kind(expr.if_then_expr, kind) || expr_contains_kind(expr.if_else_expr, kind);
        }

        case AstExprKind.EXPR_TUPLE: {
            for (var i: u64 = 0; i < expr.tuple_count; i += 1) {
                if (expr_contains_kind(expr.tuple_elements[i], kind)) {
                    return true;
                }
            }

            return false;
        }

        case AstExprKind.EXPR_STRUCT_LIT: {
            for (var i: u64 = 0; i < expr.struct_lit_field_count; i += 1) {
                if (expr_contains_kind(expr.struct_lit_field_values[i], kind)) {
                    return true;
                }
            }

            return false;
        }

        case AstExprKind.EXPR_ARRAY_LIT: {
            for (var i: u64 = 0; i < expr.array_count; i += 1) {
                if (expr_contains_kind(expr.array_elements[i], kind)) {
                    return true;
                }
            }

            return false;
        }

        case AstExprKind.EXPR_SLICE: {
            return expr_contains_kind(expr.slice_target, kind) || expr_contains_kind(expr.slice_start, kind) || expr_contains_kind(expr.slice_end, kind);
        }

        case AstExprKind.EXPR_ALLOCA: {
            return expr_contains_kind(expr.alloca_count_expr, kind);
        }

        case AstExprKind.EXPR_SIZEOF, AstExprKind.EXPR_ALIGNOF: {
            return expr_contains_kind(expr.size_align_expr, kind);
        }

        case AstExprKind.EXPR_VA_ARG: {
            return expr_contains_kind(expr.va_valist_expr, kind);
        }

        case AstExprKind.EXPR_ASM: {
            for (var i: u64 = 0; i < expr.asm_input_count; i += 1) {
                if (expr_contains_kind(expr.asm_inputs[i].expr, kind)) {
                    return true;
                }
            }

            for (var i: u64 = 0; i < expr.asm_output_count; i += 1) {
                if (expr_contains_kind(expr.asm_outputs[i].expr, kind)) {
                    return true;
                }
            }

            return false;
        }

        default: {
            return false;
        }
    }
}

proc expr_contains_comptime(expr: AstExpr*) -> bool {
    return expr_contains_kind(expr, AstExprKind.EXPR_COMPTIME_BLOCK);
}

proc expr_contains_call(expr: AstExpr*) -> bool {
    return expr_contains_kind(expr, AstExprKind.EXPR_CALL);
}

proc expr_contains_struct_lit(expr: AstExpr*) -> bool {
    return expr_contains_kind(expr, AstExprKind.EXPR_STRUCT_LIT);
}

proc expr_references_name(expr: AstExpr*, name: StrView) -> bool {
    if (expr == null) {
        return false;
    }

    if (expr.kind == AstExprKind.EXPR_VAR && expr.var_name.equals(name)) {
        return true;
    }

    switch (expr.kind) {
        case AstExprKind.EXPR_UNARY: {
            return expr_references_name(expr.unary_operand, name);
        }

        case AstExprKind.EXPR_BINARY: {
            return expr_references_name(expr.binary_lhs, name) || expr_references_name(expr.binary_rhs, name);
        }

        case AstExprKind.EXPR_CALL: {
            if (expr_references_name(expr.call_callee_expr, name)) {
                return true;
            }

            for (var i: u64 = 0; i < expr.call_arg_count; i += 1) {
                if (expr_references_name(expr.call_args[i], name)) {
                    return true;
                }
            }

            return false;
        }

        case AstExprKind.EXPR_INDEX: {
            return expr_references_name(expr.index_ptr, name) || expr_references_name(expr.index_index, name);
        }

        case AstExprKind.EXPR_MEMBER: {
            return expr_references_name(expr.member_target, name);
        }

        case AstExprKind.EXPR_CAST: {
            return expr_references_name(expr.cast_expr, name);
        }

        case AstExprKind.EXPR_IF: {
            return expr_references_name(expr.if_cond, name) || expr_references_name(expr.if_then_expr, name) || expr_references_name(expr.if_else_expr, name);
        }

        case AstExprKind.EXPR_TUPLE: {
            for (var i: u64 = 0; i < expr.tuple_count; i += 1) {
                if (expr_references_name(expr.tuple_elements[i], name)) {
                    return true;
                }
            }

            return false;
        }

        case AstExprKind.EXPR_STRUCT_LIT: {
            for (var i: u64 = 0; i < expr.struct_lit_field_count; i += 1) {
                if (expr_references_name(expr.struct_lit_field_values[i], name)) {
                    return true;
                }
            }

            return false;
        }

        case AstExprKind.EXPR_ARRAY_LIT: {
            for (var i: u64 = 0; i < expr.array_count; i += 1) {
                if (expr_references_name(expr.array_elements[i], name)) {
                    return true;
                }
            }

            return false;
        }

        case AstExprKind.EXPR_SLICE: {
            return expr_references_name(expr.slice_target, name) || expr_references_name(expr.slice_start, name) || expr_references_name(expr.slice_end, name);
        }

        case AstExprKind.EXPR_ALLOCA: {
            return expr_references_name(expr.alloca_count_expr, name);
        }

        case AstExprKind.EXPR_SIZEOF, AstExprKind.EXPR_ALIGNOF: {
            return expr_references_name(expr.size_align_expr, name);
        }

        case AstExprKind.EXPR_VA_ARG: {
            return expr_references_name(expr.va_valist_expr, name);
        }

        case AstExprKind.EXPR_ASM: {
            for (var i: u64 = 0; i < expr.asm_input_count; i += 1) {
                if (expr_references_name(expr.asm_inputs[i].expr, name)) {
                    return true;
                }
            }

            for (var i: u64 = 0; i < expr.asm_output_count; i += 1) {
                if (expr_references_name(expr.asm_outputs[i].expr, name)) {
                    return true;
                }
            }

            return false;
        }

        default: {
            return false;
        }
    }
}

proc reflection_builtin_kind(name: StrView) -> ReflectKind {
    if (name.equals_cstr("typeName")) {
        return ReflectKind.REFLECT_TYPE_NAME;
    }

    if (name.equals_cstr("typeInfo")) {
        return ReflectKind.REFLECT_TYPE_INFO;
    }

    if (name.equals_cstr("hasField") || name.equals_cstr("hasDecl")) {
        return ReflectKind.REFLECT_HAS_MEMBER;
    }

    if (name.equals_cstr("compileError") || name.equals_cstr("panic")) {
        return ReflectKind.REFLECT_DIAG;
    }

    return ReflectKind.REFLECT_NONE;
}

proc comptime_expr_foldable(expr: AstExpr*) -> bool {
    if (expr == null) {
        return false;
    }

    if (expr.kind == AstExprKind.EXPR_CALL) {
        var sym: Symbol* = expr.call_callee_sym;

        if (sym == null || sym.proc_decl == null || sym.proc_decl.attrs.is_extern || sym.proc_decl.body == null) {
            return false;
        }

        for (var i: u64 = 0; i < expr.call_arg_count; i += 1) {
            if (!comptime_expr_foldable(expr.call_args[i])) {
                return false;
            }
        }

        return true;
    }

    var (ev, ok) = eval_expr(expr);

    if (ok) {
        return true;
    }

    switch (expr.kind) {
        case AstExprKind.EXPR_REFLECT: {
            return true;
        }

        case AstExprKind.EXPR_UNARY: {
            return comptime_expr_foldable(expr.unary_operand);
        }

        case AstExprKind.EXPR_BINARY: {
            return comptime_expr_foldable(expr.binary_lhs) && comptime_expr_foldable(expr.binary_rhs);
        }

        case AstExprKind.EXPR_CAST: {
            return comptime_expr_foldable(expr.cast_expr);
        }

        case AstExprKind.EXPR_INDEX: {
            return comptime_expr_foldable(expr.index_ptr) && comptime_expr_foldable(expr.index_index);
        }

        case AstExprKind.EXPR_MEMBER: {
            return comptime_expr_foldable(expr.member_target);
        }

        case AstExprKind.EXPR_VAR: {
            return expr.var_symbol != null &&
                   expr.var_symbol.kind == SymbolKind.SYM_CONST &&
                   expr.var_symbol.const_kind == ConstKind.CONST_COMPTIME;
        }

        case AstExprKind.EXPR_IF: {
            return comptime_expr_foldable(expr.if_cond) && comptime_expr_foldable(expr.if_then_expr) && comptime_expr_foldable(expr.if_else_expr);
        }

        case AstExprKind.EXPR_TUPLE: {
            for (var i: u64 = 0; i < expr.tuple_count; i += 1) {
                if (!comptime_expr_foldable(expr.tuple_elements[i])) {
                    return false;
                }
            }

            return true;
        }

        case AstExprKind.EXPR_STRUCT_LIT: {
            for (var i: u64 = 0; i < expr.struct_lit_field_count; i += 1) {
                if (!comptime_expr_foldable(expr.struct_lit_field_values[i])) {
                    return false;
                }
            }

            return true;
        }

        case AstExprKind.EXPR_ARRAY_LIT: {
            for (var i: u64 = 0; i < expr.array_count; i += 1) {
                if (!comptime_expr_foldable(expr.array_elements[i])) {
                    return false;
                }
            }

            return true;
        }

        case AstExprKind.EXPR_SLICE: {
            return comptime_expr_foldable(expr.slice_target) && comptime_expr_foldable(expr.slice_start) && comptime_expr_foldable(expr.slice_end);
        }

        default: {
            return false;
        }
    }
}

proc pointer_const_compatible(expected: Type*, actual: Type*) -> bool {
    var e: Type* = expected;
    var a: Type* = actual;

    while (e != null && a != null && e.is_pointer() && a.is_pointer()) {
        if (!e.base_type.is_const && a.base_type.is_const) {
            return false;
        }

        e = e.base_type;
        a = a.base_type;
    }

    return true;
}

proc types_are_compatible(expected: Type*, actual: Type*) -> bool {
    if (expected == null || actual == null) {
        return false;
    }

    if (expected.is_pointer() && actual.is_pointer() && !pointer_const_compatible(expected, actual)) {
        return false;
    }

    if (expected.equals(actual)) {
        return true;
    }

    if (expected.kind == TypeKind.TYPE_NULL) {
        return actual.is_pointer() || actual.kind == TypeKind.TYPE_FUNC || actual.kind == TypeKind.TYPE_NULL;
    }

    if (actual.kind == TypeKind.TYPE_NULL) {
        return expected.is_pointer() || expected.kind == TypeKind.TYPE_FUNC || expected.kind == TypeKind.TYPE_NULL;
    }

    if (expected.kind == TypeKind.TYPE_DISTINCT || actual.kind == TypeKind.TYPE_DISTINCT) {
        return false;
    }

    if (expected.kind == TypeKind.TYPE_UNION || actual.kind == TypeKind.TYPE_UNION) {
        return false;
    }

    if (expected.is_integer() && actual.is_integer()) {
        return true;
    }

    if (expected.is_float() && actual.is_float()) {
        return true;
    }

    if (expected.is_pointer() && actual.is_pointer()) {
        if (expected.base_type.kind == TypeKind.TYPE_VOID || actual.base_type.kind == TypeKind.TYPE_VOID) {
            return true;
        }

        if (type_is_byte_like(expected.base_type) && type_is_byte_like(actual.base_type)) {
            return true;
        }

        if (struct_is_derived_from(actual.base_type, expected.base_type)) {
            return true;
        }

        return expected.base_type.equals(actual.base_type);
    }

    if (expected.kind == TypeKind.TYPE_FUNC && actual.is_pointer() && actual.base_type.kind == TypeKind.TYPE_VOID) {
        return true;
    }

    if (actual.kind == TypeKind.TYPE_FUNC && expected.is_pointer() && expected.base_type.kind == TypeKind.TYPE_VOID) {
        return true;
    }

    if (expected.is_pointer() && actual.kind == TypeKind.TYPE_STRUCT) {
        if (expected.base_type.equals(actual)) {
            return true;
        }

        return struct_is_derived_from(actual, expected.base_type);
    }

    if (expected.is_slice() && actual.is_slice()) {
        if (expected.slice_elem.kind == TypeKind.TYPE_VOID || actual.slice_elem.kind == TypeKind.TYPE_VOID) {
            return true;
        }

        if (type_is_byte_like(expected.slice_elem) && type_is_byte_like(actual.slice_elem)) {
            return true;
        }

        return expected.slice_elem.equals(actual.slice_elem);
    }

    if (expected.is_slice() && actual.kind == TypeKind.TYPE_ARRAY) {
        if (type_is_byte_like(expected.slice_elem) && type_is_byte_like(actual.array_elem)) {
            return true;
        }

        return expected.slice_elem.equals(actual.array_elem);
    }

    if (expected.is_slice() && type_is_byte_like(expected.slice_elem) && actual.is_pointer() && type_is_byte_like(actual.base_type)) {
        return true;
    }

    if (expected.is_tuple() && actual.is_tuple()) {
        if (expected.tuple_count != actual.tuple_count) {
            return false;
        }

        for (var i: u64 = 0; i < expected.tuple_count; i += 1) {
            if (!types_are_compatible(expected.tuple_elements[i], actual.tuple_elements[i])) {
                return false;
            }
        }

        return true;
    }

    if (expected.kind == TypeKind.TYPE_BOOL && (actual.is_integer() || actual.is_pointer() || actual.kind == TypeKind.TYPE_FUNC || actual.kind == TypeKind.TYPE_NULL)) {
        return true;
    }

    if (actual.kind == TypeKind.TYPE_BOOL && (expected.is_integer() || expected.kind == TypeKind.TYPE_FUNC)) {
        return true;
    }

    return false;
}

proc expr_is_lvalue(expr: AstExpr*) -> bool {
    if (expr == null) {
        return false;
    }

    switch (expr.kind) {
        case AstExprKind.EXPR_VAR: {
            return expr.var_symbol != null && expr.var_symbol.kind != SymbolKind.SYM_CONST;
        }

        case AstExprKind.EXPR_UNARY: {
            return expr.unary_op == TokenKind.TOK_STAR;
        }

        case AstExprKind.EXPR_INDEX, AstExprKind.EXPR_MEMBER: {
            return true;
        }

        default: {
            return false;
        }
    }
}

proc expr_is_const_lvalue(expr: AstExpr*) -> bool {
    if (expr == null) {
        return false;
    }

    switch (expr.kind) {
        case AstExprKind.EXPR_VAR: {
            var sym: Symbol* = expr.var_symbol;

            if (sym == null) {
                return false;
            }

            return sym.is_const || (sym.symbol_type != null && sym.symbol_type.is_const);
        }

        case AstExprKind.EXPR_UNARY: {
            if (expr.unary_op != TokenKind.TOK_STAR) {
                return false;
            }

            var op_t: Type* = expr.unary_operand.expr_type;

            return op_t != null && op_t.is_pointer() && op_t.base_type != null && op_t.base_type.is_const;
        }

        case AstExprKind.EXPR_MEMBER: {
            if (expr.member_field != null && expr.member_field.field_type != null && expr.member_field.field_type.is_const) {
                return true;
            }

            var tgt: AstExpr* = expr.member_target;

            if (tgt == null) {
                return false;
            }

            var tgt_t: Type* = tgt.expr_type;

            if (tgt_t != null && tgt_t.is_pointer()) {
                return tgt_t.base_type != null && tgt_t.base_type.is_const;
            }

            return expr_is_const_lvalue(tgt);
        }

        case AstExprKind.EXPR_INDEX: {
            var elem_t: Type* = expr.expr_type;

            if (elem_t != null && elem_t.is_const) {
                return true;
            }

            var ptr_t: Type* = expr.index_ptr.expr_type;

            if (ptr_t != null && (ptr_t.kind == TypeKind.TYPE_ARRAY || ptr_t.kind == TypeKind.TYPE_SLICE)) {
                return expr_is_const_lvalue(expr.index_ptr);
            }

            return false;
        }

        default: {
            return false;
        }
    }
}

@inline proc symbol_is_method(sym: Symbol*) -> bool {
    return sym.proc_decl != null && sym.proc_decl.method_struct.len > 0;
}

struct IfaceBoxReq {
    concrete:    Type*,
    idef:        AstInterfaceDef*,
    vtable_name: StrView
}

struct ComptimeFieldBinding {
    field:  StructField*,
    object: ComptimeObject*,
    next:   ComptimeFieldBinding*
}

struct ComptimeObject {
    concrete: Type*,
    fields:   ComptimeFieldBinding*
}

struct ComptimeIfaceBinding {
    sym:    Symbol*,
    object: ComptimeObject*,
    next:   ComptimeIfaceBinding*
}

proc find_virtual_slot(slots: VirtualSlot*, count: u64, name: StrView) -> i64 {
    for (var i: u64 = 0; i < count; i += 1) {
        if (slots[i].method_name.equals(name)) {
            return cast(i64, i);
        }
    }

    return -1;
}

struct Sema {
    arena:             Arena*,
    global_scope:      Scope*,
    current_scope:     Scope*,
    registry:          TypeRegistry,

    modules:           ModuleTable,
    top_level:         HashMap[StrView, Symbol*],
    all_symbols:       Vec[Symbol*],
    current_module:    u32,

    poly_types:        Vec[AstStructDef*],
    iface_boxes:       Vec[IfaceBoxReq],
    conformance:       HashMap[StrView, StrView],
    conform_failed:    HashMap[StrView, bool],

    current_subst_env: TypeSubstEnv*,
    current_program:   AstProgram*,
    current_proc:      AstProc*,

    loop_depth:        u32,
    switch_depth:      u32,
    had_error:         bool,

    comptime_depth:    u32,

    comptime_counter:  u64,
    comptime_consts:   Vec[AstConstDef*],
    deferred_consts:   Vec[AstConstDef*],
    current_const:     AstConstDef*,
    type_eval_depth:   u32,
    comptime_bindings: ComptimeIfaceBinding*,
    next_code_id:      u64,

    proc init(self, a: Arena*) -> void {
        self.arena             = a;
        self.global_scope      = scope_create(a, null);
        self.current_scope     = self.global_scope;

        self.registry.init(a);

        self.top_level.init(a, hash_str);
        self.all_symbols.init(a);
        self.current_module    = 0;

        self.poly_types.init(a);
        self.iface_boxes.init(a);
        self.conformance.init(a, hash_str);
        self.conform_failed.init(a, hash_str);

        self.current_subst_env = null;
        self.current_program   = null;
        self.current_proc      = null;

        self.loop_depth        = 0;
        self.switch_depth      = 0;
        self.had_error         = false;

        self.comptime_depth    = 0;

        self.comptime_counter  = 0;
        self.comptime_consts.init(a);
        self.deferred_consts.init(a);
        self.current_const     = null;
        self.type_eval_depth   = 0;
        self.comptime_bindings = null;
        self.next_code_id      = 0;

        var dummy_loc: SourceLoc = SourceLoc {
            filename:   null,
            line_start: null,
            line:       0,
            col:        0,
            len:        0
        };

        var (sym_true, t_ok) = self.global_scope.define(
            a,
            SymbolKind.SYM_CONST,
            strview_from_cstr("true"),
            type_primitive(TypeKind.TYPE_BOOL),
            dummy_loc
        );
        sym_true.const_val = 1;

        var (sym_false, f_ok) = self.global_scope.define(
            a,
            SymbolKind.SYM_CONST,
            strview_from_cstr("false"),
            type_primitive(TypeKind.TYPE_BOOL),
            dummy_loc
        );
        sym_false.const_val = 0;

        self.registry.register_alias(
            strview_from_cstr("VaList"),
            type_primitive(TypeKind.TYPE_VALIST),
            false,
            null
        );

        self.global_scope.define(
            a,
            SymbolKind.SYM_TYPE_ALIAS,
            strview_from_cstr("VaList"),
            type_primitive(TypeKind.TYPE_VALIST),
            dummy_loc
        );
    }

    proc scope_push(self) -> void {
        self.current_scope = self.current_scope.push(self.arena);
    }

    proc scope_pop(self) -> void {
        if (self.current_scope.parent != null) {
            self.current_scope = self.current_scope.pop();
        }
    }

    proc define_symbol(self, kind: SymbolKind, name: StrView, sym_type: Type*, loc: SourceLoc) -> Symbol* {
        var (sym, ok) = self.current_scope.define(self.arena, kind, name, sym_type, loc);

        if (!ok) {
            self.had_error = true;
            diag_error(loc, "redefinition of identifier '%.*s'", cast(i32, name.len), name.data);
        }

        return sym;
    }

    proc set_module_context(self, mod: u32) -> void {
        self.current_module          = mod;
        self.registry.resolve_module = mod;
    }

    proc lookup_raw(self, name: StrView) -> Symbol* {
        var (head, found) = self.top_level.get(name);

        if (!found) {
            return null;
        }

        return head;
    }

    proc visibility_tier(self, mod: u32) -> i32 {
        if (mod == self.current_module) {
            return 0;
        }

        if (self.modules.is_direct_plain(self.current_module, mod)) {
            return 1;
        }

        return 2;
    }

    proc lookup_visible(self, name: StrView) -> Symbol* {
        var local: Symbol* = self.current_scope.lookup(name);

        if (local != null) {
            return local;
        }

        var head: Symbol* = self.lookup_raw(name);

        if (head == null) {
            return null;
        }

        var best:       Symbol* = null;
        var best_other: Symbol* = null;
        var best_tier:  i32     = 2147483647;
        var all_extern: bool    = true;

        var s: Symbol* = head;

        while (s != null) {
            var usable: bool = symbol_is_method(s) ||
                               (!self.modules.is_hidden(self.current_module, s.module_id) &&
                                (s.module_id == self.current_module || !self.modules.is_strict(s.module_id) || s.attrs.is_public));

            if (usable) {
                var tier: i32 = self.visibility_tier(s.module_id);

                if (tier < best_tier) {
                    best_tier  = tier;
                    best_other = best;
                    best       = s;
                } else if (tier == best_tier) {
                    if (best_other == null) {
                        best_other = s;
                    }
                }

                if (!s.is_extern) {
                    all_extern = false;
                }
            }

            s = s.next_homonym;
        }

        if (best != null && best_other != null && !all_extern) {
            self.had_error = true;
            diag_error(best.loc, "reference to '%.*s' is ambiguous: also declared in module '%.*s'",
                       cast(i32, name.len), name.data,
                       cast(i32, self.modules.module_path(best_other.module_id).len),
                       self.modules.module_path(best_other.module_id).data);
        }

        return best;
    }

    proc lookup_method(self, mangled: StrView, struct_module: u32) -> Symbol* {
        var s: Symbol* = self.lookup_raw(mangled);

        while (s != null) {
            if (s.module_id == struct_module) {
                return s;
            }

            s = s.next_homonym;
        }

        return null;
    }

    proc find_in_module(self, name: StrView, mod: u32) -> Symbol* {
        var s: Symbol* = self.lookup_raw(name);

        while (s != null) {
            if (s.module_id == mod &&
                (s.module_id == self.current_module || !self.modules.is_strict(s.module_id) || s.attrs.is_public)) {
                return s;
            }

            s = s.next_homonym;
        }

        var best:       Symbol* = null;
        var best_other: Symbol* = null;
        var all_extern: bool    = true;

        s = self.lookup_raw(name);

        while (s != null) {
            var accessible: bool = self.modules.exports(mod, s.module_id) &&
                                   (s.module_id == self.current_module || !self.modules.is_strict(s.module_id) || s.attrs.is_public);

            if (accessible) {
                if (best == null) {
                    best = s;
                } else if (best_other == null && best.module_id != s.module_id) {
                    best_other = s;
                }

                if (!s.is_extern) {
                    all_extern = false;
                }
            }

            s = s.next_homonym;
        }

        if (best != null && best_other != null && !all_extern) {
            self.had_error = true;

            diag_error(best.loc, "reference to '%.*s' via module '%.*s' is ambiguous: also exported from module '%.*s'",
                       cast(i32, name.len), name.data,
                       cast(i32, self.modules.module_path(mod).len), self.modules.module_path(mod).data,
                       cast(i32, self.modules.module_path(best_other.module_id).len),
                       self.modules.module_path(best_other.module_id).data);
        }

        return best;
    }

    proc resolve_module_path(self, expr: AstExpr*) -> (u32, bool) {
        if (expr.kind == AstExprKind.EXPR_VAR) {
            if (expr.var_symbol != null) {
                return (0, false);
            }

            if (self.current_scope.lookup(expr.var_name) != null) {
                return (0, false);
            }

            return self.modules.resolve_alias_scoped(self.current_module, expr.var_name, self.current_module);
        }

        if (expr.kind == AstExprKind.EXPR_MEMBER && expr.member_target != null) {
            var (mod, ok) = self.resolve_module_path(expr.member_target);

            if (!ok) {
                return (0, false);
            }

            return self.modules.resolve_alias_scoped(mod, expr.member_field_name, self.current_module);
        }

        return (0, false);
    }

    proc namespace_path_str(self, expr: AstExpr*) -> StrView {
        if (expr.kind == AstExprKind.EXPR_VAR) {
            return expr.var_name;
        }

        var prefix: StrView = self.namespace_path_str(expr.member_target);
        var sb: StringBuilder = sbuilder_create(self.arena);

        sb.append_str(prefix);
        sb.append_char('.');
        sb.append_str(expr.member_field_name);

        return sb.to_str();
    }

    proc define_top_level(self, kind: SymbolKind, name: StrView, sym_type: Type*, loc: SourceLoc, mod: u32, is_extern: bool, display_name: StrView) -> (Symbol*, bool) {
        var head: Symbol* = self.lookup_raw(name);
        var s:      Symbol* = head;

        while (s != null) {
            if (s.module_id == mod) {
                var disp: StrView = name;

                if (display_name.len > 0) {
                    disp = display_name;
                }

                self.had_error = true;
                diag_error(loc, "redefinition of identifier '%.*s'", cast(i32, disp.len), disp.data);

                return (s, false);
            }

            if (s.is_extern && is_extern) {
                return (s, true);
            }

            s = s.next_homonym;
        }

        var sym: Symbol* = alloc_zero[Symbol](self.arena);

        sym.kind         = kind;
        sym.name         = name;
        sym.symbol_type  = sym_type;
        sym.loc          = loc;
        sym.is_defined   = true;
        sym.is_extern    = is_extern;
        sym.module_id    = mod;
        sym.display_name = display_name;

        sym.next_homonym = head;

        self.top_level.put(name, sym);
        self.all_symbols.push(sym);

        return (sym, false);
    }

    proc assign_link_names(self) -> void {
        var counts: HashMap[StrView, u64];
        counts.init(self.arena, hash_str);

        for (var i: u64 = 0; i < self.all_symbols.len; i += 1) {
            var sym: Symbol* = self.all_symbols.data[i];

            var (cnt, found) = counts.get(sym.name);

            if (!found) {
                cnt = 0;
            }

            counts.put(sym.name, cnt + 1);
        }

        var used: HashMap[StrView, bool];
        used.init(self.arena, hash_str);

        for (var i: u64 = 0; i < self.all_symbols.len; i += 1) {
            var sym: Symbol* = self.all_symbols.data[i];

            var (cnt, found) = counts.get(sym.name);

            if (!found || cnt <= 1) {
                continue;
            }

            if (sym.is_extern) {
                continue;
            }

            if (sym.name.equals_cstr("main") && sym.module_id == 0) {
                continue;
            }

            var sb: StringBuilder = sbuilder_create(self.arena);

            sb.append_str(self.modules.symbol_prefix(sym.module_id));
            sb.append_char('_');
            sb.append_str(sym.name);

            var link: StrView = sb.to_str();

            var (_, taken) = used.get(link);

            if (taken) {
                sb.append_char('_');
                sb.append_u64(cast(u64, sym.module_id));
                link = sb.to_str();
            }

            used.put(link, true);

            sym.link_name = link;
        }
    }

    proc presolve_type_sizes(self, t: Type*) -> void {
        if (t == null) {
            return;
        }

        switch (t.kind) {
            case TypeKind.TYPE_ARRAY: {
                self.presolve_type_sizes(t.array_elem);

                if (t.size_expr != null) {
                    var val: i64  = 0;
                    var ok:  bool = false;

                    if (self.current_subst_env != null && self.current_subst_env.proc_template != null) {
                        var tmpl: AstProc* = self.current_subst_env.proc_template;

                        var folded: AstExpr* = subst_value_params_expr(self.arena, t.size_expr,
                                                                       tmpl.generic_params[0..tmpl.generic_param_count],
                                                                       self.current_subst_env.concrete_values[0..tmpl.generic_param_count]);

                        (val, ok) = eval_const_int(folded);
                    }

                    if (!ok) {
                        self.analyze_expr(t.size_expr, type_primitive(TypeKind.TYPE_U64));

                        var (evaled, eval_ok) = eval_const_int(t.size_expr);

                        val = evaled;
                        ok  = eval_ok;

                        if (!ok) {
                            var (folded, fold_ok) = self.fold_const_expr_int(t.size_expr);

                            val = folded;
                            ok  = fold_ok;
                        }
                    }

                    if (!ok || val < 0) {
                        self.had_error = true;
                        diag_error(t.loc, "array size must be a non-negative constant expression");
                        val = 0;
                    }

                    t.array_count = cast(u64, val);
                    t.size_expr   = null;
                }

                type_array_recompute_size(t);
            }

            case TypeKind.TYPE_PTR, TypeKind.TYPE_SLICE: {
                self.presolve_type_sizes(t.base_type);
                self.presolve_type_sizes(t.slice_elem);
            }

            case TypeKind.TYPE_TUPLE: {
                for (var i: u64 = 0; i < t.tuple_count; i += 1) {
                    self.presolve_type_sizes(t.tuple_elements[i]);
                }
            }

            case TypeKind.TYPE_FUNC: {
                self.presolve_type_sizes(t.func_return_type);

                for (var i: u64 = 0; i < t.func_param_count; i += 1) {
                    self.presolve_type_sizes(t.func_param_types[i]);
                }
            }

            case TypeKind.TYPE_STRUCT: {
                for (var i: u64 = 0; i < t.generic_arg_count; i += 1) {
                    if (t.generic_args != null && t.generic_args[i] != null) {
                        self.presolve_type_sizes(t.generic_args[i]);
                    }
                }
            }

            default: {}
        }
    }

    proc presolve_struct_field_sizes(self, program: AstProgram*) -> void {
        for (var i: u64 = 0; i < program.struct_count; i += 1) {
            var s: AstStructDef* = program.structs[i];

            if (s.is_generic) {
                continue;
            }

            self.set_module_context(s.module_id);

            for (var f: u64 = 0; f < s.field_count; f += 1) {
                self.presolve_type_sizes(s.fields[f].field_type);
            }
        }

        for (var i: u64 = 0; i < program.union_count; i += 1) {
            var u: AstUnionDef* = program.unions[i];

            if (u.is_generic) {
                continue;
            }

            self.set_module_context(u.module_id);

            for (var f: u64 = 0; f < u.field_count; f += 1) {
                self.presolve_type_sizes(u.fields[f].field_type);
            }
        }
    }

    proc resolve_struct_value_args(self, t: Type*, proc_template: AstProc*, env: TypeSubstEnv*) -> void {
        if (t == null || t.kind != TypeKind.TYPE_STRUCT || t.generic_arg_count == 0) {
            return;
        }

        var (base_name, _, _) = self.registry.split_qualified_name(t.name);

        var s_def: AstStructDef* = self.registry.find_generic_struct(base_name);

        if (s_def == null || s_def.generic_param_count == 0) {
            return;
        }

        var n: u64 = s_def.generic_param_count;

        var has_value_param: bool = false;

        for (var i: u64 = 0; i < n; i += 1) {
            if (s_def.generic_params[i].is_value) {
                has_value_param = true;
                break;
            }
        }

        if (!has_value_param) {
            return;
        }

        var values: []i64 = alloc_array_zero[i64](self.arena, n)[0..n];

        for (var i: u64 = 0; i < n; i += 1) {
            var param: TypeParamInfo* = &s_def.generic_params[i];

            if (!param.is_value) {
                continue;
            }

            var val: i64  = 0;
            var ok:  bool = false;
            var type_given: bool = false;

            if (i < t.generic_arg_count) {
                if (t.generic_arg_is_value != null && t.generic_arg_is_value[i]) {
                    var expr: AstExpr* = t.generic_value_exprs[i];

                    if (expr.kind == AstExprKind.EXPR_VAR && proc_template != null && env != null) {
                        (val, ok) = lookup_value_param(proc_template.generic_params[0..proc_template.generic_param_count],
                                                       env.concrete_values[0..proc_template.generic_param_count],
                                                       expr.var_name);
                    }

                    if (!ok) {
                        (val, ok) = eval_const_int(expr);
                    }
                } else if (t.generic_args != null && t.generic_args[i] != null &&
                           t.generic_args[i].kind == TypeKind.TYPE_STRUCT && t.generic_args[i].generic_arg_count == 0) {
                    var ref_name: StrView = t.generic_args[i].name;

                    if (proc_template != null && env != null) {
                        (val, ok) = lookup_value_param(proc_template.generic_params[0..proc_template.generic_param_count],
                                                       env.concrete_values[0..proc_template.generic_param_count],
                                                       ref_name);
                    }

                    if (!ok) {
                        var sym: Symbol* = self.lookup_visible(ref_name);

                        if (sym != null && sym.kind == SymbolKind.SYM_CONST && sym.const_kind != ConstKind.CONST_FLOAT) {
                            val = sym.const_val;
                            ok  = true;
                        }
                    }

                    if (!ok) {
                        type_given = true;
                    }
                } else {
                    type_given = true;
                }
            }

            if (type_given) {
                self.had_error = true;
                diag_error(t.loc, "generic parameter '%.*s' of struct '%.*s' expects a value argument, but a type was provided",
                           cast(i32, param.name.len), param.name.data,
                           cast(i32, s_def.name.len), s_def.name.data);
                continue;
            }

            if (!ok && param.has_default && param.default_expr != null) {
                (val, ok) = eval_const_int(param.default_expr);
            }

            if (!ok) {
                self.had_error = true;
                diag_error(t.loc, "missing value for generic parameter '%.*s' of struct '%.*s'",
                           cast(i32, param.name.len), param.name.data,
                           cast(i32, s_def.name.len), s_def.name.data);
                continue;
            }

            values[i] = val;
        }

        t.generic_values = values.ptr;
    }

    proc try_namespace_member(self, expr: AstExpr*) -> bool {
        if (expr.member_target == null) {
            return false;
        }

        if (expr.member_target.kind != AstExprKind.EXPR_VAR && expr.member_target.kind != AstExprKind.EXPR_MEMBER) {
            return false;
        }

        var (mod, ok) = self.resolve_module_path(expr.member_target);

        if (!ok) {
            return false;
        }

        var sym: Symbol* = self.find_in_module(expr.member_field_name, mod);

        if (sym == null) {
            self.had_error = true;

            var path: StrView = self.namespace_path_str(expr.member_target);

            var (_, field_is_alias) = self.modules.resolve_alias_scoped(mod, expr.member_field_name, self.current_module);

            if (field_is_alias) {
                diag_error(expr.loc, "module path '%.*s.%.*s' cannot be used as a value",
                           cast(i32, path.len), path.data,
                           cast(i32, expr.member_field_name.len), expr.member_field_name.data);
            } else {
                diag_error(expr.loc, "module '%.*s' has no member '%.*s'",
                           cast(i32, path.len), path.data,
                           cast(i32, expr.member_field_name.len), expr.member_field_name.data);
            }

            expr.expr_type = type_primitive(TypeKind.TYPE_I64);
            return true;
        }

        expr.kind          = AstExprKind.EXPR_VAR;
        expr.var_name      = expr.member_field_name;
        expr.var_symbol    = sym;
        expr.member_target = null;
        expr.member_field  = null;

        return true;
    }

    proc try_namespace_call(self, expr: AstExpr*) -> (bool, bool) {
        if (!expr.call_is_method || expr.call_arg_count < 1 || expr.call_args == null) {
            return (false, false);
        }

        var receiver: AstExpr* = expr.call_args[0];

        if (receiver.kind != AstExprKind.EXPR_VAR && receiver.kind != AstExprKind.EXPR_MEMBER) {
            return (false, false);
        }

        var (mod, ok) = self.resolve_module_path(receiver);

        if (!ok) {
            return (false, false);
        }

        var sym: Symbol* = self.find_in_module(expr.call_callee_name, mod);

        if (sym == null) {
            var gp: AstProc* = self.registry.find_generic_proc(expr.call_callee_name);

            if (gp != null && gp.module_id == mod) {
                var path: StrView = self.namespace_path_str(receiver);

                var sb: StringBuilder = sbuilder_create(self.arena);

                sb.append_str(path);
                sb.append_char('.');
                sb.append_str(expr.call_callee_name);

                var new_count: u64        = expr.call_arg_count - 1;
                var new_args:  []AstExpr* = alloc_array[AstExpr*](self.arena, new_count)[0..new_count];

                for (var i: u64 = 0; i < new_count; i += 1) {
                    new_args[i] = expr.call_args[i + 1];
                }

                expr.call_args        = new_args.ptr;
                expr.call_arg_count   = new_count;
                expr.call_is_method   = false;
                expr.call_callee_sym  = null;
                expr.call_callee_name = sb.to_str();

                return (true, true);
            }

            self.had_error = true;

            var path: StrView = self.namespace_path_str(receiver);

            diag_error(expr.loc, "module '%.*s' has no member '%.*s'",
                       cast(i32, path.len), path.data,
                       cast(i32, expr.call_callee_name.len), expr.call_callee_name.data);
            expr.expr_type = type_primitive(TypeKind.TYPE_I64);
            return (true, false);
        }

        if (sym.kind != SymbolKind.SYM_PROC) {
            self.had_error = true;

            var path: StrView = self.namespace_path_str(receiver);

            diag_error(expr.loc, "'%.*s' in module '%.*s' is not a procedure",
                       cast(i32, expr.call_callee_name.len), expr.call_callee_name.data,
                       cast(i32, path.len), path.data);
            expr.expr_type = type_primitive(TypeKind.TYPE_I64);
            return (true, false);
        }

        var new_count: u64         = expr.call_arg_count - 1;
        var new_args:  []AstExpr*  = alloc_array[AstExpr*](self.arena, new_count)[0..new_count];

        for (var i: u64 = 0; i < new_count; i += 1) {
            new_args[i] = expr.call_args[i + 1];
        }

        expr.call_args        = new_args.ptr;
        expr.call_arg_count   = new_count;
        expr.call_is_method   = false;
        expr.call_callee_sym  = sym;
        expr.call_callee_name = sym.effective_name();

        return (true, true);
    }

    proc register_interfaces(self, program: AstProgram*) -> void {
        for (var i: u64 = 0; i < program.interface_count; i += 1) {
            var it: AstInterfaceDef* = program.interfaces[i];

            self.set_module_context(it.module_id);

            if (self.registry.find_interface(it.name) != null || self.registry.find_struct(it.name) != null) {
                self.had_error = true;
                diag_error(it.loc, "redefinition of type name '%.*s'", cast(i32, it.name.len), it.name.data);
                continue;
            }

            var iface_t: Type* = alloc_zero[Type](self.arena);

            iface_t.kind         = TypeKind.TYPE_STRUCT;
            iface_t.name         = it.name;
            iface_t.is_interface = true;
            iface_t.iface_def    = it;
            iface_t.module_id    = it.module_id;
            iface_t.loc          = it.loc;

            var iface_fields: []StructField = alloc_array[StructField](self.arena, 2)[0..2];

            iface_fields[0].name       = strview_from_cstr("__data");
            iface_fields[0].field_type = type_ptr(self.arena, type_primitive(TypeKind.TYPE_VOID));
            iface_fields[0].is_private = false;

            iface_fields[1].name       = strview_from_cstr("__vtable");
            iface_fields[1].field_type = type_ptr(self.arena, type_primitive(TypeKind.TYPE_VOID));
            iface_fields[1].is_private = false;

            type_struct_init(iface_t, it.name, iface_fields, false);

            it.iface_type = iface_t;

            self.registry.register_interface(it.name, iface_t, it);

            for (var m: u64 = 0; m < it.method_count; m += 1) {
                var sig: AstProc* = it.methods[m];

                sig.return_type = self.resolve_type(sig.return_type);

                for (var pi: u64 = 0; pi < sig.param_count; pi += 1) {
                    sig.params[pi].param_type = self.resolve_type(sig.params[pi].param_type);
                }
            }
        }
    }

    proc resolve_parent_def(self, s: AstStructDef*) -> AstStructDef* {
        var (base, req, qual) = self.registry.split_qualified_name(s.parent_name);

        var p_entry: StructEntry* = self.registry.find_struct(base);

        if (p_entry == null || p_entry.def == null) {
            self.had_error = true;

            if (self.registry.find_union(base) != null || self.registry.find_enum(base) != null ||
                self.registry.find_alias(base) != null || self.registry.find_interface(base) != null) {
                diag_error(s.loc, "'%.*s' is not a struct type and cannot be extended",
                           cast(i32, base.len), base.data);
            } else {
                diag_error(s.loc, "cannot extend unknown struct '%.*s'",
                           cast(i32, base.len), base.data);
            }

            return null;
        }

        if (!self.registry.check_type_module(base, p_entry.def.module_id, qual, req, p_entry.def.is_public, "type", s.loc)) {
            self.had_error = true;
            return null;
        }

        if (p_entry.def == s) {
            self.had_error = true;
            diag_error(s.loc, "struct '%.*s' cannot extend itself", cast(i32, s.name.len), s.name.data);
            return null;
        }

        if (p_entry.def.is_generic) {
            self.had_error = true;
            diag_error(s.loc, "cannot extend generic struct '%.*s' without type arguments",
                       cast(i32, base.len), base.data);
            return null;
        }

        if (p_entry.def.inherit_resolving) {
            self.had_error = true;
            diag_error(s.loc, "cyclic inheritance involving '%.*s' and '%.*s'",
                       cast(i32, s.name.len), s.name.data,
                       cast(i32, base.len), base.data);
            return null;
        }

        return p_entry.def;
    }

    proc flatten_inherited_fields(self, s: AstStructDef*, parent_def: AstStructDef*) -> void {
        if (parent_def == null) {
            return;
        }

        var own_count: u64 = s.field_count;
        var total:     u64 = parent_def.field_count + own_count;

        var nf: []StructField = alloc_array[StructField](self.arena, total)[0..total];

        for (var i: u64 = 0; i < parent_def.field_count; i += 1) {
            nf[i] = parent_def.fields[i];
        }

        for (var i: u64 = 0; i < own_count; i += 1) {
            var own: StructField = s.fields[i];

            for (var j: u64 = 0; j < parent_def.field_count; j += 1) {
                if (nf[j].name.equals(own.name)) {
                    self.had_error = true;
                    diag_error(s.loc, "field '%.*s' in struct '%.*s' duplicates an inherited field",
                               cast(i32, own.name.len), own.name.data,
                               cast(i32, s.name.len), s.name.data);
                    break;
                }
            }

            nf[parent_def.field_count + i] = own;
        }

        s.fields      = nf.ptr;
        s.field_count = total;

        s.def_type.fields      = nf.ptr;
        s.def_type.field_count = total;
    }

    proc build_virtual_slots(self, s: AstStructDef*, parent_def: AstStructDef*, program: AstProgram*) -> void {
        var slots: Vec[VirtualSlot] = vec_with_capacity[VirtualSlot](self.arena, 8);

        if (parent_def != null) {
            for (var i: u64 = 0; i < parent_def.virtual_slot_count; i += 1) {
                slots.push(parent_def.virtual_slots[i]);
            }

            s.is_polymorphic = parent_def.is_polymorphic;
        }

        for (var i: u64 = 0; i < program.proc_count; i += 1) {
            var m: AstProc* = program.procs[i];

            if (m.is_generic || !m.method_struct.equals(s.name)) {
                continue;
            }

            var idx: i64 = find_virtual_slot(slots.data, slots.len, m.orig_name);

            if (m.attrs.is_override) {
                if (idx < 0) {
                    self.had_error = true;
                    diag_error(m.loc, "'@override' method '%.*s' does not override any virtual method in the hierarchy of '%.*s'",
                               cast(i32, m.orig_name.len), m.orig_name.data,
                               cast(i32, s.name.len), s.name.data);
                    continue;
                }

                slots.data[idx].impl_name   = m.name;
                slots.data[idx].is_abstract = (m.body == null);
                continue;
            }

            if (m.attrs.is_virtual) {
                if (parent_def != null && !parent_def.is_polymorphic) {
                    self.had_error = true;
                    diag_error(m.loc, "'@virtual' method '%.*s' cannot be introduced in '%.*s': base struct '%.*s' is not polymorphic (declare virtual methods in the hierarchy root)",
                               cast(i32, m.orig_name.len), m.orig_name.data,
                               cast(i32, s.name.len), s.name.data,
                               cast(i32, parent_def.name.len), parent_def.name.data);
                    continue;
                }

                if (idx >= 0) {
                    self.had_error = true;
                    diag_error(m.loc, "method '%.*s' already exists as a virtual method of the base struct; use '@override'",
                               cast(i32, m.orig_name.len), m.orig_name.data);
                    continue;
                }

                var slot: VirtualSlot;

                slot.method_name = m.orig_name;
                slot.impl_name   = m.name;
                slot.decl        = m;
                slot.is_abstract = (m.body == null);

                slots.push(slot);

                s.is_polymorphic = true;
                continue;
            }

            if (idx >= 0) {
                self.had_error = true;
                diag_error(m.loc, "method '%.*s' overrides a virtual method of the base struct; mark it '@override'",
                           cast(i32, m.orig_name.len), m.orig_name.data);
            }
        }

        s.virtual_slot_count = slots.len;

        if (slots.len > 0) {
            s.virtual_slots = alloc_array[VirtualSlot](self.arena, slots.len);

            for (var i: u64 = 0; i < slots.len; i += 1) {
                s.virtual_slots[i] = slots.data[i];
            }
        }

        if (s.is_polymorphic) {
            if (parent_def == null) {
                var total: u64 = s.field_count + 1;

                var nf: []StructField = alloc_array[StructField](self.arena, total)[0..total];

                nf[0].name       = strview_from_cstr("__vptr");
                nf[0].field_type = type_ptr(self.arena, type_primitive(TypeKind.TYPE_VOID));
                nf[0].offset     = 0;
                nf[0].is_private = false;

                for (var i: u64 = 0; i < s.field_count; i += 1) {
                    nf[i + 1] = s.fields[i];
                }

                s.fields      = nf.ptr;
                s.field_count = total;

                s.def_type.fields      = nf.ptr;
                s.def_type.field_count = total;
            }

            if (s.def_type.vtable_name.len == 0) {
                var sb: StringBuilder = sbuilder_create(self.arena);

                sb.append_str(strview_from_cstr("__vtable_"));
                sb.append_str(s.name);

                s.def_type.vtable_name = sb.to_str();
            }

            self.poly_types.push(s);
        }

        if (parent_def != null) {
            s.def_type.parent_type = parent_def.def_type;
        }
    }

    proc resolve_struct_inheritance(self, s: AstStructDef*, program: AstProgram*, depth: u64) -> void {
        if (s.inherit_resolved) {
            return;
        }

        s.inherit_resolved = true;

        if (s.is_generic) {
            if (s.parent_name.len > 0) {
                self.had_error = true;
                diag_error(s.loc, "generic struct '%.*s' cannot use 'extends'",
                           cast(i32, s.name.len), s.name.data);
            }

            return;
        }

        if (depth > 64) {
            self.had_error = true;
            diag_error(s.loc, "inheritance hierarchy of '%.*s' is too deep or cyclic",
                       cast(i32, s.name.len), s.name.data);
            return;
        }

        var parent_def: AstStructDef* = null;

        if (s.parent_name.len > 0) {
            parent_def = self.resolve_parent_def(s);
        }

        if (parent_def != null) {
            s.inherit_resolving = true;

            self.resolve_struct_inheritance(parent_def, program, depth + 1);

            s.inherit_resolving = false;
        }

        self.flatten_inherited_fields(s, parent_def);
        self.build_virtual_slots(s, parent_def, program);
    }

    proc lookup_method_chain(self, struct_t: Type*, method_name: StrView) -> Symbol* {
        var t: Type* = struct_t;

        while (t != null && t.kind == TypeKind.TYPE_STRUCT && !t.is_interface) {
            var sb: StringBuilder = sbuilder_create(self.arena);

            sb.append_str(t.name);
            sb.append_char('_');
            sb.append_str(method_name);

            var sym: Symbol* = self.lookup_method(sb.to_str(), t.module_id);

            if (sym != null) {
                return sym;
            }

            t = t.parent_type;
        }

        return null;
    }

    proc iface_method_matches(self, sig: AstProc*, impl: Symbol*) -> bool {
        var ft: Type* = impl.symbol_type;

        if (ft == null || ft.kind != TypeKind.TYPE_FUNC) {
            return false;
        }

        if (ft.func_param_count != sig.param_count) {
            return false;
        }

        for (var pi: u64 = 1; pi < sig.param_count; pi += 1) {
            if (!types_are_compatible(sig.params[pi].param_type, ft.func_param_types[pi]) ||
                !types_are_compatible(ft.func_param_types[pi], sig.params[pi].param_type)) {
                return false;
            }
        }

        return types_are_compatible(sig.return_type, ft.func_return_type) &&
               types_are_compatible(ft.func_return_type, sig.return_type);
    }

    proc check_interface_conformance(self, concrete: Type*, idef: AstInterfaceDef*, loc: SourceLoc) -> (StrView, bool) {
        var kb: StringBuilder = sbuilder_create(self.arena);

        kb.append_str(concrete.name);
        kb.append_char(1);
        kb.append_str(idef.name);

        var key: StrView = kb.to_str();

        var (cached_vt, cached_ok) = self.conformance.get(key);

        if (cached_ok) {
            return (cached_vt, true);
        }

        var (_, failed) = self.conform_failed.get(key);

        if (failed) {
            return (strview_from_raw(null, 0), false);
        }

        var vb: StringBuilder = sbuilder_create(self.arena);

        vb.append_str(strview_from_cstr("__itable_"));
        vb.append_str(idef.name);
        vb.append_char('_');
        vb.append_str(concrete.name);

        var vt_name: StrView = vb.to_str();

        var all_ok: bool = true;

        for (var i: u64 = 0; i < idef.method_count; i += 1) {
            var sig: AstProc* = idef.methods[i];

            var impl: Symbol* = self.lookup_method_chain(concrete, sig.orig_name);

            if (impl == null) {
                self.had_error = true;
                diag_error(loc, "type '%.*s' does not satisfy interface '%.*s': missing method '%.*s'",
                           cast(i32, concrete.name.len), concrete.name.data,
                           cast(i32, idef.name.len), idef.name.data,
                           cast(i32, sig.orig_name.len), sig.orig_name.data);
                all_ok = false;
                continue;
            }

            if (impl.proc_decl != null && impl.proc_decl.body == null) {
                self.had_error = true;
                diag_error(loc, "type '%.*s' does not satisfy interface '%.*s': method '%.*s' has no body",
                           cast(i32, concrete.name.len), concrete.name.data,
                           cast(i32, idef.name.len), idef.name.data,
                           cast(i32, sig.orig_name.len), sig.orig_name.data);
                all_ok = false;
                continue;
            }

            var sig_ok: bool = self.iface_method_matches(sig, impl);

            if (!sig_ok) {
                self.had_error = true;
                diag_error(loc, "type '%.*s' does not satisfy interface '%.*s': method '%.*s' has an incompatible signature",
                           cast(i32, concrete.name.len), concrete.name.data,
                           cast(i32, idef.name.len), idef.name.data,
                           cast(i32, sig.orig_name.len), sig.orig_name.data);
                all_ok = false;
            }
        }

        if (!all_ok) {
            self.conform_failed.put(key, true);
            return (strview_from_raw(null, 0), false);
        }

        self.conformance.put(key, vt_name);

        var req: IfaceBoxReq;

        req.concrete    = concrete;
        req.idef        = idef;
        req.vtable_name = vt_name;

        self.iface_boxes.push(req);

        return (vt_name, true);
    }

    proc coerce_for_target(self, expr: AstExpr*, target_t: Type*) -> AstExpr* {
        if (expr == null || target_t == null || expr.expr_type == null || !target_t.is_interface) {
            return expr;
        }

        if (expr.expr_type == target_t) {
            return expr;
        }

        var src: Type* = expr.expr_type;

        if (src.is_pointer() && src.base_type != null &&
            src.base_type.kind == TypeKind.TYPE_STRUCT && !src.base_type.is_interface) {
            var concrete: Type* = src.base_type;

            if (concrete.is_generic_template) {
                self.had_error = true;
                diag_error(expr.loc, "generic struct '%.*s' cannot be used as interface '%.*s'",
                           cast(i32, concrete.name.len), concrete.name.data,
                           cast(i32, target_t.name.len), target_t.name.data);
                return expr;
            }

            var (vt_name, ok) = self.check_interface_conformance(concrete, target_t.iface_def, expr.loc);

            if (!ok) {
                return expr;
            }

            var box: AstExpr* = alloc_zero[AstExpr](self.arena);

            box.kind            = AstExprKind.EXPR_TO_INTERFACE;
            box.loc             = expr.loc;
            box.unary_operand   = expr;
            box.expr_type       = target_t;
            box.to_iface_vtable = vt_name;

            return box;
        }

        self.had_error = true;

        var ts: StrView = src.to_str(self.arena);

        diag_error(expr.loc, "cannot use value of type '%.*s' as interface '%.*s'",
                   cast(i32, ts.len), ts.data,
                   cast(i32, target_t.name.len), target_t.name.data);

        return expr;
    }

    proc check_slicing(self, target_t: Type*, src_t: Type*, loc: SourceLoc) -> void {
        if (target_t == null || src_t == null) {
            return;
        }

        if (target_t.kind != TypeKind.TYPE_STRUCT || src_t.kind != TypeKind.TYPE_STRUCT) {
            return;
        }

        if (target_t.is_interface || src_t.is_interface || target_t == src_t) {
            return;
        }

        if (struct_is_derived_from(src_t, target_t) || struct_is_derived_from(target_t, src_t)) {
            self.had_error = true;
            diag_error(loc, "object slicing is forbidden: cannot copy '%.*s' into '%.*s' by value; use pointers",
                       cast(i32, src_t.name.len), src_t.name.data,
                       cast(i32, target_t.name.len), target_t.name.data);
        }
    }

    proc check_override_signatures(self, program: AstProgram*) -> void {
        for (var i: u64 = 0; i < program.proc_count; i += 1) {
            var m: AstProc* = program.procs[i];

            if (m.method_struct.len == 0) {
                if (m.attrs.is_virtual || m.attrs.is_override) {
                    self.had_error = true;
                    diag_error(m.loc, "'@virtual' and '@override' are only valid on struct methods");
                }

                continue;
            }

            if (m.attrs.is_virtual && self.registry.find_generic_struct(m.method_struct) != null) {
                self.had_error = true;
                diag_error(m.loc, "'@virtual' method '%.*s' cannot be declared in generic struct '%.*s'",
                           cast(i32, m.orig_name.len), m.orig_name.data,
                           cast(i32, m.method_struct.len), m.method_struct.data);
            }

            if (!m.attrs.is_override) {
                continue;
            }

            var s_entry: StructEntry* = self.registry.find_struct(m.method_struct);

            if (s_entry == null || s_entry.def == null) {
                continue;
            }

            var def: AstStructDef* = s_entry.def;

            var idx: i64 = find_virtual_slot(def.virtual_slots, def.virtual_slot_count, m.orig_name);

            if (idx < 0) {
                continue;
            }

            var base: AstProc* = def.virtual_slots[idx].decl;

            if (base == null || base == m) {
                continue;
            }

            var sig_ok: bool = (m.param_count == base.param_count);

            if (sig_ok) {
                for (var pi: u64 = 1; pi < m.param_count; pi += 1) {
                    if (!types_are_compatible(m.params[pi].param_type, base.params[pi].param_type) ||
                        !types_are_compatible(base.params[pi].param_type, m.params[pi].param_type)) {
                        sig_ok = false;
                        break;
                    }
                }
            }

            if (sig_ok) {
                sig_ok = types_are_compatible(m.return_type, base.return_type) &&
                         types_are_compatible(base.return_type, m.return_type);
            }

            if (!sig_ok) {
                self.had_error = true;
                diag_error(m.loc, "'@override' method '%.*s' has a different signature than the virtual method in the base struct",
                           cast(i32, m.orig_name.len), m.orig_name.data);
            }
        }
    }

    proc expr_calls_comptime_builtin(self, expr: AstExpr*) -> bool {
        if (expr == null) {
            return false;
        }

        switch (expr.kind) {
            case AstExprKind.EXPR_CALL: {
                if (expr.call_callee_sym != null && expr.call_callee_sym.proc_decl != null) {
                    var callee: AstProc* = expr.call_callee_sym.proc_decl;

                    if (callee.comptime_only || comptime_builtin_kind(callee.name) != ComptimeBuiltin.CB_NONE) {
                        return true;
                    }
                }

                if (self.expr_calls_comptime_builtin(expr.call_callee_expr)) {
                    return true;
                }

                for (var i: u64 = 0; i < expr.call_arg_count; i += 1) {
                    if (self.expr_calls_comptime_builtin(expr.call_args[i])) {
                        return true;
                    }
                }

                return false;
            }

            case AstExprKind.EXPR_VIRT_CALL: {
                for (var i: u64 = 0; i < expr.call_arg_count; i += 1) {
                    if (self.expr_calls_comptime_builtin(expr.call_args[i])) {
                        return true;
                    }
                }

                return false;
            }

            case AstExprKind.EXPR_UNARY: {
                return self.expr_calls_comptime_builtin(expr.unary_operand);
            }

            case AstExprKind.EXPR_BINARY: {
                return self.expr_calls_comptime_builtin(expr.binary_lhs) ||
                       self.expr_calls_comptime_builtin(expr.binary_rhs);
            }

            case AstExprKind.EXPR_TO_INTERFACE: {
                return self.expr_calls_comptime_builtin(expr.unary_operand);
            }

            case AstExprKind.EXPR_INDEX: {
                return self.expr_calls_comptime_builtin(expr.index_ptr) ||
                       self.expr_calls_comptime_builtin(expr.index_index);
            }

            case AstExprKind.EXPR_MEMBER: {
                return self.expr_calls_comptime_builtin(expr.member_target);
            }

            case AstExprKind.EXPR_CAST: {
                return self.expr_calls_comptime_builtin(expr.cast_expr);
            }

            case AstExprKind.EXPR_IF: {
                return self.expr_calls_comptime_builtin(expr.if_cond) ||
                       self.expr_calls_comptime_builtin(expr.if_then_expr) ||
                       self.expr_calls_comptime_builtin(expr.if_else_expr);
            }

            case AstExprKind.EXPR_TUPLE: {
                for (var i: u64 = 0; i < expr.tuple_count; i += 1) {
                    if (self.expr_calls_comptime_builtin(expr.tuple_elements[i])) {
                        return true;
                    }
                }

                return false;
            }

            case AstExprKind.EXPR_STRUCT_LIT: {
                for (var i: u64 = 0; i < expr.struct_lit_field_count; i += 1) {
                    if (self.expr_calls_comptime_builtin(expr.struct_lit_field_values[i])) {
                        return true;
                    }
                }

                return false;
            }

            case AstExprKind.EXPR_ARRAY_LIT: {
                for (var i: u64 = 0; i < expr.array_count; i += 1) {
                    if (self.expr_calls_comptime_builtin(expr.array_elements[i])) {
                        return true;
                    }
                }

                return false;
            }

            case AstExprKind.EXPR_SLICE: {
                return self.expr_calls_comptime_builtin(expr.slice_target) ||
                       self.expr_calls_comptime_builtin(expr.slice_start) ||
                       self.expr_calls_comptime_builtin(expr.slice_end);
            }

            case AstExprKind.EXPR_ALLOCA: {
                return self.expr_calls_comptime_builtin(expr.alloca_count_expr);
            }

            case AstExprKind.EXPR_SIZEOF, AstExprKind.EXPR_ALIGNOF: {
                return self.expr_calls_comptime_builtin(expr.size_align_expr);
            }

            case AstExprKind.EXPR_VA_ARG: {
                return self.expr_calls_comptime_builtin(expr.va_valist_expr);
            }

            case AstExprKind.EXPR_ASM: {
                for (var i: u64 = 0; i < expr.asm_input_count; i += 1) {
                    if (self.expr_calls_comptime_builtin(expr.asm_inputs[i].expr)) {
                        return true;
                    }
                }

                for (var i: u64 = 0; i < expr.asm_output_count; i += 1) {
                    if (self.expr_calls_comptime_builtin(expr.asm_outputs[i].expr)) {
                        return true;
                    }
                }

                return false;
            }

            case AstExprKind.EXPR_COMPTIME_BLOCK: {
                return self.stmt_calls_comptime_builtin(expr.comptime_block);
            }

            default: {
                return false;
            }
        }
    }

    proc stmt_calls_comptime_builtin(self, stmt: AstStmt*) -> bool {
        if (stmt == null) {
            return false;
        }

        switch (stmt.kind) {
            case AstStmtKind.STMT_BLOCK: {
                for (var i: u64 = 0; i < stmt.block_count; i += 1) {
                    if (self.stmt_calls_comptime_builtin(stmt.block_stmts[i])) {
                        return true;
                    }
                }

                return false;
            }

            case AstStmtKind.STMT_VAR_DECL: {
                return self.expr_calls_comptime_builtin(stmt.var_decl_init_expr);
            }

            case AstStmtKind.STMT_DESTRUCTURE_DECL: {
                return self.expr_calls_comptime_builtin(stmt.destructure_decl_init_expr);
            }

            case AstStmtKind.STMT_ASSIGN: {
                return self.expr_calls_comptime_builtin(stmt.assign_target) ||
                       self.expr_calls_comptime_builtin(stmt.assign_value);
            }

            case AstStmtKind.STMT_DESTRUCTURE_ASSIGN: {
                for (var i: u64 = 0; i < stmt.destructure_assign_count; i += 1) {
                    if (self.expr_calls_comptime_builtin(stmt.destructure_assign_targets[i])) {
                        return true;
                    }
                }

                return self.expr_calls_comptime_builtin(stmt.destructure_assign_value);
            }

            case AstStmtKind.STMT_COMPOUND_ASSIGN: {
                return self.expr_calls_comptime_builtin(stmt.compound_assign_target) ||
                       self.expr_calls_comptime_builtin(stmt.compound_assign_value);
            }

            case AstStmtKind.STMT_RETURN: {
                return self.expr_calls_comptime_builtin(stmt.return_expr);
            }

            case AstStmtKind.STMT_IF: {
                return self.expr_calls_comptime_builtin(stmt.if_cond) ||
                       self.stmt_calls_comptime_builtin(stmt.if_then_branch) ||
                       self.stmt_calls_comptime_builtin(stmt.if_else_branch);
            }

            case AstStmtKind.STMT_WHILE: {
                return self.expr_calls_comptime_builtin(stmt.while_cond) ||
                       self.stmt_calls_comptime_builtin(stmt.while_body);
            }

            case AstStmtKind.STMT_FOR: {
                return self.stmt_calls_comptime_builtin(stmt.for_init) ||
                       self.expr_calls_comptime_builtin(stmt.for_cond) ||
                       self.stmt_calls_comptime_builtin(stmt.for_step) ||
                       self.stmt_calls_comptime_builtin(stmt.for_body);
            }

            case AstStmtKind.STMT_FOR_IN: {
                if (stmt.forin_desugared != null) {
                    return self.stmt_calls_comptime_builtin(stmt.forin_desugared);
                }

                return self.expr_calls_comptime_builtin(stmt.forin_iterable) ||
                       self.expr_calls_comptime_builtin(stmt.forin_range_end) ||
                       self.stmt_calls_comptime_builtin(stmt.forin_body);
            }

            case AstStmtKind.STMT_SWITCH: {
                if (self.expr_calls_comptime_builtin(stmt.switch_cond)) {
                    return true;
                }

                for (var i: u64 = 0; i < stmt.switch_case_count; i += 1) {
                    for (var p: u64 = 0; p < stmt.switch_cases[i].pattern_count; p += 1) {
                        if (self.expr_calls_comptime_builtin(stmt.switch_cases[i].patterns[p].val_start) ||
                            self.expr_calls_comptime_builtin(stmt.switch_cases[i].patterns[p].val_end)) {
                            return true;
                        }
                    }

                    for (var s: u64 = 0; s < stmt.switch_cases[i].stmt_count; s += 1) {
                        if (self.stmt_calls_comptime_builtin(stmt.switch_cases[i].stmts[s])) {
                            return true;
                        }
                    }
                }

                return false;
            }

            case AstStmtKind.STMT_DEFER: {
                return self.stmt_calls_comptime_builtin(stmt.defer_stmt);
            }

            case AstStmtKind.STMT_EXPR: {
                return self.expr_calls_comptime_builtin(stmt.expr_stmt_expr);
            }

            default: {
                return false;
            }
        }
    }

    proc mark_comptime_only_procs(self, program: AstProgram*) -> void {
        if (program == null) {
            return;
        }

        var changed: bool = true;

        while (changed) {
            changed = false;

            for (var i: u64 = 0; i < program.proc_count; i += 1) {
                var p: AstProc* = program.procs[i];

                if (p == null || p.is_generic || p.comptime_only || p.body == null) {
                    continue;
                }

                if (self.stmt_calls_comptime_builtin(p.body)) {
                    p.comptime_only = true;
                    changed         = true;
                }
            }
        }
    }

    proc build_vtables(self, program: AstProgram*) -> void {
        var vts: Vec[AstVTable*] = vec_with_capacity[AstVTable*](self.arena, 8);

        for (var i: u64 = 0; i < self.poly_types.len; i += 1) {
            var def: AstStructDef* = self.poly_types.data[i];

            var has_abstract: bool = false;

            for (var s: u64 = 0; s < def.virtual_slot_count; s += 1) {
                if (def.virtual_slots[s].is_abstract) {
                    has_abstract = true;
                    break;
                }
            }

            if (has_abstract) {
                continue;
            }

            var vt: AstVTable* = alloc_zero[AstVTable](self.arena);

            vt.name       = def.def_type.vtable_name;
            vt.slot_count = def.virtual_slot_count;
            vt.slots      = alloc_array[StrView](self.arena, def.virtual_slot_count);

            for (var s: u64 = 0; s < def.virtual_slot_count; s += 1) {
                var impl: Symbol* = self.lookup_raw(def.virtual_slots[s].impl_name);

                if (impl != null) {
                    vt.slots[s] = impl.effective_name();

                    if (impl.proc_decl != null && impl.proc_decl.comptime_only) {
                        vt.comptime_only = true;
                    }
                } else {
                    vt.slots[s] = def.virtual_slots[s].impl_name;
                }
            }

            vts.push(vt);
        }

        for (var i: u64 = 0; i < self.iface_boxes.len; i += 1) {
            var req: IfaceBoxReq = self.iface_boxes.data[i];

            var vt: AstVTable* = alloc_zero[AstVTable](self.arena);

            vt.name       = req.vtable_name;
            vt.slot_count = req.idef.method_count;
            vt.slots      = alloc_array[StrView](self.arena, req.idef.method_count);

            for (var s: u64 = 0; s < req.idef.method_count; s += 1) {
                var sig:  AstProc* = req.idef.methods[s];
                var impl: Symbol*  = self.lookup_method_chain(req.concrete, sig.orig_name);

                if (impl != null) {
                    vt.slots[s] = impl.effective_name();

                    if (impl.proc_decl != null && impl.proc_decl.comptime_only) {
                        vt.comptime_only = true;
                    }
                } else {
                    vt.slots[s] = sig.orig_name;
                }
            }

            vts.push(vt);
        }

        program.vtable_count = vts.len;

        if (vts.len > 0) {
            program.vtables = alloc_array[AstVTable*](self.arena, vts.len);

            for (var i: u64 = 0; i < vts.len; i += 1) {
                program.vtables[i] = vts.data[i];
            }
        }
    }

    proc require_valist(self, expr: AstExpr*, op_name: char*) -> Type* {
        var t: Type* = self.analyze_expr(expr, null);

        if (t == null || t.kind != TypeKind.TYPE_VALIST) {
            var ts: StrView = strview_from_cstr("<unknown>");

            if (t != null) {
                ts = t.to_str(self.arena);
            }

            self.had_error = true;
            diag_error(expr.loc, "%s expects VaList, got '%.*s'", op_name, cast(i32, ts.len), ts.data);

            return type_primitive(TypeKind.TYPE_VALIST);
        }

        return t;
    }

    @inline proc resolve_type(self, t: Type*) -> Type* {
        if (t == null) {
            return null;
        }

        if (t.kind == TypeKind.TYPE_EXPR) {
            return self.resolve_type_expr(t);
        }

        var tmpl: AstProc* = null;

        if (self.current_subst_env != null && self.current_subst_env.proc_template != null) {
            tmpl = self.current_subst_env.proc_template;
        } else if (self.current_proc != null) {
            tmpl = self.current_proc.generic_template;
        }

        self.presolve_type_sizes(t);

        self.resolve_struct_value_args(t, tmpl, self.current_subst_env);

        return self.registry.resolve_type(self.arena, t, self.current_subst_env, tmpl);
    }

    proc find_proc_return_expr(self, proc_def: AstProc*) -> AstExpr* {
        if (proc_def == null || proc_def.body == null || proc_def.body.kind != AstStmtKind.STMT_BLOCK) {
            return null;
        }

        var block: AstStmt* = proc_def.body;

        for (var i: u64 = 0; i < block.block_count; i += 1) {
            var stmt: AstStmt* = block.block_stmts[i];

            if (stmt.kind == AstStmtKind.STMT_RETURN && stmt.return_expr != null) {
                return stmt.return_expr;
            }
        }

        return null;
    }

    proc eval_type_value(self, expr: AstExpr*) -> Type* {
        if (expr == null) {
            return null;
        }

        if (expr.kind == AstExprKind.EXPR_TYPE_VALUE) {
            return expr.type_value;
        }

        if (expr.kind == AstExprKind.EXPR_CALL) {
            return self.eval_type_call(expr);
        }

        self.had_error = true;
        diag_error(expr.loc, "expression in type position does not evaluate to a type");

        return null;
    }

    proc eval_type_call(self, call: AstExpr*) -> Type* {
        var sym: Symbol* = call.call_callee_sym;

        if (sym == null || sym.proc_decl == null) {
            self.had_error = true;
            diag_error(call.loc, "procedure in type position could not be resolved");

            return null;
        }

        var proc_def: AstProc* = sym.proc_decl;

        if (proc_def.attrs.is_extern || proc_def.body == null) {
            self.had_error = true;
            diag_error(call.loc, "procedure '%.*s' has no body and cannot produce a type",
                       cast(i32, proc_def.display_name.len), proc_def.display_name.data);

            return null;
        }

        if (!proc_def.body_analyzed) {
            self.analyze_proc_body(proc_def);
        }

        var ret_expr: AstExpr* = self.find_proc_return_expr(proc_def);

        if (ret_expr == null) {
            self.had_error = true;
            diag_error(call.loc, "procedure '%.*s' must return a type value",
                       cast(i32, proc_def.display_name.len), proc_def.display_name.data);

            return null;
        }

        return self.eval_type_value(ret_expr);
    }

    proc resolve_type_expr(self, t: Type*) -> Type* {
        if (t.type_expr == null) {
            return t.base_type;
        }

        var call: AstExpr* = t.type_expr;

        self.type_eval_depth += 1;

        var call_t: Type* = self.analyze_expr(call, type_primitive(TypeKind.TYPE_TYPE));

        self.type_eval_depth -= 1;

        var result: Type* = null;

        if (call_t == null || call_t.kind != TypeKind.TYPE_TYPE) {
            if (!self.had_error) {
                self.had_error = true;
                diag_error(call.loc, "expression in type position does not evaluate to a type");
            }

            result = type_primitive(TypeKind.TYPE_I64);
        } else {
            result = self.eval_type_call(call);

            if (result == null) {
                result = type_primitive(TypeKind.TYPE_I64);
            }
        }

        t.type_expr = null;
        t.base_type = result;

        return result;
    }

    proc classify_generic_value_params(self, proc_def: AstProc*) -> void {
        for (var i: u64 = 0; i < proc_def.generic_param_count; i += 1) {
            var gp: TypeParamInfo* = &proc_def.generic_params[i];

            if (gp.is_value || gp.has_default) {
                continue;
            }

            var type_used:  bool = false;
            var value_used: bool = false;

            for (var pi: u64 = 0; pi < proc_def.param_count; pi += 1) {
                if (type_uses_name_as_type(proc_def.params[pi].param_type, gp.name)) {
                    type_used = true;
                }

                if (type_uses_name_as_value(proc_def.params[pi].param_type, gp.name)) {
                    value_used = true;
                }
            }

            if (type_uses_name_as_type(proc_def.return_type, gp.name)) {
                type_used = true;
            }

            if (type_uses_name_as_value(proc_def.return_type, gp.name)) {
                value_used = true;
            }

            if (stmt_uses_name_as_type(proc_def.body, gp.name)) {
                type_used = true;
            }

            if (stmt_uses_name_as_value(proc_def.body, gp.name)) {
                value_used = true;
            }

            if (type_used && value_used) {
                self.had_error = true;
                diag_error(proc_def.loc, "generic parameter '%.*s' is used both as a type and as a value; declare it explicitly with ': type'",
                           cast(i32, gp.name.len), gp.name.data);
                continue;
            }

            if (!type_used) {
                gp.is_value = true;
            }
        }
    }

    proc eval_generic_value_arg(self, arg: AstGenericArg*, param: TypeParamInfo*) -> (i64, Type*, bool) {
        if (arg.is_value) {
            var t: Type* = self.analyze_expr(arg.value_expr, null);

            var (val, ok) = eval_const_int(arg.value_expr);

            if (!ok) {
                self.had_error = true;
                diag_error(arg.value_expr.loc, "value for generic parameter '%.*s' must be a constant expression",
                           cast(i32, param.name.len), param.name.data);
                return (0, null, false);
            }

            var vt: Type* = param.value_type;

            if (vt == null) {
                vt = t;
            }

            return (val, self.resolve_type(vt), true);
        }

        var tname: StrView = arg.arg_type.name;

        if (arg.arg_type.kind == TypeKind.TYPE_STRUCT && arg.arg_type.generic_arg_count == 0 && tname.len > 0) {
            var sym: Symbol* = self.lookup_visible(tname);

            if (sym != null && sym.kind == SymbolKind.SYM_CONST && sym.const_kind != ConstKind.CONST_FLOAT) {
                var vt: Type* = param.value_type;

                if (vt == null) {
                    vt = sym.symbol_type;
                }

                return (sym.const_val, self.resolve_type(vt), true);
            }
        }

        self.had_error = true;
        diag_error(arg.arg_type.loc, "expected a constant value for generic parameter '%.*s', but got a type",
                   cast(i32, param.name.len), param.name.data);

        return (0, null, false);
    }

    proc analyze_reflect_call(self, expr: AstExpr*, kind: ReflectKind, template_proc: AstProc*, expected_type: Type*) -> Type* {
        if (kind == ReflectKind.REFLECT_DIAG) {
            var msg: StrView = strview_from_raw(null, 0);

            if (expr.call_arg_count >= 1 && expr.call_args[0] != null &&
                expr.call_args[0].kind == AstExprKind.EXPR_STRING_LIT) {
                msg = expr.call_args[0].string_val;
            }

            self.had_error = true;

            if (template_proc != null && template_proc.name.equals_cstr("panic")) {
                if (msg.data != null) {
                    diag_error(expr.loc, "panic: %.*s", cast(i32, msg.len), msg.data);
                } else {
                    diag_error(expr.loc, "panic");
                }
            } else {
                if (msg.data != null) {
                    diag_error(expr.loc, "%.*s", cast(i32, msg.len), msg.data);
                } else {
                    diag_error(expr.loc, "compileError");
                }
            }

            expr.kind      = AstExprKind.EXPR_INT_LIT;
            expr.int_val   = 0;

            if (expected_type != null) {
                expr.expr_type = expected_type;
            } else {
                expr.expr_type = type_primitive(TypeKind.TYPE_VOID);
            }

            return expr.expr_type;
        }

        if (expr.call_arg_count < 1 || expr.call_args[0] == null ||
            expr.call_args[0].kind != AstExprKind.EXPR_TYPE_VALUE) {
            self.had_error = true;
            diag_error(expr.loc, "reflection builtin '%.*s' requires a type argument ('type T')",
                       cast(i32, expr.call_callee_name.len), expr.call_callee_name.data);
            expr.expr_type = type_primitive(TypeKind.TYPE_I64);
            return expr.expr_type;
        }

        var t: Type* = self.resolve_type(expr.call_args[0].type_value);

        if (kind == ReflectKind.REFLECT_TYPE_NAME || kind == ReflectKind.REFLECT_TYPE_INFO) {
            if (self.comptime_depth == 0) {
                self.had_error = true;
                diag_error(expr.loc, "reflection builtin '%.*s' can only be used at comptime",
                           cast(i32, expr.call_callee_name.len), expr.call_callee_name.data);
                expr.expr_type = type_primitive(TypeKind.TYPE_I64);
                return expr.expr_type;
            }

            expr.kind         = AstExprKind.EXPR_REFLECT;
            expr.reflect_kind = kind;
            expr.reflect_type = t;

            var saved_mod: u32 = self.current_module;

            self.set_module_context(template_proc.module_id);

            expr.expr_type = self.resolve_type(template_proc.return_type);

            self.set_module_context(saved_mod);

            return expr.expr_type;
        }

        var name: StrView = strview_from_raw(null, 0);

        if (expr.call_arg_count >= 2 && expr.call_args[1] != null &&
            expr.call_args[1].kind == AstExprKind.EXPR_STRING_LIT) {
            name = expr.call_args[1].string_val;
        } else {
            self.had_error = true;
            diag_error(expr.loc, "reflection builtin '%.*s' requires a string literal name argument",
                       cast(i32, expr.call_callee_name.len), expr.call_callee_name.data);
            expr.expr_type = type_primitive(TypeKind.TYPE_I64);
            return expr.expr_type;
        }

        var found: bool = false;

        if (t != null && (t.kind == TypeKind.TYPE_STRUCT || t.kind == TypeKind.TYPE_UNION)) {
            if (template_proc != null && template_proc.name.equals_cstr("hasField")) {
                for (var i: u64 = 0; i < t.field_count; i += 1) {
                    if (t.fields[i].name.equals(name)) {
                        found = true;
                        break;
                    }
                }
            } else {
                found = self.lookup_method_chain(t, name) != null;
            }
        }

        expr.kind      = AstExprKind.EXPR_INT_LIT;
        expr.expr_type = type_primitive(TypeKind.TYPE_BOOL);

        if (found) {
            expr.int_val = 1;
        } else {
            expr.int_val = 0;
        }

        return expr.expr_type;
    }

    proc split_comptime_call_args(self, expr: AstExpr*, template_proc: AstProc*) -> bool {
        var explicit_gen: u64 = template_proc.generic_param_count - template_proc.comptime_slot_count;

        var new_gcount: u64 = expr.call_generic_arg_count + template_proc.comptime_slot_count;
        var new_gargs: AstGenericArg* = alloc_array_zero[AstGenericArg](self.arena, new_gcount);

        for (var i: u64 = 0; i < expr.call_generic_arg_count; i += 1) {
            new_gargs[i] = expr.call_generic_args[i];
        }

        for (var i: u64 = 0; i < template_proc.comptime_slot_count; i += 1) {
            var slot: u64 = template_proc.comptime_slots[i];

            if (slot >= expr.call_arg_count) {
                self.had_error = true;
                diag_error(expr.loc, "missing argument for a comptime parameter of '%.*s'",
                           cast(i32, template_proc.display_name.len), template_proc.display_name.data);
                return false;
            }

            var arg_expr: AstExpr* = expr.call_args[slot];
            var dst: u64 = expr.call_generic_arg_count + i;
            var gi:  u64 = explicit_gen + i;

            if (template_proc.generic_params[gi].is_value) {
                new_gargs[dst].is_value   = true;
                new_gargs[dst].value_expr = arg_expr;
                continue;
            }

            if (arg_expr == null || arg_expr.kind != AstExprKind.EXPR_TYPE_VALUE) {
                self.had_error = true;
                diag_error(arg_expr.loc, "argument to comptime type parameter '%.*s' must be a type value",
                           cast(i32, template_proc.generic_params[gi].name.len), template_proc.generic_params[gi].name.data);
                return false;
            }

            self.analyze_expr(arg_expr, null);

            new_gargs[dst].is_value = false;
            new_gargs[dst].arg_type = arg_expr.type_value;
        }

        var new_arg_count: u64 = expr.call_arg_count - template_proc.comptime_slot_count;
        var new_args: AstExpr** = alloc_array[AstExpr*](self.arena, new_arg_count);

        var w: u64 = 0;

        for (var i: u64 = 0; i < expr.call_arg_count; i += 1) {
            var is_slot: bool = false;

            for (var s: u64 = 0; s < template_proc.comptime_slot_count; s += 1) {
                if (template_proc.comptime_slots[s] == i) {
                    is_slot = true;
                    break;
                }
            }

            if (!is_slot) {
                new_args[w] = expr.call_args[i];
                w += 1;
            }
        }

        expr.call_generic_args      = new_gargs;
        expr.call_generic_arg_count = new_gcount;
        expr.call_args              = new_args;
        expr.call_arg_count         = new_arg_count;

        return true;
    }

    proc resolve_generic_call_args(self, template_proc: AstProc*, expr: AstExpr*, expected_type: Type*) -> ([]Type*, []i64, []Type*, []AstStmt*, bool) {
        var n: u64 = template_proc.generic_param_count;

        var types:       []Type*    = alloc_array_zero[Type*](self.arena, n)[0..n];
        var values:      []i64      = alloc_array_zero[i64](self.arena, n)[0..n];
        var value_types: []Type*    = alloc_array_zero[Type*](self.arena, n)[0..n];
        var codes:       []AstStmt* = alloc_array_zero[AstStmt*](self.arena, n)[0..n];

        var explicit_count: u64 = expr.call_generic_arg_count;

        if (explicit_count > n) {
            self.had_error = true;
            diag_error(expr.loc, "generic procedure '%.*s' expects %llu generic arguments, got %llu",
                       cast(i32, template_proc.display_name.len), template_proc.display_name.data, n, explicit_count);
            return (types, values, value_types, codes, false);
        }

        for (var j: u64 = 0; j < explicit_count; j += 1) {
            var param: TypeParamInfo* = &template_proc.generic_params[j];
            var arg:   AstGenericArg* = &expr.call_generic_args[j];

            if (param.is_value) {
                if (arg.is_value && arg.value_expr != null && arg.value_expr.kind == AstExprKind.EXPR_CODE_BLOCK) {
                    var cb_t: Type* = self.analyze_expr(arg.value_expr, null);

                    if (cb_t == null || cb_t.kind != TypeKind.TYPE_CODE) {
                        self.had_error = true;
                        diag_error(arg.value_expr.loc, "value for generic parameter '%.*s' must be a code block",
                                   cast(i32, param.name.len), param.name.data);
                        return (types, values, value_types, codes, false);
                    }

                    codes[j]       = arg.value_expr.code_block;
                    values[j]      = cast(i64, arg.value_expr.code_block.code_id);
                    value_types[j] = type_primitive(TypeKind.TYPE_CODE);

                    continue;
                }

                var (val, vt, ok) = self.eval_generic_value_arg(arg, param);

                if (!ok) {
                    return (types, values, value_types, codes, false);
                }

                values[j]      = val;
                value_types[j] = vt;
            } else {
                if (arg.is_value) {
                    self.had_error = true;
                    diag_error(expr.loc, "generic parameter '%.*s' expects a type argument, but a value was provided",
                               cast(i32, param.name.len), param.name.data);
                    return (types, values, value_types, codes, false);
                }

                types[j] = self.resolve_type(arg.arg_type);
            }
        }

        for (var j: u64 = 0; j < n; j += 1) {
            var param: TypeParamInfo* = &template_proc.generic_params[j];

            if (param.is_value) {
                if (explicit_count > j) {
                    continue;
                }

                if (!param.has_default) {
                    self.had_error = true;
                    diag_error(expr.loc, "missing value for generic parameter '%.*s' of procedure '%.*s'",
                               cast(i32, param.name.len), param.name.data,
                               cast(i32, template_proc.display_name.len), template_proc.display_name.data);
                    return (types, values, value_types, codes, false);
                }

                var def_t: Type* = self.analyze_expr(param.default_expr, null);

                var (dval, dok) = eval_const_int(param.default_expr);

                if (!dok) {
                    self.had_error = true;
                    diag_error(param.default_expr.loc, "default value for generic parameter '%.*s' is not a constant expression",
                               cast(i32, param.name.len), param.name.data);
                    return (types, values, value_types, codes, false);
                }

                values[j] = dval;

                var vt: Type* = param.value_type;

                if (vt == null) {
                    vt = def_t;
                }

                value_types[j] = self.resolve_type(vt);
            } else {
                if (types[j] == null && param.has_default) {
                    types[j] = self.resolve_type(param.default_type);
                }
            }
        }

        var need_infer: bool = false;

        for (var j: u64 = 0; j < n; j += 1) {
            if (!template_proc.generic_params[j].is_value && types[j] == null) {
                need_infer = true;
                break;
            }
        }

        if (need_infer) {
            var inferred: []Type* = alloc_array_zero[Type*](self.arena, n)[0..n];

            for (var j: u64 = 0; j < n; j += 1) {
                inferred[j] = types[j];
            }

            if (expected_type != null && template_proc.return_type != null) {
                type_unify(template_proc.return_type, expected_type, inferred);
            }

            for (var i: u64 = 0; i < expr.call_arg_count && i < template_proc.param_count; i += 1) {
                var param_pattern: Type* = template_proc.params[i].param_type;
                var exp_arg_t:     Type* = null;

                if (param_pattern.kind == TypeKind.TYPE_PARAM && cast(u64, param_pattern.param.index) < n) {
                    exp_arg_t = inferred[param_pattern.param.index];
                }

                var arg_t: Type* = self.analyze_expr(expr.call_args[i], exp_arg_t);

                if (param_pattern.is_slice() && arg_t.kind == TypeKind.TYPE_ARRAY) {
                    expr.call_args[i] = ast_expr_slice(self.arena, expr.call_args[i], null, null, expr.call_args[i].loc);
                    arg_t = type_slice(self.arena, arg_t.array_elem);
                    expr.call_args[i].expr_type = arg_t;
                }

                type_unify(param_pattern, arg_t, inferred);
            }

            for (var j: u64 = 0; j < n; j += 1) {
                if (template_proc.generic_params[j].is_value) {
                    continue;
                }

                types[j] = inferred[j];

                if (types[j] == null) {
                    self.had_error = true;
                    diag_error(expr.loc, "could not infer type arguments for generic procedure '%.*s'",
                               cast(i32, template_proc.display_name.len), template_proc.display_name.data);
                    return (types, values, value_types, codes, false);
                }
            }
        }

        return (types, values, value_types, codes, true);
    }

    proc instantiate_generic_proc(self, template_proc: AstProc*, concrete_args: []Type*, concrete_values: []i64, value_arg_types: []Type*, concrete_codes: []AstStmt*, loc: SourceLoc) -> Symbol* {
        var mangled: StrView = mangle_generic_proc_name(self.arena, template_proc.name,
                                                        template_proc.generic_params[0..template_proc.generic_param_count],
                                                        concrete_args, concrete_values);

        var cached: AstProc* = self.registry.find_proc_instance(mangled);

        if (cached != null) {
            var existing: Symbol* = self.lookup_raw(mangled);

            if (existing != null) {
                return existing;
            }
        }

        var saved_module: u32 = self.current_module;

        self.set_module_context(template_proc.module_id);

        var inst_proc: AstProc* = alloc_zero[AstProc](self.arena);

        inst_proc.name                = mangled;
        inst_proc.method_struct       = template_proc.method_struct;
        inst_proc.display_name        = template_proc.display_name;
        inst_proc.generic_params      = null;
        inst_proc.generic_param_count = 0;
        inst_proc.is_generic          = false;
        inst_proc.param_count         = template_proc.param_count;
        inst_proc.params              = alloc_array[AstParam](self.arena, template_proc.param_count);
        inst_proc.module_id           = template_proc.module_id;
        inst_proc.value_args          = concrete_values.ptr;
        inst_proc.value_arg_count     = concrete_values.len;
        inst_proc.value_arg_types     = value_arg_types.ptr;
        inst_proc.value_codes         = concrete_codes.ptr;

        var depth_val: u32 = 0;

        if (template_proc.method_struct.len > 0) {
            depth_val = 1;
        }

        var env: TypeSubstEnv = TypeSubstEnv {
            depth:           depth_val,
            concrete_types:  concrete_args.ptr,
            concrete_values: concrete_values.ptr,
            count:           concrete_args.len,
            parent:          null,
            proc_template:   template_proc
        };

        var prev_env: TypeSubstEnv* = self.current_subst_env;
        self.current_subst_env      = &env;

        for (var p: u64 = 0; p < template_proc.param_count; p += 1) {
            inst_proc.params[p].name        = template_proc.params[p].name;
            inst_proc.params[p].loc         = template_proc.params[p].loc;
            inst_proc.params[p].param_type  = self.resolve_type(template_proc.params[p].param_type);
            inst_proc.params[p].is_comptime = template_proc.params[p].is_comptime;

            if (template_proc.params[p].default_value != null) {
                inst_proc.params[p].default_value = clone_expr(self.arena, template_proc.params[p].default_value);
            }
        }

        inst_proc.return_type      = self.resolve_type(template_proc.return_type);
        inst_proc.body             = clone_stmt(self.arena, template_proc.body);
        inst_proc.loc              = loc;
        inst_proc.attrs            = template_proc.attrs;
        inst_proc.generic_template = template_proc;

        for (var c: u64 = 0; c < concrete_codes.len; c += 1) {
            if (concrete_codes[c] != null) {
                inst_proc.attrs.is_inlined = true;
                break;
            }
        }

        var param_types: []Type* = alloc_array[Type*](self.arena, template_proc.param_count)[0..template_proc.param_count];

        for (var p: u64 = 0; p < template_proc.param_count; p += 1) {
            param_types[p] = inst_proc.params[p].param_type;
        }

        var proc_type: Type* = type_func(self.arena, inst_proc.return_type, param_types, inst_proc.is_variadic);

        var inst_sym: Symbol* = alloc_zero[Symbol](self.arena);

        inst_sym.kind         = SymbolKind.SYM_PROC;
        inst_sym.name         = inst_proc.name;
        inst_sym.symbol_type  = proc_type;
        inst_sym.loc          = inst_proc.loc;
        inst_sym.is_defined   = true;
        inst_sym.is_extern    = inst_proc.attrs.is_extern;
        inst_sym.attrs        = inst_proc.attrs;
        inst_sym.proc_decl    = inst_proc;
        inst_sym.display_name = template_proc.display_name;
        inst_sym.module_id    = template_proc.module_id;

        inst_proc.symbol     = inst_sym;

        inst_sym.next_homonym = self.lookup_raw(mangled);

        self.top_level.put(mangled, inst_sym);
        self.all_symbols.push(inst_sym);
        self.registry.cache_proc_instance(mangled, inst_proc);

        if (self.current_program != null) {
            var old_procs: AstProc** = self.current_program.procs;
            var new_count: u64       = self.current_program.proc_count + 1;
            var new_procs: AstProc** = alloc_array[AstProc*](self.arena, new_count);

            for (var i: u64 = 0; i < self.current_program.proc_count; i += 1) {
                new_procs[i] = old_procs[i];
            }

            new_procs[self.current_program.proc_count] = inst_proc;
            self.current_program.procs      = new_procs;
            self.current_program.proc_count = new_count;
        }

        self.analyze_proc_body(inst_proc);

        self.current_subst_env = prev_env;

        self.set_module_context(saved_module);

        return inst_sym;
    }

    proc resolve_size_align_type(self, expr: AstExpr*) -> Type* {
        if (expr.size_align_expr != null) {
            var et: Type* = self.analyze_expr(expr.size_align_expr, null);

            if (et == null || et.kind == TypeKind.TYPE_VOID) {
                self.had_error = true;
                diag_error(expr.loc, "cannot evaluate sizeof/alignof on a void or unknown expression");
                return type_primitive(TypeKind.TYPE_U64);
            }

            return et;
        }

        var target_t: Type* = expr.size_align_type;

        if (target_t != null && target_t.kind == TypeKind.TYPE_STRUCT &&
            target_t.generic_arg_count == 0 && target_t.field_count == 0 &&
            target_t.fields == null && target_t.type_param_count == 0 &&
            target_t.name.len > 0) {
            var sym: Symbol* = self.lookup_visible(target_t.name);

            if (sym != null && sym.symbol_type != null &&
                sym.symbol_type.kind != TypeKind.TYPE_FUNC &&
                sym.symbol_type.kind != TypeKind.TYPE_VOID) {
                return sym.symbol_type;
            }
        }

        return self.resolve_type(target_t);
    }

    proc append_default_args(self, expr: AstExpr*, callee_proc: AstProc*, param_count: u64) -> void {
        if (callee_proc == null) {
            return;
        }

        while (expr.call_arg_count < param_count) {
            var idx: u64 = expr.call_arg_count;

            if (idx >= callee_proc.param_count || callee_proc.params[idx].default_value == null) {
                return;
            }

            var new_count: u64 = expr.call_arg_count + 1;
            var new_args: []AstExpr* = alloc_array[AstExpr*](self.arena, new_count)[0..new_count];

            for (var i: u64 = 0; i < expr.call_arg_count; i += 1) {
                new_args[i] = expr.call_args[i];
            }

            new_args[expr.call_arg_count] = clone_expr(self.arena, callee_proc.params[idx].default_value);

            expr.call_args      = new_args.ptr;
            expr.call_arg_count = new_count;
        }
    }

    proc analyze_expr(self, expr: AstExpr*, expected_type: Type*) -> Type* {
        if (expr == null) {
            return type_primitive(TypeKind.TYPE_VOID);
        }

        switch (expr.kind) {
            case AstExprKind.EXPR_INT_LIT: {
                if (expected_type != null && expected_type.is_integer()) {
                    expr.expr_type = expected_type;
                } else if (expected_type != null && (expected_type.is_pointer() || expected_type.kind == TypeKind.TYPE_FUNC) && expr.int_val == 0) {
                    expr.expr_type = expected_type;
                } else if (expr.expr_type == null) {
                    expr.expr_type = type_primitive(TypeKind.TYPE_I64);
                }

                return expr.expr_type;
            }

            case AstExprKind.EXPR_FLOAT_LIT: {
                if (expected_type != null && expected_type.is_float()) {
                    expr.expr_type = expected_type;
                } else if (expr.expr_type == null) {
                    expr.expr_type = type_primitive(TypeKind.TYPE_F64);
                }

                return expr.expr_type;
            }

            case AstExprKind.EXPR_STRING_LIT: {
                if (expected_type != null && expected_type.is_slice() && type_is_byte_like(expected_type.slice_elem)) {
                    expr.expr_type = expected_type;
                    return expr.expr_type;
                }

                var char_t: Type* = type_primitive(TypeKind.TYPE_CHAR);
                expr.expr_type    = type_ptr(self.arena, char_t);

                return expr.expr_type;
            }

            case AstExprKind.EXPR_NULL: {
                if (expected_type != null && (expected_type.is_pointer() || expected_type.kind == TypeKind.TYPE_FUNC)) {
                    expr.expr_type = expected_type;
                } else {
                    expr.expr_type = type_primitive(TypeKind.TYPE_NULL);
                }

                return expr.expr_type;
            }

            case AstExprKind.EXPR_VAR: {
                var sym: Symbol* = expr.var_symbol;

                if (sym == null) {
                    sym = self.lookup_visible(expr.var_name);
                }

                if (sym == null) {
                    self.had_error = true;
                    diag_error(expr.loc, "use of undeclared identifier '%.*s'", cast(i32, expr.var_name.len), expr.var_name.data);
                    expr.expr_type = type_primitive(TypeKind.TYPE_I64);
                    return expr.expr_type;
                }

                if (sym.kind == SymbolKind.SYM_PROC && sym.attrs.is_inlined && !sym.attrs.is_exported) {
                    self.had_error = true;
                    diag_error(expr.loc, "cannot take address of inline procedure '%.*s'", cast(i32, sym.display().len), sym.display().data);
                }

                expr.var_symbol = sym;
                expr.expr_type  = sym.symbol_type;

                return expr.expr_type;
            }

            case AstExprKind.EXPR_UNARY: {
                var op_t: Type* = self.analyze_expr(expr.unary_operand, null);
                expr.unary_operand.expr_type = op_t;

                var (rewritten, is_rewritten) = try_rewrite_unary_op(self, expr);

                if (is_rewritten) {
                    *expr = *rewritten;
                    return self.analyze_expr(expr, expected_type);
                }

                if (expr.unary_op == TokenKind.TOK_STAR) {
                    if (!op_t.is_pointer()) {
                        var ts: StrView = op_t.to_str(self.arena);
                        self.had_error  = true;
                        diag_error(expr.loc, "cannot dereference non-pointer type '%.*s'", cast(i32, ts.len), ts.data);
                        expr.expr_type = type_primitive(TypeKind.TYPE_I64);
                        return expr.expr_type;
                    }

                    expr.expr_type = op_t.base_type;
                    return expr.expr_type;
                }

                if (expr.unary_op == TokenKind.TOK_AMP) {
                    if (!expr_is_lvalue(expr.unary_operand)) {
                        self.had_error = true;
                        diag_error(expr.loc, "cannot take address of non-lvalue expression");
                    }

                    var ptr_t: Type* = type_ptr(self.arena, op_t);

                    if (expr_is_const_lvalue(expr.unary_operand)) {
                        ptr_t.base_type = type_with_const(self.arena, op_t);
                    }

                    expr.expr_type = ptr_t;
                    return expr.expr_type;
                }

                if (expr.unary_op == TokenKind.TOK_MINUS || expr.unary_op == TokenKind.TOK_PLUS) {
                    if (!op_t.is_arithmetic()) {
                        var ts: StrView = op_t.to_str(self.arena);
                        self.had_error  = true;
                        diag_error(expr.loc, "unary operator requires numeric operand, got '%.*s'", cast(i32, ts.len), ts.data);
                    }

                    expr.expr_type = type_arithmetic_promote(op_t);
                    return expr.expr_type;
                }

                if (expr.unary_op == TokenKind.TOK_TILDE) {
                    if (!op_t.is_integer()) {
                        var ts: StrView = op_t.to_str(self.arena);
                        self.had_error  = true;
                        diag_error(expr.loc, "bitwise complement requires integer operand, got '%.*s'", cast(i32, ts.len), ts.data);
                    }

                    expr.expr_type = type_integer_promote(op_t);
                    return expr.expr_type;
                }

                if (expr.unary_op == TokenKind.TOK_BANG) {
                    expr.expr_type = type_primitive(TypeKind.TYPE_BOOL);
                    return expr.expr_type;
                }

                expr.expr_type = op_t;
                return expr.expr_type;
            }

            case AstExprKind.EXPR_BINARY: {
                var lhs_t: Type* = self.analyze_expr(expr.binary_lhs, null);
                expr.binary_lhs.expr_type = lhs_t;

                var (rewritten, is_rewritten) = try_rewrite_binary_op(self, expr);

                if (is_rewritten) {
                    *expr = *rewritten;
                    return self.analyze_expr(expr, expected_type);
                }

                var exp_rhs: Type* = lhs_t;

                if (lhs_t.is_pointer()) {
                    exp_rhs = type_primitive(TypeKind.TYPE_I64);
                }

                var rhs_t: Type* = self.analyze_expr(expr.binary_rhs, exp_rhs);
                expr.binary_rhs.expr_type = rhs_t;

                switch (expr.binary_op) {
                    case TokenKind.TOK_AMP_AMP, TokenKind.TOK_PIPE_PIPE: {
                        expr.expr_type = type_primitive(TypeKind.TYPE_BOOL);
                        return expr.expr_type;
                    }

                    case TokenKind.TOK_EQ_EQ, TokenKind.TOK_BANG_EQ,
                         TokenKind.TOK_LESS, TokenKind.TOK_LESS_EQ,
                         TokenKind.TOK_GREATER, TokenKind.TOK_GREATER_EQ: {

                        if (!types_are_compatible(lhs_t, rhs_t)) {
                            var ts1: StrView = lhs_t.to_str(self.arena);
                            var ts2: StrView = rhs_t.to_str(self.arena);

                            self.had_error = true;
                            diag_error(expr.loc, "comparison between incompatible types '%.*s' and '%.*s'",
                                       cast(i32, ts1.len), ts1.data,
                                       cast(i32, ts2.len), ts2.data);
                        }

                        expr.expr_type = type_primitive(TypeKind.TYPE_BOOL);
                        return expr.expr_type;
                    }

                    case TokenKind.TOK_SHL, TokenKind.TOK_SHR: {
                        if (!lhs_t.is_integer() || !rhs_t.is_integer()) {
                            var ts1: StrView = lhs_t.to_str(self.arena);
                            var ts2: StrView = rhs_t.to_str(self.arena);

                            self.had_error = true;
                            diag_error(expr.loc, "shift operator requires integer types, got '%.*s' and '%.*s'",
                                       cast(i32, ts1.len), ts1.data,
                                       cast(i32, ts2.len), ts2.data);
                        }

                        expr.expr_type = type_integer_promote(lhs_t);
                        return expr.expr_type;
                    }

                    case TokenKind.TOK_PLUS, TokenKind.TOK_MINUS: {
                        if (lhs_t.is_pointer() && rhs_t.is_integer()) {
                            expr.expr_type = lhs_t;
                            return expr.expr_type;
                        }

                        if (!types_are_compatible(lhs_t, rhs_t)) {
                            var ts1: StrView = lhs_t.to_str(self.arena);
                            var ts2: StrView = rhs_t.to_str(self.arena);

                            self.had_error = true;
                            diag_error(expr.loc, "binary operator requires compatible types, got '%.*s' and '%.*s'",
                                       cast(i32, ts1.len), ts1.data,
                                       cast(i32, ts2.len), ts2.data);
                        }

                        expr.expr_type = type_common_arithmetic(lhs_t, rhs_t);
                        return expr.expr_type;
                    }

                    case TokenKind.TOK_STAR, TokenKind.TOK_SLASH: {
                        if (!lhs_t.is_arithmetic() || !rhs_t.is_arithmetic()) {
                            var ts1: StrView = lhs_t.to_str(self.arena);
                            var ts2: StrView = rhs_t.to_str(self.arena);

                            self.had_error = true;
                            diag_error(expr.loc, "arithmetic operator requires numeric types, got '%.*s' and '%.*s'",
                                       cast(i32, ts1.len), ts1.data,
                                       cast(i32, ts2.len), ts2.data);
                        }

                        expr.expr_type = type_common_arithmetic(lhs_t, rhs_t);
                        return expr.expr_type;
                    }

                    case TokenKind.TOK_PERCENT,
                         TokenKind.TOK_AMP, TokenKind.TOK_PIPE, TokenKind.TOK_CARET: {

                        if (!lhs_t.is_integer() || !rhs_t.is_integer()) {
                            var ts1: StrView = lhs_t.to_str(self.arena);
                            var ts2: StrView = rhs_t.to_str(self.arena);

                            self.had_error = true;
                            diag_error(expr.loc, "bitwise/arithmetic operator requires integer types, got '%.*s' and '%.*s'",
                                       cast(i32, ts1.len), ts1.data,
                                       cast(i32, ts2.len), ts2.data);
                        }

                        expr.expr_type = type_common_arithmetic(lhs_t, rhs_t);
                        return expr.expr_type;
                    }

                    default: {}
                }

                expr.expr_type = lhs_t;
                return expr.expr_type;
            }

            case AstExprKind.EXPR_INDEX: {
                var ptr_t: Type* = self.analyze_expr(expr.index_ptr, null);
                expr.index_ptr.expr_type = ptr_t;

                var (rewritten, is_rewritten) = try_rewrite_index(self, expr);

                if (is_rewritten) {
                    *expr = *rewritten;
                    return self.analyze_expr(expr, expected_type);
                }

                var idx_t: Type* = self.analyze_expr(expr.index_index, type_primitive(TypeKind.TYPE_U64));

                if (ptr_t.kind == TypeKind.TYPE_ARRAY) {
                    expr.expr_type = ptr_t.array_elem;
                    return expr.expr_type;
                }

                if (ptr_t.is_slice()) {
                    if (!idx_t.is_integer()) {
                        var ts: StrView = idx_t.to_str(self.arena);
                        self.had_error  = true;
                        diag_error(expr.loc, "slice index must be an integer, got '%.*s'", cast(i32, ts.len), ts.data);
                    }

                    expr.expr_type = ptr_t.slice_elem;
                    return expr.expr_type;
                }

                if (!ptr_t.is_pointer()) {
                    var ts: StrView = ptr_t.to_str(self.arena);
                    self.had_error  = true;
                    diag_error(expr.loc, "subscripted value is not an array, slice or pointer, got '%.*s'", cast(i32, ts.len), ts.data);
                    expr.expr_type = type_primitive(TypeKind.TYPE_I64);
                    return expr.expr_type;
                }

                if (!idx_t.is_integer()) {
                    var ts: StrView = idx_t.to_str(self.arena);
                    self.had_error  = true;
                    diag_error(expr.loc, "index must be an integer, got '%.*s'", cast(i32, ts.len), ts.data);
                }

                expr.expr_type = ptr_t.base_type;
                return expr.expr_type;
            }

            case AstExprKind.EXPR_CAST: {
                expr.cast_target_type = self.resolve_type(expr.cast_target_type);
                self.analyze_expr(expr.cast_expr, expr.cast_target_type);

                expr.expr_type = expr.cast_target_type;
                return expr.expr_type;
            }

            case AstExprKind.EXPR_SIZEOF: {
                var target_t: Type* = self.resolve_size_align_type(expr);

                if (target_t == null) {
                    self.had_error = true;
                    diag_error(expr.loc, "cannot evaluate sizeof on unknown type");
                    expr.expr_type = type_primitive(TypeKind.TYPE_U64);
                    return expr.expr_type;
                }

                expr.kind      = AstExprKind.EXPR_INT_LIT;
                expr.int_val   = cast(i64, target_t.size);
                expr.expr_type = type_primitive(TypeKind.TYPE_U64);

                return expr.expr_type;
            }

            case AstExprKind.EXPR_ALIGNOF: {
                var target_t: Type* = self.resolve_size_align_type(expr);

                if (target_t == null) {
                    self.had_error = true;
                    diag_error(expr.loc, "cannot evaluate alignof on unknown type");
                    expr.expr_type = type_primitive(TypeKind.TYPE_U64);
                    return expr.expr_type;
                }

                var align_val: u64 = target_t.align;

                if (align_val == 0) {
                    align_val = 1;
                }

                expr.kind      = AstExprKind.EXPR_INT_LIT;
                expr.int_val   = cast(i64, align_val);
                expr.expr_type = type_primitive(TypeKind.TYPE_U64);

                return expr.expr_type;
            }

            case AstExprKind.EXPR_OFFSETOF: {
                var st: Type* = self.resolve_type(expr.offset_struct_type);

                if (st != null && st.is_pointer()) {
                    st = st.base_type;
                }

                if (st == null || (st.kind != TypeKind.TYPE_STRUCT && st.kind != TypeKind.TYPE_UNION)) {
                    var ts: StrView = strview_from_cstr("<null>");

                    if (st != null) {
                        ts = st.to_str(self.arena);
                    }

                    self.had_error = true;
                    diag_error(expr.loc, "offsetof requires struct or union type, got '%.*s'", cast(i32, ts.len), ts.data);
                    expr.expr_type = type_primitive(TypeKind.TYPE_U64);
                    return expr.expr_type;
                }

                var field: StructField* = st.lookup_field(expr.offset_field_name);

                if (field == null) {
                    self.had_error = true;
                    diag_error(expr.loc, "type '%.*s' has no field named '%.*s'",
                               cast(i32, st.name.len), st.name.data,
                               cast(i32, expr.offset_field_name.len), expr.offset_field_name.data);
                    expr.expr_type = type_primitive(TypeKind.TYPE_U64);
                    return expr.expr_type;
                }

                expr.kind      = AstExprKind.EXPR_INT_LIT;
                expr.int_val   = cast(i64, field.offset);
                expr.expr_type = type_primitive(TypeKind.TYPE_U64);

                return expr.expr_type;
            }

            case AstExprKind.EXPR_ALLOCA: {
                var elem_t: Type* = self.resolve_type(expr.alloca_elem_type);

                if (elem_t == null || elem_t.kind == TypeKind.TYPE_VOID || elem_t.size == 0) {
                    self.had_error = true;
                    diag_error(expr.loc, "cannot allocate zero-sized or void type with alloca");
                    expr.expr_type = type_ptr(self.arena, type_primitive(TypeKind.TYPE_U8));
                    return expr.expr_type;
                }

                var count_t: Type* = self.analyze_expr(expr.alloca_count_expr, type_primitive(TypeKind.TYPE_U64));

                if (!count_t.is_integer()) {
                    var ts: StrView = count_t.to_str(self.arena);
                    self.had_error  = true;
                    diag_error(expr.alloca_count_expr.loc, "alloca count must be an integer, got '%.*s'", cast(i32, ts.len), ts.data);
                }

                expr.alloca_elem_type = elem_t;
                expr.expr_type        = type_ptr(self.arena, elem_t);

                return expr.expr_type;
            }

            case AstExprKind.EXPR_ASM: {
                for (var i: u64 = 0; i < expr.asm_input_count; i += 1) {
                    var in_op:     AsmOperand* = &expr.asm_inputs[i];
                    var reg_bytes: u64         = 0;
                    var r:         X86Reg      = parse_reg_name(in_op.reg_name, &reg_bytes);

                    if (r == X86Reg.REG_NONE) {
                        self.had_error = true;
                        diag_error(in_op.loc, "unknown register \"%.*s\" in asm input",
                                   cast(i32, in_op.reg_name.len), in_op.reg_name.data);
                    }

                    in_op.reg       = r;
                    in_op.byte_size = reg_bytes;

                    var in_t:      Type* = self.analyze_expr(in_op.expr, null);
                    var val_bytes: u64   = 8;

                    if (in_t != null && in_t.size != 0) {
                        val_bytes = in_t.size;
                    }

                    if (reg_bytes > 0 && val_bytes > reg_bytes) {
                        self.had_error = true;
                        diag_error(in_op.loc,
                                   "expression of size %llu does not fit in register \"%.*s\" (%llu bytes)",
                                   val_bytes,
                                   cast(i32, in_op.reg_name.len), in_op.reg_name.data,
                                   reg_bytes);
                    }
                }

                for (var i: u64 = 0; i < expr.asm_output_count; i += 1) {
                    var out_op:    AsmOperand* = &expr.asm_outputs[i];
                    var reg_bytes: u64         = 0;
                    var r:         X86Reg      = parse_reg_name(out_op.reg_name, &reg_bytes);

                    if (r == X86Reg.REG_NONE) {
                        self.had_error = true;
                        diag_error(out_op.loc, "unknown register \"%.*s\" in asm output",
                                   cast(i32, out_op.reg_name.len), out_op.reg_name.data);
                    }

                    out_op.reg       = r;
                    out_op.byte_size = reg_bytes;

                    if (out_op.expr != null) {
                        var out_t: Type* = self.analyze_expr(out_op.expr, null);

                        if (!expr_is_lvalue(out_op.expr)) {
                            self.had_error = true;
                            diag_error(out_op.loc, "asm output target is not a valid lvalue");
                        }

                        var target_bytes: u64 = 8;

                        if (out_t != null && out_t.size != 0) {
                            target_bytes = out_t.size;
                        }

                        if (reg_bytes > 0 && target_bytes > reg_bytes) {
                            self.had_error = true;
                            diag_error(out_op.loc,
                                       "variable of size %llu cannot receive from register \"%.*s\" (%llu bytes)",
                                       target_bytes,
                                       cast(i32, out_op.reg_name.len), out_op.reg_name.data,
                                       reg_bytes);
                        }
                    }
                }

                if (expr.asm_explicit_type != null) {
                    expr.asm_explicit_type = self.resolve_type(expr.asm_explicit_type);
                    expr.expr_type         = expr.asm_explicit_type;
                } else if (expected_type != null && expected_type.kind != TypeKind.TYPE_VOID) {
                    expr.expr_type = expected_type;
                } else {
                    expr.expr_type = type_primitive(TypeKind.TYPE_VOID);
                }

                return expr.expr_type;
            }

            case AstExprKind.EXPR_MEMBER: {
                if (self.try_namespace_member(expr)) {
                    if (expr.kind == AstExprKind.EXPR_VAR) {
                        return self.analyze_expr(expr, expected_type);
                    }

                    return expr.expr_type;
                }

                var target_t: Type* = self.analyze_expr(expr.member_target, null);
                expr.member_target.expr_type = target_t;

                if (target_t != null && target_t.is_interface) {
                    self.had_error = true;
                    diag_error(expr.loc, "interface '%.*s' exposes no fields; only interface methods can be called on it",
                               cast(i32, target_t.name.len), target_t.name.data);
                    expr.expr_type = type_primitive(TypeKind.TYPE_I64);
                    return expr.expr_type;
                }

                if (target_t != null && target_t.is_slice()) {
                    if (expr.member_field_name.equals_cstr("ptr")) {
                        expr.expr_type = type_ptr(self.arena, target_t.slice_elem);
                        return expr.expr_type;
                    }

                    if (expr.member_field_name.equals_cstr("len")) {
                        expr.expr_type = type_primitive(TypeKind.TYPE_U64);
                        return expr.expr_type;
                    }

                    var ts: StrView = target_t.to_str(self.arena);
                    self.had_error  = true;
                    diag_error(expr.loc, "slice type '%.*s' has no field named '%.*s' (expected 'ptr' or 'len')",
                               cast(i32, ts.len), ts.data,
                               cast(i32, expr.member_field_name.len), expr.member_field_name.data);
                    expr.expr_type = type_primitive(TypeKind.TYPE_I64);
                    return expr.expr_type;
                }

                if (target_t != null && target_t.kind == TypeKind.TYPE_ENUM) {
                    var v: EnumVariant* = target_t.lookup_variant(expr.member_field_name);

                    if (v == null) {
                        self.had_error = true;
                        diag_error(expr.loc, "enum '%.*s' has no variant named '%.*s'",
                                   cast(i32, target_t.name.len), target_t.name.data,
                                   cast(i32, expr.member_field_name.len), expr.member_field_name.data);
                        expr.expr_type = target_t;
                        return expr.expr_type;
                    }

                    expr.kind      = AstExprKind.EXPR_INT_LIT;
                    expr.int_val   = v.value;
                    expr.expr_type = target_t;

                    return expr.expr_type;
                }

                var struct_t: Type* = target_t;

                if (target_t != null && target_t.is_pointer()) {
                    struct_t = target_t.base_type;
                }

                struct_t = self.resolve_type(struct_t);

                if (struct_t == null || (struct_t.kind != TypeKind.TYPE_STRUCT && struct_t.kind != TypeKind.TYPE_UNION)) {
                    var ts: StrView = strview_from_cstr("<null>");

                    if (target_t != null) {
                        ts = target_t.to_str(self.arena);
                    }

                    self.had_error = true;
                    diag_error(expr.loc, "member access on non-aggregate type '%.*s'", cast(i32, ts.len), ts.data);
                    expr.expr_type = type_primitive(TypeKind.TYPE_I64);
                    return expr.expr_type;
                }

                var field: StructField* = struct_t.lookup_field(expr.member_field_name);

                if (field == null) {
                    self.had_error = true;
                    diag_error(expr.loc, "aggregate '%.*s' has no field named '%.*s'",
                               cast(i32, struct_t.name.len), struct_t.name.data,
                               cast(i32, expr.member_field_name.len), expr.member_field_name.data);
                    expr.expr_type = type_primitive(TypeKind.TYPE_I64);
                    return expr.expr_type;
                }

                if (field.is_private && struct_t.module_id != self.current_module) {
                    self.had_error = true;
                    diag_error(expr.loc, "field '%.*s' of struct '%.*s' is private",
                               cast(i32, expr.member_field_name.len), expr.member_field_name.data,
                               cast(i32, struct_t.name.len), struct_t.name.data);
                    expr.expr_type = type_primitive(TypeKind.TYPE_I64);
                    return expr.expr_type;
                }

                expr.member_field = field;
                expr.expr_type    = field.field_type;

                return expr.expr_type;
            }

            case AstExprKind.EXPR_STRUCT_LIT: {
                var (lit_base, lit_mod, lit_qual) = self.registry.split_qualified_name(expr.struct_lit_name);

                var s_entry: StructEntry* = self.registry.find_struct(lit_base);
                var struct_t: Type* = null;
                var lit_is_public: bool = false;

                if (s_entry != null) {
                    struct_t = s_entry.struct_type;

                    if (s_entry.def != null) {
                        lit_is_public = s_entry.def.is_public;
                    }
                }

                if (struct_t == null) {
                    var u_entry: UnionEntry* = self.registry.find_union(lit_base);

                    if (u_entry != null) {
                        struct_t = u_entry.union_type;

                        if (u_entry.def != null) {
                            lit_is_public = u_entry.def.is_public;
                        }
                    }
                }

                if (struct_t != null &&
                    !self.registry.check_type_module(lit_base, struct_t.module_id, lit_qual, lit_mod, lit_is_public, "type", expr.loc)) {
                    self.had_error = true;
                    expr.expr_type = type_primitive(TypeKind.TYPE_I64);
                    return expr.expr_type;
                }

                if (struct_t == null && expr.struct_lit_type_arg_count > 0) {
                    var gen_type: Type* = alloc_zero[Type](self.arena);

                    gen_type.kind                = TypeKind.TYPE_STRUCT;
                    gen_type.name                = expr.struct_lit_name;
                    gen_type.generic_args        = expr.struct_lit_type_args;
                    gen_type.generic_arg_count   = expr.struct_lit_type_arg_count;
                    gen_type.generic_arg_is_value = expr.struct_lit_arg_is_value;
                    gen_type.generic_value_exprs = expr.struct_lit_value_exprs;
                    gen_type.size                = 8;
                    gen_type.align               = 8;

                    struct_t = self.resolve_type(gen_type);
                }

                if (struct_t == null) {
                    var gen_default: Type* = alloc_zero[Type](self.arena);

                    gen_default.kind = TypeKind.TYPE_STRUCT;
                    gen_default.name = expr.struct_lit_name;
                    gen_default.size = 8;
                    gen_default.align = 8;

                    struct_t = self.registry.resolve_struct_with_defaults(self.arena, gen_default, null, null);

                    if (struct_t != null) {
                        var gen_def: AstStructDef* = self.registry.find_generic_struct(lit_base);

                        if (gen_def != null) {
                            lit_is_public = gen_def.is_public;
                        }
                    }
                }

                if (struct_t == null) {
                    self.had_error = true;
                    diag_error(expr.loc, "unknown aggregate type '%.*s'", cast(i32, expr.struct_lit_name.len), expr.struct_lit_name.data);
                    expr.expr_type = type_primitive(TypeKind.TYPE_I64);
                    return expr.expr_type;
                }

                expr.struct_lit_type = struct_t;

                if (struct_t.is_polymorphic()) {
                    var poly_entry: StructEntry* = self.registry.find_struct(struct_t.name);

                    if (poly_entry != null && poly_entry.def != null) {
                        var poly_def: AstStructDef* = poly_entry.def;

                        for (var s: u64 = 0; s < poly_def.virtual_slot_count; s += 1) {
                            if (poly_def.virtual_slots[s].is_abstract) {
                                self.had_error = true;
                                diag_error(expr.loc, "cannot instantiate abstract struct '%.*s': virtual method '%.*s' is not implemented",
                                           cast(i32, struct_t.name.len), struct_t.name.data,
                                           cast(i32, poly_def.virtual_slots[s].method_name.len),
                                           poly_def.virtual_slots[s].method_name.data);
                                break;
                            }
                        }
                    }
                }

                for (var i: u64 = 0; i < expr.struct_lit_field_count; i += 1) {
                    var fname: StrView = expr.struct_lit_field_names[i];
                    var f: StructField* = struct_t.lookup_field(fname);

                    if (fname.equals_cstr("__vptr")) {
                        self.had_error = true;
                        diag_error(expr.loc, "cannot initialize hidden field '__vptr' of polymorphic struct '%.*s'",
                                   cast(i32, struct_t.name.len), struct_t.name.data);
                        continue;
                    }

                    if (f == null) {
                        self.had_error = true;
                        diag_error(expr.loc, "aggregate '%.*s' has no field named '%.*s'",
                                   cast(i32, struct_t.name.len), struct_t.name.data,
                                   cast(i32, fname.len), fname.data);
                        continue;
                    }

                    if (f.is_private && struct_t.module_id != self.current_module) {
                        self.had_error = true;
                        diag_error(expr.loc, "field '%.*s' of struct '%.*s' is private",
                                   cast(i32, fname.len), fname.data,
                                   cast(i32, struct_t.name.len), struct_t.name.data);
                        continue;
                    }

                    for (var prev_idx: u64 = 0; prev_idx < i; prev_idx += 1) {
                        if (expr.struct_lit_field_names[prev_idx].equals(fname)) {
                            self.had_error = true;
                            diag_error(expr.loc, "duplicate field '%.*s' in struct literal", cast(i32, fname.len), fname.data);
                            break;
                        }
                    }

                    var val_t: Type* = self.analyze_expr(expr.struct_lit_field_values[i], f.field_type);

                    if (f.field_type != null && f.field_type.is_slice() && val_t.kind == TypeKind.TYPE_ARRAY) {
                        expr.struct_lit_field_values[i] = ast_expr_slice(self.arena, expr.struct_lit_field_values[i], null, null, expr.struct_lit_field_values[i].loc);
                        val_t = self.analyze_expr(expr.struct_lit_field_values[i], f.field_type);
                    }
                }

                expr.expr_type = struct_t;
                return expr.expr_type;
            }

            case AstExprKind.EXPR_ARRAY_LIT: {
                var exp_elem: Type* = null;

                if (expected_type != null) {
                    if (expected_type.kind == TypeKind.TYPE_ARRAY) {
                        exp_elem = expected_type.array_elem;
                    } else if (expected_type.is_slice()) {
                        exp_elem = expected_type.slice_elem;
                    }
                }

                if (expr.array_count == 0) {
                    if (exp_elem == null) {
                        exp_elem = type_primitive(TypeKind.TYPE_VOID);
                    }

                    expr.expr_type = type_array(self.arena, exp_elem, 0);
                    return expr.expr_type;
                }

                var elem_types: []Type* = alloc_array[Type*](self.arena, expr.array_count)[0..expr.array_count];

                for (var i: u64 = 0; i < expr.array_count; i += 1) {
                    elem_types[i] = self.analyze_expr(expr.array_elements[i], exp_elem);

                    if (exp_elem == null && elem_types[i].kind != TypeKind.TYPE_VOID) {
                        exp_elem = elem_types[i];
                    }
                }

                if (exp_elem == null) {
                    exp_elem = type_primitive(TypeKind.TYPE_I64);
                }

                for (var i: u64 = 0; i < expr.array_count; i += 1) {
                    if (!types_are_compatible(exp_elem, elem_types[i])) {
                        var ts1: StrView = elem_types[i].to_str(self.arena);
                        var ts2: StrView = exp_elem.to_str(self.arena);

                        self.had_error = true;
                        diag_error(expr.array_elements[i].loc,
                                   "array element %llu has type '%.*s', incompatible with expected element type '%.*s'",
                                   i + 1,
                                   cast(i32, ts1.len), ts1.data,
                                   cast(i32, ts2.len), ts2.data);
                    }
                }

                expr.expr_type = type_array(self.arena, exp_elem, expr.array_count);
                return expr.expr_type;
            }

            case AstExprKind.EXPR_SLICE: {
                var exp_target: Type* = null;

                if (expected_type != null && expected_type.is_slice()) {
                    exp_target = type_array(self.arena, expected_type.slice_elem, 0);
                }

                var target_t: Type* = self.analyze_expr(expr.slice_target, exp_target);
                expr.slice_target.expr_type = target_t;

                var (rewritten, is_rewritten) = try_rewrite_slice(self, expr);

                if (is_rewritten) {
                    *expr = *rewritten;
                    return self.analyze_expr(expr, expected_type);
                }

                var elem_t: Type* = null;

                if (target_t.kind == TypeKind.TYPE_ARRAY) {
                    elem_t = target_t.array_elem;
                } else if (target_t.is_slice()) {
                    elem_t = target_t.slice_elem;
                } else if (target_t.is_pointer()) {
                    elem_t = target_t.base_type;

                    if (expr.slice_end == null) {
                        self.had_error = true;
                        diag_error(expr.loc, "cannot slice raw pointer without explicit end index");
                    }
                } else {
                    var ts: StrView = target_t.to_str(self.arena);
                    self.had_error  = true;
                    diag_error(expr.loc, "cannot slice non-indexable type '%.*s'", cast(i32, ts.len), ts.data);
                    expr.expr_type = type_slice(self.arena, type_primitive(TypeKind.TYPE_VOID));
                    return expr.expr_type;
                }

                if (elem_t != null && elem_t.kind == TypeKind.TYPE_VOID &&
                    expected_type != null && expected_type.is_slice()) {

                    elem_t = expected_type.slice_elem;
                }

                if (expr.slice_start != null) {
                    var start_t: Type* = self.analyze_expr(expr.slice_start, type_primitive(TypeKind.TYPE_U64));

                    if (!start_t.is_integer()) {
                        var ts: StrView = start_t.to_str(self.arena);
                        self.had_error  = true;
                        diag_error(expr.slice_start.loc, "slice start index must be an integer, got '%.*s'", cast(i32, ts.len), ts.data);
                    }
                }

                if (expr.slice_end != null) {
                    var end_t: Type* = self.analyze_expr(expr.slice_end, type_primitive(TypeKind.TYPE_U64));

                    if (!end_t.is_integer()) {
                        var ts: StrView = end_t.to_str(self.arena);
                        self.had_error  = true;
                        diag_error(expr.slice_end.loc, "slice end index must be an integer, got '%.*s'", cast(i32, ts.len), ts.data);
                    }
                }

                expr.expr_type = type_slice(self.arena, elem_t);
                return expr.expr_type;
            }

            case AstExprKind.EXPR_TUPLE: {
                var elem_types: []Type* = alloc_array[Type*](self.arena, expr.tuple_count)[0..expr.tuple_count];

                for (var i: u64 = 0; i < expr.tuple_count; i += 1) {
                    var exp_elem: Type* = null;

                    if (expected_type != null && expected_type.is_tuple() && i < expected_type.tuple_count) {
                        exp_elem = expected_type.tuple_elements[i];
                    }

                    elem_types[i] = self.analyze_expr(expr.tuple_elements[i], exp_elem);

                    if (exp_elem != null && exp_elem.is_slice() && elem_types[i].kind == TypeKind.TYPE_ARRAY) {
                        expr.tuple_elements[i] = ast_expr_slice(self.arena, expr.tuple_elements[i], null, null, expr.tuple_elements[i].loc);
                        elem_types[i] = self.analyze_expr(expr.tuple_elements[i], exp_elem);
                    }
                }

                expr.expr_type = type_tuple(self.arena, elem_types);
                return expr.expr_type;
            }

            case AstExprKind.EXPR_CALL: {
                if (expr.call_is_method) {
                    var (ns_handled, ns_ok) = self.try_namespace_call(expr);

                    if (ns_handled && !ns_ok) {
                        return expr.expr_type;
                    }
                }

                if (expr.call_is_method) {
                    var receiver_t: Type* = self.analyze_expr(expr.call_args[0], null);
                    var struct_t:   Type* = receiver_t;

                    if (struct_t.is_pointer()) {
                        struct_t = struct_t.base_type;
                    }

                    struct_t = self.resolve_type(struct_t);

                    if (struct_t == null || (struct_t.kind != TypeKind.TYPE_STRUCT && struct_t.kind != TypeKind.TYPE_UNION)) {
                        var ts: StrView = receiver_t.to_str(self.arena);
                        self.had_error  = true;
                        diag_error(expr.loc, "method call on non-aggregate receiver of type '%.*s'", cast(i32, ts.len), ts.data);
                        expr.expr_type = type_primitive(TypeKind.TYPE_I64);
                        return expr.expr_type;
                    }

                    var proc_t:      Type*    = null;
                    var callee_proc: AstProc* = null;

                    if (struct_t.is_interface) {
                        var sig:  AstProc* = null;
                        var slot: i64      = -1;

                        for (var mi: u64 = 0; mi < struct_t.iface_def.method_count; mi += 1) {
                            if (struct_t.iface_def.methods[mi].orig_name.equals(expr.call_callee_name)) {
                                sig  = struct_t.iface_def.methods[mi];
                                slot = cast(i64, mi);
                                break;
                            }
                        }

                        if (sig == null) {
                            self.had_error = true;
                            diag_error(expr.loc, "interface '%.*s' has no method '%.*s'",
                                       cast(i32, struct_t.name.len), struct_t.name.data,
                                       cast(i32, expr.call_callee_name.len), expr.call_callee_name.data);
                            expr.expr_type = type_primitive(TypeKind.TYPE_I64);
                            return expr.expr_type;
                        }

                        var iface_params: []Type* = alloc_array[Type*](self.arena, sig.param_count)[0..sig.param_count];

                        for (var pi: u64 = 0; pi < sig.param_count; pi += 1) {
                            iface_params[pi] = sig.params[pi].param_type;
                        }

                        proc_t = type_func(self.arena, sig.return_type, iface_params, sig.is_variadic);

                        callee_proc = sig;

                        expr.kind                = AstExprKind.EXPR_VIRT_CALL;
                        expr.member_target       = expr.call_args[0];
                        expr.virt_slot           = cast(u64, slot);
                        expr.virt_func_type      = proc_t;
                        expr.virt_from_interface = true;
                        expr.call_is_method      = false;
                        expr.call_callee_name    = sig.display_name;
                    } else {
                        var method_sym: Symbol* = self.lookup_method_chain(struct_t, expr.call_callee_name);

                        if (method_sym == null) {
                            var sb: StringBuilder = sbuilder_create(self.arena);
                            sb.append_str(struct_t.name);
                            sb.append_char('_');
                            sb.append_str(expr.call_callee_name);

                            method_sym = self.lookup_raw(sb.to_str());
                        }

                        if (method_sym != null && method_sym.kind == SymbolKind.SYM_PROC) {
                            if (method_sym.attrs.is_private && method_sym.module_id != self.current_module) {
                                self.had_error = true;
                                diag_error(expr.loc, "method '%.*s' of struct '%.*s' is private",
                                           cast(i32, expr.call_callee_name.len), expr.call_callee_name.data,
                                           cast(i32, struct_t.name.len), struct_t.name.data);
                            }

                            proc_t = method_sym.symbol_type;

                            callee_proc = method_sym.proc_decl;

                            var slot: i64 = -1;

                            if (struct_t.is_polymorphic()) {
                                var def_entry: StructEntry* = self.registry.find_struct(struct_t.name);

                                if (def_entry != null && def_entry.def != null) {
                                    slot = find_virtual_slot(def_entry.def.virtual_slots,
                                                             def_entry.def.virtual_slot_count,
                                                             expr.call_callee_name);
                                }
                            }

                            if (slot >= 0 && receiver_t.is_pointer()) {
                                expr.kind                = AstExprKind.EXPR_VIRT_CALL;
                                expr.member_target       = expr.call_args[0];
                                expr.virt_slot           = cast(u64, slot);
                                expr.virt_func_type      = proc_t;
                                expr.virt_from_interface = false;
                            } else if (slot >= 0 && method_sym.proc_decl != null &&
                                       method_sym.proc_decl.body == null &&
                                       !method_sym.proc_decl.attrs.is_extern) {
                                self.had_error = true;
                                diag_error(expr.loc, "cannot call abstract method '%.*s' on a value; use a pointer for virtual dispatch",
                                           cast(i32, expr.call_callee_name.len), expr.call_callee_name.data);
                            }

                            expr.call_callee_name = method_sym.effective_name();
                            expr.call_callee_sym  = method_sym;
                            expr.call_is_method   = false;
                        }
                    }

                    if (proc_t != null) {
                        if (expr.call_arg_count < proc_t.func_param_count) {
                            self.append_default_args(expr, callee_proc, proc_t.func_param_count);
                        }

                        if (proc_t.func_is_variadic) {
                            if (expr.call_arg_count < proc_t.func_param_count) {
                                self.had_error = true;
                                diag_error(expr.loc, "variadic call expects at least %llu arguments, but %llu were provided",
                                           proc_t.func_param_count, expr.call_arg_count);
                            }
                        } else if (expr.call_arg_count != proc_t.func_param_count) {
                            var disp: StrView = expr.call_callee_name;

                            if (expr.call_callee_sym != null) {
                                disp = expr.call_callee_sym.display();
                            }

                            self.had_error = true;
                            diag_error(expr.loc, "procedure '%.*s' expects %llu arguments, but %llu were provided",
                                       cast(i32, disp.len), disp.data,
                                       proc_t.func_param_count, expr.call_arg_count);
                        }

                        for (var i: u64 = 0; i < expr.call_arg_count; i += 1) {
                            var exp_param: Type* = null;

                            if (i < proc_t.func_param_count) {
                                exp_param = proc_t.func_param_types[i];
                            }

                            var arg_t: Type* = null;

                            if (i == 0) {
                                arg_t = receiver_t;
                            } else {
                                arg_t = self.analyze_expr(expr.call_args[i], exp_param);
                            }

                            if (exp_param != null && exp_param.is_slice() && arg_t.kind == TypeKind.TYPE_ARRAY) {
                                expr.call_args[i] = ast_expr_slice(self.arena, expr.call_args[i], null, null, expr.call_args[i].loc);
                                arg_t = self.analyze_expr(expr.call_args[i], exp_param);
                            }

                            if (exp_param != null && i > 0) {
                                expr.call_args[i] = self.coerce_for_target(expr.call_args[i], exp_param);
                                arg_t = expr.call_args[i].expr_type;

                                self.check_slicing(exp_param, arg_t, expr.call_args[i].loc);
                            }

                            if (exp_param != null && !types_are_compatible(exp_param, arg_t)) {
                                var ts1: StrView = exp_param.to_str(self.arena);
                                var ts2: StrView = arg_t.to_str(self.arena);

                                self.had_error = true;
                                diag_error(expr.call_args[i].loc,
                                           "argument %llu expects type '%.*s', but got '%.*s'",
                                           i + 1,
                                           cast(i32, ts1.len), ts1.data,
                                           cast(i32, ts2.len), ts2.data);
                            }
                        }

                        expr.expr_type = proc_t.func_return_type;
                        return expr.expr_type;
                    }

                    var field: StructField* = struct_t.lookup_field(expr.call_callee_name);

                    if (field != null) {
                        var member_expr: AstExpr* = ast_expr_member(self.arena, expr.call_args[0], field.name, expr.loc);
                        member_expr.member_field  = field;
                        member_expr.expr_type     = field.field_type;

                        var new_count: u64 = expr.call_arg_count - 1;
                        var new_args: []AstExpr* = alloc_array[AstExpr*](self.arena, new_count)[0..new_count];

                        for (var i: u64 = 0; i < new_count; i += 1) {
                            new_args[i] = expr.call_args[i + 1];
                        }

                        expr.call_callee_expr    = member_expr;
                        expr.call_callee_name    = strview_from_raw(null, 0);
                        expr.call_callee_sym     = null;
                        expr.call_args           = new_args.ptr;
                        expr.call_arg_count      = new_count;
                        expr.call_is_method      = false;

                        var callee_t: Type* = field.field_type;

                        if (callee_t != null && callee_t.is_pointer() && callee_t.base_type.kind == TypeKind.TYPE_FUNC) {
                            callee_t = callee_t.base_type;
                        }

                        if (callee_t == null || callee_t.kind != TypeKind.TYPE_FUNC) {
                            self.had_error = true;
                            diag_error(expr.loc, "field '%.*s' is not a procedure or procedure pointer",
                                       cast(i32, field.name.len), field.name.data);
                            expr.expr_type = type_primitive(TypeKind.TYPE_I64);
                            return expr.expr_type;
                        }

                        if (callee_t.func_is_variadic) {
                            if (expr.call_arg_count < callee_t.func_param_count) {
                                self.had_error = true;
                                diag_error(expr.loc, "variadic call expects at least %llu arguments, but %llu were provided",
                                           callee_t.func_param_count, expr.call_arg_count);
                            }
                        } else {
                            if (expr.call_arg_count != callee_t.func_param_count) {
                                self.had_error = true;
                                diag_error(expr.loc, "call expects %llu arguments, but %llu were provided",
                                           callee_t.func_param_count, expr.call_arg_count);
                            }
                        }

                        for (var i: u64 = 0; i < expr.call_arg_count; i += 1) {
                            var exp_param: Type* = null;

                            if (i < callee_t.func_param_count && callee_t.func_param_types != null) {
                                exp_param = callee_t.func_param_types[i];
                            }

                            var arg_t: Type* = self.analyze_expr(expr.call_args[i], exp_param);

                            if (exp_param != null && exp_param.is_slice() && arg_t.kind == TypeKind.TYPE_ARRAY) {
                                expr.call_args[i] = ast_expr_slice(self.arena, expr.call_args[i], null, null, expr.call_args[i].loc);
                                arg_t = self.analyze_expr(expr.call_args[i], exp_param);
                            }

                            if (exp_param != null) {
                                expr.call_args[i] = self.coerce_for_target(expr.call_args[i], exp_param);
                                arg_t = expr.call_args[i].expr_type;

                                self.check_slicing(exp_param, arg_t, expr.call_args[i].loc);
                            }

                            if (exp_param != null && !types_are_compatible(exp_param, arg_t)) {
                                var ts1: StrView = exp_param.to_str(self.arena);
                                var ts2: StrView = arg_t.to_str(self.arena);

                                self.had_error = true;
                                diag_error(expr.call_args[i].loc,
                                           "argument %llu expects type '%.*s', but got '%.*s'",
                                           i + 1,
                                           cast(i32, ts1.len), ts1.data,
                                           cast(i32, ts2.len), ts2.data);
                            }
                        }

                        expr.expr_type = callee_t.func_return_type;
                        return expr.expr_type;
                    } else if (struct_t.generic_arg_count > 0) {
                        var base_name: StrView = struct_t.name;

                        if (struct_t.generic_template != null) {
                            base_name = struct_t.generic_template.name;
                        }

                        var gen_sb: StringBuilder = sbuilder_create(self.arena);
                        gen_sb.append_str(base_name);
                        gen_sb.append_char('_');
                        gen_sb.append_str(expr.call_callee_name);

                        expr.call_callee_name = gen_sb.to_str();

                        expr.call_generic_arg_count = struct_t.generic_arg_count;

                        if (struct_t.generic_arg_count > 0) {
                            expr.call_generic_args = alloc_array[AstGenericArg](self.arena, struct_t.generic_arg_count);

                            for (var gi: u64 = 0; gi < struct_t.generic_arg_count; gi += 1) {
                                expr.call_generic_args[gi].is_value = false;
                                expr.call_generic_args[gi].arg_type = struct_t.generic_args[gi];
                                expr.call_generic_args[gi].value_expr = null;
                            }
                        }

                        expr.call_is_method = false;
                    } else {
                        self.had_error = true;
                        diag_error(expr.loc, "aggregate '%.*s' has no method or field named '%.*s'",
                                   cast(i32, struct_t.name.len), struct_t.name.data,
                                   cast(i32, expr.call_callee_name.len), expr.call_callee_name.data);
                        expr.expr_type = type_primitive(TypeKind.TYPE_I64);
                        return expr.expr_type;
                    }
                }

                var func_type: Type* = null;

                if (expr.call_callee_expr != null) {
                    var callee_t: Type* = self.analyze_expr(expr.call_callee_expr, null);

                    if (callee_t != null && callee_t.is_pointer() && callee_t.base_type.kind == TypeKind.TYPE_FUNC) {
                        callee_t = callee_t.base_type;
                    }

                    if (callee_t == null || callee_t.kind != TypeKind.TYPE_FUNC) {
                        self.had_error = true;
                        diag_error(expr.loc, "called object is not a procedure or procedure pointer");
                        expr.expr_type = type_primitive(TypeKind.TYPE_I64);
                        return expr.expr_type;
                    }

                    func_type = callee_t;
                } else {
                    var sym: Symbol* = expr.call_callee_sym;

                    if (sym == null) {
                        sym = self.lookup_visible(expr.call_callee_name);
                    }

                    if (sym == null) {
                        var (gp_base, gp_mod, gp_qual) = self.registry.split_qualified_name(expr.call_callee_name);
                        var template_proc: AstProc* = self.registry.find_generic_proc(gp_base);

                        if (template_proc != null && template_proc.method_struct.len > 0) {
                            if (template_proc.attrs.is_private && template_proc.module_id != self.current_module) {
                                self.had_error = true;
                                diag_error(expr.loc, "method '%.*s' of struct '%.*s' is private",
                                           cast(i32, template_proc.orig_name.len), template_proc.orig_name.data,
                                           cast(i32, template_proc.method_struct.len), template_proc.method_struct.data);
                                expr.expr_type = type_primitive(TypeKind.TYPE_I64);
                                return expr.expr_type;
                            }
                        } else if (template_proc != null &&
                                   !self.registry.check_type_module(gp_base, template_proc.module_id, gp_qual, gp_mod, template_proc.attrs.is_public, "procedure", expr.loc)) {
                            self.had_error = true;
                            expr.expr_type = type_primitive(TypeKind.TYPE_I64);
                            return expr.expr_type;
                        }

                        if (template_proc != null) {
                            var reflect_kind: ReflectKind = ReflectKind.REFLECT_NONE;

                            if (template_proc.attrs.is_extern) {
                                reflect_kind = reflection_builtin_kind(template_proc.name);
                            }

                            if (reflect_kind != ReflectKind.REFLECT_NONE) {
                                return self.analyze_reflect_call(expr, reflect_kind, template_proc, expected_type);
                            }

                            if (template_proc.comptime_slot_count > 0 &&
                                !self.split_comptime_call_args(expr, template_proc)) {
                                expr.expr_type = type_primitive(TypeKind.TYPE_I64);
                                return expr.expr_type;
                            }

                            var (concrete_args, concrete_values, value_arg_types, concrete_codes, bind_ok) = self.resolve_generic_call_args(template_proc, expr, expected_type);

                            if (!bind_ok) {
                                expr.expr_type = type_primitive(TypeKind.TYPE_I64);
                                return expr.expr_type;
                            }

                            sym = self.instantiate_generic_proc(template_proc, concrete_args, concrete_values, value_arg_types, concrete_codes, expr.loc);

                            if (sym != null) {
                                expr.call_callee_name = sym.effective_name();
                                expr.call_callee_sym  = sym;
                                func_type             = sym.symbol_type;
                            }
                        }

                        if (sym == null) {
                            self.had_error = true;
                            diag_error(expr.loc, "call to undeclared identifier '%.*s'", cast(i32, expr.call_callee_name.len), expr.call_callee_name.data);
                            expr.expr_type = type_primitive(TypeKind.TYPE_I64);
                            return expr.expr_type;
                        }
                    }

                    if (sym.kind == SymbolKind.SYM_PROC) {
                        expr.call_callee_sym  = sym;
                        expr.call_callee_name = sym.effective_name();
                        func_type             = sym.symbol_type;
                    } else if (sym.symbol_type != null && (sym.symbol_type.kind == TypeKind.TYPE_FUNC || (sym.symbol_type.is_pointer() && sym.symbol_type.base_type.kind == TypeKind.TYPE_FUNC))) {
                        var var_expr: AstExpr* = ast_expr_var(self.arena, sym.name, expr.loc);

                        var_expr.var_symbol = sym;
                        var_expr.expr_type  = sym.symbol_type;

                        expr.call_callee_expr = var_expr;
                        expr.call_callee_name = strview_from_raw(null, 0);

                        if (sym.symbol_type.kind == TypeKind.TYPE_FUNC) {
                            func_type = sym.symbol_type;
                        } else {
                            func_type = sym.symbol_type.base_type;
                        }
                    } else {
                        var disp: StrView = sym.display();

                        self.had_error = true;
                        diag_error(expr.loc, "'%.*s' is not callable", cast(i32, disp.len), disp.data);
                        expr.expr_type = type_primitive(TypeKind.TYPE_I64);
                        return expr.expr_type;
                    }
                }

                if (func_type == null || func_type.kind != TypeKind.TYPE_FUNC) {
                    expr.expr_type = type_primitive(TypeKind.TYPE_I64);
                    return expr.expr_type;
                }

                if (expr.call_arg_count < func_type.func_param_count) {
                    var callee_proc: AstProc* = null;

                    if (expr.call_callee_sym != null) {
                        callee_proc = expr.call_callee_sym.proc_decl;
                    }

                    self.append_default_args(expr, callee_proc, func_type.func_param_count);
                }

                if (func_type.func_is_variadic) {
                    if (expr.call_arg_count < func_type.func_param_count) {
                        self.had_error = true;
                        diag_error(expr.loc, "variadic call expects at least %llu arguments, but %llu were provided",
                                   func_type.func_param_count, expr.call_arg_count);
                    }
                } else {
                    if (expr.call_arg_count != func_type.func_param_count) {
                        self.had_error = true;
                        diag_error(expr.loc, "call expects %llu arguments, but %llu were provided",
                                   func_type.func_param_count, expr.call_arg_count);
                    }
                }

                for (var i: u64 = 0; i < expr.call_arg_count; i += 1) {
                    var exp_param: Type* = null;

                    if (i < func_type.func_param_count && func_type.func_param_types != null) {
                        exp_param = func_type.func_param_types[i];
                    }

                    var arg_t: Type* = self.analyze_expr(expr.call_args[i], exp_param);

                    if (exp_param != null && exp_param.is_slice() && arg_t.kind == TypeKind.TYPE_ARRAY) {
                        expr.call_args[i] = ast_expr_slice(self.arena, expr.call_args[i], null, null, expr.call_args[i].loc);
                        arg_t = self.analyze_expr(expr.call_args[i], exp_param);
                    }

                    if (exp_param != null) {
                        expr.call_args[i] = self.coerce_for_target(expr.call_args[i], exp_param);
                        arg_t = expr.call_args[i].expr_type;

                        self.check_slicing(exp_param, arg_t, expr.call_args[i].loc);
                    }

                    if (exp_param != null && !types_are_compatible(exp_param, arg_t)) {
                        var ts1: StrView = exp_param.to_str(self.arena);
                        var ts2: StrView = arg_t.to_str(self.arena);

                        self.had_error = true;
                        diag_error(expr.call_args[i].loc,
                                   "argument %llu expects type '%.*s', but got '%.*s'",
                                   i + 1,
                                   cast(i32, ts1.len), ts1.data,
                                   cast(i32, ts2.len), ts2.data);
                    }
                }

                if (func_type.func_return_type != null &&
                    func_type.func_return_type.kind == TypeKind.TYPE_TYPE &&
                    self.type_eval_depth == 0) {

                    var disp: StrView = expr.call_callee_name;

                    if (expr.call_callee_sym != null) {
                        disp = expr.call_callee_sym.display();
                    }

                    self.had_error = true;
                    diag_error(expr.loc, "procedure '%.*s' returns a type and can only be used in type position",
                               cast(i32, disp.len), disp.data);
                    expr.expr_type = type_primitive(TypeKind.TYPE_I64);
                    return expr.expr_type;
                }

                expr.expr_type = func_type.func_return_type;
                return expr.expr_type;
            }

            case AstExprKind.EXPR_IF: {
                self.analyze_expr(expr.if_cond, type_primitive(TypeKind.TYPE_BOOL));

                var then_t: Type* = self.analyze_expr(expr.if_then_expr, expected_type);

                var exp_else: Type* = expected_type;

                if (exp_else == null) {
                    exp_else = then_t;
                }

                var else_t: Type* = self.analyze_expr(expr.if_else_expr, exp_else);

                if (exp_else != null && exp_else.is_slice() && then_t.kind == TypeKind.TYPE_ARRAY) {
                    expr.if_then_expr = ast_expr_slice(self.arena, expr.if_then_expr, null, null, expr.if_then_expr.loc);
                    then_t = self.analyze_expr(expr.if_then_expr, exp_else);
                }

                if (exp_else != null && exp_else.is_slice() && else_t.kind == TypeKind.TYPE_ARRAY) {
                    expr.if_else_expr = ast_expr_slice(self.arena, expr.if_else_expr, null, null, expr.if_else_expr.loc);
                    else_t = self.analyze_expr(expr.if_else_expr, exp_else);
                }

                if (exp_else != null) {
                    expr.if_then_expr = self.coerce_for_target(expr.if_then_expr, exp_else);
                    then_t = expr.if_then_expr.expr_type;

                    expr.if_else_expr = self.coerce_for_target(expr.if_else_expr, exp_else);
                    else_t = expr.if_else_expr.expr_type;
                }

                var result_t: Type* = expected_type;

                if (result_t == null) {
                    result_t = then_t;
                }

                if (result_t == null || result_t.kind == TypeKind.TYPE_VOID) {
                    self.had_error = true;
                    diag_error(expr.loc, "conditional expression produces no value");
                    result_t = type_primitive(TypeKind.TYPE_I64);
                }

                if (!types_are_compatible(result_t, then_t)) {
                    var ts1: StrView = then_t.to_str(self.arena);
                    var ts2: StrView = result_t.to_str(self.arena);

                    self.had_error = true;
                    diag_error(expr.if_then_expr.loc, "conditional branch has type '%.*s', incompatible with '%.*s'",
                               cast(i32, ts1.len), ts1.data,
                               cast(i32, ts2.len), ts2.data);
                }

                if (!types_are_compatible(result_t, else_t)) {
                    var ts1: StrView = else_t.to_str(self.arena);
                    var ts2: StrView = result_t.to_str(self.arena);

                    self.had_error = true;
                    diag_error(expr.if_else_expr.loc, "conditional branch has type '%.*s', incompatible with '%.*s'",
                               cast(i32, ts1.len), ts1.data,
                               cast(i32, ts2.len), ts2.data);
                }

                expr.expr_type = result_t;
                return expr.expr_type;
            }

            case AstExprKind.EXPR_COMPTIME_BLOCK: {
                var block: AstStmt* = expr.comptime_block;

                if (block == null || block.kind != AstStmtKind.STMT_BLOCK || block.block_count == 0) {
                    self.had_error = true;
                    diag_error(expr.loc, "comptime block must produce a value");
                    expr.expr_type = type_primitive(TypeKind.TYPE_I64);
                    return expr.expr_type;
                }

                var last:       AstStmt* = block.block_stmts[block.block_count - 1];
                var final_expr: AstExpr* = null;

                if (last.kind == AstStmtKind.STMT_EXPR && last.expr_stmt_expr != null) {
                    final_expr = last.expr_stmt_expr;
                    block.block_count -= 1;
                }

                if (final_expr == null) {
                    self.had_error = true;
                    diag_error(expr.loc, "comptime block must end with an expression that produces a value");
                    expr.expr_type = type_primitive(TypeKind.TYPE_I64);
                    return expr.expr_type;
                }

                self.comptime_depth += 1;

                var result_t: Type* = expected_type;

                if (result_t == null) {
                    result_t = self.analyze_expr(final_expr, null);

                    if (result_t == null || result_t.kind == TypeKind.TYPE_VOID) {
                        self.had_error = true;
                        diag_error(expr.loc, "comptime block produces no value");
                        result_t = type_primitive(TypeKind.TYPE_I64);
                    }
                }

                var sp: AstProc* = alloc_zero[AstProc](self.arena);

                sp.name        = strview_from_cstr("__comptime");
                sp.orig_name   = sp.name;
                sp.return_type = result_t;
                sp.body        = block;
                sp.loc         = expr.loc;

                var saved_proc:   AstProc* = self.current_proc;
                var saved_depth:  u32      = self.loop_depth;
                var saved_switch: u32      = self.switch_depth;
                var saved_scope:  Scope*   = self.current_scope;

                self.current_proc  = sp;
                self.loop_depth    = 0;
                self.switch_depth  = 0;
                self.current_scope = self.global_scope;

                self.scope_push();

                for (var i: u64 = 0; i < block.block_count; i += 1) {
                    self.analyze_stmt(block.block_stmts[i]);
                }

                var ret_stmt: AstStmt* = alloc_zero[AstStmt](self.arena);

                ret_stmt.kind        = AstStmtKind.STMT_RETURN;
                ret_stmt.return_expr = final_expr;
                ret_stmt.loc         = final_expr.loc;

                block.block_stmts[block.block_count] = ret_stmt;
                block.block_count += 1;

                if (expected_type != null) {
                    self.analyze_stmt(ret_stmt);
                }

                self.comptime_depth -= 1;

                self.scope_pop();

                self.current_proc  = saved_proc;
                self.loop_depth    = saved_depth;
                self.switch_depth  = saved_switch;
                self.current_scope = saved_scope;

                expr.expr_type = result_t;

                var callees: Vec[AstProc*] = vec_with_capacity[AstProc*](self.arena, 8);

                if (!self.comptime_collect_callees(block, &callees)) {
                    expr.kind     = AstExprKind.EXPR_INT_LIT;
                    expr.int_val  = 0;
                    expr.expr_type = type_primitive(TypeKind.TYPE_I64);

                    return expr.expr_type;
                }

                var cres: ComptimeResult = comptime_eval_block(self.arena, self.current_program, block, result_t, callees.data, callees.len);

                if (!cres.ok) {
                    self.had_error = true;
                    diag_error(expr.loc, "comptime evaluation failed: %s", cast(char*, cres.err_msg));

                    expr.kind     = AstExprKind.EXPR_INT_LIT;
                    expr.int_val  = 0;
                    expr.expr_type = type_primitive(TypeKind.TYPE_I64);

                    return expr.expr_type;
                }

                expr.expr_type = self.materialize_comptime(expr, result_t, cres);

                return expr.expr_type;
            }

            case AstExprKind.EXPR_TYPE_VALUE: {
                expr.type_value = self.resolve_type(expr.type_value);
                expr.expr_type  = type_primitive(TypeKind.TYPE_TYPE);

                return expr.expr_type;
            }

            case AstExprKind.EXPR_CODE_BLOCK: {
                if (expr.code_block != null && expr.code_block.code_id == 0) {
                    self.next_code_id += 1;
                    expr.code_block.code_id = self.next_code_id;
                }

                self.scope_push();

                if (expr.code_block != null) {
                    if (expr.code_block.kind == AstStmtKind.STMT_BLOCK) {
                        for (var i: u64 = 0; i < expr.code_block.block_count; i += 1) {
                            self.analyze_stmt(expr.code_block.block_stmts[i]);
                        }
                    } else {
                        self.analyze_stmt(expr.code_block);
                    }
                }

                self.scope_pop();

                expr.expr_type = type_primitive(TypeKind.TYPE_CODE);

                return expr.expr_type;
            }

            case AstExprKind.EXPR_VA_START: {
                if (self.current_proc == null || !self.current_proc.is_variadic) {
                    self.had_error = true;
                    diag_error(expr.loc, "va_start can only be used inside variadic procedures");
                }

                self.require_valist(expr.va_valist_expr, "va_start");

                expr.expr_type = type_primitive(TypeKind.TYPE_VOID);
                return expr.expr_type;
            }

            case AstExprKind.EXPR_VA_ARG: {
                expr.va_target_type = self.resolve_type(expr.va_target_type);
                self.require_valist(expr.va_valist_expr, "va_arg");

                expr.expr_type = expr.va_target_type;
                return expr.expr_type;
            }

            case AstExprKind.EXPR_VA_END: {
                self.require_valist(expr.va_valist_expr, "va_end");

                expr.expr_type = type_primitive(TypeKind.TYPE_VOID);
                return expr.expr_type;
            }

            case AstExprKind.EXPR_VA_COPY: {
                self.require_valist(expr.va_valist_expr, "va_copy");
                self.require_valist(expr.va_src_valist_expr, "va_copy");

                expr.expr_type = type_primitive(TypeKind.TYPE_VOID);
                return expr.expr_type;
            }

            default: {
                return type_primitive(TypeKind.TYPE_VOID);
            }
        }
    }

    proc forin_fresh_name(self, base: StrView, loop_var: StrView) -> StrView {
        var name: StrView = base;

        while (name.equals(loop_var)) {
            var sb: StringBuilder = sbuilder_create(self.arena);

            sb.append_str(name);
            sb.append_char('_');

            name = sb.to_str();
        }

        return name;
    }

    proc forin_next_elem(self, sym: Symbol*, loc: SourceLoc) -> Type* {
        var ret_t: Type* = sym.symbol_type.func_return_type;

        if (ret_t == null || !ret_t.is_tuple() || ret_t.tuple_count != 2 ||
            !ret_t.tuple_elements[1].equals(type_primitive(TypeKind.TYPE_BOOL))) {
            self.had_error = true;
            diag_error(loc, "iterator method '__next__' must return '(Elem, bool)'");
            return null;
        }

        return ret_t.tuple_elements[0];
    }

    proc desugar_for_in_range(self, stmt: AstStmt*) -> AstStmt* {
        var loc: SourceLoc = stmt.loc;

        var end_name: StrView = self.forin_fresh_name(strview_from_cstr("__klang_range_end"), stmt.forin_var_name);
        var end_decl: AstStmt* = ast_stmt_var_decl(self.arena, end_name, null, stmt.forin_range_end, loc);

        var init: AstStmt* = ast_stmt_var_decl(self.arena, stmt.forin_var_name, stmt.forin_var_declared_type, stmt.forin_iterable, loc);

        var cond: AstExpr* = ast_expr_binary(self.arena, TokenKind.TOK_LESS,
                                             ast_expr_var(self.arena, stmt.forin_var_name, loc),
                                             ast_expr_var(self.arena, end_name, loc), loc);

        var step: AstStmt* = ast_stmt_compound_assign(self.arena, TokenKind.TOK_PLUS_EQ,
                                                      ast_expr_var(self.arena, stmt.forin_var_name, loc),
                                                      ast_expr_int_lit(self.arena, 1, loc), loc);

        var for_loop: AstStmt* = ast_stmt_for(self.arena, init, cond, step, stmt.forin_body, loc);

        var outer_stmts: []AstStmt* = alloc_array[AstStmt*](self.arena, 2)[0..2];
        outer_stmts[0] = end_decl;
        outer_stmts[1] = for_loop;

        return ast_stmt_block(self.arena, outer_stmts, loc);
    }

    proc desugar_for_in_indexed(self, stmt: AstStmt*, iterable_t: Type*) -> AstStmt* {
        var loc: SourceLoc = stmt.loc;

        var elem: Type* = iterable_t.slice_elem;

        if (iterable_t.kind == TypeKind.TYPE_ARRAY) {
            elem = iterable_t.array_elem;
        }

        var seq_name: StrView = self.forin_fresh_name(strview_from_cstr("__klang_for_seq"), stmt.forin_var_name);
        var idx_name: StrView = self.forin_fresh_name(strview_from_cstr("__klang_for_i"), stmt.forin_var_name);

        var seq_decl: AstStmt* = ast_stmt_var_decl(self.arena, seq_name, type_slice(self.arena, elem),
                                                   clone_expr(self.arena, stmt.forin_iterable), loc);

        var idx_decl: AstStmt* = ast_stmt_var_decl(self.arena, idx_name, type_primitive(TypeKind.TYPE_U64),
                                                   ast_expr_int_lit(self.arena, 0, loc), loc);

        var cond: AstExpr* = ast_expr_binary(self.arena, TokenKind.TOK_LESS,
                                             ast_expr_var(self.arena, idx_name, loc),
                                             ast_expr_member(self.arena, ast_expr_var(self.arena, seq_name, loc),
                                                             strview_from_cstr("len"), loc), loc);

        var step: AstStmt* = ast_stmt_compound_assign(self.arena, TokenKind.TOK_PLUS_EQ,
                                                      ast_expr_var(self.arena, idx_name, loc),
                                                      ast_expr_int_lit(self.arena, 1, loc), loc);

        var elem_expr: AstExpr* = ast_expr_index(self.arena, ast_expr_var(self.arena, seq_name, loc),
                                                 ast_expr_var(self.arena, idx_name, loc), loc);

        var elem_decl: AstStmt* = ast_stmt_var_decl(self.arena, stmt.forin_var_name, stmt.forin_var_declared_type, elem_expr, loc);

        var body_stmts: []AstStmt* = alloc_array[AstStmt*](self.arena, 2)[0..2];
        body_stmts[0] = elem_decl;
        body_stmts[1] = stmt.forin_body;

        var for_s: AstStmt* = ast_stmt_for(self.arena, idx_decl, cond, step,
                                           ast_stmt_block(self.arena, body_stmts, loc), loc);

        var outer_stmts: []AstStmt* = alloc_array[AstStmt*](self.arena, 2)[0..2];
        outer_stmts[0] = seq_decl;
        outer_stmts[1] = for_s;

        return ast_stmt_block(self.arena, outer_stmts, loc);
    }

    proc desugar_for_in_iterator(self, stmt: AstStmt*, iterable_t: Type*) -> AstStmt* {
        var loc: SourceLoc = stmt.loc;

        var it_struct: Type* = iterable_t;

        if (it_struct != null && it_struct.is_pointer()) {
            it_struct = it_struct.base_type;
        }

        it_struct = self.resolve_type(it_struct);

        if (it_struct == null || (it_struct.kind != TypeKind.TYPE_STRUCT && it_struct.kind != TypeKind.TYPE_UNION)) {
            var ts: StrView = strview_from_cstr("<unknown>");

            if (iterable_t != null) {
                ts = iterable_t.to_str(self.arena);
            }

            self.had_error = true;
            diag_error(stmt.loc, "cannot iterate over non-iterable type '%.*s'", cast(i32, ts.len), ts.data);
            return null;
        }

        var next_sym: Symbol* = self.lookup_method_chain(it_struct, strview_from_cstr("__next__"));
        var iter_sym: Symbol* = self.lookup_method_chain(it_struct, strview_from_cstr("__iter__"));
        var is_self_iterator: bool = next_sym != null;

        if (next_sym == null && iter_sym == null) {
            var ts: StrView = iterable_t.to_str(self.arena);

            self.had_error = true;
            diag_error(stmt.loc, "type '%.*s' is not iterable: expected an '__iter__' or '__next__' method", cast(i32, ts.len), ts.data);
            return null;
        }

        if (next_sym == null) {
            var it_t: Type* = iter_sym.symbol_type.func_return_type;

            if (it_t != null && it_t.is_pointer()) {
                it_t = it_t.base_type;
            }

            it_t = self.resolve_type(it_t);

            if (it_t == null || (it_t.kind != TypeKind.TYPE_STRUCT && it_t.kind != TypeKind.TYPE_UNION)) {
                self.had_error = true;
                diag_error(stmt.loc, "'__iter__' of '%.*s' must return an iterator type", cast(i32, it_struct.name.len), it_struct.name.data);
                return null;
            }

            next_sym = self.lookup_method_chain(it_t, strview_from_cstr("__next__"));

            if (next_sym == null) {
                self.had_error = true;
                diag_error(stmt.loc, "iterator type '%.*s' returned by '__iter__' has no '__next__' method", cast(i32, it_t.name.len), it_t.name.data);
                return null;
            }
        }

        if (self.forin_next_elem(next_sym, stmt.loc) == null) {
            return null;
        }

        var it_name: StrView = self.forin_fresh_name(strview_from_cstr("__klang_for_it"), stmt.forin_var_name);
        var ok_name: StrView = self.forin_fresh_name(strview_from_cstr("__klang_for_ok"), stmt.forin_var_name);

        var src_expr: AstExpr* = clone_expr(self.arena, stmt.forin_iterable);

        var it_init: AstExpr* = src_expr;

        if (!is_self_iterator) {
            var args: []AstExpr* = alloc_array[AstExpr*](self.arena, 1)[0..1];
            args[0] = src_expr;

            it_init = ast_expr_call(self.arena, strview_from_cstr("__iter__"), null, args, true, loc);
        }

        var it_decl: AstStmt* = ast_stmt_var_decl(self.arena, it_name, null, it_init, loc);

        var next_args: []AstExpr* = alloc_array[AstExpr*](self.arena, 1)[0..1];
        next_args[0] = ast_expr_var(self.arena, it_name, loc);

        var next_call: AstExpr* = ast_expr_call(self.arena, strview_from_cstr("__next__"), null, next_args, true, loc);

        var names: []StrView = alloc_array[StrView](self.arena, 2)[0..2];
        names[0] = stmt.forin_var_name;
        names[1] = ok_name;

        var declared: []Type* = alloc_array[Type*](self.arena, 2)[0..2];
        declared[0] = stmt.forin_var_declared_type;
        declared[1] = null;

        var next_decl: AstStmt* = ast_stmt_destructure_decl(self.arena, names, declared, next_call, loc);

        var not_ok: AstExpr* = ast_expr_unary(self.arena, TokenKind.TOK_BANG, ast_expr_var(self.arena, ok_name, loc), loc);

        var if_break: AstStmt* = ast_stmt_if(self.arena, not_ok, ast_stmt_break(self.arena, loc), null, loc);

        var user_block: AstStmt* = ast_stmt_block(self.arena, one_stmt_slice(self.arena, stmt.forin_body), loc);

        var body_stmts: []AstStmt* = alloc_array[AstStmt*](self.arena, 3)[0..3];
        body_stmts[0] = next_decl;
        body_stmts[1] = if_break;
        body_stmts[2] = user_block;

        var while_s: AstStmt* = ast_stmt_while(self.arena,
                                               ast_expr_var(self.arena, strview_from_cstr("true"), loc),
                                               ast_stmt_block(self.arena, body_stmts, loc), loc);

        var outer_stmts: []AstStmt* = alloc_array[AstStmt*](self.arena, 2)[0..2];
        outer_stmts[0] = it_decl;
        outer_stmts[1] = while_s;

        return ast_stmt_block(self.arena, outer_stmts, loc);
    }

    proc analyze_for_in(self, stmt: AstStmt*) -> void {
        if (stmt.forin_var_declared_type != null) {
            stmt.forin_var_declared_type = self.resolve_type(stmt.forin_var_declared_type);
        }

        var desugared: AstStmt* = null;

        if (stmt.forin_range_end != null) {
            desugared = self.desugar_for_in_range(stmt);
        } else {
            var iterable_t: Type* = self.analyze_expr(stmt.forin_iterable, null);

            if (iterable_t != null && (iterable_t.is_slice() || iterable_t.kind == TypeKind.TYPE_ARRAY)) {
                desugared = self.desugar_for_in_indexed(stmt, iterable_t);
            } else {
                desugared = self.desugar_for_in_iterator(stmt, iterable_t);
            }
        }

        if (desugared != null) {
            stmt.forin_desugared = desugared;
            self.analyze_stmt(desugared);
        }
    }

    proc analyze_stmt(self, stmt: AstStmt*) -> void {
        if (stmt == null) {
            return;
        }

        switch (stmt.kind) {
            case AstStmtKind.STMT_BLOCK: {
                self.scope_push();

                for (var i: u64 = 0; i < stmt.block_count; i += 1) {
                    self.analyze_stmt(stmt.block_stmts[i]);
                }

                self.scope_pop();
            }

            case AstStmtKind.STMT_INJECT: {
                var block: AstStmt* = null;

                if (stmt.inject_expr != null && stmt.inject_expr.kind == AstExprKind.EXPR_CODE_BLOCK) {
                    self.analyze_expr(stmt.inject_expr, null);

                    block = stmt.inject_expr.code_block;
                } else if (stmt.inject_expr != null) {
                    var sym: Symbol* = null;

                    if (stmt.inject_expr.kind == AstExprKind.EXPR_VAR) {
                        sym = self.lookup_visible(stmt.inject_expr.var_name);

                        if (sym == null) {
                            sym = stmt.inject_expr.var_symbol;
                        }
                    }

                    if (sym != null && sym.kind == SymbolKind.SYM_CONST && sym.const_kind == ConstKind.CONST_CODE) {
                        block = sym.const_code;
                    }
                }

                if (block == null) {
                    self.had_error = true;
                    diag_error(stmt.loc, "inject requires a code block value");
                }

                stmt.inject_block = block;
            }

            case AstStmtKind.STMT_VAR_DECL: {
                var declared: Type* = self.resolve_type(stmt.var_decl_declared_type);
                stmt.var_decl_declared_type = declared;

                var init_t: Type* = null;

                if (stmt.var_decl_init_expr != null) {
                    init_t = self.analyze_expr(stmt.var_decl_init_expr, declared);

                    if (declared != null && declared.is_slice() && init_t.kind == TypeKind.TYPE_ARRAY) {
                        stmt.var_decl_init_expr = ast_expr_slice(self.arena, stmt.var_decl_init_expr, null, null, stmt.loc);
                        init_t = self.analyze_expr(stmt.var_decl_init_expr, declared);
                    }

                    if (declared != null) {
                        stmt.var_decl_init_expr = self.coerce_for_target(stmt.var_decl_init_expr, declared);
                        init_t = stmt.var_decl_init_expr.expr_type;

                        self.check_slicing(declared, init_t, stmt.loc);
                    }

                    if (declared != null && !types_are_compatible(declared, init_t)) {
                        var ts1: StrView = declared.to_str(self.arena);
                        var ts2: StrView = init_t.to_str(self.arena);

                        self.had_error = true;
                        diag_error(stmt.loc, "variable '%.*s' declared with type '%.*s', but initialized with '%.*s'",
                                   cast(i32, stmt.var_decl_name.len), stmt.var_decl_name.data,
                                   cast(i32, ts1.len), ts1.data,
                                   cast(i32, ts2.len), ts2.data);
                    }
                }

                var final_t: Type* = declared;

                if (final_t == null) {
                    final_t = init_t;
                }

                if (final_t == null || final_t.kind == TypeKind.TYPE_VOID) {
                    self.had_error = true;
                    diag_error(stmt.loc, "variable '%.*s' cannot have type void", cast(i32, stmt.var_decl_name.len), stmt.var_decl_name.data);
                    final_t = type_primitive(TypeKind.TYPE_I64);
                }

                var sym: Symbol* = self.define_symbol(SymbolKind.SYM_VAR, stmt.var_decl_name, final_t, stmt.loc);
                sym.is_const        = stmt.var_decl_is_const;
                stmt.var_decl_symbol = sym;
            }

            case AstStmtKind.STMT_DESTRUCTURE_DECL: {
                var init_t: Type* = self.analyze_expr(stmt.destructure_decl_init_expr, null);

                if (init_t == null || !init_t.is_tuple()) {
                    var ts: StrView = strview_from_cstr("<null>");

                    if (init_t != null) {
                        ts = init_t.to_str(self.arena);
                    }

                    self.had_error = true;
                    diag_error(stmt.loc, "cannot destructure non-tuple type '%.*s'", cast(i32, ts.len), ts.data);
                    return;
                }

                if (stmt.destructure_decl_count != init_t.tuple_count) {
                    self.had_error = true;
                    diag_error(stmt.loc, "destructuring expects %llu variables, but tuple has %llu elements",
                               stmt.destructure_decl_count, init_t.tuple_count);
                    return;
                }

                for (var i: u64 = 0; i < stmt.destructure_decl_count; i += 1) {
                    var name: StrView = stmt.destructure_decl_names[i];

                    if (name.len == 1 && name.data[0] == '_') {
                        stmt.destructure_decl_symbols[i] = null;
                        continue;
                    }

                    var declared: Type* = self.resolve_type(stmt.destructure_decl_declared_types[i]);
                    var elem_t:   Type* = init_t.tuple_elements[i];

                    if (declared != null && !types_are_compatible(declared, elem_t)) {
                        var ts1: StrView = declared.to_str(self.arena);
                        var ts2: StrView = elem_t.to_str(self.arena);

                        self.had_error = true;
                        diag_error(stmt.loc, "variable '%.*s' declared with type '%.*s', but tuple element has type '%.*s'",
                                   cast(i32, name.len), name.data,
                                   cast(i32, ts1.len), ts1.data,
                                   cast(i32, ts2.len), ts2.data);
                    }

                    var final_t: Type* = declared;

                    if (final_t == null) {
                        final_t = elem_t;
                    }

                    if (final_t == null || final_t.kind == TypeKind.TYPE_VOID) {
                        self.had_error = true;
                        diag_error(stmt.loc, "variable '%.*s' cannot have type void", cast(i32, name.len), name.data);
                        final_t = type_primitive(TypeKind.TYPE_I64);
                    }

                    var sym: Symbol* = self.define_symbol(SymbolKind.SYM_VAR, name, final_t, stmt.loc);
                    stmt.destructure_decl_symbols[i] = sym;
                }
            }

            case AstStmtKind.STMT_ASSIGN: {
                var target_t: Type* = self.analyze_expr(stmt.assign_target, null);
                var value_t:  Type* = self.analyze_expr(stmt.assign_value, target_t);

                if (target_t.is_slice() && value_t.kind == TypeKind.TYPE_ARRAY) {
                    stmt.assign_value = ast_expr_slice(self.arena, stmt.assign_value, null, null, stmt.loc);
                    value_t = self.analyze_expr(stmt.assign_value, target_t);
                }

                stmt.assign_value = self.coerce_for_target(stmt.assign_value, target_t);
                value_t = stmt.assign_value.expr_type;

                self.check_slicing(target_t, value_t, stmt.loc);

                if (!expr_is_lvalue(stmt.assign_target)) {
                    self.had_error = true;
                    diag_error(stmt.loc, "assignment target is not a valid lvalue");
                }

                if (expr_is_const_lvalue(stmt.assign_target)) {
                    self.had_error = true;
                    diag_error(stmt.loc, "cannot assign to a const object");
                }

                if (!types_are_compatible(target_t, value_t)) {
                    var ts1: StrView = value_t.to_str(self.arena);
                    var ts2: StrView = target_t.to_str(self.arena);

                    self.had_error = true;
                    diag_error(stmt.loc, "cannot assign type '%.*s' to target of type '%.*s'",
                               cast(i32, ts1.len), ts1.data,
                               cast(i32, ts2.len), ts2.data);
                }
            }

            case AstStmtKind.STMT_DESTRUCTURE_ASSIGN: {
                var val_t: Type* = self.analyze_expr(stmt.destructure_assign_value, null);

                if (val_t == null || !val_t.is_tuple()) {
                    var ts: StrView = strview_from_cstr("<null>");

                    if (val_t != null) {
                        ts = val_t.to_str(self.arena);
                    }

                    self.had_error = true;
                    diag_error(stmt.loc, "cannot destructure non-tuple type '%.*s' in assignment", cast(i32, ts.len), ts.data);
                    return;
                }

                if (stmt.destructure_assign_count != val_t.tuple_count) {
                    self.had_error = true;
                    diag_error(stmt.loc, "destructuring assignment expects %llu targets, but tuple has %llu elements",
                               stmt.destructure_assign_count, val_t.tuple_count);
                    return;
                }

                for (var i: u64 = 0; i < stmt.destructure_assign_count; i += 1) {
                    var target: AstExpr* = stmt.destructure_assign_targets[i];

                    if (target.kind == AstExprKind.EXPR_VAR && target.var_name.len == 1 && target.var_name.data[0] == '_') {
                        continue;
                    }

                    var target_t: Type* = self.analyze_expr(target, null);
                    var elem_t:   Type* = val_t.tuple_elements[i];

                    if (!expr_is_lvalue(target)) {
                        self.had_error = true;
                        diag_error(target.loc, "destructuring assignment target is not a valid lvalue");
                    }

                    if (expr_is_const_lvalue(target)) {
                        self.had_error = true;
                        diag_error(target.loc, "cannot assign to a const object");
                    }

                    if (!types_are_compatible(target_t, elem_t)) {
                        var ts1: StrView = elem_t.to_str(self.arena);
                        var ts2: StrView = target_t.to_str(self.arena);

                        self.had_error = true;
                        diag_error(target.loc, "cannot assign tuple element of type '%.*s' to target of type '%.*s'",
                                   cast(i32, ts1.len), ts1.data,
                                   cast(i32, ts2.len), ts2.data);
                    }
                }
            }

            case AstStmtKind.STMT_COMPOUND_ASSIGN: {
                var target_t: Type* = self.analyze_expr(stmt.compound_assign_target, null);

                if (!target_t.is_pointer()) {
                    var bin_op: TokenKind = TokenKind.TOK_PLUS;

                    switch (stmt.compound_assign_op) {
                        case TokenKind.TOK_PLUS_EQ:    bin_op = TokenKind.TOK_PLUS;
                        case TokenKind.TOK_MINUS_EQ:   bin_op = TokenKind.TOK_MINUS;
                        case TokenKind.TOK_STAR_EQ:    bin_op = TokenKind.TOK_STAR;
                        case TokenKind.TOK_SLASH_EQ:   bin_op = TokenKind.TOK_SLASH;
                        case TokenKind.TOK_PERCENT_EQ: bin_op = TokenKind.TOK_PERCENT;
                        case TokenKind.TOK_AMP_EQ:     bin_op = TokenKind.TOK_AMP;
                        case TokenKind.TOK_PIPE_EQ:    bin_op = TokenKind.TOK_PIPE;
                        case TokenKind.TOK_CARET_EQ:   bin_op = TokenKind.TOK_CARET;
                        case TokenKind.TOK_SHL_EQ:     bin_op = TokenKind.TOK_SHL;
                        case TokenKind.TOK_SHR_EQ:     bin_op = TokenKind.TOK_SHR;
                        default: {}
                    }

                    var bin_expr: AstExpr* = ast_expr_binary(self.arena, bin_op, stmt.compound_assign_target, stmt.compound_assign_value, stmt.loc);
                    var (rewritten, is_rewritten) = try_rewrite_binary_op(self, bin_expr);

                    if (is_rewritten) {
                        stmt.kind         = AstStmtKind.STMT_ASSIGN;
                        stmt.assign_target = stmt.compound_assign_target;
                        stmt.assign_value  = rewritten;
                        self.analyze_stmt(stmt);
                        return;
                    }
                }

                var value_t: Type* = self.analyze_expr(stmt.compound_assign_value, target_t);

                if (!expr_is_lvalue(stmt.compound_assign_target)) {
                    self.had_error = true;
                    diag_error(stmt.loc, "compound assignment target is not a valid lvalue");
                }

                if (expr_is_const_lvalue(stmt.compound_assign_target)) {
                    self.had_error = true;
                    diag_error(stmt.loc, "cannot assign to a const object");
                }

                if (target_t.is_pointer() && value_t.is_integer()) {
                    return;
                }

                if (!types_are_compatible(target_t, value_t)) {
                    var ts1: StrView = target_t.to_str(self.arena);
                    var ts2: StrView = value_t.to_str(self.arena);

                    self.had_error = true;
                    diag_error(stmt.loc, "incompatible types in compound assignment: '%.*s' and '%.*s'",
                               cast(i32, ts1.len), ts1.data,
                               cast(i32, ts2.len), ts2.data);
                }
            }

            case AstStmtKind.STMT_RETURN: {
                var expected_t: Type* = type_primitive(TypeKind.TYPE_VOID);

                if (self.current_proc != null) {
                    expected_t = self.current_proc.return_type;
                }

                if (stmt.return_expr != null) {
                    var actual_t: Type* = self.analyze_expr(stmt.return_expr, expected_t);

                    if (expected_t != null && expected_t.is_slice() && actual_t.kind == TypeKind.TYPE_ARRAY) {
                        stmt.return_expr = ast_expr_slice(self.arena, stmt.return_expr, null, null, stmt.loc);
                        actual_t = self.analyze_expr(stmt.return_expr, expected_t);
                    }

                    stmt.return_expr = self.coerce_for_target(stmt.return_expr, expected_t);
                    actual_t = stmt.return_expr.expr_type;

                    self.check_slicing(expected_t, actual_t, stmt.loc);

                    if (!types_are_compatible(expected_t, actual_t)) {
                        var ts1: StrView = expected_t.to_str(self.arena);
                        var ts2: StrView = actual_t.to_str(self.arena);

                        self.had_error = true;

                        if (self.current_proc != null) {
                            diag_error(stmt.loc, "procedure '%.*s' expects return type '%.*s', but got '%.*s'",
                                       cast(i32, self.current_proc.display_name.len), self.current_proc.display_name.data,
                                       cast(i32, ts1.len), ts1.data,
                                       cast(i32, ts2.len), ts2.data);
                        } else {
                            diag_error(stmt.loc, "return statement outside of procedure");
                        }
                    }
                } else {
                    if (expected_t.kind != TypeKind.TYPE_VOID) {
                        var ts: StrView = expected_t.to_str(self.arena);
                        self.had_error  = true;

                        if (self.current_proc != null) {
                            diag_error(stmt.loc, "procedure '%.*s' must return a value of type '%.*s'",
                                       cast(i32, self.current_proc.display_name.len), self.current_proc.display_name.data,
                                       cast(i32, ts.len), ts.data);
                        } else {
                            diag_error(stmt.loc, "return statement outside of procedure");
                        }
                    }
                }
            }

            case AstStmtKind.STMT_IF: {
                self.analyze_expr(stmt.if_cond, type_primitive(TypeKind.TYPE_BOOL));
                self.analyze_stmt(stmt.if_then_branch);

                if (stmt.if_else_branch != null) {
                    self.analyze_stmt(stmt.if_else_branch);
                }
            }

            case AstStmtKind.STMT_WHILE: {
                self.analyze_expr(stmt.while_cond, type_primitive(TypeKind.TYPE_BOOL));

                self.loop_depth += 1;
                self.analyze_stmt(stmt.while_body);
                self.loop_depth -= 1;
            }

            case AstStmtKind.STMT_FOR: {
                self.scope_push();

                if (stmt.for_init != null) {
                    self.analyze_stmt(stmt.for_init);
                }

                if (stmt.for_cond != null) {
                    self.analyze_expr(stmt.for_cond, type_primitive(TypeKind.TYPE_BOOL));
                }

                if (stmt.for_step != null) {
                    self.analyze_stmt(stmt.for_step);
                }

                self.loop_depth += 1;
                self.analyze_stmt(stmt.for_body);
                self.loop_depth -= 1;

                self.scope_pop();
            }

            case AstStmtKind.STMT_FOR_IN: {
                self.analyze_for_in(stmt);
            }

            case AstStmtKind.STMT_BREAK: {
                if (self.loop_depth == 0 && self.switch_depth == 0) {
                    self.had_error = true;
                    diag_error(stmt.loc, "'break' statement outside of loop");
                }
            }

            case AstStmtKind.STMT_CONTINUE: {
                if (self.loop_depth == 0) {
                    self.had_error = true;
                    diag_error(stmt.loc, "'continue' statement outside of loop");
                }
            }

            case AstStmtKind.STMT_DEFER: {
                self.analyze_stmt(stmt.defer_stmt);
            }

            case AstStmtKind.STMT_SWITCH: {
                self.switch_depth += 1;

                var cond_t: Type* = self.analyze_expr(stmt.switch_cond, null);

                if (!cond_t.is_integer() && cond_t.kind != TypeKind.TYPE_ENUM && cond_t.kind != TypeKind.TYPE_CHAR && cond_t.kind != TypeKind.TYPE_BOOL) {
                    var ts: StrView = cond_t.to_str(self.arena);
                    self.had_error  = true;
                    diag_error(stmt.loc, "switch condition must be an integer, char, or enum, got '%.*s'", cast(i32, ts.len), ts.data);
                }

                var has_default: bool = false;

                for (var i: u64 = 0; i < stmt.switch_case_count; i += 1) {
                    var c: AstSwitchCase* = &stmt.switch_cases[i];

                    if (c.is_default) {
                        if (has_default) {
                            self.had_error = true;
                            diag_error(c.loc, "multiple 'default' labels in switch");
                        }
                        has_default = true;
                    } else {
                        for (var p: u64 = 0; p < c.pattern_count; p += 1) {
                            var pat: AstCasePattern* = &c.patterns[p];

                            self.analyze_expr(pat.val_start, cond_t);

                            var (start_val, start_ok) = eval_const_int(pat.val_start);

                            if (!start_ok) {
                                self.had_error = true;
                                diag_error(pat.val_start.loc, "case value must be a constant expression");
                                continue;
                            }

                            pat.const_start = start_val;
                            pat.const_end   = start_val;

                            if (pat.is_range) {
                                self.analyze_expr(pat.val_end, cond_t);

                                var (end_val, end_ok) = eval_const_int(pat.val_end);

                                if (!end_ok) {
                                    self.had_error = true;
                                    diag_error(pat.val_end.loc, "case range end must be a constant expression");
                                    continue;
                                }

                                if (start_val > end_val) {
                                    self.had_error = true;
                                    diag_error(pat.loc, "inverted case range: start (%lld) is greater than end (%lld)", start_val, end_val);
                                }

                                pat.const_end = end_val;
                            }

                            for (var prev_i: u64 = 0; prev_i <= i; prev_i += 1) {
                                var prev_c: AstSwitchCase* = &stmt.switch_cases[prev_i];

                                if (prev_c.is_default) {
                                    continue;
                                }

                                var max_p: u64 = prev_c.pattern_count;

                                if (prev_i == i) {
                                    max_p = p;
                                }

                                for (var prev_p: u64 = 0; prev_p < max_p; prev_p += 1) {
                                    var prev_pat: AstCasePattern* = &prev_c.patterns[prev_p];

                                    var low:  i64 = pat.const_start;
                                    var high: i64 = pat.const_end;

                                    if (prev_pat.const_start > low) {
                                        low = prev_pat.const_start;
                                    }

                                    if (prev_pat.const_end < high) {
                                        high = prev_pat.const_end;
                                    }

                                    if (low <= high) {
                                        self.had_error = true;
                                        diag_error(pat.loc, "duplicate or overlapping case value/range [%lld..%lld]", pat.const_start, pat.const_end);
                                    }
                                }
                            }
                        }
                    }

                    self.scope_push();

                    for (var s: u64 = 0; s < c.stmt_count; s += 1) {
                        self.analyze_stmt(c.stmts[s]);
                    }

                    self.scope_pop();
                }

                self.switch_depth -= 1;
            }

            case AstStmtKind.STMT_EXPR: {
                self.analyze_expr(stmt.expr_stmt_expr, null);
            }

            default: {}
        }
    }

    proc analyze_proc_body(self, proc_def: AstProc*) -> void {
        if (proc_def == null) {
            return;
        }

        proc_def.body_analyzed = true;

        var saved_proc:    AstProc* = self.current_proc;
        var saved_depth:   u32      = self.loop_depth;
        var saved_switch:  u32      = self.switch_depth;
        var saved_scope:   Scope*   = self.current_scope;
        var saved_module:  u32      = self.current_module;

        self.current_proc    = proc_def;
        self.loop_depth      = 0;
        self.switch_depth    = 0;
        self.current_scope   = self.global_scope;

        self.set_module_context(proc_def.module_id);

        for (var i: u64 = 0; i < proc_def.param_count; i += 1) {
            var p: AstParam* = &proc_def.params[i];
            p.param_type = self.resolve_type(p.param_type);
        }

        for (var i: u64 = 0; i < proc_def.param_count; i += 1) {
            var p: AstParam* = &proc_def.params[i];

            if (p.default_value != null) {
                var def_t: Type* = self.analyze_expr(p.default_value, p.param_type);

                if (p.param_type != null && !types_are_compatible(p.param_type, def_t)) {
                    var ts1: StrView = def_t.to_str(self.arena);
                    var ts2: StrView = p.param_type.to_str(self.arena);

                    self.had_error = true;
                    diag_error(p.loc, "default value for parameter '%.*s' has type '%.*s', but parameter has type '%.*s'",
                               cast(i32, p.name.len), p.name.data,
                               cast(i32, ts1.len), ts1.data,
                               cast(i32, ts2.len), ts2.data);
                }
            }
        }

        self.scope_push();

        if (proc_def.generic_template != null && proc_def.generic_template.generic_param_count > 0) {
            var template: AstProc* = proc_def.generic_template;

            for (var i: u64 = 0; i < template.generic_param_count; i += 1) {
                var gp: TypeParamInfo* = &template.generic_params[i];

                if (!gp.is_value) {
                    continue;
                }

                var value_type: Type* = null;

                if (proc_def.value_arg_types != null && i < proc_def.value_arg_count) {
                    value_type = self.resolve_type(proc_def.value_arg_types[i]);
                }

                if (value_type == null) {
                    value_type = type_primitive(TypeKind.TYPE_I64);
                }

                var c_sym: Symbol* = self.define_symbol(SymbolKind.SYM_CONST, gp.name, value_type, proc_def.loc);

                if (value_type.kind == TypeKind.TYPE_CODE) {
                    c_sym.const_kind = ConstKind.CONST_CODE;

                    if (proc_def.value_codes != null && i < proc_def.value_arg_count) {
                        c_sym.const_code = proc_def.value_codes[i];
                    }
                } else {
                    c_sym.const_kind = ConstKind.CONST_INT;
                    c_sym.const_val  = proc_def.value_args[i];
                }
            }
        }

        for (var i: u64 = 0; i < proc_def.param_count; i += 1) {
            var p: AstParam* = &proc_def.params[i];

            var sym: Symbol* = self.define_symbol(SymbolKind.SYM_PARAM, p.name, p.param_type, p.loc);
            p.symbol = sym;
        }

        if (proc_def.body != null) {
            if (proc_def.body.kind == AstStmtKind.STMT_BLOCK) {
                for (var i: u64 = 0; i < proc_def.body.block_count; i += 1) {
                    self.analyze_stmt(proc_def.body.block_stmts[i]);
                }
            } else {
                self.analyze_stmt(proc_def.body);
            }
        }

        self.scope_pop();

        self.current_proc    = saved_proc;
        self.loop_depth      = saved_depth;
        self.switch_depth    = saved_switch;
        self.current_scope   = saved_scope;

        self.set_module_context(saved_module);
    }

    proc comptime_build_blob(self, cres: ComptimeResult, result_t: Type*) -> (u8*, u64) {
        if (!cres.is_scalar) {
            return (cres.blob, cres.blob_size);
        }

        var size: u64 = 8;

        if (result_t != null && result_t.size > 0) {
            size = result_t.size;
        }

        var blob: u8* = self.arena.alloc(size);

        for (var i: u64 = 0; i < size; i += 1) {
            blob[i] = cast(u8, cast(u64, cres.int_val) >> (i * 8));
        }

        return (blob, size);
    }

    proc materialize_comptime(self, expr: AstExpr*, result_t: Type*, cres: ComptimeResult) -> Type* {
        var (blob, blob_size) = self.comptime_build_blob(cres, result_t);

        if (self.current_const != null && self.current_const.init_expr == expr) {
            var c: AstConstDef* = self.current_const;

            c.const_kind            = ConstKind.CONST_COMPTIME;
            c.val                   = cres.int_val;
            c.comptime_blob         = blob;
            c.comptime_blob_size    = blob_size;
            c.comptime_regions      = cres.regions;
            c.comptime_region_count = cres.region_count;
            c.comptime_heap         = cres.heap;
            c.comptime_heap_count   = cres.heap_count;

            return result_t;
        }

        var name_buf: StringBuilder;

        name_buf.init(self.arena);
        name_buf.append_cstr("__comptime_");
        name_buf.append_u64(self.comptime_counter);

        self.comptime_counter += 1;

        var c: AstConstDef* = alloc_zero[AstConstDef](self.arena);

        c.name                  = name_buf.to_str();
        c.const_type            = result_t;
        c.init_expr             = null;
        c.loc                   = expr.loc;
        c.module_id             = self.current_module;
        c.is_public             = false;
        c.const_kind            = ConstKind.CONST_COMPTIME;
        c.val                   = cres.int_val;
        c.comptime_blob         = blob;
        c.comptime_blob_size    = blob_size;
        c.comptime_regions      = cres.regions;
        c.comptime_region_count = cres.region_count;
        c.comptime_heap         = cres.heap;
        c.comptime_heap_count   = cres.heap_count;

        var (sym, c_merged) = self.define_top_level(SymbolKind.SYM_CONST, c.name, result_t, expr.loc, c.module_id, false, strview_from_raw(null, 0));

        sym.const_kind            = c.const_kind;
        sym.const_val             = c.val;
        sym.const_float_bits      = 0;
        sym.const_str             = c.const_str;
        sym.comptime_blob         = c.comptime_blob;
        sym.comptime_blob_size    = c.comptime_blob_size;
        sym.comptime_regions      = c.comptime_regions;
        sym.comptime_region_count = c.comptime_region_count;
        sym.comptime_heap         = c.comptime_heap;
        sym.comptime_heap_count   = c.comptime_heap_count;
        c.symbol                  = sym;

        self.comptime_consts.push(c);

        expr.kind       = AstExprKind.EXPR_VAR;
        expr.var_name   = c.name;
        expr.var_symbol = sym;

        return result_t;
    }

    proc flush_comptime_consts(self) -> void {
        if (self.comptime_consts.is_empty()) {
            return;
        }

        var program: AstProgram* = self.current_program;
        var extra:    u64         = self.comptime_consts.len;
        var new_count: u64        = program.const_count + extra;
        var new_consts: AstConstDef** = alloc_array[AstConstDef*](self.arena, new_count);

        for (var i: u64 = 0; i < program.const_count; i += 1) {
            new_consts[i] = program.consts[i];
        }

        for (var i: u64 = 0; i < extra; i += 1) {
            new_consts[program.const_count + i] = self.comptime_consts.data[i];
        }

        program.consts      = new_consts;
        program.const_count = new_count;

        self.comptime_consts.clear();
    }

    proc comptime_const_deferred(self, c: AstConstDef*) -> bool {
        for (var i: u64 = 0; i < self.deferred_consts.len; i += 1) {
            if (self.deferred_consts.data[i] == c) {
                return true;
            }
        }

        return false;
    }

    proc collect_deferred_consts(self, program: AstProgram*) -> void {
        var deferred_names: Vec[StrView] = vec_with_capacity[StrView](self.arena, 8);

        var progressed: bool = true;

        while (progressed) {
            progressed = false;

            for (var i: u64 = 0; i < program.const_count; i += 1) {
                var c: AstConstDef* = program.consts[i];

                if (c.symbol != null || self.comptime_const_deferred(c)) {
                    continue;
                }

                var should_defer: bool = false;

                if (c.init_expr != null) {
                    should_defer = expr_contains_comptime(c.init_expr) || expr_contains_call(c.init_expr) ||
                                   expr_contains_struct_lit(c.init_expr);

                    if (!should_defer) {
                        for (var n: u64 = 0; n < deferred_names.len; n += 1) {
                            if (expr_references_name(c.init_expr, deferred_names.data[n])) {
                                should_defer = true;
                                break;
                            }
                        }
                    }
                }

                if (!should_defer && c.const_type != null && c.const_type.refs_named()) {
                    should_defer = true;
                }

                if (should_defer) {
                    self.deferred_consts.push(c);
                    deferred_names.push(c.name);
                    progressed = true;
                }
            }
        }
    }

    proc comptime_eval_expr(self, expr: AstExpr*, result_t: Type*) -> (ComptimeResult, bool) {
        var ret_stmt: AstStmt* = alloc_zero[AstStmt](self.arena);

        ret_stmt.kind        = AstStmtKind.STMT_RETURN;
        ret_stmt.return_expr = expr;
        ret_stmt.loc         = expr.loc;

        var block: AstStmt* = ast_stmt_block(self.arena, one_stmt_slice(self.arena, ret_stmt), expr.loc);

        var callees: Vec[AstProc*] = vec_with_capacity[AstProc*](self.arena, 8);

        if (!self.comptime_collect_callees(block, &callees)) {
            var fail: ComptimeResult;
            fail.ok = false;
            return (fail, false);
        }

        var cres: ComptimeResult = comptime_eval_block(self.arena, self.current_program, block, result_t, callees.data, callees.len);

        if (!cres.ok) {
            return (cres, false);
        }

        return (cres, true);
    }

    proc fold_const_expr_int(self, expr: AstExpr*) -> (i64, bool) {
        if (expr == null || !comptime_expr_foldable(expr)) {
            return (0, false);
        }

        var (cres, ok) = self.comptime_eval_expr(expr, type_primitive(TypeKind.TYPE_I64));

        if (!ok || cres.is_float) {
            return (0, false);
        }

        return (cres.int_val, true);
    }

    proc comptime_fold_const(self, c: AstConstDef*) -> bool {
        if (c.init_expr == null || !comptime_expr_foldable(c.init_expr)) {
            return false;
        }

        var (cres, ok) = self.comptime_eval_expr(c.init_expr, c.const_type);

        if (!ok) {
            return false;
        }

        var (blob, blob_size) = self.comptime_build_blob(cres, c.const_type);

        c.const_kind            = ConstKind.CONST_COMPTIME;
        c.val                   = cres.int_val;
        c.comptime_blob         = blob;
        c.comptime_blob_size    = blob_size;
        c.comptime_regions      = cres.regions;
        c.comptime_region_count = cres.region_count;
        c.comptime_heap         = cres.heap;
        c.comptime_heap_count   = cres.heap_count;

        return true;
    }

    proc analyze_const_def(self, c: AstConstDef*) -> void {
        self.set_module_context(c.module_id);

        c.const_type = self.resolve_type(c.const_type);

        var saved_const: AstConstDef* = self.current_const;

        self.current_const = c;

        self.comptime_depth += 1;

        var init_t: Type* = self.analyze_expr(c.init_expr, c.const_type);

        self.comptime_depth -= 1;

        self.current_const = saved_const;

        if (c.const_type == null) {
            if (init_t == null || init_t.kind == TypeKind.TYPE_VOID || init_t.kind == TypeKind.TYPE_NULL) {
                self.had_error = true;
                diag_error(c.loc, "cannot infer a type for 'const %.*s' from its initializer", cast(i32, c.name.len), c.name.data);
                c.const_type = type_primitive(TypeKind.TYPE_I64);
            } else {
                c.const_type = init_t;
            }
        }

        if (c.const_kind == ConstKind.CONST_COMPTIME) {
        } else if (c.init_expr != null && c.init_expr.kind == AstExprKind.EXPR_VAR &&
                   c.init_expr.var_symbol != null && c.init_expr.var_symbol.const_kind == ConstKind.CONST_COMPTIME) {
            var src: Symbol* = c.init_expr.var_symbol;

            c.const_kind            = ConstKind.CONST_COMPTIME;
            c.val                   = src.const_val;
            c.comptime_blob         = src.comptime_blob;
            c.comptime_blob_size    = src.comptime_blob_size;
            c.comptime_regions      = src.comptime_regions;
            c.comptime_region_count = src.comptime_region_count;
            c.comptime_heap         = src.comptime_heap;
            c.comptime_heap_count   = src.comptime_heap_count;
        } else {
            var (ev, ok) = eval_expr(c.init_expr);

            if (!ok) {
                if (!self.comptime_fold_const(c)) {
                    self.had_error = true;
                    diag_error(c.loc, "initializer for 'const %.*s' is not a constant expression", cast(i32, c.name.len), c.name.data);
                    c.const_kind = ConstKind.CONST_INT;
                    c.val        = 0;
                }
            } else if (ev.is_int() && c.const_type.is_float()) {
                ev = eval_int_to_float(ev, c.const_type);
                c.const_kind       = ConstKind.CONST_FLOAT;
                c.const_float_bits = ev.float_bits;
                c.val              = cast(i64, ev.float_bits);
            } else if (ev.is_float()) {
                if (!c.const_type.is_float()) {
                    self.had_error = true;
                    diag_error(c.loc, "cannot initialize 'const %.*s' of non-float type with a floating-point value; use an explicit cast",
                               cast(i32, c.name.len), c.name.data);
                }

                c.const_kind       = ConstKind.CONST_FLOAT;
                c.const_float_bits = ev.float_bits;
                c.val              = cast(i64, ev.float_bits);
            } else if (ev.is_str()) {
                if (c.const_type.is_slice()) {
                    if (!self.comptime_fold_const(c)) {
                        self.had_error = true;
                        diag_error(c.loc, "initializer for 'const %.*s' is not a constant expression", cast(i32, c.name.len), c.name.data);

                        c.const_kind = ConstKind.CONST_STR;
                        c.const_str  = ev.str_val;
                        c.val        = 0;
                    }
                } else {
                    if (!c.const_type.is_pointer()) {
                        self.had_error = true;
                        diag_error(c.loc, "cannot initialize 'const %.*s' of type '%.*s' with a string literal",
                                   cast(i32, c.name.len), c.name.data,
                                   cast(i32, c.const_type.to_str(self.arena).len), c.const_type.to_str(self.arena).data);
                    }

                    c.const_kind = ConstKind.CONST_STR;
                    c.const_str  = ev.str_val;
                    c.val        = 0;
                }
            } else if (ev.is_null()) {
                if (!c.const_type.is_pointer() && c.const_type.kind != TypeKind.TYPE_FUNC) {
                    self.had_error = true;
                    diag_error(c.loc, "cannot initialize 'const %.*s' of non-pointer type with null",
                               cast(i32, c.name.len), c.name.data);
                }

                c.const_kind = ConstKind.CONST_NULL;
                c.val        = 0;
            } else {
                if (!c.const_type.is_integer() &&
                    c.const_type.kind != TypeKind.TYPE_BOOL &&
                    c.const_type.kind != TypeKind.TYPE_CHAR &&
                    c.const_type.kind != TypeKind.TYPE_ENUM &&
                    !c.const_type.is_pointer()) {
                    self.had_error = true;
                    diag_error(c.loc, "'const %.*s' has non-scalar type '%.*s', which cannot be stored as a constant",
                               cast(i32, c.name.len), c.name.data,
                               cast(i32, c.const_type.to_str(self.arena).len), c.const_type.to_str(self.arena).data);
                }

                c.const_kind = ConstKind.CONST_INT;
                c.val        = ev.int_val;
            }
        }

        var (sym, c_merged) = self.define_top_level(SymbolKind.SYM_CONST, c.name, c.const_type, c.loc, c.module_id, false, strview_from_raw(null, 0));
        sym.const_kind            = c.const_kind;
        sym.const_val             = c.val;
        sym.const_float_bits      = c.const_float_bits;
        sym.const_str             = c.const_str;
        sym.comptime_blob         = c.comptime_blob;
        sym.comptime_blob_size    = c.comptime_blob_size;
        sym.comptime_regions      = c.comptime_regions;
        sym.comptime_region_count = c.comptime_region_count;
        sym.comptime_heap         = c.comptime_heap;
        sym.comptime_heap_count   = c.comptime_heap_count;
        sym.attrs.is_public    = c.is_public;
        c.symbol               = sym;
    }

    proc comptime_collect_expr(self, expr: AstExpr*, out_procs: Vec[AstProc*]*) -> void {
        if (expr == null) {
            return;
        }

        switch (expr.kind) {
            case AstExprKind.EXPR_UNARY: {
                self.comptime_collect_expr(expr.unary_operand, out_procs);
            }

            case AstExprKind.EXPR_BINARY: {
                self.comptime_collect_expr(expr.binary_lhs, out_procs);
                self.comptime_collect_expr(expr.binary_rhs, out_procs);
            }

            case AstExprKind.EXPR_CALL: {
                self.comptime_collect_expr(expr.call_callee_expr, out_procs);

                for (var i: u64 = 0; i < expr.call_arg_count; i += 1) {
                    self.comptime_collect_expr(expr.call_args[i], out_procs);
                }

                self.comptime_enqueue_callee(expr, out_procs);
            }

            case AstExprKind.EXPR_VIRT_CALL: {
                self.comptime_collect_expr(expr.member_target, out_procs);

                for (var i: u64 = 0; i < expr.call_arg_count; i += 1) {
                    self.comptime_collect_expr(expr.call_args[i], out_procs);
                }

                self.comptime_enqueue_callee(expr, out_procs);
            }

            case AstExprKind.EXPR_TO_INTERFACE: {
                self.comptime_collect_expr(expr.unary_operand, out_procs);
            }

            case AstExprKind.EXPR_INDEX: {
                self.comptime_collect_expr(expr.index_ptr, out_procs);
                self.comptime_collect_expr(expr.index_index, out_procs);
            }

            case AstExprKind.EXPR_MEMBER: {
                self.comptime_collect_expr(expr.member_target, out_procs);
            }

            case AstExprKind.EXPR_CAST: {
                self.comptime_collect_expr(expr.cast_expr, out_procs);
            }

            case AstExprKind.EXPR_IF: {
                self.comptime_collect_expr(expr.if_cond, out_procs);
                self.comptime_collect_expr(expr.if_then_expr, out_procs);
                self.comptime_collect_expr(expr.if_else_expr, out_procs);
            }

            case AstExprKind.EXPR_TUPLE: {
                for (var i: u64 = 0; i < expr.tuple_count; i += 1) {
                    self.comptime_collect_expr(expr.tuple_elements[i], out_procs);
                }
            }

            case AstExprKind.EXPR_STRUCT_LIT: {
                for (var i: u64 = 0; i < expr.struct_lit_field_count; i += 1) {
                    self.comptime_collect_expr(expr.struct_lit_field_values[i], out_procs);
                }
            }

            case AstExprKind.EXPR_ARRAY_LIT: {
                for (var i: u64 = 0; i < expr.array_count; i += 1) {
                    self.comptime_collect_expr(expr.array_elements[i], out_procs);
                }
            }

            case AstExprKind.EXPR_SLICE: {
                self.comptime_collect_expr(expr.slice_target, out_procs);
                self.comptime_collect_expr(expr.slice_start, out_procs);
                self.comptime_collect_expr(expr.slice_end, out_procs);
            }

            case AstExprKind.EXPR_ALLOCA: {
                self.comptime_collect_expr(expr.alloca_count_expr, out_procs);
            }

            case AstExprKind.EXPR_SIZEOF, AstExprKind.EXPR_ALIGNOF: {
                self.comptime_collect_expr(expr.size_align_expr, out_procs);
            }

            case AstExprKind.EXPR_VA_ARG: {
                self.comptime_collect_expr(expr.va_valist_expr, out_procs);
            }

            case AstExprKind.EXPR_ASM: {
                for (var i: u64 = 0; i < expr.asm_input_count; i += 1) {
                    self.comptime_collect_expr(expr.asm_inputs[i].expr, out_procs);
                }

                for (var i: u64 = 0; i < expr.asm_output_count; i += 1) {
                    self.comptime_collect_expr(expr.asm_outputs[i].expr, out_procs);
                }
            }

            case AstExprKind.EXPR_COMPTIME_BLOCK: {
                self.comptime_collect_stmt(expr.comptime_block, out_procs);
            }

            default: {}
        }
    }

    proc comptime_collect_stmt(self, stmt: AstStmt*, out_procs: Vec[AstProc*]*) -> void {
        if (stmt == null) {
            return;
        }

        switch (stmt.kind) {
            case AstStmtKind.STMT_BLOCK: {
                for (var i: u64 = 0; i < stmt.block_count; i += 1) {
                    self.comptime_collect_stmt(stmt.block_stmts[i], out_procs);
                }
            }

            case AstStmtKind.STMT_VAR_DECL: {
                self.comptime_collect_expr(stmt.var_decl_init_expr, out_procs);

                var obj: ComptimeObject* = self.comptime_object_of_expr(stmt.var_decl_init_expr);

                if (obj == null && stmt.var_decl_symbol != null) {
                    obj = self.comptime_object_for_type(stmt.var_decl_symbol.symbol_type);
                }

                self.comptime_bind_var(stmt.var_decl_symbol, obj);
            }

            case AstStmtKind.STMT_DESTRUCTURE_DECL: {
                self.comptime_collect_expr(stmt.destructure_decl_init_expr, out_procs);
            }

            case AstStmtKind.STMT_ASSIGN: {
                self.comptime_collect_expr(stmt.assign_target, out_procs);
                self.comptime_collect_expr(stmt.assign_value, out_procs);

                self.comptime_record_assignment(stmt.assign_target, stmt.assign_value);
            }

            case AstStmtKind.STMT_DESTRUCTURE_ASSIGN: {
                for (var i: u64 = 0; i < stmt.destructure_assign_count; i += 1) {
                    self.comptime_collect_expr(stmt.destructure_assign_targets[i], out_procs);
                }

                self.comptime_collect_expr(stmt.destructure_assign_value, out_procs);
            }

            case AstStmtKind.STMT_COMPOUND_ASSIGN: {
                self.comptime_collect_expr(stmt.compound_assign_target, out_procs);
                self.comptime_collect_expr(stmt.compound_assign_value, out_procs);
            }

            case AstStmtKind.STMT_RETURN: {
                self.comptime_collect_expr(stmt.return_expr, out_procs);
            }

            case AstStmtKind.STMT_IF: {
                self.comptime_collect_expr(stmt.if_cond, out_procs);
                self.comptime_collect_stmt(stmt.if_then_branch, out_procs);
                self.comptime_collect_stmt(stmt.if_else_branch, out_procs);
            }

            case AstStmtKind.STMT_WHILE: {
                self.comptime_collect_expr(stmt.while_cond, out_procs);
                self.comptime_collect_stmt(stmt.while_body, out_procs);
            }

            case AstStmtKind.STMT_FOR: {
                self.comptime_collect_stmt(stmt.for_init, out_procs);
                self.comptime_collect_expr(stmt.for_cond, out_procs);
                self.comptime_collect_stmt(stmt.for_step, out_procs);
                self.comptime_collect_stmt(stmt.for_body, out_procs);
            }

            case AstStmtKind.STMT_FOR_IN: {
                if (stmt.forin_desugared != null) {
                    self.comptime_collect_stmt(stmt.forin_desugared, out_procs);
                } else {
                    self.comptime_collect_expr(stmt.forin_iterable, out_procs);
                    self.comptime_collect_expr(stmt.forin_range_end, out_procs);
                    self.comptime_collect_stmt(stmt.forin_body, out_procs);
                }
            }

            case AstStmtKind.STMT_SWITCH: {
                self.comptime_collect_expr(stmt.switch_cond, out_procs);

                for (var i: u64 = 0; i < stmt.switch_case_count; i += 1) {
                    for (var p: u64 = 0; p < stmt.switch_cases[i].pattern_count; p += 1) {
                        self.comptime_collect_expr(stmt.switch_cases[i].patterns[p].val_start, out_procs);
                        self.comptime_collect_expr(stmt.switch_cases[i].patterns[p].val_end, out_procs);
                    }

                    for (var s: u64 = 0; s < stmt.switch_cases[i].stmt_count; s += 1) {
                        self.comptime_collect_stmt(stmt.switch_cases[i].stmts[s], out_procs);
                    }
                }
            }

            case AstStmtKind.STMT_DEFER: {
                self.comptime_collect_stmt(stmt.defer_stmt, out_procs);
            }

            case AstStmtKind.STMT_EXPR: {
                self.comptime_collect_expr(stmt.expr_stmt_expr, out_procs);
            }

            default: {}
        }
    }

    proc comptime_object_new(self, concrete: Type*) -> ComptimeObject* {
        var o: ComptimeObject* = alloc_zero[ComptimeObject](self.arena);

        o.concrete = concrete;

        return o;
    }

    proc comptime_object_for_type(self, t: Type*) -> ComptimeObject* {
        if (t == null) {
            return null;
        }

        var struct_t: Type* = t;

        if (t.is_pointer() && t.base_type != null) {
            struct_t = t.base_type;
        }

        if (struct_t.kind != TypeKind.TYPE_STRUCT || struct_t.is_interface || struct_t.is_generic_template) {
            return null;
        }

        return self.comptime_object_new(struct_t);
    }

    proc comptime_bind_var(self, sym: Symbol*, object: ComptimeObject*) -> void {
        if (sym == null || object == null) {
            return;
        }

        var b: ComptimeIfaceBinding* = alloc_zero[ComptimeIfaceBinding](self.arena);

        b.sym    = sym;
        b.object = object;
        b.next   = self.comptime_bindings;

        self.comptime_bindings = b;
    }

    proc comptime_lookup_var(self, sym: Symbol*) -> ComptimeObject* {
        var b: ComptimeIfaceBinding* = self.comptime_bindings;

        while (b != null) {
            if (b.sym == sym) {
                return b.object;
            }

            b = b.next;
        }

        return null;
    }

    proc comptime_field_bind(self, object: ComptimeObject*, field: StructField*, target: ComptimeObject*) -> void {
        if (object == null || field == null || target == null) {
            return;
        }

        var fb: ComptimeFieldBinding* = object.fields;

        while (fb != null) {
            if (fb.field == field) {
                fb.object = target;
                return;
            }

            fb = fb.next;
        }

        var nf: ComptimeFieldBinding* = alloc_zero[ComptimeFieldBinding](self.arena);

        nf.field  = field;
        nf.object = target;
        nf.next   = object.fields;

        object.fields = nf;
    }

    proc comptime_field_lookup(self, object: ComptimeObject*, field: StructField*) -> ComptimeObject* {
        if (object == null || field == null) {
            return null;
        }

        var fb: ComptimeFieldBinding* = object.fields;

        while (fb != null) {
            if (fb.field == field) {
                return fb.object;
            }

            fb = fb.next;
        }

        return null;
    }

    proc comptime_object_of_expr(self, expr: AstExpr*) -> ComptimeObject* {
        if (expr == null) {
            return null;
        }

        switch (expr.kind) {
            case AstExprKind.EXPR_VAR: {
                var obj: ComptimeObject* = self.comptime_lookup_var(expr.var_symbol);

                if (obj != null) {
                    return obj;
                }

                return self.comptime_object_for_type(expr.expr_type);
            }

            case AstExprKind.EXPR_UNARY: {
                if (expr.unary_op == TokenKind.TOK_AMP) {
                    return self.comptime_object_of_expr(expr.unary_operand);
                }

                return null;
            }

            case AstExprKind.EXPR_TO_INTERFACE: {
                return self.comptime_object_of_expr(expr.unary_operand);
            }

            case AstExprKind.EXPR_CAST: {
                return self.comptime_object_of_expr(expr.cast_expr);
            }

            case AstExprKind.EXPR_MEMBER: {
                var base: ComptimeObject* = self.comptime_object_of_expr(expr.member_target);

                if (base == null) {
                    return null;
                }

                return self.comptime_field_lookup(base, expr.member_field);
            }

            case AstExprKind.EXPR_STRUCT_LIT: {
                var obj: ComptimeObject* = self.comptime_object_for_type(expr.expr_type);

                if (obj == null) {
                    return null;
                }

                for (var i: u64 = 0; i < expr.struct_lit_field_count; i += 1) {
                    var fv: ComptimeObject* = self.comptime_object_of_expr(expr.struct_lit_field_values[i]);

                    if (fv == null) {
                        continue;
                    }

                    for (var f: u64 = 0; f < obj.concrete.field_count; f += 1) {
                        if (obj.concrete.fields[f].name.equals(expr.struct_lit_field_names[i])) {
                            self.comptime_field_bind(obj, &obj.concrete.fields[f], fv);
                            break;
                        }
                    }
                }

                return obj;
            }

            case AstExprKind.EXPR_CALL: {
                return self.comptime_proc_result_object(expr);
            }

            default: {
                return null;
            }
        }
    }

    proc comptime_build_param_bindings(self, call: AstExpr*, p: AstProc*) -> ComptimeIfaceBinding* {
        if (p == null) {
            return null;
        }

        var head:  ComptimeIfaceBinding* = null;
        var count: u64                  = p.param_count;

        if (count > call.call_arg_count) {
            count = call.call_arg_count;
        }

        for (var i: u64 = 0; i < count; i += 1) {
            if (p.params[i].symbol == null) {
                continue;
            }

            var obj: ComptimeObject* = self.comptime_object_of_expr(call.call_args[i]);

            if (obj == null) {
                continue;
            }

            var b: ComptimeIfaceBinding* = alloc_zero[ComptimeIfaceBinding](self.arena);

            b.sym    = p.params[i].symbol;
            b.object = obj;
            b.next   = head;

            head = b;
        }

        return head;
    }

    proc comptime_proc_result_object(self, call: AstExpr*) -> ComptimeObject* {
        if (call.expr_type == null || !call.expr_type.is_interface) {
            return null;
        }

        var p: AstProc* = null;

        if (call.call_callee_sym != null) {
            p = call.call_callee_sym.proc_decl;
        }

        if (p == null || p.body == null) {
            return null;
        }

        var saved: ComptimeIfaceBinding* = self.comptime_bindings;

        self.comptime_bindings = self.comptime_build_param_bindings(call, p);

        var result: ComptimeObject* = null;

        if (p.body.kind == AstStmtKind.STMT_BLOCK) {
            for (var i: u64 = 0; i < p.body.block_count; i += 1) {
                var s: AstStmt* = p.body.block_stmts[i];

                if (s.kind == AstStmtKind.STMT_RETURN && s.return_expr != null) {
                    result = self.comptime_object_of_expr(s.return_expr);
                    break;
                }
            }
        } else if (p.body.kind == AstStmtKind.STMT_RETURN) {
            result = self.comptime_object_of_expr(p.body.return_expr);
        }

        self.comptime_bindings = saved;

        return result;
    }

    proc comptime_record_assignment(self, target: AstExpr*, value: AstExpr*) -> void {
        if (target == null || value == null) {
            return;
        }

        var val_obj: ComptimeObject* = self.comptime_object_of_expr(value);

        if (val_obj == null) {
            return;
        }

        if (target.kind == AstExprKind.EXPR_VAR) {
            self.comptime_bind_var(target.var_symbol, val_obj);
        } else if (target.kind == AstExprKind.EXPR_MEMBER && target.member_field != null) {
            var base: ComptimeObject* = self.comptime_object_of_expr(target.member_target);

            if (base != null) {
                self.comptime_field_bind(base, target.member_field, val_obj);
            }
        }
    }

    proc comptime_resolve_virtual(self, call: AstExpr*) -> AstProc* {
        if (call == null) {
            return null;
        }

        var method_name: StrView = strview_from_raw(null, 0);

        if (call.virt_from_interface) {
            var iface_t: Type* = call.member_target.expr_type;

            if (iface_t == null || iface_t.iface_def == null || call.virt_slot >= iface_t.iface_def.method_count) {
                return null;
            }

            method_name = iface_t.iface_def.methods[call.virt_slot].orig_name;
        } else if (call.call_callee_sym != null && call.call_callee_sym.proc_decl != null) {
            method_name = call.call_callee_sym.proc_decl.orig_name;
        } else {
            return null;
        }

        var obj: ComptimeObject* = self.comptime_object_of_expr(call.member_target);

        if (obj == null) {
            if (!call.virt_from_interface && call.call_callee_sym != null) {
                return call.call_callee_sym.proc_decl;
            }

            return null;
        }

        var impl: Symbol* = self.lookup_method_chain(obj.concrete, method_name);

        if (impl != null && impl.proc_decl != null) {
            return impl.proc_decl;
        }

        if (!call.virt_from_interface && call.call_callee_sym != null) {
            return call.call_callee_sym.proc_decl;
        }

        return null;
    }

    proc comptime_enqueue_callee(self, call: AstExpr*, out_procs: Vec[AstProc*]*) -> void {
        var p: AstProc* = null;

        if (call.kind == AstExprKind.EXPR_VIRT_CALL) {
            p = self.comptime_resolve_virtual(call);

            if (p == null) {
                self.had_error = true;
                diag_error(call.loc, "cannot resolve dynamic dispatch target at comptime");
                return;
            }
        } else if (call.call_callee_sym != null) {
            p = call.call_callee_sym.proc_decl;
        }

        if (p == null) {
            return;
        }

        for (var i: u64 = 0; i < out_procs.len; i += 1) {
            if (out_procs.data[i] == p) {
                return;
            }
        }

        if (p.attrs.is_extern) {
            if (comptime_builtin_kind(p.name) == ComptimeBuiltin.CB_NONE) {
                self.had_error = true;
                diag_error(p.loc, "cannot call extern procedure '%.*s' at comptime", cast(i32, p.display_name.len), p.display_name.data);
            }

            return;
        }

        if (p.body == null) {
            self.had_error = true;
            diag_error(p.loc, "cannot call procedure '%.*s' at comptime: it has no body", cast(i32, p.display_name.len), p.display_name.data);
            return;
        }

        if (!p.body_analyzed) {
            self.analyze_proc_body(p);
        }

        out_procs.push(p);

        var body_saved: ComptimeIfaceBinding* = self.comptime_bindings;

        self.comptime_bindings = self.comptime_build_param_bindings(call, p);

        self.comptime_collect_stmt(p.body, out_procs);

        self.comptime_bindings = body_saved;
    }

    proc comptime_collect_callees(self, block: AstStmt*, out_procs: Vec[AstProc*]*) -> bool {
        var saved_bindings: ComptimeIfaceBinding* = self.comptime_bindings;

        self.comptime_bindings = null;

        self.comptime_collect_stmt(block, out_procs);

        self.comptime_bindings = saved_bindings;

        if (self.current_program != null) {
            self.build_vtables(self.current_program);
        }

        return !self.had_error;
    }

    proc analyze_program(self, program: AstProgram*) -> bool {
        if (program == null) {
            return false;
        }

        self.current_program = program;

        self.modules.init(self.arena, program);
        self.registry.modules = &self.modules;

        if (self.modules.had_error) {
            self.had_error = true;
        }

        self.collect_deferred_consts(program);

        for (var i: u64 = 0; i < program.const_count; i += 1) {
            var c: AstConstDef* = program.consts[i];

            if (c.symbol != null || self.comptime_const_deferred(c)) {
                continue;
            }

            self.analyze_const_def(c);
        }

        for (var i: u64 = 0; i < program.enum_count; i += 1) {
            var e: AstEnumDef* = program.enums[i];
            self.registry.register_enum(e.name, e.enum_type, e);
        }

        for (var i: u64 = 0; i < program.enum_count; i += 1) {
            var e: AstEnumDef* = program.enums[i];

            self.set_module_context(e.module_id);

            var base_t: Type*  = self.resolve_type(e.underlying_type);

            if (base_t == null) {
                base_t = type_primitive(TypeKind.TYPE_U32);
            }

            var variants: []EnumVariant = alloc_array_zero[EnumVariant](self.arena, e.variant_count)[0..e.variant_count];
            var current_val: i64        = 0;

            for (var v: u64 = 0; v < e.variant_count; v += 1) {
                var vardef: AstEnumVariantDef* = &e.variants[v];

                if (vardef.explicit_value != null) {
                    self.analyze_expr(vardef.explicit_value, base_t);

                    var (exp_int, ok) = eval_const_int(vardef.explicit_value);

                    if (ok) {
                        current_val = exp_int;
                    } else {
                        self.had_error = true;
                        diag_error(vardef.loc, "enum variant value must be a constant expression");
                    }
                }

                variants[v].name  = vardef.name;
                variants[v].value = current_val;

                current_val += 1;
            }

            e.enum_type = type_enum(self.arena, e.name, base_t, variants);
            e.enum_type.module_id = e.module_id;

            var e_entry: EnumEntry* = self.registry.find_enum(e.name);

            if (e_entry != null) {
                e_entry.enum_type = e.enum_type;
            }

            var (sym, e_merged) = self.define_top_level(SymbolKind.SYM_ENUM, e.name, e.enum_type, e.loc, e.module_id, false, strview_from_raw(null, 0));
            sym.attrs.is_public = e.is_public;
            e.symbol            = sym;
        }

        for (var i: u64 = 0; i < program.struct_count; i += 1) {
            var s: AstStructDef* = program.structs[i];

            self.set_module_context(s.module_id);

            if (s.is_generic) {
                for (var f: u64 = 0; f < s.field_count; f += 1) {
                    s.fields[f].field_type = bind_type_params(self.arena, s.fields[f].field_type, s.generic_params[0..s.generic_param_count], 0);
                }

                self.registry.register_generic_struct(s.name, s);
            } else {
                s.def_type.module_id = s.module_id;

                self.registry.register_struct(s.name, s.def_type, s);
            }
        }

        for (var i: u64 = 0; i < program.union_count; i += 1) {
            var u: AstUnionDef* = program.unions[i];

            self.set_module_context(u.module_id);

            if (u.is_generic) {
                for (var f: u64 = 0; f < u.field_count; f += 1) {
                    u.fields[f].field_type = bind_type_params(self.arena, u.fields[f].field_type, u.generic_params[0..u.generic_param_count], 0);
                }
            } else {
                u.def_type.module_id = u.module_id;

                self.registry.register_union(u.name, u.def_type, u);
            }
        }

        for (var i: u64 = 0; i < program.typedef_count; i += 1) {
            var td: AstTypeDef* = program.typedefs[i];
            self.registry.register_alias(td.name, td.target_type, td.is_distinct, td);
        }

        self.register_interfaces(program);

        for (var i: u64 = 0; i < program.typedef_count; i += 1) {
            var td: AstTypeDef* = program.typedefs[i];

            self.set_module_context(td.module_id);

            var a_entry: AliasEntry* = self.registry.find_alias(td.name);

            if (a_entry != null) {
                a_entry.is_resolving = true;
                td.target_type       = self.resolve_type(td.target_type);
                a_entry.is_resolving = false;

                if (td.is_distinct) {
                    a_entry.alias_type = type_distinct(self.arena, td.name, td.target_type);
                } else {
                    a_entry.alias_type = td.target_type;
                }
            }

            var final_t: Type* = td.target_type;

            if (a_entry != null) {
                final_t = a_entry.alias_type;
            }

            var (sym, td_merged) = self.define_top_level(SymbolKind.SYM_TYPE_ALIAS, td.name, final_t, td.loc, td.module_id, false, strview_from_raw(null, 0));
            sym.attrs.is_public = td.is_public;
            td.symbol           = sym;
        }

        for (var i: u64 = 0; i < program.struct_count; i += 1) {
            var s: AstStructDef* = program.structs[i];

            self.set_module_context(s.module_id);

            self.resolve_struct_inheritance(s, program, 0);
        }

        if (self.had_error || self.registry.had_error) {
            return false;
        }

        self.presolve_struct_field_sizes(program);

        resolve_all_layouts(&self.registry, self.arena);

        for (var i: u64 = 0; i < program.proc_count; i += 1) {
            var p: AstProc* = program.procs[i];

            self.set_module_context(p.module_id);

            if (p.is_generic) {
                self.classify_generic_value_params(p);

                var depth_val: u32 = 0;

                if (p.method_struct.len > 0) {
                    depth_val = 1;
                }

                p.return_type = bind_type_params(self.arena, p.return_type, p.generic_params[0..p.generic_param_count], depth_val);

                for (var param_idx: u64 = 0; param_idx < p.param_count; param_idx += 1) {
                    p.params[param_idx].param_type = bind_type_params(self.arena, p.params[param_idx].param_type, p.generic_params[0..p.generic_param_count], depth_val);
                }

                self.registry.register_generic_proc(p.name, p);
            } else {
                p.return_type = self.resolve_type(p.return_type);

                if (p.body == null && !p.attrs.is_extern) {
                    var is_abstract_method: bool = p.attrs.is_virtual && p.method_struct.len > 0;

                    if (!is_abstract_method) {
                        self.had_error = true;
                        diag_error(p.loc, "procedure '%.*s' has no body", cast(i32, p.display_name.len), p.display_name.data);
                    }
                }

                if (p.attrs.custom_align > 0) {
                    if ((p.attrs.custom_align & (p.attrs.custom_align - 1)) != 0) {
                        self.had_error = true;
                        diag_error(p.loc, "function alignment must be a power of two");
                    }
                }

                var param_types: []Type* = alloc_array[Type*](self.arena, p.param_count)[0..p.param_count];

                for (var param_idx: u64 = 0; param_idx < p.param_count; param_idx += 1) {
                    p.params[param_idx].param_type = self.resolve_type(p.params[param_idx].param_type);
                    param_types[param_idx]         = p.params[param_idx].param_type;
                }

                var proc_t: Type* = type_func(self.arena, p.return_type, param_types, p.is_variadic);
                var (sym, p_merged) = self.define_top_level(SymbolKind.SYM_PROC, p.name, proc_t, p.loc, p.module_id, p.attrs.is_extern, p.display_name);

                if (p_merged) {
                    p.suppressed = true;
                } else {
                    sym.is_extern = p.attrs.is_extern;
                    sym.attrs     = p.attrs;
                    sym.proc_decl = p;
                }

                p.symbol = sym;
            }
        }

        if (self.had_error || self.registry.had_error) {
            return false;
        }

        for (var i: u64 = 0; i < self.deferred_consts.len; i += 1) {
            self.analyze_const_def(self.deferred_consts.data[i]);
        }

        for (var i: u64 = 0; i < program.global_count; i += 1) {
            var g: AstGlobalVarDef* = program.globals[i];

            self.set_module_context(g.module_id);

            g.var_type = self.resolve_type(g.var_type);

            if (g.init_expr != null) {
                var init_t: Type* = self.analyze_expr(g.init_expr, g.var_type);

                if (g.var_type == null) {
                    g.var_type = init_t;
                } else if (!types_are_compatible(g.var_type, init_t)) {
                    self.had_error = true;
                    diag_error(g.loc, "type mismatch in global variable initializer");
                }

                if (expr_contains_call(g.init_expr) && comptime_expr_foldable(g.init_expr)) {
                    var (cres, ok) = self.comptime_eval_expr(g.init_expr, g.var_type);

                    if (ok) {
                        self.materialize_comptime(g.init_expr, g.var_type, cres);
                    }
                }
            }

            if (g.attrs.custom_align > 0) {
                if ((g.attrs.custom_align & (g.attrs.custom_align - 1)) != 0) {
                    self.had_error = true;
                    diag_error(g.loc, "alignment must be a power of two");
                }
            }

            if (g.attrs.is_extern && g.init_expr != null) {
                self.had_error = true;
                diag_error(g.loc, "extern variable cannot have an initializer");
            }

            var (sym, g_merged) = self.define_top_level(SymbolKind.SYM_GLOBAL_VAR, g.name, g.var_type, g.loc, g.module_id, g.attrs.is_extern, strview_from_raw(null, 0));

            if (g_merged) {
                g.suppressed = true;
            } else {
                sym.is_extern = g.attrs.is_extern;
                sym.attrs     = g.attrs;
            }

            sym.is_const = g.is_const;

            g.symbol = sym;
        }

        if (self.had_error || self.registry.had_error) {
            return false;
        }

        self.check_override_signatures(program);

        self.assign_link_names();

        var init_proc_count: u64 = program.proc_count;

        for (var i: u64 = 0; i < init_proc_count; i += 1) {
            if (!program.procs[i].is_generic && !program.procs[i].suppressed && program.procs[i].body != null && !program.procs[i].body_analyzed) {
                self.analyze_proc_body(program.procs[i]);
            }
        }

        self.flush_comptime_consts();

        self.mark_comptime_only_procs(program);

        self.build_vtables(program);

        return !self.had_error && !self.registry.had_error;
    }
}

proc sema_create(a: Arena*) -> Sema* {
    var s: Sema* = alloc_zero[Sema](a);

    s.init(a);

    return s;
}

proc sema_analyze_program(sema: Sema*, program: AstProgram*) -> bool {
    if (sema == null || program == null) {
        return false;
    }

    return sema.analyze_program(program);
}