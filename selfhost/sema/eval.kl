import "libc.kl";
import "arena.kl";
import "strview.kl";
import "lexer.kl";
import "type.kl";
import "ast.kl";
import "float.kl";

enum EvalKind: u32 {
    EVAL_INT = 0,
    EVAL_FLOAT,
    EVAL_STR,
    EVAL_NULL
}

struct EvalValue {
    kind:       EvalKind,
    val_type:   Type*,
    int_val:    i64,
    float_bits: u64,
    str_val:    StrView,

    @inline proc is_int(self) -> bool {
        return self.kind == EvalKind.EVAL_INT;
    }

    @inline proc is_float(self) -> bool {
        return self.kind == EvalKind.EVAL_FLOAT;
    }

    @inline proc is_str(self) -> bool {
        return self.kind == EvalKind.EVAL_STR;
    }

    @inline proc is_null(self) -> bool {
        return self.kind == EvalKind.EVAL_NULL;
    }

    proc float_to_f64_bits(self) -> u64 {
        if (self.val_type != null) {
            if (self.val_type.kind == TypeKind.TYPE_F32) {
                return f32_to_f64_bits(cast(u32, self.float_bits));
            }

            if (self.val_type.kind == TypeKind.TYPE_F16) {
                return f32_to_f64_bits(f16_to_f32_bits(cast(u32, self.float_bits)));
            }

            if (self.val_type.kind == TypeKind.TYPE_F8) {
                return f32_to_f64_bits(f8_to_f32_bits(cast(u32, self.float_bits)));
            }
        }

        return self.float_bits;
    }

    proc eval_unary(self, op: TokenKind) -> (EvalValue, bool) {
        if (self.is_float()) {
            switch (op) {
                case TokenKind.TOK_MINUS: {
                    var neg_bits: u64 = self.float_bits;

                    if (self.val_type != null && self.val_type.kind == TypeKind.TYPE_F32) {
                        neg_bits = cast(u64, f32_bits_negate(cast(u32, self.float_bits)));
                    } else {
                        neg_bits = f64_bits_negate(self.float_bits);
                    }

                    return (eval_val_float(neg_bits, self.val_type), true);
                }

                case TokenKind.TOK_PLUS: {
                    return (eval_val_float(self.float_bits, self.val_type), true);
                }

                default: {
                    return (eval_val_empty(), false);
                }
            }
        }

        if (!self.is_int()) {
            return (eval_val_empty(), false);
        }

        var sz:        u64  = 8;
        var is_signed: bool = false;

        if (self.val_type != null) {
            sz        = self.val_type.size;
            is_signed = self.val_type.is_signed();
        }

        if (sz == 0) {
            sz = 8;
        }

        switch (op) {
            case TokenKind.TOK_MINUS: {
                var res: i64 = int_truncate_to_width(-self.int_val, sz, is_signed);
                return (eval_val_int(res, self.val_type), true);
            }

            case TokenKind.TOK_PLUS: {
                return (eval_val_int(self.int_val, self.val_type), true);
            }

            case TokenKind.TOK_TILDE: {
                var res: i64 = int_truncate_to_width(~self.int_val, sz, is_signed);
                return (eval_val_int(res, self.val_type), true);
            }

            case TokenKind.TOK_BANG: {
                var bool_val: i64 = 0;

                if (self.int_val == 0) {
                    bool_val = 1;
                }

                return (eval_val_int(bool_val, type_primitive(TypeKind.TYPE_BOOL)), true);
            }

            default: {
                return (eval_val_empty(), false);
            }
        }
    }

    proc eval_binary(self, op: TokenKind, rhs: EvalValue, res_type: Type*) -> (EvalValue, bool) {
        if (self.is_float() && rhs.is_float()) {
            return self.eval_binary_float(op, rhs, res_type);
        }

        if (!self.is_int() || !rhs.is_int()) {
            return (eval_val_empty(), false);
        }

        var target_type: Type* = res_type;

        if (target_type == null) {
            target_type = self.val_type;
        }

        var sz:        u64  = 8;
        var is_signed: bool = false;

        if (target_type != null) {
            sz        = target_type.size;
            is_signed = target_type.is_signed();
        }

        if (sz == 0) {
            sz = 8;
        }

        var a: i64 = self.int_val;
        var b: i64 = rhs.int_val;
        var r: i64 = 0;

        switch (op) {
            case TokenKind.TOK_PLUS: {
                r = a + b;
            }

            case TokenKind.TOK_MINUS: {
                r = a - b;
            }

            case TokenKind.TOK_STAR: {
                r = a * b;
            }

            case TokenKind.TOK_SLASH: {
                if (b == 0) {
                    return (eval_val_empty(), false);
                }

                if (is_signed) {
                    if (a == -9223372036854775807 - 1 && b == -1) {
                        return (eval_val_empty(), false);
                    }
                    r = a / b;
                } else {
                    r = cast(i64, cast(u64, a) / cast(u64, b));
                }
            }

            case TokenKind.TOK_PERCENT: {
                if (b == 0) {
                    return (eval_val_empty(), false);
                }

                if (is_signed) {
                    if (a == -9223372036854775807 - 1 && b == -1) {
                        return (eval_val_empty(), false);
                    }
                    r = a % b;
                } else {
                    r = cast(i64, cast(u64, a) % cast(u64, b));
                }
            }

            case TokenKind.TOK_AMP: {
                r = a & b;
            }

            case TokenKind.TOK_PIPE: {
                r = a | b;
            }

            case TokenKind.TOK_CARET: {
                r = a ^ b;
            }

            case TokenKind.TOK_SHL: {
                var shift_mask: u64 = 63;

                if (sz < 8) {
                    shift_mask = 31;
                }

                var shift: u64 = cast(u64, b) & shift_mask;
                r = cast(i64, cast(u64, a) << shift);
            }

            case TokenKind.TOK_SHR: {
                var shift_mask: u64 = 63;

                if (sz < 8) {
                    shift_mask = 31;
                }

                var shift: u64 = cast(u64, b) & shift_mask;

                if (is_signed) {
                    r = a >> shift;
                } else {
                    r = cast(i64, cast(u64, a) >> shift);
                }
            }

            case TokenKind.TOK_EQ_EQ: {
                var res: i64 = cast(i64, a == b);
                return (eval_val_int(res, type_primitive(TypeKind.TYPE_BOOL)), true);
            }

            case TokenKind.TOK_BANG_EQ: {
                var res: i64 = cast(i64, a != b);
                return (eval_val_int(res, type_primitive(TypeKind.TYPE_BOOL)), true);
            }

            case TokenKind.TOK_LESS: {
                var res: i64 = 0;

                if (is_signed) {
                    res = cast(i64, a < b);
                } else {
                    res = cast(i64, cast(u64, a) < cast(u64, b));
                }

                return (eval_val_int(res, type_primitive(TypeKind.TYPE_BOOL)), true);
            }

            case TokenKind.TOK_LESS_EQ: {
                var res: i64 = 0;

                if (is_signed) {
                    res = cast(i64, a <= b);
                } else {
                    res = cast(i64, cast(u64, a) <= cast(u64, b));
                }

                return (eval_val_int(res, type_primitive(TypeKind.TYPE_BOOL)), true);
            }

            case TokenKind.TOK_GREATER: {
                var res: i64 = 0;

                if (is_signed) {
                    res = cast(i64, a > b);
                } else {
                    res = cast(i64, cast(u64, a) > cast(u64, b));
                }

                return (eval_val_int(res, type_primitive(TypeKind.TYPE_BOOL)), true);
            }

            case TokenKind.TOK_GREATER_EQ: {
                var res: i64 = 0;

                if (is_signed) {
                    res = cast(i64, a >= b);
                } else {
                    res = cast(i64, cast(u64, a) >= cast(u64, b));
                }

                return (eval_val_int(res, type_primitive(TypeKind.TYPE_BOOL)), true);
            }

            case TokenKind.TOK_AMP_AMP: {
                var res: i64 = cast(i64, a != 0 && b != 0);
                return (eval_val_int(res, type_primitive(TypeKind.TYPE_BOOL)), true);
            }

            case TokenKind.TOK_PIPE_PIPE: {
                var res: i64 = cast(i64, a != 0 || b != 0);
                return (eval_val_int(res, type_primitive(TypeKind.TYPE_BOOL)), true);
            }

            default: {
                return (eval_val_empty(), false);
            }
        }

        var res_val: i64 = int_truncate_to_width(r, sz, is_signed);
        return (eval_val_int(res_val, target_type), true);
    }

    proc eval_binary_float(self, op: TokenKind, rhs: EvalValue, res_type: Type*) -> (EvalValue, bool) {
        var a: u64 = self.float_to_f64_bits();
        var b: u64 = rhs.float_to_f64_bits();

        switch (op) {
            case TokenKind.TOK_PLUS: {
                return (eval_val_float(eval_narrow_f64_bits(soft_float_add_bits(a, b), res_type), res_type), true);
            }

            case TokenKind.TOK_MINUS: {
                return (eval_val_float(eval_narrow_f64_bits(soft_float_sub_bits(a, b), res_type), res_type), true);
            }

            case TokenKind.TOK_STAR: {
                return (eval_val_float(eval_narrow_f64_bits(soft_float_mul_bits(a, b), res_type), res_type), true);
            }

            case TokenKind.TOK_SLASH: {
                if (f64_bits_is_zero(b)) {
                    return (eval_val_empty(), false);
                }

                return (eval_val_float(eval_narrow_f64_bits(soft_float_div_bits(a, b), res_type), res_type), true);
            }

            case TokenKind.TOK_EQ_EQ, TokenKind.TOK_BANG_EQ,
                 TokenKind.TOK_LESS, TokenKind.TOK_LESS_EQ,
                 TokenKind.TOK_GREATER, TokenKind.TOK_GREATER_EQ: {
                var (cmp, ok) = soft_float_compare_bits(a, b);

                if (!ok) {
                    return (eval_val_empty(), false);
                }

                var res: i64 = 0;

                switch (op) {
                    case TokenKind.TOK_EQ_EQ:    res = cast(i64, cmp == 0);
                    case TokenKind.TOK_BANG_EQ:  res = cast(i64, cmp != 0);
                    case TokenKind.TOK_LESS:     res = cast(i64, cmp < 0);
                    case TokenKind.TOK_LESS_EQ:  res = cast(i64, cmp <= 0);
                    case TokenKind.TOK_GREATER:  res = cast(i64, cmp > 0);
                    case TokenKind.TOK_GREATER_EQ: res = cast(i64, cmp >= 0);
                    default: {}
                }

                return (eval_val_int(res, type_primitive(TypeKind.TYPE_BOOL)), true);
            }

            default: {
                return (eval_val_empty(), false);
            }
        }
    }
}

@inline proc eval_val_int(val: i64, t: Type*) -> EvalValue {
    var res: EvalValue;
    res.kind     = EvalKind.EVAL_INT;
    res.val_type = t;
    res.int_val  = val;
    return res;
}

@inline proc eval_val_float(bits: u64, t: Type*) -> EvalValue {
    var res: EvalValue;
    res.kind       = EvalKind.EVAL_FLOAT;
    res.val_type   = t;
    res.float_bits = bits;
    return res;
}

proc eval_narrow_f64_bits(bits: u64, t: Type*) -> u64 {
    if (t != null) {
        if (t.kind == TypeKind.TYPE_F32) {
            return cast(u64, f64_to_f32_bits(bits));
        }

        if (t.kind == TypeKind.TYPE_F16) {
            return cast(u64, f32_to_f16_bits(f64_to_f32_bits(bits)));
        }

        if (t.kind == TypeKind.TYPE_F8) {
            return cast(u64, f32_to_f8_bits(f64_to_f32_bits(bits)));
        }
    }

    return bits;
}

proc eval_int_to_float(ev: EvalValue, t: Type*) -> EvalValue {
    var f64_bits: u64 = 0;

    if (ev.val_type != null && !ev.val_type.is_signed()) {
        f64_bits = soft_float_from_u64(cast(u64, ev.int_val));
    } else {
        f64_bits = soft_float_from_i64(ev.int_val);
    }

    return eval_val_float(eval_narrow_f64_bits(f64_bits, t), t);
}

@inline proc eval_val_str(str: StrView, t: Type*) -> EvalValue {
    var res: EvalValue;
    res.kind     = EvalKind.EVAL_STR;
    res.val_type = t;
    res.str_val  = str;
    return res;
}

@inline proc eval_val_null(t: Type*) -> EvalValue {
    var res: EvalValue;
    res.kind     = EvalKind.EVAL_NULL;
    res.val_type = t;
    res.int_val  = 0;
    return res;
}

@inline proc eval_val_empty() -> EvalValue {
    var res: EvalValue;
    return res;
}

proc eval_expr(expr: AstExpr*) -> (EvalValue, bool) {
    if (expr == null) {
        return (eval_val_empty(), false);
    }

    switch (expr.kind) {
        case AstExprKind.EXPR_INT_LIT: {
            var t: Type* = expr.expr_type;

            if (t == null) {
                t = type_primitive(TypeKind.TYPE_I64);
            }

            return (eval_val_int(expr.int_val, t), true);
        }

        case AstExprKind.EXPR_FLOAT_LIT: {
            var t: Type* = expr.expr_type;

            if (t == null) {
                t = type_primitive(TypeKind.TYPE_F64);
            }

            return (eval_val_float(cast(u64, expr.int_val), t), true);
        }

        case AstExprKind.EXPR_STRING_LIT: {
            return (eval_val_str(expr.string_val, expr.expr_type), true);
        }

        case AstExprKind.EXPR_NULL: {
            var t: Type* = expr.expr_type;

            if (t == null) {
                t = type_primitive(TypeKind.TYPE_NULL);
            }

            return (eval_val_null(t), true);
        }

        case AstExprKind.EXPR_SIZEOF: {
            if (expr.size_align_type == null) {
                return (eval_val_empty(), false);
            }

            var size_val: i64 = cast(i64, expr.size_align_type.size);
            return (eval_val_int(size_val, type_primitive(TypeKind.TYPE_U64)), true);
        }

        case AstExprKind.EXPR_ALIGNOF: {
            if (expr.size_align_type == null) {
                return (eval_val_empty(), false);
            }

            var align_val: u64 = expr.size_align_type.align;

            if (align_val == 0) {
                align_val = 1;
            }

            return (eval_val_int(cast(i64, align_val), type_primitive(TypeKind.TYPE_U64)), true);
        }

        case AstExprKind.EXPR_OFFSETOF: {
            var st: Type* = expr.offset_struct_type;

            if (st == null) {
                return (eval_val_empty(), false);
            }

            if (st.is_pointer()) {
                st = st.base_type;
            }

            var field: StructField* = st.lookup_field(expr.offset_field_name);

            if (field == null) {
                return (eval_val_empty(), false);
            }

            return (eval_val_int(cast(i64, field.offset), type_primitive(TypeKind.TYPE_U64)), true);
        }

        case AstExprKind.EXPR_VAR: {
            if (expr.var_symbol != null && expr.var_symbol.kind == SymbolKind.SYM_CONST) {
                var sym: Symbol* = expr.var_symbol;

                switch (sym.const_kind) {
                    case ConstKind.CONST_FLOAT: {
                        return (eval_val_float(sym.const_float_bits, sym.symbol_type), true);
                    }

                    case ConstKind.CONST_STR: {
                        return (eval_val_str(sym.const_str, sym.symbol_type), true);
                    }

                    case ConstKind.CONST_NULL: {
                        return (eval_val_null(sym.symbol_type), true);
                    }

                    default: {
                        return (eval_val_int(sym.const_val, sym.symbol_type), true);
                    }
                }
            }

            return (eval_val_empty(), false);
        }

        case AstExprKind.EXPR_MEMBER: {
            if (expr.member_target != null && expr.member_target.expr_type != null) {
                var target_t: Type* = expr.member_target.expr_type;

                if (target_t.kind == TypeKind.TYPE_ENUM) {
                    var v: EnumVariant* = target_t.lookup_variant(expr.member_field_name);

                    if (v == null) {
                        return (eval_val_empty(), false);
                    }

                    return (eval_val_int(v.value, target_t), true);
                }
            }

            return (eval_val_empty(), false);
        }

        case AstExprKind.EXPR_UNARY: {
            var (inner, ok) = eval_expr(expr.unary_operand);

            if (!ok) {
                return (eval_val_empty(), false);
            }

            return inner.eval_unary(expr.unary_op);
        }

        case AstExprKind.EXPR_BINARY: {
            var (lhs, lhs_ok) = eval_expr(expr.binary_lhs);

            if (!lhs_ok) {
                return (eval_val_empty(), false);
            }

            var (rhs, rhs_ok) = eval_expr(expr.binary_rhs);

            if (!rhs_ok) {
                return (eval_val_empty(), false);
            }

            return lhs.eval_binary(expr.binary_op, rhs, expr.expr_type);
        }

        case AstExprKind.EXPR_CAST: {
            var (inner, ok) = eval_expr(expr.cast_expr);

            if (!ok) {
                return (eval_val_empty(), false);
            }

            var target_t: Type* = expr.cast_target_type;

            if (target_t == null) {
                return (eval_val_empty(), false);
            }

            if (inner.is_int() && target_t.is_float()) {
                var f64_bits: u64 = 0;

                if (inner.val_type != null && !inner.val_type.is_signed()) {
                    f64_bits = soft_float_from_u64(cast(u64, inner.int_val));
                } else {
                    f64_bits = soft_float_from_i64(inner.int_val);
                }

                return (eval_val_float(eval_narrow_f64_bits(f64_bits, target_t), target_t), true);
            }

            if (inner.is_float() && target_t.is_float()) {
                return (eval_val_float(eval_narrow_f64_bits(inner.float_to_f64_bits(), target_t), target_t), true);
            }

            if (inner.is_float() && target_t.is_integer()) {
                var (as_i64, conv_ok) = soft_float_to_i64(inner.float_to_f64_bits());

                if (!conv_ok) {
                    return (eval_val_empty(), false);
                }

                var truncated: i64 = int_truncate_to_width(as_i64, target_t.size, target_t.is_signed());
                return (eval_val_int(truncated, target_t), true);
            }

            if (inner.is_int()) {
                var truncated: i64 = int_truncate_to_width(inner.int_val, target_t.size, target_t.is_signed());
                return (eval_val_int(truncated, target_t), true);
            }

            if (inner.is_null() && (target_t.is_pointer() || target_t.kind == TypeKind.TYPE_FUNC)) {
                return (eval_val_null(target_t), true);
            }

            return (eval_val_empty(), false);
        }

        default: {
            return (eval_val_empty(), false);
        }
    }
}

proc eval_const_int(expr: AstExpr*) -> (i64, bool) {
    var (val, ok) = eval_expr(expr);

    if (ok && (val.is_int() || val.is_null())) {
        return (val.int_val, true);
    }

    return (0, false);
}