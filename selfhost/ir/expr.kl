import "libc.kl";
import "arena.kl";
import "strview.kl";
import "lexer.kl";
import "type.kl";
import "ast.kl";
import "float.kl";
import "ir/ir.kl";
import "ir/context.kl";
import "ir/addr.kl";
import "ir/cond.kl";
import "ir/inline.kl";
import "ir/aggregate.kl";

proc emit_float_unary(self: IRLower*, op: IROpcode, src: IROperand, width: u64, loc: SourceLoc) -> IROperand {
    var func: IRFunction* = self.current_func;
    var vreg: u32         = ir_vreg_alloc_t(func, ir_float_type_from_width(width));

    ir_emit_inst(func, op, ir_op_vreg_float(vreg, width), src, ir_op_none(), loc);

    return ir_op_vreg_float(vreg, width);
}

proc lower_float_widen(self: IRLower*, src: IROperand, from_width: u64, to_width: u64, loc: SourceLoc) -> IROperand {
    if (from_width >= to_width) {
        return src;
    }

    return emit_float_unary(self, IROpcode.IR_FPEXT, src, to_width, loc);
}

proc lower_float_narrow(self: IRLower*, src: IROperand, from_width: u64, to_width: u64, loc: SourceLoc) -> IROperand {
    if (from_width <= to_width) {
        return src;
    }

    return emit_float_unary(self, IROpcode.IR_FPTRUNC, src, to_width, loc);
}

proc lower_bitcast_float_to_int(self: IRLower*, src: IROperand, width: u64, loc: SourceLoc) -> IROperand {
    var func: IRFunction* = self.current_func;
    var vreg: u32         = ir_vreg_alloc_t(func, ir_type_from_shape(width, false));

    ir_emit_inst(func, IROpcode.IR_FPBITCAST_TO_INT, ir_op_vreg(vreg, width, false), src, ir_op_none(), loc);

    return ir_op_vreg(vreg, width, false);
}

proc lower_bitcast_int_to_float(self: IRLower*, src: IROperand, width: u64, loc: SourceLoc) -> IROperand {
    var func: IRFunction* = self.current_func;
    var vreg: u32         = ir_vreg_alloc_t(func, ir_float_type_from_width(width));

    ir_emit_inst(func, IROpcode.IR_FPBITCAST_TO_FLOAT, ir_op_vreg_float(vreg, width), src, ir_op_none(), loc);

    return ir_op_vreg_float(vreg, width);
}

proc lower_storage_float_pack(self: IRLower*, src: IROperand, target: Type*, loc: SourceLoc) -> IROperand {
    var func: IRFunction* = self.current_func;
    var bits: IROperand   = lower_bitcast_float_to_int(self, src, 4, loc);

    var helper: char* = "__klang_f32_to_f16";

    if (target.kind == TypeKind.TYPE_F8) {
        helper = "__klang_f32_to_f8";
        self.module.needs_f8_helpers = true;
    } else {
        self.module.needs_f16_helpers = true;
    }

    var narrowed: u32 = ir_vreg_alloc_t(func, ir_type_from_shape(target.size, false));

    ir_emit_runtime_call(func, helper, ir_op_vreg(narrowed, target.size, false), bits, loc);

    return ir_op_vreg(narrowed, target.size, false);
}

proc lower_storage_float_unpack(self: IRLower*, src: IROperand, source: Type*, loc: SourceLoc) -> IROperand {
    var func: IRFunction* = self.current_func;

    var helper: char* = "__klang_f16_to_f32";

    if (source.kind == TypeKind.TYPE_F8) {
        helper = "__klang_f8_to_f32";
        self.module.needs_f8_helpers = true;
    } else {
        self.module.needs_f16_helpers = true;
    }

    var raw: u32 = ir_vreg_alloc_t(func, type_primitive(TypeKind.TYPE_U32));

    ir_emit_runtime_call(func, helper, ir_op_vreg(raw, 4, false), src, loc);

    return lower_bitcast_int_to_float(self, ir_op_vreg(raw, 4, false), 4, loc);
}

proc lower_float_conversion(self: IRLower*, src: IROperand, src_type: Type*, dst_type: Type*, loc: SourceLoc) -> IROperand {
    var func: IRFunction* = self.current_func;

    var src_float: bool = src_type != null && src_type.is_float();
    var dst_float: bool = dst_type != null && dst_type.is_float();

    var value: IROperand = src;

    if (src_float && src_type.is_storage_float()) {
        value    = lower_storage_float_unpack(self, value, src_type, loc);
        src_type = type_primitive(TypeKind.TYPE_F32);
    }

    if (src_float && dst_float) {
        if (dst_type.is_storage_float()) {
            if (src_type.size > 4) {
                value = lower_float_narrow(self, value, src_type.size, 4, loc);
            } else if (src_type.size < 4) {
                value = lower_float_widen(self, value, src_type.size, 4, loc);
            }

            return lower_storage_float_pack(self, value, dst_type, loc);
        }

        if (src_type.size < dst_type.size) {
            return lower_float_widen(self, value, src_type.size, dst_type.size, loc);
        }

        if (src_type.size > dst_type.size) {
            return lower_float_narrow(self, value, src_type.size, dst_type.size, loc);
        }

        return value;
    }

    if (!src_float && dst_float) {
        var int_width:   u64  = 8;
        var is_unsigned: bool = true;

        if (src_type != null) {
            if (src_type.size > 0) {
                int_width = src_type.size;
            }

            is_unsigned = !src_type.is_signed();
        }

        var promoted: IROperand = value;

        if (int_width < 4) {
            var pv: u32 = ir_vreg_alloc_t(func, type_primitive(TypeKind.TYPE_I32));

            ir_emit_inst(func, IROpcode.IR_MOV, ir_op_vreg(pv, 4, !is_unsigned), value, ir_op_none(), loc);

            promoted  = ir_op_vreg(pv, 4, !is_unsigned);
            int_width = 4;
        }

        var target_width: u64 = dst_type.size;

        if (dst_type.is_storage_float()) {
            target_width = 4;
        }

        var conv_op: IROpcode = IROpcode.IR_SITOFP;

        if (is_unsigned) {
            conv_op = IROpcode.IR_UITOFP;
        }

        var fvreg: u32 = ir_vreg_alloc_t(func, ir_float_type_from_width(target_width));

        ir_emit_inst(func, conv_op, ir_op_vreg_float(fvreg, target_width), promoted, ir_op_none(), loc);

        var produced: IROperand = ir_op_vreg_float(fvreg, target_width);

        if (dst_type.is_storage_float()) {
            return lower_storage_float_pack(self, produced, dst_type, loc);
        }

        return produced;
    }

    var dst_width:  u64  = 8;
    var dst_signed: bool = true;

    if (dst_type != null) {
        if (dst_type.size > 0) {
            dst_width = dst_type.size;
        }

        dst_signed = dst_type.is_signed();
    }

    var conv_op: IROpcode = IROpcode.IR_FPTOSI;

    if (!dst_signed) {
        conv_op = IROpcode.IR_FPTOUI;
    }

    var result_width: u64 = dst_width;

    if (result_width < 4) {
        result_width = 4;
    }

    var ivreg: u32 = ir_vreg_alloc_t(func, ir_type_from_shape(result_width, dst_signed));

    ir_emit_inst(func, conv_op, ir_op_vreg(ivreg, result_width, dst_signed), value, ir_op_none(), loc);

    if (dst_width >= result_width) {
        return ir_op_vreg(ivreg, dst_width, dst_signed);
    }

    var narrow: u32 = ir_vreg_alloc_t(func, ir_type_from_shape(dst_width, dst_signed));

    ir_emit_inst(func, IROpcode.IR_MOV, ir_op_vreg(narrow, dst_width, dst_signed),
                 ir_op_vreg(ivreg, result_width, dst_signed), ir_op_none(), loc);

    return ir_op_vreg(narrow, dst_width, dst_signed);
}

proc lower_expr(self: IRLower*, expr: AstExpr*) -> IROperand {
    if (expr == null) {
        return ir_op_none();
    }

    var func: IRFunction* = self.current_func;

    if (expr.expr_type != null && expr.expr_type.kind == TypeKind.TYPE_ARRAY) {
        var addr: IROperand = lower_addr(self, expr);

        if (addr.kind == IROperandKind.IR_OP_STACK || addr.kind == IROperandKind.IR_OP_GLOBAL) {
            var vreg: u32 = ir_vreg_alloc_t(func, type_ptr(func.arena, expr.expr_type));

            ir_emit_inst(func, IROpcode.IR_ADDR, ir_op_vreg(vreg, 8, false), addr, ir_op_none(), expr.loc);

            return ir_op_vreg(vreg, 8, false);
        }

        return addr;
    }

    var expr_size: u64  = 8;
    var is_signed: bool = false;

    if (expr.expr_type != null) {
        if (expr.expr_type.size > 0) {
            expr_size = expr.expr_type.size;
        }
        is_signed = expr.expr_type.is_signed();
    }

    switch (expr.kind) {
        case AstExprKind.EXPR_INT_LIT,
             AstExprKind.EXPR_SIZEOF,
             AstExprKind.EXPR_ALIGNOF,
             AstExprKind.EXPR_OFFSETOF: {
            return ir_op_const(expr.int_val, expr_size, is_signed);
        }

        case AstExprKind.EXPR_FLOAT_LIT: {
            if (expr.expr_type != null && expr.expr_type.is_storage_float()) {
                var f32_bits: u32 = f64_to_f32_bits(cast(u64, expr.int_val));
                var narrowed: u32 = f32_to_f16_bits(f32_bits);

                if (expr.expr_type.kind == TypeKind.TYPE_F8) {
                    narrowed = f32_to_f8_bits(f32_bits);
                }

                return ir_op_const(cast(i64, cast(u64, narrowed)), expr.expr_type.size, false);
            }

            var width: u64 = expr_size;

            if (width != 4) {
                width = 8;
            }

            var bits: i64 = expr.int_val;

            if (width == 4) {
                bits = cast(i64, cast(u64, f64_to_f32_bits(cast(u64, expr.int_val))));
            }

            var pool_id: u32 = self.register_float_literal(bits, width);

            return ir_op_const_float(bits, width, pool_id);
        }

        case AstExprKind.EXPR_NULL: {
            return ir_op_const(0, expr_size, false);
        }

        case AstExprKind.EXPR_STRING_LIT: {
            var str_id: u32 = self.register_string_literal(expr.string_val);
            var vreg:   u32 = ir_vreg_alloc_t(func, type_ptr(func.arena, type_primitive(TypeKind.TYPE_CHAR)));

            ir_emit_inst(func, IROpcode.IR_GLOBAL_STR, ir_op_vreg(vreg, 8, false),
                         ir_op_str(str_id), ir_op_none(), expr.loc);

            if (expr.expr_type != null && expr.expr_type.is_slice()) {
                var tmp_slot: i32 = ir_func_alloc_stack_slot(func, 16, 8);

                ir_emit_inst(func, IROpcode.IR_MOV, ir_op_stack(tmp_slot, 8, false),
                             ir_op_vreg(vreg, 8, false), ir_op_none(), expr.loc);

                ir_emit_inst(func, IROpcode.IR_MOV, ir_op_stack(tmp_slot + 8, 8, false),
                             ir_op_const(cast(i64, expr.string_val.len), 8, false), ir_op_none(), expr.loc);

                return ir_op_stack(tmp_slot, 16, false);
            }

            return ir_op_vreg(vreg, 8, false);
        }

        case AstExprKind.EXPR_VAR: {
            var sym: Symbol* = expr.var_symbol;

            if (sym.kind == SymbolKind.SYM_CONST) {
                return ir_op_const(sym.const_val, expr_size, is_signed);
            }

            if (sym.kind == SymbolKind.SYM_PROC) {
                var vreg: u32 = ir_vreg_alloc_t(func, type_ptr(func.arena, expr.expr_type));

                ir_emit_inst(func, IROpcode.IR_ADDR, ir_op_vreg(vreg, 8, false),
                             ir_op_global(sym.name, 8, false), ir_op_none(), expr.loc);

                return ir_op_vreg(vreg, 8, false);
            }

            var addr: IROperand = lower_addr(self, expr);

            if (expr.expr_type != null && expr.expr_type.is_compound()) {
                return addr;
            }

            var vreg: u32       = ir_vreg_alloc_t(func, expr.expr_type);
            var dst:  IROperand = ir_op_vreg_of_type(func, vreg, expr.expr_type);

            ir_emit_inst(func, IROpcode.IR_MOV, dst, addr, ir_op_none(), expr.loc);

            return dst;
        }

        case AstExprKind.EXPR_UNARY: {
            if (expr.unary_op == TokenKind.TOK_STAR) {
                var ptr_op: IROperand = lower_expr(self, expr.unary_operand);
                var vreg:   u32       = ir_vreg_alloc(func);

                ir_emit_inst(func, IROpcode.IR_LOAD, ir_op_vreg(vreg, expr_size, is_signed),
                             ptr_op, ir_op_none(), expr.loc);

                return ir_op_vreg(vreg, expr_size, is_signed);
            }

            if (expr.unary_op == TokenKind.TOK_AMP) {
                var addr: IROperand = lower_addr(self, expr.unary_operand);

                if (addr.kind == IROperandKind.IR_OP_VREG) {
                    return addr;
                }

                var vreg: u32 = ir_vreg_alloc(func);

                ir_emit_inst(func, IROpcode.IR_ADDR, ir_op_vreg(vreg, 8, false),
                             addr, ir_op_none(), expr.loc);

                return ir_op_vreg(vreg, 8, false);
            }

            if (expr.unary_op == TokenKind.TOK_MINUS) {
                var inner_op: IROperand = lower_expr(self, expr.unary_operand);

                if (ir_operand_is_float(func, inner_op)) {
                    var fwidth: u64 = ir_float_width_normalize(inner_op.byte_size);

                    return emit_float_unary(self, IROpcode.IR_FNEG, inner_op, fwidth, expr.loc);
                }

                var vreg: u32 = ir_vreg_alloc(func);

                ir_emit_inst(func, IROpcode.IR_NEG, ir_op_vreg(vreg, expr_size, is_signed),
                             inner_op, ir_op_none(), expr.loc);

                return ir_op_vreg(vreg, expr_size, is_signed);
            }

            if (expr.unary_op == TokenKind.TOK_TILDE) {
                var inner_op: IROperand = lower_expr(self, expr.unary_operand);
                var vreg:     u32       = ir_vreg_alloc(func);

                ir_emit_inst(func, IROpcode.IR_NOT, ir_op_vreg(vreg, expr_size, false),
                             inner_op, ir_op_none(), expr.loc);

                return ir_op_vreg(vreg, expr_size, false);
            }

            if (expr.unary_op == TokenKind.TOK_BANG) {
                var inner_op: IROperand = lower_expr(self, expr.unary_operand);
                var vreg:     u32       = ir_vreg_alloc(func);

                ir_emit_inst(func, IROpcode.IR_CMP_EQ, ir_op_vreg(vreg, 1, false), inner_op,
                             ir_op_const(0, inner_op.byte_size, false), expr.loc);

                return ir_op_vreg(vreg, 1, false);
            }

            return lower_expr(self, expr.unary_operand);
        }

        case AstExprKind.EXPR_BINARY: {
            if (expr.binary_op == TokenKind.TOK_AMP_AMP || expr.binary_op == TokenKind.TOK_PIPE_PIPE) {
                var bb_true:  IRBlock* = ir_block_create(func, strview_from_cstr("bb_logic_true"));
                var bb_false: IRBlock* = ir_block_create(func, strview_from_cstr("bb_logic_false"));
                var bb_merge: IRBlock* = ir_block_create(func, strview_from_cstr("bb_logic_merge"));

                var tmp_slot: i32 = ir_func_alloc_stack_slot(func, 1, 1);

                lower_cond(self, expr, bb_true, bb_false);

                ir_block_switch(func, bb_true);
                ir_emit_inst(func, IROpcode.IR_MOV, ir_op_stack(tmp_slot, 1, false),
                             ir_op_const(1, 1, false), ir_op_none(), expr.loc);
                ir_emit_inst(func, IROpcode.IR_JMP, ir_op_block(bb_merge), ir_op_none(), ir_op_none(), expr.loc);

                ir_block_switch(func, bb_false);
                ir_emit_inst(func, IROpcode.IR_MOV, ir_op_stack(tmp_slot, 1, false),
                             ir_op_const(0, 1, false), ir_op_none(), expr.loc);
                ir_emit_inst(func, IROpcode.IR_JMP, ir_op_block(bb_merge), ir_op_none(), ir_op_none(), expr.loc);

                ir_block_switch(func, bb_merge);

                var res_vreg: u32 = ir_vreg_alloc(func);

                ir_emit_inst(func, IROpcode.IR_MOV, ir_op_vreg(res_vreg, 1, false),
                             ir_op_stack(tmp_slot, 1, false), ir_op_none(), expr.loc);

                return ir_op_vreg(res_vreg, 1, false);
            }

            if (expr.binary_lhs.expr_type != null && expr.binary_lhs.expr_type.is_slice() &&
                (expr.binary_op == TokenKind.TOK_EQ_EQ || expr.binary_op == TokenKind.TOK_BANG_EQ)) {

                var lhs_addr: IROperand = lower_addr(self, expr.binary_lhs);

                if (lhs_addr.kind == IROperandKind.IR_OP_STACK || lhs_addr.kind == IROperandKind.IR_OP_GLOBAL) {
                    var v: u32 = ir_vreg_alloc(func);

                    ir_emit_inst(func, IROpcode.IR_ADDR, ir_op_vreg(v, 8, false), lhs_addr, ir_op_none(), expr.loc);

                    lhs_addr = ir_op_vreg(v, 8, false);
                }

                var rhs_addr: IROperand = lower_addr(self, expr.binary_rhs);

                if (rhs_addr.kind == IROperandKind.IR_OP_STACK || rhs_addr.kind == IROperandKind.IR_OP_GLOBAL) {
                    var v: u32 = ir_vreg_alloc(func);

                    ir_emit_inst(func, IROpcode.IR_ADDR, ir_op_vreg(v, 8, false), rhs_addr, ir_op_none(), expr.loc);

                    rhs_addr = ir_op_vreg(v, 8, false);
                }

                var lhs_ptr: u32 = ir_vreg_alloc(func);
                ir_emit_inst(func, IROpcode.IR_LOAD, ir_op_vreg(lhs_ptr, 8, false), lhs_addr, ir_op_none(), expr.loc);

                var rhs_ptr: u32 = ir_vreg_alloc(func);
                ir_emit_inst(func, IROpcode.IR_LOAD, ir_op_vreg(rhs_ptr, 8, false), rhs_addr, ir_op_none(), expr.loc);

                var lhs_len_addr: u32 = ir_vreg_alloc(func);
                ir_emit_inst(func, IROpcode.IR_ADD, ir_op_vreg(lhs_len_addr, 8, false), lhs_addr, ir_op_const(8, 8, false), expr.loc);

                var lhs_len: u32 = ir_vreg_alloc(func);
                ir_emit_inst(func, IROpcode.IR_LOAD, ir_op_vreg(lhs_len, 8, false), ir_op_vreg(lhs_len_addr, 8, false), ir_op_none(), expr.loc);

                var rhs_len_addr: u32 = ir_vreg_alloc(func);
                ir_emit_inst(func, IROpcode.IR_ADD, ir_op_vreg(rhs_len_addr, 8, false), rhs_addr, ir_op_const(8, 8, false), expr.loc);

                var rhs_len: u32 = ir_vreg_alloc(func);
                ir_emit_inst(func, IROpcode.IR_LOAD, ir_op_vreg(rhs_len, 8, false), ir_op_vreg(rhs_len_addr, 8, false), ir_op_none(), expr.loc);

                if (expr.binary_op == TokenKind.TOK_EQ_EQ) {
                    var cmp_ptr: u32 = ir_vreg_alloc(func);
                    ir_emit_inst(func, IROpcode.IR_CMP_EQ, ir_op_vreg(cmp_ptr, 1, false),
                                 ir_op_vreg(lhs_ptr, 8, false), ir_op_vreg(rhs_ptr, 8, false), expr.loc);

                    var cmp_len: u32 = ir_vreg_alloc(func);
                    ir_emit_inst(func, IROpcode.IR_CMP_EQ, ir_op_vreg(cmp_len, 1, false),
                                 ir_op_vreg(lhs_len, 8, false), ir_op_vreg(rhs_len, 8, false), expr.loc);

                    var res_vreg: u32 = ir_vreg_alloc(func);
                    ir_emit_inst(func, IROpcode.IR_AND, ir_op_vreg(res_vreg, 1, false),
                                 ir_op_vreg(cmp_ptr, 1, false), ir_op_vreg(cmp_len, 1, false), expr.loc);

                    return ir_op_vreg(res_vreg, 1, false);
                } else {
                    var cmp_ptr: u32 = ir_vreg_alloc(func);
                    ir_emit_inst(func, IROpcode.IR_CMP_NE, ir_op_vreg(cmp_ptr, 1, false),
                                 ir_op_vreg(lhs_ptr, 8, false), ir_op_vreg(rhs_ptr, 8, false), expr.loc);

                    var cmp_len: u32 = ir_vreg_alloc(func);
                    ir_emit_inst(func, IROpcode.IR_CMP_NE, ir_op_vreg(cmp_len, 1, false),
                                 ir_op_vreg(lhs_len, 8, false), ir_op_vreg(rhs_len, 8, false), expr.loc);

                    var res_vreg: u32 = ir_vreg_alloc(func);
                    ir_emit_inst(func, IROpcode.IR_OR, ir_op_vreg(res_vreg, 1, false),
                                 ir_op_vreg(cmp_ptr, 1, false), ir_op_vreg(cmp_len, 1, false), expr.loc);

                    return ir_op_vreg(res_vreg, 1, false);
                }
            }

            var lhs: IROperand = lower_expr(self, expr.binary_lhs);
            var rhs: IROperand = lower_expr(self, expr.binary_rhs);

            if (expr.binary_op == TokenKind.TOK_PLUS || expr.binary_op == TokenKind.TOK_MINUS) {
                var lhs_is_ptr: bool = (expr.binary_lhs.expr_type != null && expr.binary_lhs.expr_type.is_pointer());
                var rhs_is_ptr: bool = (expr.binary_rhs.expr_type != null && expr.binary_rhs.expr_type.is_pointer());

                if (lhs_is_ptr && expr.binary_rhs.expr_type != null && expr.binary_rhs.expr_type.is_integer()) {
                    var base:      Type* = expr.binary_lhs.expr_type.base_type;
                    var elem_size: u64   = 1;

                    if (base != null && base.size > 0) {
                        elem_size = base.size;
                    }

                    if (elem_size > 1) {
                        var scale_vreg: u32 = ir_vreg_alloc(func);

                        ir_emit_inst(func, IROpcode.IR_MUL, ir_op_vreg(scale_vreg, 8, false), rhs,
                                     ir_op_const(cast(i64, elem_size), 8, false), expr.loc);

                        rhs = ir_op_vreg(scale_vreg, 8, false);
                    }
                } else if (rhs_is_ptr && expr.binary_lhs.expr_type != null && expr.binary_lhs.expr_type.is_integer() && expr.binary_op == TokenKind.TOK_PLUS) {
                    var base:      Type* = expr.binary_rhs.expr_type.base_type;
                    var elem_size: u64   = 1;

                    if (base != null && base.size > 0) {
                        elem_size = base.size;
                    }

                    if (elem_size > 1) {
                        var scale_vreg: u32 = ir_vreg_alloc(func);

                        ir_emit_inst(func, IROpcode.IR_MUL, ir_op_vreg(scale_vreg, 8, false), lhs,
                                     ir_op_const(cast(i64, elem_size), 8, false), expr.loc);

                        lhs = ir_op_vreg(scale_vreg, 8, false);
                    }
                }
            }

            var operands_are_float: bool = ir_operand_is_float(func, lhs) || ir_operand_is_float(func, rhs);

            if (operands_are_float) {
                var fop:           IROpcode = ir_float_binop_from_token(expr.binary_op);
                var operand_width: u64      = ir_float_operand_width(func, lhs, rhs);

                if (ir_opcode_is_float_compare(fop)) {
                    var cmp_vreg: u32 = ir_vreg_alloc_t(func, type_primitive(TypeKind.TYPE_BOOL));

                    ir_emit_inst(func, fop, ir_op_vreg(cmp_vreg, 1, false), lhs, rhs, expr.loc);

                    return ir_op_vreg(cmp_vreg, 1, false);
                }

                var fvreg: u32 = ir_vreg_alloc_t(func, ir_float_type_from_width(operand_width));

                ir_emit_inst(func, fop, ir_op_vreg_float(fvreg, operand_width), lhs, rhs, expr.loc);

                return ir_op_vreg_float(fvreg, operand_width);
            }

            var vreg: u32      = ir_vreg_alloc(func);
            var op:   IROpcode = IROpcode.IR_ADD;

            switch (expr.binary_op) {
                case TokenKind.TOK_PLUS:        op = IROpcode.IR_ADD;
                case TokenKind.TOK_MINUS:       op = IROpcode.IR_SUB;
                case TokenKind.TOK_STAR:        op = IROpcode.IR_MUL;
                case TokenKind.TOK_SLASH:       op = IROpcode.IR_DIV;
                case TokenKind.TOK_PERCENT:     op = IROpcode.IR_MOD;
                case TokenKind.TOK_AMP:         op = IROpcode.IR_AND;
                case TokenKind.TOK_PIPE:        op = IROpcode.IR_OR;
                case TokenKind.TOK_CARET:       op = IROpcode.IR_XOR;
                case TokenKind.TOK_SHL:         op = IROpcode.IR_SHL;
                case TokenKind.TOK_SHR:         op = IROpcode.IR_SHR;
                case TokenKind.TOK_EQ_EQ:       op = IROpcode.IR_CMP_EQ;
                case TokenKind.TOK_BANG_EQ:     op = IROpcode.IR_CMP_NE;
                case TokenKind.TOK_LESS:        op = IROpcode.IR_CMP_LT;
                case TokenKind.TOK_LESS_EQ:     op = IROpcode.IR_CMP_LE;
                case TokenKind.TOK_GREATER:     op = IROpcode.IR_CMP_GT;
                case TokenKind.TOK_GREATER_EQ:  op = IROpcode.IR_CMP_GE;
                default: {}
            }

            ir_emit_inst(func, op, ir_op_vreg(vreg, expr_size, is_signed), lhs, rhs, expr.loc);

            return ir_op_vreg(vreg, expr_size, is_signed);
        }

        case AstExprKind.EXPR_CAST: {
            var inner_op: IROperand = lower_expr(self, expr.cast_expr);
            var src_type: Type*     = expr.cast_expr.expr_type;
            var dst_type: Type*     = expr.expr_type;

            var src_float: bool = src_type != null && src_type.is_float();
            var dst_float: bool = dst_type != null && dst_type.is_float();

            if (src_float || dst_float) {
                return lower_float_conversion(self, inner_op, src_type, dst_type, expr.loc);
            }

            var vreg: u32 = ir_vreg_alloc(func);

            ir_emit_inst(func, IROpcode.IR_MOV, ir_op_vreg(vreg, expr_size, is_signed), inner_op, ir_op_none(), expr.loc);

            return ir_op_vreg(vreg, expr_size, is_signed);
        }

        case AstExprKind.EXPR_INDEX,
             AstExprKind.EXPR_MEMBER: {
            var addr: IROperand = lower_addr(self, expr);

            if (expr.expr_type != null && expr.expr_type.is_compound()) {
                return addr;
            }

            var vreg: u32       = ir_vreg_alloc_t(func, expr.expr_type);
            var dst:  IROperand = ir_op_vreg_of_type(func, vreg, expr.expr_type);

            ir_emit_inst(func, IROpcode.IR_LOAD, dst, addr, ir_op_none(), expr.loc);

            return dst;
        }

        case AstExprKind.EXPR_ALLOCA: {
            var elem_t:    Type* = expr.alloca_elem_type;
            var elem_size: u64   = 1;

            if (elem_t != null && elem_t.size > 0) {
                elem_size = elem_t.size;
            }

            var ptr_vreg: u32 = ir_vreg_alloc_t(func, type_ptr(func.arena, elem_t));

            if (expr.alloca_count_expr.kind == AstExprKind.EXPR_INT_LIT) {
                var total_bytes:   i64 = expr.alloca_count_expr.int_val * cast(i64, elem_size);
                var aligned_bytes: i64 = (total_bytes + 15) & ~15;

                ir_emit_inst(func, IROpcode.IR_ALLOCA, ir_op_vreg(ptr_vreg, 8, false),
                             ir_op_const(aligned_bytes, 8, false), ir_op_none(), expr.loc);
            } else {
                var count_op: IROperand = lower_expr(self, expr.alloca_count_expr);
                var size_op:  IROperand = count_op;

                if (elem_size > 1) {
                    var scale_vreg: u32 = ir_vreg_alloc(func);

                    ir_emit_inst(func, IROpcode.IR_MUL, ir_op_vreg(scale_vreg, 8, false), count_op,
                                 ir_op_const(cast(i64, elem_size), 8, false), expr.loc);

                    size_op = ir_op_vreg(scale_vreg, 8, false);
                }

                var add_vreg: u32 = ir_vreg_alloc(func);

                ir_emit_inst(func, IROpcode.IR_ADD, ir_op_vreg(add_vreg, 8, false), size_op,
                             ir_op_const(15, 8, false), expr.loc);

                var align_vreg: u32 = ir_vreg_alloc(func);

                ir_emit_inst(func, IROpcode.IR_AND, ir_op_vreg(align_vreg, 8, false), ir_op_vreg(add_vreg, 8, false),
                             ir_op_const(-16, 8, true), expr.loc);

                ir_emit_inst(func, IROpcode.IR_ALLOCA, ir_op_vreg(ptr_vreg, 8, false),
                             ir_op_vreg(align_vreg, 8, false), ir_op_none(), expr.loc);
            }

            return ir_op_vreg(ptr_vreg, 8, false);
        }

        case AstExprKind.EXPR_ASM: {
            var dst: IROperand = ir_op_none();

            if (expr.expr_type != null && expr.expr_type.kind != TypeKind.TYPE_VOID) {
                var vreg: u32 = ir_vreg_alloc_t(func, expr.expr_type);
                dst = ir_op_vreg_of_type(func, vreg, expr.expr_type);
            }

            var ir_inputs: IRAsmOp* = null;

            if (expr.asm_input_count > 0) {
                ir_inputs = alloc_array[IRAsmOp](self.arena, expr.asm_input_count);

                for (var i: u64 = 0; i < expr.asm_input_count; i += 1) {
                    var in_op: AsmOperand* = &expr.asm_inputs[i];
                    var val:   IROperand   = lower_expr(self, in_op.expr);
                    var bsize: u64         = in_op.byte_size;

                    if (bsize == 0) {
                        bsize = val.byte_size;
                    }

                    ir_inputs[i].reg       = in_op.reg;
                    ir_inputs[i].byte_size = bsize;
                    ir_inputs[i].val       = val;
                }
            }

            var ir_outputs: IRAsmOp* = null;

            if (expr.asm_output_count > 0) {
                ir_outputs = alloc_array[IRAsmOp](self.arena, expr.asm_output_count);

                for (var i: u64 = 0; i < expr.asm_output_count; i += 1) {
                    var out_op: AsmOperand* = &expr.asm_outputs[i];
                    var bsize:  u64         = out_op.byte_size;

                    if (bsize == 0) {
                        bsize = 8;
                    }

                    ir_outputs[i].reg       = out_op.reg;
                    ir_outputs[i].byte_size = bsize;
                    ir_outputs[i].val       = ir_op_none();
                }
            }

            var clobber_mask: u32 = 0;

            for (var i: u64 = 0; i < expr.asm_clobber_count; i += 1) {
                var reg_name: StrView = expr.asm_clobbers[i];
                var r:        X86Reg  = X86Reg.REG_NONE;

                if (reg_name.equals_cstr("rax")) r = X86Reg.REG_RAX;
                else if (reg_name.equals_cstr("rcx")) r = X86Reg.REG_RCX;
                else if (reg_name.equals_cstr("rdx")) r = X86Reg.REG_RDX;
                else if (reg_name.equals_cstr("rbx")) r = X86Reg.REG_RBX;
                else if (reg_name.equals_cstr("rsi")) r = X86Reg.REG_RSI;
                else if (reg_name.equals_cstr("rdi")) r = X86Reg.REG_RDI;
                else if (reg_name.equals_cstr("rsp")) r = X86Reg.REG_RSP;
                else if (reg_name.equals_cstr("rbp")) r = X86Reg.REG_RBP;
                else if (reg_name.equals_cstr("r8"))  r = X86Reg.REG_R8;
                else if (reg_name.equals_cstr("r9"))  r = X86Reg.REG_R9;
                else if (reg_name.equals_cstr("r10")) r = X86Reg.REG_R10;
                else if (reg_name.equals_cstr("r11")) r = X86Reg.REG_R11;
                else if (reg_name.equals_cstr("r12")) r = X86Reg.REG_R12;
                else if (reg_name.equals_cstr("r13")) r = X86Reg.REG_R13;
                else if (reg_name.equals_cstr("r14")) r = X86Reg.REG_R14;
                else if (reg_name.equals_cstr("r15")) r = X86Reg.REG_R15;

                if (r != X86Reg.REG_NONE) {
                    clobber_mask = clobber_mask | (cast(u32, 1) << cast(u32, r));
                }
            }

            var inst: IRInst* = ir_emit_inst(func, IROpcode.IR_INLINE_ASM, dst, ir_op_none(), ir_op_none(), expr.loc);

            inst.symbol_name      = expr.asm_code;
            inst.asm_inputs       = ir_inputs;
            inst.asm_input_count  = expr.asm_input_count;
            inst.asm_outputs      = ir_outputs;
            inst.asm_output_count = expr.asm_output_count;
            inst.clobber_mask     = clobber_mask;
            inst.clobbers_memory  = expr.asm_clobbers_memory;

            for (var i: u64 = 0; i < expr.asm_output_count; i += 1) {
                var out_op: AsmOperand* = &expr.asm_outputs[i];

                if (out_op.expr != null) {
                    var dst_addr: IROperand = lower_addr(self, out_op.expr);
                    dst_addr.byte_size = out_op.byte_size;

                    var out_vreg: u32 = ir_vreg_alloc(func);

                    ir_emit_inst(func, IROpcode.IR_MOV, ir_op_vreg(out_vreg, out_op.byte_size, false),
                                 ir_op_reg(out_op.reg, out_op.byte_size, false), ir_op_none(), expr.loc);

                    if (dst_addr.kind == IROperandKind.IR_OP_STACK || dst_addr.kind == IROperandKind.IR_OP_GLOBAL) {
                        ir_emit_inst(func, IROpcode.IR_MOV, dst_addr,
                                     ir_op_vreg(out_vreg, out_op.byte_size, false), ir_op_none(), expr.loc);
                    } else {
                        ir_emit_inst(func, IROpcode.IR_STORE, dst_addr,
                                     ir_op_vreg(out_vreg, out_op.byte_size, false), ir_op_none(), expr.loc);
                    }
                }
            }

            return dst;
        }

        case AstExprKind.EXPR_STRUCT_LIT: {
            var st:          Type* = expr.struct_lit_type;
            var total_size:  u64   = 8;
            var total_align: u64   = 8;

            if (st != null) {
                if (st.size > 0)  total_size  = st.size;
                if (st.align > 0) total_align = st.align;
            }

            var tmp_slot: i32       = ir_func_alloc_stack_slot(func, total_size, total_align);
            var dest_op:  IROperand = ir_op_stack(tmp_slot, total_size, false);

            lower_struct_lit_into(self, expr, dest_op);

            return dest_op;
        }

        case AstExprKind.EXPR_ARRAY_LIT: {
            var arr_t:       Type* = expr.expr_type;
            var total_size:  u64   = 8;
            var total_align: u64   = 8;

            if (arr_t != null) {
                if (arr_t.size > 0)  total_size  = arr_t.size;
                if (arr_t.align > 0) total_align = arr_t.align;
            }

            var tmp_slot: i32       = ir_func_alloc_stack_slot(func, total_size, total_align);
            var dest_op:  IROperand = ir_op_stack(tmp_slot, total_size, false);

            lower_array_lit_into(self, expr, dest_op);

            return dest_op;
        }

        case AstExprKind.EXPR_SLICE: {
            var target_type: Type* = expr.slice_target.expr_type;
            var elem_type:   Type* = null;

            if (expr.expr_type != null && expr.expr_type.is_slice()) {
                elem_type = expr.expr_type.slice_elem;
            }

            var elem_size: u64 = 1;

            if (elem_type != null && elem_type.size > 0) {
                elem_size = elem_type.size;
            }

            var tmp_slot: i32       = ir_func_alloc_stack_slot(func, 16, 8);
            var base_ptr: IROperand;
            var max_len:  IROperand = ir_op_none();

            if (target_type != null && target_type.kind == TypeKind.TYPE_ARRAY) {
                var arr_addr: IROperand = lower_addr(self, expr.slice_target);

                if (arr_addr.kind == IROperandKind.IR_OP_STACK || arr_addr.kind == IROperandKind.IR_OP_GLOBAL) {
                    var vreg: u32 = ir_vreg_alloc_t(func, type_ptr(func.arena, target_type));

                    ir_emit_inst(func, IROpcode.IR_ADDR, ir_op_vreg(vreg, 8, false), arr_addr, ir_op_none(), expr.loc);

                    base_ptr = ir_op_vreg(vreg, 8, false);
                } else {
                    base_ptr = arr_addr;
                }

                max_len = ir_op_const(cast(i64, target_type.array_count), 8, false);
            } else if (target_type != null && target_type.is_slice()) {
                var slice_addr: IROperand = lower_addr(self, expr.slice_target);

                if (slice_addr.kind == IROperandKind.IR_OP_STACK || slice_addr.kind == IROperandKind.IR_OP_GLOBAL) {
                    var vreg: u32 = ir_vreg_alloc_t(func, type_ptr(func.arena, target_type));

                    ir_emit_inst(func, IROpcode.IR_ADDR, ir_op_vreg(vreg, 8, false), slice_addr, ir_op_none(), expr.loc);

                    slice_addr = ir_op_vreg(vreg, 8, false);
                }

                var ptr_vreg: u32 = ir_vreg_alloc_t(func, type_ptr(func.arena, elem_type));
                ir_emit_inst(func, IROpcode.IR_LOAD, ir_op_vreg(ptr_vreg, 8, false), slice_addr, ir_op_none(), expr.loc);
                base_ptr = ir_op_vreg(ptr_vreg, 8, false);

                var len_addr_vreg: u32 = ir_vreg_alloc_t(func, type_ptr(func.arena, type_primitive(TypeKind.TYPE_U64)));
                ir_emit_inst(func, IROpcode.IR_ADD, ir_op_vreg(len_addr_vreg, 8, false), slice_addr,
                             ir_op_const(8, 8, false), expr.loc);

                var len_vreg: u32 = ir_vreg_alloc_t(func, type_primitive(TypeKind.TYPE_U64));
                ir_emit_inst(func, IROpcode.IR_LOAD, ir_op_vreg(len_vreg, 8, false),
                             ir_op_vreg(len_addr_vreg, 8, false), ir_op_none(), expr.loc);

                max_len = ir_op_vreg(len_vreg, 8, false);
            } else {
                base_ptr = lower_expr(self, expr.slice_target);
            }

            var start_op: IROperand;

            if (expr.slice_start != null) {
                start_op = lower_expr(self, expr.slice_start);
            } else {
                start_op = ir_op_const(0, 8, false);
            }

            var end_op: IROperand;

            if (expr.slice_end != null) {
                end_op = lower_expr(self, expr.slice_end);
            } else {
                end_op = max_len;
            }

            var slice_len_vreg: u32 = ir_vreg_alloc(func);
            ir_emit_inst(func, IROpcode.IR_SUB, ir_op_vreg(slice_len_vreg, 8, false), end_op, start_op, expr.loc);

            var offset_op: IROperand = start_op;

            if (elem_size > 1) {
                var scale_vreg: u32 = ir_vreg_alloc(func);

                ir_emit_inst(func, IROpcode.IR_MUL, ir_op_vreg(scale_vreg, 8, false), start_op,
                             ir_op_const(cast(i64, elem_size), 8, false), expr.loc);

                offset_op = ir_op_vreg(scale_vreg, 8, false);
            }

            var final_ptr_vreg: u32 = ir_vreg_alloc_t(func, type_ptr(func.arena, elem_type));
            ir_emit_inst(func, IROpcode.IR_ADD, ir_op_vreg(final_ptr_vreg, 8, false), base_ptr, offset_op, expr.loc);

            ir_emit_inst(func, IROpcode.IR_MOV, ir_op_stack(tmp_slot, 8, false),
                         ir_op_vreg(final_ptr_vreg, 8, false), ir_op_none(), expr.loc);

            ir_emit_inst(func, IROpcode.IR_MOV, ir_op_stack(tmp_slot + 8, 8, false),
                         ir_op_vreg(slice_len_vreg, 8, false), ir_op_none(), expr.loc);

            return ir_op_stack(tmp_slot, 16, false);
        }

        case AstExprKind.EXPR_TUPLE: {
            var tuple_type:  Type* = expr.expr_type;
            var total_size:  u64   = 8;
            var total_align: u64   = 8;

            if (tuple_type.size > 0)  total_size  = tuple_type.size;
            if (tuple_type.align > 0) total_align = tuple_type.align;

            var tmp_slot: i32 = ir_func_alloc_stack_slot(func, total_size, total_align);

            for (var i: u64 = 0; i < expr.tuple_count; i += 1) {
                var elem_t:    Type* = tuple_type.tuple_elements[i];
                var elem_size: u64   = 8;

                if (elem_t != null && elem_t.size > 0) {
                    elem_size = elem_t.size;
                }

                var elem_off: i32 = tmp_slot + cast(i32, tuple_type.tuple_offsets[i]);

                var val: IROperand = lower_expr(self, expr.tuple_elements[i]);

                if (elem_t != null && elem_t.is_compound()) {
                    var dst_vreg: u32 = ir_vreg_alloc_t(func, type_ptr(func.arena, elem_t));

                    ir_emit_inst(func, IROpcode.IR_ADDR, ir_op_vreg(dst_vreg, 8, false),
                                 ir_op_stack(elem_off, elem_size, false), ir_op_none(), expr.loc);

                    var src_addr: IROperand = val;

                    if (src_addr.kind == IROperandKind.IR_OP_STACK || src_addr.kind == IROperandKind.IR_OP_GLOBAL) {
                        var src_vreg: u32 = ir_vreg_alloc_t(func, type_ptr(func.arena, expr.tuple_elements[i].expr_type));

                        ir_emit_inst(func, IROpcode.IR_ADDR, ir_op_vreg(src_vreg, 8, false),
                                     src_addr, ir_op_none(), expr.loc);

                        src_addr = ir_op_vreg(src_vreg, 8, false);
                    }

                    if (!ir_try_scalar_copy(self, ir_op_vreg(dst_vreg, 8, false), src_addr,
                                            elem_t, expr.loc, false)) {
                        ir_emit_inst(func, IROpcode.IR_MEMCPY, ir_op_vreg(dst_vreg, 8, false),
                                     src_addr, ir_op_const(cast(i64, elem_size), 8, false), expr.loc);
                    }
                } else {
                    ir_emit_inst(func, IROpcode.IR_MOV, ir_op_stack(elem_off, elem_size, false),
                                 val, ir_op_none(), expr.loc);
                }
            }

            return ir_op_stack(tmp_slot, total_size, false);
        }

        case AstExprKind.EXPR_CALL: {
            var callee_proc: AstProc* = null;

            if (expr.call_callee_sym != null && expr.call_callee_sym.proc_decl != null) {
                callee_proc = expr.call_callee_sym.proc_decl;
            }

            if (callee_proc != null && callee_proc.attrs.is_inlined) {
                var inlined_res: IROperand = ir_op_none();

                var call_args_slice: []AstExpr* = [];
                if (expr.call_arg_count > 0 && expr.call_args != null) {
                    call_args_slice = expr.call_args[0..expr.call_arg_count];
                }

                var inl_dest: IROperand = self.call_dest_hint;
                self.call_dest_hint = ir_op_none();

                if (try_inline_call(self, callee_proc, call_args_slice, &inlined_res, expr.loc, inl_dest)) {
                    return inlined_res;
                }

                self.call_dest_hint = inl_dest;
            }

            var ret_is_sret: bool = false;

            if (expr.expr_type != null) {
                ret_is_sret = expr.expr_type.requires_sret();
            }

            var sret_offset: u64 = 0;

            if (ret_is_sret) {
                sret_offset = 1;
            }

            var total_args: u64        = expr.call_arg_count + sret_offset;
            var args:       IROperand* = alloc_array[IROperand](self.arena, total_args);
            var arg_idx:    u64        = 0;
            var ret_slot:   i32        = 0;
            var sret_result: IROperand = ir_op_none();

            if (ret_is_sret) {
                var ret_size:  u64 = 8;
                var ret_align: u64 = 8;

                if (expr.expr_type != null) {
                    if (expr.expr_type.size > 0)  ret_size  = expr.expr_type.size;
                    if (expr.expr_type.align > 0) ret_align = expr.expr_type.align;
                }

                var dest_hint: IROperand = self.call_dest_hint;
                self.call_dest_hint = ir_op_none();

                if (dest_hint.kind == IROperandKind.IR_OP_VREG) {
                    args[arg_idx] = dest_hint;
                    arg_idx += 1;
                    sret_result = dest_hint;
                } else if (dest_hint.kind == IROperandKind.IR_OP_STACK || dest_hint.kind == IROperandKind.IR_OP_GLOBAL) {
                    var dest_vreg: u32 = ir_vreg_alloc_t(func, type_ptr(func.arena, expr.expr_type));

                    ir_emit_inst(func, IROpcode.IR_ADDR, ir_op_vreg(dest_vreg, 8, false),
                                 dest_hint, ir_op_none(), expr.loc);

                    args[arg_idx] = ir_op_vreg(dest_vreg, 8, false);
                    arg_idx += 1;
                    sret_result = dest_hint;
                } else {
                    ret_slot = ir_func_alloc_slot_t(func, expr.expr_type);

                    var ret_addr_vreg: u32 = ir_vreg_alloc_t(func, type_ptr(func.arena, expr.expr_type));

                    ir_emit_inst(func, IROpcode.IR_ADDR, ir_op_vreg(ret_addr_vreg, 8, false),
                                 ir_op_stack(ret_slot, ret_size, false), ir_op_none(), expr.loc);

                    args[arg_idx] = ir_op_vreg(ret_addr_vreg, 8, false);
                    arg_idx += 1;
                    sret_result = ir_op_stack(ret_slot, expr.expr_type.size, false);
                }
            }

            for (var i: u64 = 0; i < expr.call_arg_count; i += 1) {
                var arg: AstExpr* = expr.call_args[i];

                if (arg.expr_type != null && arg.expr_type.is_compound()) {
                    var compound_addr: IROperand = lower_addr(self, arg);

                    if (compound_addr.kind == IROperandKind.IR_OP_STACK || compound_addr.kind == IROperandKind.IR_OP_GLOBAL) {
                        var addr_vreg: u32 = ir_vreg_alloc_t(func, type_ptr(func.arena, arg.expr_type));

                        ir_emit_inst(func, IROpcode.IR_ADDR, ir_op_vreg(addr_vreg, 8, false),
                                     compound_addr, ir_op_none(), arg.loc);

                        args[arg_idx] = ir_op_vreg(addr_vreg, 8, false);
                    } else {
                        args[arg_idx] = compound_addr;
                    }
                } else {
                    args[arg_idx] = lower_expr(self, arg);
                }

                arg_idx += 1;
            }

            var dst: IROperand = ir_op_none();

            if (!ret_is_sret && expr.expr_type != null && expr.expr_type.kind != TypeKind.TYPE_VOID) {
                var vreg: u32 = ir_vreg_alloc_t(func, expr.expr_type);
                dst = ir_op_vreg(vreg, expr_size, is_signed);
            }

            var opcode: IROpcode  = IROpcode.IR_CALL;
            var src1:   IROperand = ir_op_none();

            if (expr.call_callee_expr != null) {
                opcode = IROpcode.IR_CALL_PTR;
                src1   = lower_expr(self, expr.call_callee_expr);
            }

            var call_inst: IRInst* = ir_emit_inst(func, opcode, dst, src1, ir_op_none(), expr.loc);

            call_inst.symbol_name     = expr.call_callee_name;
            call_inst.extra_args      = args;
            call_inst.extra_arg_count = total_args;

            var is_callee_variadic: bool = false;

            if (callee_proc != null) {
                is_callee_variadic = callee_proc.is_variadic;
            } else if (expr.call_callee_sym != null && expr.call_callee_sym.symbol_type != null && expr.call_callee_sym.symbol_type.kind == TypeKind.TYPE_FUNC) {
                is_callee_variadic = expr.call_callee_sym.symbol_type.func_is_variadic;
            } else if (expr.call_callee_expr != null && expr.call_callee_expr.expr_type != null) {
                var t: Type* = expr.call_callee_expr.expr_type;

                if (t.is_pointer()) {
                    t = t.base_type;
                }

                if (t.kind == TypeKind.TYPE_FUNC) {
                    is_callee_variadic = t.func_is_variadic;
                }
            }

            call_inst.is_variadic = is_callee_variadic;

            if (ret_is_sret) {
                return sret_result;
            }

            return dst;
        }

        case AstExprKind.EXPR_VA_START: {
            var ap_addr: IROperand = lower_addr(self, expr.va_valist_expr);

            ir_emit_inst(func, IROpcode.IR_VA_START, ap_addr,
                         ir_op_stack(func.reg_save_slot, 48, false),
                         ir_op_none(), expr.loc);

            return ir_op_none();
        }

        case AstExprKind.EXPR_VA_ARG: {
            var ap_addr:     IROperand = lower_addr(self, expr.va_valist_expr);
            var target_type: Type*     = expr.va_target_type;
            var size:        u64       = 8;
            var is_sgn:      bool      = false;

            if (target_type != null) {
                if (target_type.size > 0) {
                    size = target_type.size;
                }
                is_sgn = target_type.is_signed();
            }

            if (target_type != null && target_type.is_compound()) {
                var align: u64 = 8;

                if (target_type.align > 0) {
                    align = target_type.align;
                }

                var value_slot:       i32 = ir_func_alloc_slot_t(func, target_type);
                var value_ptr_vreg:   u32 = ir_vreg_alloc_t(func, type_ptr(func.arena, target_type));

                ir_emit_inst(func, IROpcode.IR_VA_ARG, ir_op_vreg(value_ptr_vreg, 8, false),
                             ap_addr, ir_op_const(8, 8, false), expr.loc);

                var destination_vreg: u32 = ir_vreg_alloc_t(func, type_ptr(func.arena, target_type));

                ir_emit_inst(func, IROpcode.IR_ADDR, ir_op_vreg(destination_vreg, 8, false),
                             ir_op_stack(value_slot, size, false), ir_op_none(), expr.loc);

                ir_emit_inst(func, IROpcode.IR_MEMCPY, ir_op_vreg(destination_vreg, 8, false),
                             ir_op_vreg(value_ptr_vreg, 8, false), ir_op_const(cast(i64, size), 8, false), expr.loc);

                return ir_op_stack(value_slot, size, false);
            }

            var vreg: u32 = ir_vreg_alloc(func);

            ir_emit_inst(func, IROpcode.IR_VA_ARG, ir_op_vreg(vreg, size, is_sgn),
                         ap_addr, ir_op_const(8, 8, false), expr.loc);

            return ir_op_vreg(vreg, size, is_sgn);
        }

        case AstExprKind.EXPR_VA_END: {
            var ap_addr: IROperand = lower_addr(self, expr.va_valist_expr);

            ir_emit_inst(func, IROpcode.IR_VA_END, ap_addr, ir_op_none(), ir_op_none(), expr.loc);

            return ir_op_none();
        }

        case AstExprKind.EXPR_VA_COPY: {
            var dst_addr: IROperand = lower_addr(self, expr.va_valist_expr);
            var src_addr: IROperand = lower_addr(self, expr.va_src_valist_expr);

            ir_emit_inst(func, IROpcode.IR_VA_COPY, dst_addr, src_addr, ir_op_none(), expr.loc);

            return ir_op_none();
        }
    }

    return ir_op_none();
}