import "libc.kl";
import "arena.kl";
import "strview.kl";
import "sbuilder.kl";
import "lexer.kl";
import "type.kl";
import "ast.kl";
import "ir/ir.kl";

struct SymbolSlot {
    symbol: Symbol*,
    offset: i32,
    next:   SymbolSlot*
}

struct LoopContext {
    bb_cond: IRBlock*,
    bb_end:  IRBlock*,
    prev:    LoopContext*
}

struct DeferEntry {
    active: bool,
    stmt: AstStmt*,
    next: DeferEntry*
}

struct DeferScope {
    entries: DeferEntry*,
    is_loop: bool,
    parent:  DeferScope*
}

struct InlineContext {
    proc_decl:            AstProc*,
    bb_return:            IRBlock*,
    ret_val_op:           IROperand,
    ret_sret_slot:        i32,
    has_return_val:       bool,
    boundary_defer_scope: DeferScope*,
    prev:                 InlineContext*
}

struct CleanupRoute {
    bb:    IRBlock*,
    scope: DeferScope*,
    next:  CleanupRoute*
}

struct IRLower {
    arena:                Arena*,
    module:               IRModule*,
    current_func:         IRFunction*,
    current_loop:         LoopContext*,
    symbol_slots:         SymbolSlot*,
    current_sret_slot:    i32,
    current_defer_scope:  DeferScope*,
    current_inline:       InlineContext*,
    call_dest_hint:       IROperand,
    nrvo_sym:             Symbol*,
    nrvo_ptr:             IROperand,
    defer_epoch:          u64,
    cleanup_bb:           IRBlock*,
    cleanup_epoch:        u64,
    cleanup_scope:        DeferScope*,
    cleanup_ret_slot:     i32,
    cleanup_pending:      bool,
    cleanup_enabled:      bool,
    cleanup_routes:       CleanupRoute*,
    body_block_depth:     u64,

    proc init(self, a: Arena*, mod: IRModule*) -> void {
        self.arena               = a;
        self.module              = mod;
        self.current_func         = null;
        self.current_loop         = null;
        self.symbol_slots         = null;
        self.current_sret_slot    = 0;
        self.current_defer_scope  = null;
        self.current_inline       = null;
        self.call_dest_hint       = ir_op_none();
        self.nrvo_sym             = null;
        self.nrvo_ptr             = ir_op_none();
        self.defer_epoch          = 0;
        self.cleanup_bb           = null;
        self.cleanup_epoch        = 0;
        self.cleanup_scope        = null;
        self.cleanup_ret_slot     = 0;
        self.cleanup_pending      = false;
        self.cleanup_enabled      = false;
        self.cleanup_routes       = null;
        self.body_block_depth     = 0;
    }

    proc bind_symbol_slot(self, sym: Symbol*, offset: i32) -> void {
        var slot: SymbolSlot* = alloc_zero[SymbolSlot](self.arena);

        slot.symbol = sym;
        slot.offset = offset;
        slot.next   = self.symbol_slots;

        self.symbol_slots = slot;
    }

    proc lookup_symbol_slot(self, sym: Symbol*) -> i32 {
        var s: SymbolSlot* = self.symbol_slots;

        while (s != null) {
            if (s.symbol == sym) {
                return s.offset;
            }

            s = s.next;
        }

        return 0;
    }

    proc defer_scope_push(self, is_loop: bool) -> void {
        var scope: DeferScope* = alloc_zero[DeferScope](self.arena);

        scope.entries = null;
        scope.is_loop = is_loop;
        scope.parent  = self.current_defer_scope;

        self.current_defer_scope = scope;
    }

    proc defer_scope_pop(self) -> void {
        if (self.current_defer_scope != null) {
            self.current_defer_scope = self.current_defer_scope.parent;
        }
    }

    proc defer_register(self, stmt: AstStmt*) -> void {
        self.defer_epoch += 1;

        if (stmt != null && stmt.kind == AstStmtKind.STMT_EXPR &&
            stmt.expr_stmt_expr != null && stmt.expr_stmt_expr.kind == AstExprKind.EXPR_CALL &&
            stmt.expr_stmt_expr.call_callee_sym != null) {
            self.cleanup_enabled = true;
        }

        if (self.current_defer_scope == null) {
            return;
        }

        var entry: DeferEntry* = alloc_zero[DeferEntry](self.arena);

        entry.stmt = stmt;
        entry.next = self.current_defer_scope.entries;

        self.current_defer_scope.entries = entry;
    }

    proc register_float_literal(self, bits: i64, byte_size: u64) -> u32 {
        if (bits == 0) {
            return 0;
        }

        var f: IRFloatConst* = self.module.first_float;

        while (f != null) {
            if (f.bits == bits && f.byte_size == byte_size) {
                return f.id;
            }

            f = f.next;
        }

        var fc: IRFloatConst* = alloc_zero[IRFloatConst](self.arena);

        fc.id        = cast(u32, self.module.float_count);
        fc.bits      = bits;
        fc.byte_size = byte_size;
        fc.next      = null;

        self.module.float_count += 1;

        if (self.module.first_float == null) {
            self.module.first_float = fc;
            self.module.last_float  = fc;
        } else {
            self.module.last_float.next = fc;
            self.module.last_float      = fc;
        }

        return fc.id;
    }

    proc register_string_literal(self, str: StrView) -> u32 {
        var s: IRStringConst* = self.module.first_str;

        while (s != null) {
            if (s.value.equals(str)) {
                return s.id;
            }

            s = s.next;
        }

        var sc: IRStringConst* = alloc_zero[IRStringConst](self.arena);

        sc.id    = cast(u32, self.module.str_count);
        sc.value = str;
        sc.next  = null;

        self.module.str_count += 1;

        if (self.module.first_str == null) {
            self.module.first_str = sc;
            self.module.last_str  = sc;
        } else {
            self.module.last_str.next = sc;
            self.module.last_str      = sc;
        }

        return sc.id;
    }
}

proc ir_block_create(func: IRFunction*, prefix: StrView) -> IRBlock* {
    var block: IRBlock* = alloc_zero[IRBlock](func.arena);

    block.name          = prefix;
    block.id            = 0;
    block.first_inst    = null;
    block.last_inst     = null;
    block.inst_count    = 0;
    block.is_terminated = false;
    block.is_placed     = false;
    block.next_block    = null;

    return block;
}

proc ir_block_switch(func: IRFunction*, block: IRBlock*) -> void {
    if (!block.is_placed) {
        block.is_placed = true;
        block.id        = func.next_block_id;
        func.next_block_id += 1;

        var sb: StringBuilder = sbuilder_create(func.arena);
        sb.append_str(block.name);
        sb.append_char('_');
        sb.append_u64(cast(u64, block.id));

        block.name = sb.to_str();

        if (func.first_block == null) {
            func.first_block = block;
            func.last_block  = block;
        } else {
            func.last_block.next_block = block;
            func.last_block            = block;
        }

        func.block_count += 1;
    }

    func.current_block = block;
}

proc ir_function_create(module: IRModule*, name: StrView, return_type: Type*) -> IRFunction* {
    var func: IRFunction* = alloc_zero[IRFunction](module.arena);

    func.arena                  = module.arena;
    func.name                   = name;
    func.return_type            = return_type;
    func.stack_frame_size       = 0;
    func.next_vreg_id           = 0;
    func.next_block_id          = 0;
    func.block_count            = 0;
    func.stack_slots            = null;
    func.stack_slot_count       = 0;
    func.stack_slot_cap         = 0;
    func.vreg_types             = null;
    func.vreg_type_cap          = 0;

    var entry: IRBlock* = ir_block_create(func, strview_from_cstr("bb_entry"));
    ir_block_switch(func, entry);

    func.entry_block   = entry;
    func.current_block = entry;

    if (module.first_func == null) {
        module.first_func = func;
        module.last_func  = func;
    } else {
        module.last_func.next = func;
        module.last_func      = func;
    }

    module.func_count += 1;

    return func;
}

proc ir_vreg_types_ensure(func: IRFunction*, need: u64) -> void {
    if (need <= func.vreg_type_cap) {
        return;
    }

    var new_cap: u64 = 16;

    while (new_cap < need) {
        new_cap = new_cap * 2;
    }

    var types: Type** = alloc_array_zero[Type*](func.arena, new_cap);

    var i: u64 = 0;

    while (i < cast(u64, func.next_vreg_id) && i < func.vreg_type_cap) {
        types[i] = func.vreg_types[i];
        i += 1;
    }

    func.vreg_types    = types;
    func.vreg_type_cap = new_cap;
}

proc ir_op_from_type(kind: IROperandKind, ty: Type*, byte_size: u64, is_signed: bool) -> IROperand {
    if (ty != null && ty.is_native_float()) {
        return ir_op_shaped(kind, ty.size, true, true);
    }

    return ir_op_shaped(kind, byte_size, is_signed, false);
}

proc ir_op_vreg_of_type(func: IRFunction*, vreg_id: u32, ty: Type*) -> IROperand {
    if (ty != null && ty.is_native_float()) {
        return ir_op_vreg_float(vreg_id, ty.size);
    }

    var size:   u64  = 8;
    var signed: bool = false;

    if (ty != null) {
        size   = ty.size;
        signed = ty.is_signed();
    }

    return ir_op_vreg(vreg_id, size, signed);
}

proc ir_vreg_is_float(func: IRFunction*, id: u32) -> bool {
    var ty: Type* = ir_vreg_type(func, id);

    return ty != null && ty.is_native_float();
}

proc ir_operand_is_float(func: IRFunction*, op: IROperand) -> bool {
    if (op.is_float) {
        return true;
    }

    if (op.kind == IROperandKind.IR_OP_REG) {
        return x86_reg_is_xmm(op.reg);
    }

    if (op.kind == IROperandKind.IR_OP_VREG) {
        return ir_vreg_is_float(func, op.vreg_id);
    }

    return false;
}

proc ir_float_operand_width(func: IRFunction*, a: IROperand, b: IROperand) -> u64 {
    var width: u64 = 4;

    if (ir_operand_is_float(func, a) && a.byte_size > width) {
        width = a.byte_size;
    }

    if (ir_operand_is_float(func, b) && b.byte_size > width) {
        width = b.byte_size;
    }

    return ir_float_width_normalize(width);
}

proc ir_float_type_from_width(byte_size: u64) -> Type* {
    switch (byte_size) {
        case 1:  return type_primitive(TypeKind.TYPE_F8);
        case 2:  return type_primitive(TypeKind.TYPE_F16);
        case 4:  return type_primitive(TypeKind.TYPE_F32);
        case 8:  return type_primitive(TypeKind.TYPE_F64);
        default: return null;
    }
}

proc ir_type_from_shape(byte_size: u64, is_signed: bool) -> Type* {
    if (byte_size == 1) {
        if (is_signed) { return type_primitive(TypeKind.TYPE_I8); }
        return type_primitive(TypeKind.TYPE_U8);
    }

    if (byte_size == 2) {
        if (is_signed) { return type_primitive(TypeKind.TYPE_I16); }
        return type_primitive(TypeKind.TYPE_U16);
    }

    if (byte_size == 4) {
        if (is_signed) { return type_primitive(TypeKind.TYPE_I32); }
        return type_primitive(TypeKind.TYPE_U32);
    }

    if (byte_size >= 8 && byte_size <= 8) {
        if (is_signed) { return type_primitive(TypeKind.TYPE_I64); }
        return type_primitive(TypeKind.TYPE_U64);
    }

    return null;
}

proc ir_operand_type_or_shape(func: IRFunction*, op: IROperand) -> Type* {
    if (op.kind == IROperandKind.IR_OP_VREG) {
        return ir_vreg_type(func, op.vreg_id);
    }

    if (op.kind == IROperandKind.IR_OP_REG && op.vreg_id != 0) {
        return ir_vreg_type(func, op.vreg_id);
    }

    if (op.kind == IROperandKind.IR_OP_STACK) {
        var st: Type* = ir_slot_type(func, op.stack_offset);

        if (st != null) {
            return st;
        }

        if (op.is_float) {
            return ir_float_type_from_width(op.byte_size);
        }

        return ir_type_from_shape(op.byte_size, op.is_signed);
    }

    if (op.kind == IROperandKind.IR_OP_CONST || op.kind == IROperandKind.IR_OP_GLOBAL) {
        if (op.is_float) {
            return ir_float_type_from_width(op.byte_size);
        }

        return ir_type_from_shape(op.byte_size, op.is_signed);
    }

    return null;
}

proc ir_backfill_inst_type(func: IRFunction*, inst: IRInst*) -> Type* {
    if (inst.opcode == IROpcode.IR_MOV) {
        var mov_ty: Type* = ir_operand_type_or_shape(func, inst.src1);

        if (mov_ty != null) {
            if (mov_ty.size == inst.dst.byte_size ||
                (mov_ty.kind == TypeKind.TYPE_PTR && inst.dst.byte_size == 8) ||
                (mov_ty.size < 8 && inst.dst.byte_size == 8)) {
                return mov_ty;
            }

            return null;
        }

        return ir_type_from_shape(inst.dst.byte_size, inst.dst.is_signed);
    }

    if (inst.opcode == IROpcode.IR_LOAD) {
        var addr_ty: Type* = ir_operand_type_or_shape(func, inst.src1);

        if (addr_ty != null && addr_ty.kind == TypeKind.TYPE_PTR && addr_ty.base_type != null) {
            if (addr_ty.base_type.size == inst.dst.byte_size) {
                return addr_ty.base_type;
            }

            return null;
        }

        if (addr_ty != null && addr_ty.kind != TypeKind.TYPE_PTR) {
            if (addr_ty.size == inst.dst.byte_size) {
                return addr_ty;
            }

            return null;
        }

        return null;
    }

    if (inst.opcode == IROpcode.IR_ADDR) {
        var pointee: Type* = ir_operand_type_or_shape(func, inst.src1);

        if (pointee == null) {
            pointee = ir_type_from_shape(inst.src1.byte_size, inst.src1.is_signed);
        }

        if (pointee == null) {
            return null;
        }

        return type_ptr(func.arena, pointee);
    }

    if (inst.opcode == IROpcode.IR_GLOBAL_STR) {
        return type_ptr(func.arena, type_primitive(TypeKind.TYPE_CHAR));
    }

    if (inst.opcode == IROpcode.IR_CMP_EQ || inst.opcode == IROpcode.IR_CMP_NE ||
        inst.opcode == IROpcode.IR_CMP_LT || inst.opcode == IROpcode.IR_CMP_LE ||
        inst.opcode == IROpcode.IR_CMP_GT || inst.opcode == IROpcode.IR_CMP_GE) {
        return type_primitive(TypeKind.TYPE_BOOL);
    }

    if (inst.opcode == IROpcode.IR_PHI) {
        var i: u64 = 0;

        while (i + 1 < inst.extra_arg_count) {
            var arg_ty: Type* = ir_operand_type_or_shape(func, inst.extra_args[i]);

            if (arg_ty != null) {
                return arg_ty;
            }

            i += 2;
        }

        return null;
    }

    return ir_type_from_shape(inst.dst.byte_size, inst.dst.is_signed);
}

proc ir_backfill_vreg_types(func: IRFunction*) -> void {
    if (func == null || func.vreg_types == null) {
        return;
    }

    var round: u64 = 0;

    while (round < 2) {
        var b: IRBlock* = func.first_block;

        while (b != null) {
            var inst: IRInst* = b.first_inst;

            while (inst != null) {
                if (inst.opcode != IROpcode.IR_NOP &&
                    inst.dst.kind == IROperandKind.IR_OP_VREG &&
                    cast(u64, inst.dst.vreg_id) < func.vreg_type_cap &&
                    func.vreg_types[inst.dst.vreg_id] == null) {

                    var ty: Type* = ir_backfill_inst_type(func, inst);

                    if (ty != null) {
                        func.vreg_types[inst.dst.vreg_id] = ty;
                    }
                }

                inst = inst.next;
            }

            b = b.next_block;
        }

        round += 1;
    }
}

proc ir_slot_type(func: IRFunction*, stack_offset: i32) -> Type* {
    var found:     Type* = null;
    var new_seen:  bool  = false;
    var ambiguous: bool  = false;
    var i:         u64   = 0;

    while (i < func.stack_slot_count) {
        if (func.stack_slots[i].new_offset != 0 && func.stack_slots[i].new_offset == stack_offset) {
            var ty: Type* = func.stack_slots[i].slot_type;

            new_seen = true;

            if (found == null) {
                found = ty;
            } else if (ty != found) {
                ambiguous = true;
            }
        }

        i += 1;
    }

    if (new_seen) {
        if (!ambiguous) {
            return found;
        }

        return null;
    }

    i = 0;

    while (i < func.stack_slot_count) {
        if (func.stack_slots[i].old_offset == stack_offset) {
            return func.stack_slots[i].slot_type;
        }

        i += 1;
    }

    return null;
}

proc ir_vreg_alloc(func: IRFunction*) -> u32 {
    ir_vreg_types_ensure(func, cast(u64, func.next_vreg_id) + 1);

    var id: u32 = func.next_vreg_id;
    func.next_vreg_id += 1;

    return id;
}

proc ir_vreg_alloc_t(func: IRFunction*, ty: Type*) -> u32 {
    ir_vreg_types_ensure(func, cast(u64, func.next_vreg_id) + 1);

    var id: u32 = func.next_vreg_id;
    func.next_vreg_id += 1;

    func.vreg_types[id] = ty;

    return id;
}

proc ir_vreg_type(func: IRFunction*, id: u32) -> Type* {
    if (func.vreg_types == null || cast(u64, id) >= func.vreg_type_cap) {
        return null;
    }

    return func.vreg_types[id];
}

proc ir_func_alloc_slot_t(func: IRFunction*, ty: Type*) -> i32 {
    var size:  u64 = 8;
    var align: u64 = 8;

    if (ty != null) {
        if (ty.size > 0) {
            size = ty.size;
        }
        if (ty.align > 0) {
            align = ty.align;
        }
    }

    var offset: i32 = ir_func_alloc_stack_slot(func, size, align);

    if (func.stack_slot_count > 0) {
        func.stack_slots[func.stack_slot_count - 1].slot_type = ty;
    }

    return offset;
}

proc ir_func_alloc_stack_slot(func: IRFunction*, size: u64, align: u64) -> i32 {
    var actual_align: u64 = align;
    var actual_size:  u64 = size;

    if (actual_align == 0) {
        actual_align = 8;
    }

    if (actual_size == 0) {
        actual_size = 1;
    }

    var aligned_size: u64 = (actual_size + actual_align - 1) & ~(actual_align - 1);
    func.stack_frame_size = (func.stack_frame_size + aligned_size + (actual_align - 1)) & ~(actual_align - 1);

    var offset: i32 = -cast(i32, func.stack_frame_size);

    var slot: IRStackSlot;
    slot.id         = cast(u32, func.stack_slot_count);
    slot.old_offset = offset;
    slot.size       = actual_size;
    slot.align      = actual_align;
    slot.is_spill   = false;
    slot.slot_type  = null;
    slot.new_offset = 0;

    if (func.stack_slot_count >= func.stack_slot_cap) {
        var old_cap: u64 = func.stack_slot_cap;
        var new_cap: u64 = 8;

        if (old_cap > 0) {
            new_cap = old_cap * 2;
        }

        var new_mem: u8* = func.arena.realloc(cast(void*, func.stack_slots), old_cap * sizeof(IRStackSlot), new_cap * sizeof(IRStackSlot));
        func.stack_slots = cast(IRStackSlot*, new_mem);
        func.stack_slot_cap = new_cap;
    }

    func.stack_slots[func.stack_slot_count] = slot;
    func.stack_slot_count += 1;

    return offset;
}

proc ir_emit_runtime_call(func: IRFunction*, name: char*, dst: IROperand, arg: IROperand, loc: SourceLoc) -> IRInst* {
    var args: IROperand* = alloc_array_zero[IROperand](func.arena, 1);

    args[0] = arg;

    var call: IRInst* = ir_emit_inst(func, IROpcode.IR_CALL, dst, ir_op_none(), ir_op_none(), loc);

    call.symbol_name     = strview_from_cstr(name);
    call.extra_args      = args;
    call.extra_arg_count = 1;

    return call;
}

proc ir_emit_inst(func: IRFunction*, op: IROpcode, dst: IROperand, src1: IROperand, src2: IROperand, loc: SourceLoc) -> IRInst* {
    var block: IRBlock* = func.current_block;

    if (block == null || block.is_terminated) {
        return null;
    }

    var inst: IRInst* = alloc_zero[IRInst](func.arena);

    inst.opcode           = op;
    inst.dst              = dst;
    inst.src1             = src1;
    inst.src2             = src2;
    inst.loc              = loc;
    inst.next             = null;
    inst.extra_args       = null;
    inst.extra_arg_count  = 0;
    inst.mem_index        = X86Reg.REG_NONE;
    inst.mem_scale        = 0;
    inst.asm_inputs       = null;
    inst.asm_input_count  = 0;
    inst.asm_outputs      = null;
    inst.asm_output_count = 0;
    inst.clobber_mask     = 0;
    inst.clobbers_memory  = false;
    inst.is_variadic      = false;
    inst.symbol_name      = strview_from_raw(null, 0);

    if (ir_opcode_is_terminator(op)) {
        block.is_terminated = true;
    }

    if (block.first_inst == null) {
        block.first_inst = inst;
        block.last_inst  = inst;
    } else {
        block.last_inst.next = inst;
        block.last_inst      = inst;
    }

    block.inst_count += 1;

    return inst;
}